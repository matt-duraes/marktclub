.bloco_geral_banner
    width: 100%
    max-width: 1130px
    height: 430px
    position: relative
    boxShadow()
    border-radius: 15px
    background: #FFF
    display: flex
    align-items: center
    overflow: hidden
    .seta
        width: 80px
        height: 80px
        position: absolute
        fill: #FFF
        border-radius: 50%
        flexCenter()
        background-color: rgba(0,0,0,.7)
        cursor: pointer
        z-index: 2
        opacity: 0
        transition: opacity .3s ease-out
    .seta.anterior
        left: 30px
    .seta.proximo
        right: 30px
    &:hover .seta
        opacity: 1
    figure
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background-position: center center
        background-size: cover
        opacity: 0
        &:first-child
            opacity: 1
    figure a
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
