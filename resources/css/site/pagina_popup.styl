.bloco_pagina_popup
    width: calc(100% - 40px)
    max-width: 700px
    position: relative
    margin: 20px 0
    display: flex
    background-color: $corBrancoPreto
    box-shadow: 0 4px 5px $corBoxShadow
    border-radius: 3px
    display: flex
    flex-direction: column
    overflow: hidden
    .header_pagina_popup
        width: 100%
        height: 50px
        line-height: 50px
        padding: 0 10px
        boxShadow()
        background-color: $corBrancoPreto
        display: flex
        flex-direction: row
        align-items: center
        z-index: 10
    .header_pagina_popup i
        width: 30px
        height: 30px
        flexCenter()
        fill: $corCinzaCinza
        cursor: pointer
    .header_pagina_popup h1
        flexGrow()
        font-size: 1.6rem
        color: $corCinzaCinza
        padding: 0 20px 0 10px
        text-transform: uppercase
        cursor: default
    .conteudo_pagina_popup
        width: 100%
        max-height: calc(100vh - 90px)
        overflow-y: auto
        overflow-x: hidden
        flex-direction: column
        &.footer
            max-height: calc(100vh - 170px)
    .footer_pagina_popup
        width: 100%
        box-shadow: 0 -4px 5px rgba(40,40,40,.1)
        padding: 15px 20px
        display: flex
        flex-direction: row
        justify-content: space-between
        z-index: 10
        bottom: 0
        .flex
            height: 40px
            flexGrow()
        .botao
            botaoPadraoGrande()
            background-color: $corClube
            color: #FFF
    .conteudo_pagina_popup .footer_pagina_popup
        box-shadow: none
        padding: 15px 0 5px
