tituloGrande()
    line-height: 1.5em
    font-size: 3rem
titulo()
    line-height: 1.5em
    font-size: 2.4rem
subTitulo()
    line-height: 1.5em
    font-size: 2rem
subTituloMaiusculo()
    line-height: 1.5em
    font-size: 1.8rem

texto()
    line-height: 1.5em
    textoFontSize()
textoCorClara()
    color: #BBB
textoFontSize()
    font-size: 1.6rem

flexCenter()
    display: flex
    align-items: center
    justify-content: center

flexRow()
    display: flex
    flex-direction: row

flexCol()
    display: flex
    flex-direction: column
flexGrow()
    flex-grow: 1
    flex-basis: 0%

blocoShadow()
    background-color: #FFF
    border-radius: 5px
    box-shadow: 0 2px 10px rgba(0,0,0,.1)
    padding: 20px

boxShadow()
    box-shadow: 0 2px 10px rgba(0,0,0,.1)

imagemRedonda()
    border-radius: 50%
    overflow: hidden
    background-size: cover
    background-position: center center
