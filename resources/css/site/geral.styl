.bloco_geral_texto
    blocoShadow()
    header h1
        titulo()

.texto
    width: 100%
    texto()
.texto p
.texto b
.texto strong
.texto a
.texto i
.texto li
    texto()
.deletar p
    width: 110px
    flexCenter()
    color: $branco
    background-color: $vermelho3
    font-size: 0.8em
    line-height: 1.5em
    padding: 5px 10px
    cursor: pointer
    border-radius: 5px

.bold
    font-weight: bold

.botao_geral_cor
    height: 45px
    line-height: 45px
    border-radius: 5px
    textoFontSize()
    padding: 0 20px
    text-align: center
    cursor: pointer
.botao_pequeno_cor
    height: 26px
    line-height: 26px
    border-radius: 5px
    font-size: 1.2rem
    padding: 0 10px
    text-align: center
    cursor: pointer
.botao_padrao_grande
    line-height: 45px
    border-radius: 5px
    textoFontSize()
    padding: 0 20px
    text-align: center
    cursor: pointer
.botao_pequeno_borda
    height: 26px
    line-height: 26px
    border-radius: 5px
    font-size: 1.2rem
    padding: 0 10px
    text-align: center
    border: 1px dashed
    cursor: pointer
.botao_geral_cor_auto_height
    height: auto
    line-height: 1.5em
    border-radius: 5px
    textoFontSize()
    padding: 10px
    text-align: center
    cursor: pointer
.botao_geral_borda
    height: 45px
    line-height: 45px
    border-radius: 5px
    textoFontSize()
    padding: 0 20px
    text-align: center
    cursor: pointer
    border: 1px solid
    cursor: pointer
.botao_link_underline:hover
    text-decoration: underline


.botao_input
    display: inline-block
    width: auto
    height: 40px
    min-width: 150px
    margin-right: 10px
    @media screen and (max-width: 740px)
        height: 50px
    label
        display: flex
        align-items: center
        justify-content: center
        width: 100%
        height: 100%
        border-radius: 5px
        border: 1px solid $corClube
        cursor: pointer
        texto()
        padding: 0px 10px
    input[type="radio"],
    input[type="checkbox"]
        position: absolute
        opacity: 0.01
        z-index: -1
    input[type="radio"]:checked + label,
    input[type="checkbox"]:checked + label
        background-color: $corClube
        color: $branco
        border-radius: 4px

.bloco_geral_ul
    width: 100%
    li
        list-style: disc
        texto()
    li span
        font-size: 1em

.bloco_geral_tabela
    width: 100%
    overflow-x: auto

.bloco_geral_sub_menu
    blocoShadow()
    flexCol()
    position: absolute
    padding: 10px 0
    a
        height: 48px
        line-height: 48px
        texto()
        flexRow()
        align-items: center
        padding: 0 20px
        &:hover
            background-color: #F8F9FA
    a i
        alignItemCenter()
        margin-right: 10px

.bloco_geral_sem_resultado
    width: 100%
    flexCol()
    position: relative
    align-items: center
    i
        fill: #DDD
        margin-bottom: 15px
    h1
        titulo()
        text-align: center
        margin-top: 5px
    p
        max-width: 450px
        texto()
        text-align: center
        margin-top: 5px
    .botao
        margin-top: 20px

.bloco_geral_imagem_direita
.bloco_geral_imagem_esquerda
    width: 100%
    height: 200px
    flexRow()
    boxShadow()
    align-items: center
    background-color: #FFF
    border-radius: 10px
    overflow: hidden
    figure
        width: 250px
        height: 200px
        margin-right: 40px
    header
        flexGrow()
        padding-right: 40px
        margin-right: 40px
        border-right: 1px solid #DDD
    header h1
        titulo()
    header p
        texto()
    .final
        margin-right: 40px
        flexCol()
        align-items: flex-start
    .valor
        width: 100%
        flexCol()
        margin-bottom: 20px
    .valor .apartir
        width: 100%
        margin-bottom: 2px
        font-size: 1.2rem
        color: #999
    .valor .preco
        flexRow()
    .valor .preco .sifrao
        font-size: 1.1rem
        margin: 5px 5px 0 0
    .valor .preco .real
        font-weight: 500
        font-size: 3rem
    .valor .preco .asterisco
        font-size: 1.2rem
        margin-top: 2px
        color: #999
    .valor .observacao
        font-size: 1.1rem
        line-height: 1.5em
        margin-top: 5px

.bloco_geral_imagem_direita
    flex-direction: row-reverse
    figure
        margin: 0
    .final
        margin-left: 40px
        margin-right: 0
    header
        padding: 0 0 0 40px
        margin: 0 40px
        border-left: 1px solid #DDD
        border-right: none

.display_none
    display: none !important
.display_block
    display: block !important
.display_flex
    display: flex !important

.titulo_geral
    width: 100%
    flexRow()
    margin-bottom: 10px
    align-items: center
    h1
        titulo()
        flexGrow()
    a
        texto()

.bloco_atencao_geral
    width: 100%
    padding: 10px
    border: 1px dashed #f00
    borderRadius()
    p
        texto()
.bloco_atencao_geral_icone
    width: 100%
    padding: 10px
    border: 1px dashed #f00
    borderRadius()
    p
        texto()
        padding-left: 10px


.bloco_titulo_texto
.bloco_titulo_texto_centralizado
    flexCol()
    boxShadow()
    borderRadius()
    background: #FFF
    padding: 10px 20px
    > h1
        titulo()
        margin-top: 5px
    > p
        texto()
        margin: 15px 0
        color: #666
.bloco_titulo_texto_centralizado
    text-align: center
    align-items: center

.article_favoritos
    justify-content: flex-start
    .parceiro_favorito
        width: calc((100% / 3) - 20px)
        margin-right: 20px
@media screen and (max-width: 900px)
    .article_favoritos .parceiro_favorito
        width: calc(50% - 15px)
        margin: 0px
        margin-bottom: 20px
        min-height: 250px
@media screen and (max-width: 600px)
    .article_favoritos .parceiro_favorito
        width: 100%
        margin-bottom: 20px
.botao_fixo_bottom
    width: 100%
    max-width: 240px
    height: 60px
    line-height: 60px
    position: fixed
    bottom: 42px
    left: calc((100% / 2) - 120px + 150px)
    opacity: 1
    transition: opacity .3s ease-out, bottom .3s ease-out
    overflow: hidden
    &.fechar
        bottom: 0
        opacity: 0
@media screen and (max-width: 1250px)
    .botao_fixo_bottom
        left: calc((100% / 2) - 120px)
@media screen and (max-width: 600px)
    .botao_fixo_bottom
        max-width: calc(100% - 40px)
        left: 20px
        bottom: 20px

[data-anime-botao]
    opacity: 0
    transition: .3s
[data-anime-botao="left"]
    transform: translate3d(-50px, 0, 0)
[data-anime-botao="right"]
    transform: translate3d(50px, 0, 0)
.container_scroll.ativar [data-anime-botao]
    opacity: 1
    transform: translate3d(0px, 0px, 0px)
.botao_scroll.animar-botao
    transform: translate3d(0px, 100px, 0px)
    opacity: 0

.coluna
    flexCol()

.form_input_dupla
    width: 100%
    spaceBetween()
    .bloco_input:nth-child(1)
        margin-right: 20px

.bloco_regulamento
    width: 100%
    flexCenter()
    directionColumn()
    espacoVerticalPadrao()
    padding: 0px 20px
    p
        texto()
        margin-top: 5px
