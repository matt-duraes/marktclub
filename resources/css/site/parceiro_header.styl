.bloco_parceiro_header
    maxWidth()
    boxShadow()
    border-radius: 10px
    overflow: hidden
    espacoBottomPadrao()
    background-color: #FFF

.bloco_parceiro_header .bloco_banner
    width: 100%
    flexCol()
    align-items: center
    position: relative
    .banner
        width: 100%
        height: 100%
        max-height: 300px
        overflow: hidden
        flexCenter()
    .banner img
        width: 100%
        max-width: 100%
    .logo
        max-height: 140px
        boxShadow()
        background-color: #FFF
        borderRadius()
        flexCenter()
        padding: 20px
        margin-top: -70px
        z-index: 2
        &.vazio
            margin-top: 40px
    .logo img
        max-width: 100%
        max-height: 100px
.bloco_parceiro_header .bloco_header
    width: 100%
    padding: 30px 20px 30px 20px
    flexCol()
    align-items: center
    h1
        titulo()
        text-align: center
    p
        texto()
        text-align: center
        max-width: 600px
        margin: 10px 0
