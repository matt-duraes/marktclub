.bloco_loja_detalhe
    width: 100%
    flexCol()
    align-items: center

.bloco_loja_detalhe .bloco_topo
    maxWidth()
    boxShadow()
    border-radius: 10px
    overflow: hidden
    espacoBottomPadrao()
    background-color: #FFF

.bloco_loja_detalhe .bloco_topo .bloco_banner
    width: 100%
    flexCol()
    align-items: center
    position: relative
    .banner
        width: 100%
        height: 100%
        background-position: center center
        background-size: cover
        &.mobile
            display: none
    .banner img
        width: 100%
    .logo
        width: 200px
        position: absolute
        boxShadow()
        background-color: #FFF
        borderRadius()
        flexCenter()
        bottom: -25px
        padding: 10px
    .logo img
        max-width: 100%
        max-height: 100px
.bloco_loja_detalhe .bloco_topo .bloco_header
    width: 100%
    padding: 45px 20px 20px 20px
    flexCol()
    align-items: center
    h1
        titulo()
        text-align: center
    p
        texto()
        text-align: center
        max-width: 600px
        margin: 10px 0

.bloco_desconto_procedimento
    maxWidth()
    flexRow()
    justify-content: space-between
    espacoBottomPadrao()
    .bloco
        width: calc(50% - 10px)

.bloco_loja_detalhe .bloco_botao
    flexRow()
    align-items: center
    espacoBottomPadrao()
    .linha
        width: 1px
        height: 30px
        background-color: #CCC
        margin-left: 20px
    .botao
        flexRow()
        align-items: center
        cursor: pointer
    .botao i
        width: 40px
        height: 40px
        flexCenter()
    .branco
        background-color: #FFF
        boxShadow()
        padding-left: 5px
        margin-left: 20px
    .branco i
        border-right: 1px solid #DDD
        margin-right: 15px
    .destaque
        padding-right: 10px
    .destaque i
        margin-left: 5px

.bloco_loja_detalhe .bloco_mapa
    width: calc(100% + 40px)
    height: 600px
    min-height: 400px
    max-height: calc(100vh - 200px)
    margin-top: 40px
    position: relative
    flexCol()
    align-items: center
    header
        width: calc(100% - 40px)
        max-width: $maxWidth
        z-index: 2
        margin-top: 20px
        flexRow()
        align-items: center
    header h1
        titulo()
    header .grow
        flexGrow()
    header .buscar
        background-color: #FFF
        margin-right: 20px
    .mapa
        width: 100%
        height: 100%
        background: #EEE
        position: absolute
        top: 0
        left: 0
        z-index: 1

@media screen and ( max-width: 600px )
    .bloco_desconto_procedimento
        flex-direction: column
    .bloco_desconto_procedimento .bloco
        width: 100%
        &:first-child
            margin-bottom: 20px
