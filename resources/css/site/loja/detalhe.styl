.bloco_loja_detalhe
    width: 100%
    max-width: $maxWidth
    flexCol()
    align-items: center

.bloco_loja_detalhe .bloco_topo
    maxWidth()
    boxShadow()
    border-radius: 10px
    overflow: hidden
    espacoBottomPadrao()
    background-color: #FFF

.bloco_loja_detalhe .bloco_topo .bloco_banner
    width: 100%
    flexCol()
    align-items: center
    position: relative
    .banner
        width: 100%
        height: 100%
        background-position: center center
        background-size: cover
        &.mobile
            display: none
    .banner img
        width: 100%
        max-height: 260px
    .logo
        width: 200px
        position: absolute
        boxShadow()
        background-color: #FFF
        borderRadius()
        flexCenter()
        bottom: -25px
        padding: 10px
    .logo img
        max-width: 100%
        max-height: 100px
.bloco_loja_detalhe .bloco_topo .bloco_header
    width: 100%
    padding: 45px 20px 20px 20px
    flexCol()
    align-items: center
    h1
        titulo()
        text-align: center
    p
        texto()
        text-align: center
        max-width: 600px
        margin: 10px 0

.bloco_desconto_procedimento
    maxWidth()
    flexRow()
    justify-content: space-between
    espacoBottomPadrao()
    .bloco
        width: calc(50% - 10px)

.bloco_botao, .bloco_mapa header
    display: flex
    width: 100%
    flex-wrap: wrap
    align-content: stretch
    overflow: scroll
    .botao
        background-color: #f1f1f1
        margin-right: 20px
        margin-top: 20px
    .linha
        width: 1px
        height: 30px
        background-color: #CCC
        margin-left: 20px
    .botao
        flexRow()
        align-items: center
        cursor: pointer
    .botao i
        width: 40px
        height: 40px
        flexCenter()
    .branco
        background-color: #FFF
        boxShadow()
        padding-left: 5px
        margin-left: 20px
    .branco i
        border-right: 1px solid #DDD
        margin-right: 15px
    .destaque
        padding-right: 10px
    .destaque i
        margin-left: 5px

@media screen and (max-width: 940px)
    .bloco_loja_detalhe .bloco_botao
        justify-content: center
        .botao
            width: 45%
            margin: 10px
        .botao &:first-child
            margin-top: 0px
        .botao &:last-child
            margin-bottom: 0px

@media screen and (max-width: 615px)
    .bloco_loja_detalhe .bloco_botao
        padding-top: 0px
        padding-bottom: 0px
        margin-bottom: 0px
        .botao
            width: 100%
            flexCenter()
        .botao i
            display: none

.bloco_loja_detalhe .bloco_mapa
    width: calc(100% + 40px)
    height: 600px
    min-height: 400px
    max-height: calc(100vh - 200px)
    margin-top: 40px
    position: relative
    flexCol()
    align-items: center
    header
        width: calc(100% - 40px)
        max-width: $maxWidth
        z-index: 2
        margin-top: 20px
        flexRow()
        align-items: center
    header h1
        titulo()
    header .grow
        flexGrow()
    header .buscar
        background-color: #FFF
        margin-right: 20px
    .botao_geral_cor,
    .botao_geral_cor i
        flexCenter()
    .mapa
        width: 100%
        height: 100%
        background: #EEE
        position: absolute
        top: 0
        left: 0
        z-index: 1
@media screen and ( max-width: 600px)
    .bloco_loja_detalhe .bloco_mapa header
        flex-direction: column
    header h1
        margin: 0px
        width: 100%
    .bloco_loja_detalhe .bloco_mapa header .buscar
        width: 100%
        margin: 20px 0px
    .bloco_loja_detalhe .bloco_mapa header .botao_geral_cor
        width: 100%
    .bloco_mapa header .branco
        margin-left: 0px
    .bloco_botao .branco i, .bloco_mapa header .branco i
        border: none
        margin: none
    #botao_endereco
        padding: 0px
        margin-right: 0px
    #como_chegar
        padding: 0px
        margin-right: 0px
@media screen and ( max-width: 600px )
    .bloco_desconto_procedimento
        flex-direction: column
    .bloco_desconto_procedimento .bloco
        width: 100%
        &:first-child
            margin-bottom: 20px
