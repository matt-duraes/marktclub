.bloco_tabela_geral
    width: 100%
    boxShadow()
    flexCol()
    overflow: hidden
    border-radius: 5px
    .scroll
        width: 100%
        overflow-x: auto
    .conteudo
        width: 100%
    .conteudo .linha
        width: 100%
        padding: 0 10px
        flexRow()
        align-items: center
    .conteudo .linha.titulo
        background: #EEE
    .conteudo .linha.titulo .td
        background: #EEE
    .conteudo .linha .td
        texto()
        padding: 10px
    .conteudo .linha .td:first-child
        flexGrow()
    .conteudo .linha
        border-bottom: 1px solid #EEE
        &:last-child
            border-bottom: none
