.bloco_passo_passo_geral .bloco_conteudo.bloco_conteudo_item_6
    .bloco_scroll
        width: 600%
    .conteudo
        width: calc(100% / 6)
.bloco_passo_passo_geral .bloco_conteudo.bloco_conteudo_item_7
    .bloco_scroll
        width: 700%
    .conteudo
        width: calc(100% / 7)
.bloco_passo_passo_geral .bloco_conteudo.bloco_conteudo_item_8
    .bloco_scroll
        width: 800%
    .conteudo
        width: calc(100% / 8)
.bloco_passo_passo_geral .bloco_conteudo.bloco_conteudo_item_9
