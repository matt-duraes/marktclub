.bloco_popup_geral
    width: calc(100% - 40px)
    max-height: calc(100vh - 40px)
    background: #FFF
    box-shadow: 0 0 10px rgba(0,0,0,.2)
    borderRadius()
    margin-top: 20px
    .popup_header
        width: 100%
        height: 50px
        box-shadow: 0 3px 5px rgba(0,0,0,.1)
        flexRow()
        align-items: center
        padding: 0 13px 0 20px
    .popup_header h1
        flexGrow()
        titulo()
    .popup_header i
        width: 30px
        height: 30px
        flexCenter()
        cursor: pointer
    .popup_conteudo
        max-height: calc(100vh - 90px)
        overflow-y: auto
    .popup_conteudo.centralizado
        flexCenter()

@media screen and (max-width: 740px)
    .bloco_popup_geral .popup_header h1
        subTituloMaiusculo()
