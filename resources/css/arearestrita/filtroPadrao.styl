#bloco_filtro
    width: calc(100% - 40px)
    max-width: 500px
    background-color: #FFF
    margin: 20px 0
    border-radius: 5px
    box-shadow: 0 5px 5px rgba(0,0,0,.5)
    header
        width: 100%
        height: 50px
        display: flex
        align-items: center
        justify-content: space-between
        padding: 0 20px
        border-bottom: 1px solid #EEE
    header h1
        font-size: 1.6rem
        color: $cor
        flex-grow: 1
        flex-basis: 0%
    header i.mobile
        display: none
        margin-right: 20px
    header i
        cursor: pointer
    .conteudo
        width: 100%
        display: flex
        flex-direction: column
        padding: 10px 20px 20px 20px
        align-items: flex-end
    .conteudo .input_input
        padding-bottom: 0
    .conteudo .bloco_de_ate
        width: 100%
        display: flex
        flex-direction: row
    .conteudo .bloco_de_ate p
        height: 45px
        line-height: 45px
        margin: 20px 20px 0 20px
        font-size: 1.4rem
        color: #999
    .conteudo .bloco_meio
        width: 100%
        display: flex
        flex-direction: row
        justify-content: space-between
    .conteudo .bloco_meio .input_input
        width: calc(50% - 10px)
    .conteudo .checkbox
        width: 100%
        display: flex
        flex-direction: row
        flex-wrap: wrap
        border: 1px solid #DDD
        border-radius: 3px
        margin-top: 20px
        padding: 15px 0 0 15px
    .conteudo .checkbox h1
        width: 100%
        font-size: 1.4rem
        margin-bottom: 10px
    .conteudo .checkbox .input_checkbox
        margin: 0 20px 20px 0
    footer
        width: 100%
        border-top: 1px solid #DDD
        padding: 10px 20px
        display: flex
        justify-content: flex-end
    footer button
        height: 40px
        line-height: 40px
        background-color: $cor
        color: #FFF
        padding: 0 20px
        border-radius: 3px
        font-size: 1.4rem
@media screen and (max-width:1000px)
    #bloco_filtro header i.desktop
        display: none
    #bloco_filtro header i.mobile
        display: block
@media screen and (max-width:500px)
    #bloco_filtro
        width: 100%
        max-width: 100%
        min-height: 100vh
        margin: 0
        border-radius: 0
        box-shadow: none
    #bloco_filtro .conteudo .bloco_de_ate
        .input_input:nth-child(1) input
            border-radius: 3px 0 0 3px
        .input_input:nth-child(3) input
            border-radius: 0 3px 3px 0
        p
            display: none
    #bloco_filtro .conteudo .bloco_meio
        flex-direction: column
        .input_input
            width: 100%
    #bloco_filtro .conteudo
        height: calc(100vh - 111px)
        overflow-y: auto

