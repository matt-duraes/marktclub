.bloco_sem_resultado
    width: 100%
    padding: 80px 0
    display: flex
    flex-direction: column
    align-items: center
    i
        width: 80px
        height: 80px
        border-radius: 50%
        border: 1px solid #CCC
        display: flex
        align-items: center
        justify-content: center
        fill: #999
    h1
        color: #999
        font-size: 2.2rem
        text-align: center
        margin-top: 20px
    p
        width: 100%
        max-width: 400px
        margin-top: 10px
        line-height: 1.5em
        font-size: 1.6rem
        text-align: center
        color: #AAA
