#bloco_app_lista
    width: 100%
    position: relative
    padding: 20px 0 95px 0
    .botao_geral
        width: 50px
        height: 50px
        bottom: 25px
        border-radius: 25px
        position: fixed
        z-index: 10
        fill: #FFF
        overflow: hidden
        transition: width .3s ease-out, opacity .3s ease-out
        box-shadow: 0 4px 5px rgba(0,0,0,.05)
        z-index: 11
    .botao_geral.add
        right: 20px
        bgDegradeVerde()
        &.hover
            width: 110px
    .botao_geral.deletar
        display: none
        right: 85px
        transition: right .3s ease-out, width .3s ease-out
        bgDegradeVermelho()
        &.hover_add
            right: 145px
        &.hover
            width: 135px
    .botao_geral i
        width: 50px
        height: 50px
        top: 0
        position: absolute
        flexCenter()
    .botao_geral p
        width: 60px
        height: 50px
        top: 0
        position: absolute
        left: 50px
        padding-left: 5px
        line-height: 50px
        color: #FFF
        font-size: 1.2rem

#bloco_app_lista .bloco_filtro
    width: calc(100% - 40px)
    margin-left: 20px
    padding: 10px
    margin-bottom: 20px
    background-color: #FFF
    border-radius: 4px
    align-items: center
    display: flex
    flex-direction: row
    box-shadow: 0 4px 5px rgba(0,0,0,.05)
    .filtro
        display: flex
        flex-direction: row
        flex-wrap: wrap
        flexGrow()
    .limpar
        width: 30px
        height: 30px
        background-color: $corDeletar
        fill: #FFF
        flexCenter()
        border-radius: 3px
        opacity: .5
        transition: opacity .3s ease-out
        &:hover
            opacity: 1
    .bloco
        position: relative
        margin-right: 10px
        padding: 5px 30px 5px 5px
        display: flex
        justify-content: center
        flex-direction: column
        color: #999
        border: 1px solid #EEE
        border-radius: 3px
    .bloco span
        font-weight: 300
        color: #333
        font-size: 1.4rem
    .bloco button
        width: 20px
        height: 20px
        flexCenter()
        position: absolute
        right: 5px
        border-radius: 50%
        &:hover
            background: #EEE
    .linha
        width: 1px
        height: 30px
        background: #DDD
        margin: 0 20px 0 10px

#bloco_app_lista .bloco_lista
    width: 100%
    position: relative
    display: flex
    flex-direction: column
    z-index: 10
    .titulo
        background: $corBody
        position: absolute
        top: 0
        z-index: 10
        padding: 0 20px 0 30px
    .titulo.titulo_fixed
        width: calc(100% - 300px)
        position: fixed
        top: 60px
        right: 0
        box-shadow: 0 5px 5px rgba(0,0,0,.05)
    .titulo_fake
        position: relative
        opacity: 0
        z-index: 1

#bloco_app_lista.opaco
    .botao_add
        opacity: .5
    .bloco_lista .linha .lista.geral
        opacity: .7

#bloco_app_lista .bloco_lista
    .linha
        width: 100%
        padding: 5px 20px
    .lista
        width: 100%
        display: flex
        flex-direction: row
        align-items: center
    .linha .lista.geral
        background: #FFF
        padding-left: 10px
        box-shadow: 0 0 5px rgba(0,0,0,.1)
        border-radius: 5px
        align-items: center
        border: 1px solid #FFF
        opacity: 1
        transition: opacity .3s ease-out
    .linha:hover .lista.geral
        border: 1px solid $cor
        opacity: 1
    .linha.hover .lista.geral
        opacity: 1
    .lista .drag
        width: 35px
        fill: #999
        cursor: pointer
    .lista .checkbox
        width: 35px
    .lista .dado
        padding: 15px 10px 15px 0
        display: flex
        flex-direction: row
        align-items: center
        flexGrow()
    .lista .barra
        width: 1px
        height: 20px
        background-color: #DDD
        margin: 0 10px
        &:last-child
            display: none
    .lista .td
        display: flex
        align-items: center
        font-size: 1.4rem
        font-weight: 300
        word-wrap: break-word
        word-break: break-word
    .lista .td .copiar
        border: 1px solid #DDD
        border-radius: 3px
        margin-left: 10px
    .lista .dado .td.grande
        flex-grow: 3
        flex-basis: 0%
    .lista .dado .td.normal
        flex-grow: 2
        flex-basis: 0%
    .lista .dado .td.pequeno
        flex-grow: 1
        flex-basis: 0%
    .lista .td.center
        flexCenter()
    .lista .td.status
        width: 20px
        flexCenter()
    .linha .lista .td.status span
        width: 100%
        height: 10px
        background: $cor
        color: #FFF
        border-radius: 10px
    .lista .td .bola
        width: 10px
        height: 10px
        background-color: $cor
        border-radius: 50%
@media screen and (max-width:1000px)
    #bloco_app_lista .bloco_lista .lista
        .td
        .barra
            display: none
        .td:nth-child(1)
            display: flex

#bloco_app_lista .bloco_lista .sem_registro
    width: 100%
    display: flex
    padding: 0 20px
    flex-direction: column
    align-items: center
    .conteudo
        width: 100%
        min-height: calc(100vh - 320px)
        display: flex
        flex-direction: column
        justify-content: center
        align-items: center
        background-color: #fff
        box-shadow: 0 4px 5px rgba(0,0,0,.05)
        padding: 40px 20px
        border-radius: 5px
    .conteudo i
        width: 100px
        height: 100px
        border-radius: 50%
        border: 1px solid #CCC
        flexCenter()
        fill: #999
    .conteudo h2
        font-size: 1.6rem
        color: #666
        margin: 30px 0 10px 0
        text-align: center
    .conteudo p
        max-width: 400px
        line-height: 1.5em
        font-size: 1.4rem
        text-align: center
        color: #999
    .conteudo a
        height: 40px
        line-height: 40px
        padding: 0 30px
        margin-top: 20px
        border-radius: 20px
        font-size: 1.2rem
        color: #FFF
        &.add
            bgDegradeVerde()
        &.limpar
            bgDegradeVermelho()

.bloco_paginacao_numero
    height: 50px
    position: fixed
    bottom: 20px
    display: flex
    flex-direction: row
    z-index: 10
    .bg
        height: 50px
        padding: 5px 10px
        margin-left: 20px
        background-color: #FFF
        border-radius: 25px
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        display: flex
        flex-direction: row
    .bg .registro
        height: 40px
        line-height: 40px
        font-size: 1.4rem
        padding: 0 15px
    .bg .seta
        width: 40px
        height: 40px
        display: flex
        align-items: center
        justify-content: center
        fill: #CCC
        border-radius: 20px
    .bg a.seta
        fill: #666
        &:hover
            background-color: #EEE
.bloco_paginacao_geral
    width: calc(100% - 300px)
    position: fixed
    bottom: 30px
    display: none
    justify-content: center
    z-index: 10
    .conteudo
        display: flex
        flex-direction: row
    .conteudo .lista_numero
        background: #FFF
        border-radius: 3px
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        display: flex
        flex-direction: row
    .conteudo .numero
        min-width: 40px
        height: 40px
        padding: 0 5px
        font-size: 1.4rem
        display: flex
        align-items: center
        justify-content: center
    .conteudo a.numero:hover
        background-color: #F6F6F6
    .conteudo .numero.texto
        padding: 0 15px
        background: #FFF
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        border-radius: 3px
    .conteudo span.numero
        background-color: #EEE
        cursor: default
    .conteudo .numero.texto.primeiro
        margin-right: 15px
    .conteudo .numero.texto.ultimo
        margin-left: 15px

#bloco_app_filtrar
#bloco_app_filtrar .header_pagina_popup
    max-width: 500px
    .bloco_row
        width: 100%
        display: flex
        flex-direction: row
        justify-content: space-between
    .bloco_row .bloco_input
        flex-grow: 1
        flex-basis: 0%
        margin-right: 20px
    .bloco_row .bloco_input:last-child
        margin-right: 0

#bloco_app_download
    max-width: 700px
    .header_pagina_popup
        max-width: 700px
        margin-bottom: 10px
    .conteudo_pagina_popup
        max-height: calc(100vh - 100px)
    .bloco
        width: 100%
        display: flex
        flex-direction: row
        flex-wrap: wrap
        margin-top: 20px
        border: 1px solid #DDD
        border-radius: 5px
        padding: 10px
    .bloco h1
        width: 100%
        font-size: $textoFontSize
    .bloco .input_checkbox
        width: calc(100% / 3)
        margin-top: 15px
    .footer
        width: calc(100% + 40px)
        display: flex
        flex-direction: row
        flex-wrap: wrap
        padding-top: 20px
        margin-top: 40px
        margin-left: -20px
        padding: 30px 20px 0 20px
        border-top: 1px solid #DDD
    .footer .button
        width: 140px
        margin: 20px 0 0 20px
    .footer .bloco_senha
        width: calc(100% - 160px)

@media screen and (max-width:600px)
    #bloco_app_download .conteudo_pagina_popup
        .bloco
            display: flex
            flex-direction: column
        .bloco .input_checkbox
            width: 100%
        .footer
            flex-direction: column
        .footer .bloco_senha
            width: 100%
        .footer .button
            width: 100%
            margin: 10px 0 0 0
