@system "Resetar"
@system "Form"
@system "Alerta"
@system "Loading"

$cor = #169e91
$corClara = #23dbc9

$corVermelha = #FF6C60
$corAzul = #00aced
$corVerde = #169e91
$corLaranja = #ffa500

texto()
    font-size: 1.6rem
    line-height: 1.5em
textoFontSize()
    font-size: 1.6rem
titulo()
    font-size: 2.4rem

body
    font-family: 'Roboto', sans-serif

.display_flex
    display: flex !important
.display_block
    display: block !important
.display_none
    display: none !important

pre.bloco_codigo_geral
    padding: 10px
    width: 100%
    overflow-x: auto
    background: #222
    code
        texto()
        color: #FFF
#site
    width: 100%
    display: flex
    flex-direction: column
    align-items: center
.bloco_menu_mobile
    width: 100%
    height: 50px
    position: fixed
    top: 0
    right: 0
    background: #FFF
    box-shadow: 0 4px 5px rgba(0,0,0,.05)
    display: flex
    flex-direction: row
    align-items: center
    z-index: 10
    display: none
    i
        width: 40px
        height: 40px
        padding-left: 10px
        display: flex
        align-items: center
        justify-content: center
        fill: #999
        cursor: pointer
        z-index: 10
    p
        font-size: 2rem
        color: #666
        padding-left: 20px

#site nav
    width: 100%
    max-width: 300px
    height: 100vh
    position: fixed
    top: 0
    left: 0
    background-color: rgba(0,0,0,.7)
    overflow-y: auto
    transition: opacity .3s ease-out, margin-left .3s ease-out
    opacity: 1
    z-index: 11
    &.aberto
        opacity: 1
    .conteudo
        width: 100%
        min-height: 100%
        display: flex
        flex-direction: column
        background-color: #F6F6F6
        padding: 20px 10px 0 10px
        margin-left: 0
        transition: margin-left .3s ease-out
    &.aberto .conteudo
        margin-left: 0
    h1
        width: 100%
        titulo()
        color: $cor
    h2
        font-size: 1.8rem
        display: flex
        flex-direction: row
        align-items: center
        margin-top: 20px
    h2 i
        margin-right: 5px
    a
        width: 100%
        texto()
        color: #666
        cursor: pointer
        display: flex
        align-items: center
        &:hover
            background-color: #EEE
    .conteudo > a
        padding: 5px 20px
        margin-top: 5px
    .rodape
        width: 100%
        height: 100%
        padding-bottom: 20px
        display: flex
        flex-grow: 1
        flex-basis: 0
        flex-direction: column
        justify-content: flex-end
    .rodape a
        padding: 5px 0
        display: flex
        align-items: center
    .rodape a i
        width: 30px
        margin-right: 5px
        display: flex
        align-items: center
        justify-content: center
        fill: #999
    .rodape .linha
        width: 100%
        height: 1px
        background-color: #ddd
        margin: 10px 0

#site main
    width: 100%
    padding: 40px 40px 40px 340px
    overflow-y: auto
    header.header_principal
        width: 100%
        padding: 20px 20px 17px 20px
        border: 1px solid #DDD
        border-left: 5px solid $cor
        border-radius: 0 4px 4px 0
    header.header_principal h1
        titulo()
    header.header_principal p
        texto()
        color: #666
        margin: 10px 0 0

@media screen and (max-width:1350px)
    #site nav
        max-width: 100%
        display: none
        opacity: 0
        .conteudo
            max-width: 300px
            background: #FFF
            margin-left: -300px
    #site nav.aberto
        opacity: 1
        .conteudo
            margin-left: 0
    .bloco_menu_mobile
        display: flex
    #site main
        padding-left: 20px
        padding-right: 20px
        padding-top: 80px

.bloco_popup
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    z-index: 100
    background: rgba(0,0,0,.7)
    display: none
    align-items: center
    justify-content: center
    opacity: 0
    transition: opacity .3s ease-out
    &.abrir
        opacity: 1
    &.abrir .conteudo
        margin-top: 20px

.bloco_popup .conteudo
    background: #FFF
    margin: -100px 20px 20px 20px
    width: calc(100% - 40px)
    max-width: 460px
    max-height: calc(100vh - 40px)
    border-radius: 5px
    padding: 20px
    overflow-y: auto
    transition: margin-top .3s ease-out
    h1
        titulo()
        color: $cor
    p
        texto()
        color: #666
        margin-top: 10px
    p.alerta
        background-color: lighten($corVermelha, 27)
        padding: 10px 10px 10px 15px
        border-left: 3px solid $corVermelha
    form
        margin-top: 40px
    .footer
        width: 100%
        margin-top: 20px
        display: flex
        flex-direction: row
        justify-content: space-between
    .footer .botao
        height: 40px
        line-height: 40px
        padding: 0 30px
        border-radius: 20px
        background-color: #CCC
        font-size: 1.2rem
        cursor: pointer
        &.confirmar
            background-color: $cor
            color: #FFF

@media print
    #site nav
        display: none
    #site main
        padding: 20px
