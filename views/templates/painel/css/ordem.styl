#bloco_ordem_template
    width: 100%
    max-width: 220px
    position: fixed
    top: 107px
    opacity: 0
    z-index: 210
    transition: opacity .3s ease-out, top .3s ease-out
    display: none
    .seta
        width: 30px
        height: 30px
        top: 98px
        opacity: 0
        transition: opacity .3s ease-out, top .3s ease-out
        bgDegradeVerde()
        transform: rotate(45deg)
        position: fixed
        z-index: 1

#bloco_ordem_template .conteudo
    width: 100%
    position: relative
    padding-bottom: 12px
    background-color: #FFF
    overflow: hidden
    box-shadow: 0 4px 5px rgba(0,0,0,.1)
    border-radius: 5px
    z-index: 2
    header
        width: 100%
        height: 40px
        line-height: 40px
        margin-bottom: 10px
        bgDegradeVerde()
        display: flex
        flex-direction: row
    header button
        fill: #FFF
        height: 40px
        width: 40px
        display: flex
        align-items: center
        justify-content: center
    header h1
        flex-grow: 1
        flex-basis: 0%
        font-size: 1.4rem
        font-weight: 300
        padding-left: 15px
        color: #FFF
    a
        width: 100%
        position: relative
        padding: 10px
        display: flex
        flex-direction: row
        align-items: center
        transition: background-color .3s ease-out
        overflow: hidden
        &:hover
            background-color: #EEE
    a p
        font-size: 1.2rem
        flexGrow()
        color: #999
        transition: color .3s ease-out
    a:hover p
        color: #666
    a i
        width: 20px
        height: 20px
        fill: #999
        position: absolute
        right: -20px
        transition: right .3s ease-out
        flexCentro()
    a:hover i
        right: 10px

#bloco_ordem_template.ordem_abrir
    opacity: 1
    top: 67px
    .seta
        top: 58px
        opacity: 1

@media screen and (max-width:1100px)
    #bloco_ordem_template .conteudo header h1
        padding-left: 0
