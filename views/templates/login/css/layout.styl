@system "Resetar"
@system "Pagina"
@system "Form"
@system "Animacao"
@system "Loading"
@system "Alerta"

@resource "site/mixim"
@resource "site/variavel"
@resource "site/geral"

body
    background-color: #F6F6F6
    font-family: 'Inter', sans-serif
    color: #495057

#site
    min-height: 100vh
    flexCenter()
    directionColumn()
    overflow: hidden

.linha_topo
    width: 100%
    height: 12px
    position: absolute
    top: 0px


#header_principal
    width: 100%
    max-width: 1000px
    height: 180px
    position: absolute
    top: 0
    padding: 0 20px
    display: flex
    flex-direction: row
    align-items: center
    z-index: 3
    figure
        flex-grow: 1
        flex-basis: 0%
    figure img
        height: 60px
    figure .automatico
        height: auto
    nav
        display: flex
        flex-direction: row
        align-items: center
    nav .menu
        display: flex
        flex-direction: row
    nav .menu .fechar
        display: none
    nav .botao
        position: relative
        display: flex
        flex-direction: column
        align-items: center
        margin-right: 20px
        border-bottom: 3px solid rgba(255,255,255,0)
        cursor: pointer
    nav .botao i
        height: 30px
        font-size: 3em
        overflow: hidden
    nav .botao svg
        margin: 2px 0 7px
    nav .botao p
        font-size: 1.6em
        color: #666
        margin-top: 5px
    nav .botao .borda
        width: 0%
        height: 3px
        margin-top: 8px
        transition: width .3s ease-out
    nav .botao:hover .borda
        width: 100%
    nav .entrar
        height: 40px
        line-height: 40px
        padding: 0 25px
        color: #FFF
        font-size: 1.6em
        margin-left: 20px
        border-radius: 3px

@media screen and (max-width: 700px)
    #header_principal nav .menu
        position: absolute
        top: 0
        left: 0
        width: 80%
        height: 100%
        padding: 100px 20px
        display: flex
        flex-direction: column
        justify-content: center
        align-items: flex-start
        text-align: center
        transform: translateX(-100%)
    #header_principal nav .menu.show
        transform: translateX(0)
        position: fixed
        top: 0
        left: 0
        width: 100%
        height: 100%
        background-color: rgba(0, 0, 0, 0.8)
        z-index: 9999
    #header_principal nav .menu.show .fechar
        display: block
        position: absolute
        top: 20px
        right: 10px
        cursor: pointer
    #header_principal nav .menu.show .fechar svg
        width: 20px
        height: 20px
        fill: #fff
    #header_principal nav .menu a p
        color: #fff


/* Estilos para a versão desktop */
@media (min-width: 701px)
    .navbar_hamburguer
        display: none

/* Estilos para a versão mobile */
@media (max-width: 700px)
    .navbar_hamburguer
        flexCenter()
        cursor: pointer
        position: absolute
        left: 20%
        height: 100%
        top: 0

@media screen and (max-width: 700px)
    #header_principal .logo
        flex-direction: row
        text-align: center
        margin-top: 30px
    #header_principal nav
        width: 100%
        flexCenter()
        flex-direction: row
        position: fixed
        bottom: 0
        left: 0
        padding: 10px 0px
        border-color: $corClube
        background-color: white
        border-top-style: solid
        border-top-width: 2px
        z-index 4
        width: 100%
        a:nth-child(1)
            display: none
        a:nth-child(2)
            order: 1
        a:nth-child(3)
            order: 3
        a:nth-child(4)
            order: 2
        .botao, .entrar
            margin-right: 0px
            margin-left: 0px
            align-self: center
            border-radius: 20px
        .botao:hover .borda
            visibility: hidden
        a
            justify-content: space-around
    hr
        border: solid 1px #ccc
        width: 80%
        margin-top: 40px
        display inline

@media screen and (max-width: 1040px)
    #header_principal nav a p
        text-align: center
//midia queries banner//
@media screen and (max-width: 700px)
    .display_mobile
        display: block !important
    #header_principal
        flex-direction: column
        margin-top: 0px
        margin-bottom: 30px
        position: relative
        height: auto
    #header_principal div
        text-align: center
    #header_principal div h1
        font-size: 2em
        font-weight: bold
        margin-bottom: 10px
        margin-top: 20px

    #header_principal div h3
        font-size: 1.5em
        color: #666
    #header_principal .logo_mobile
        margin-top: 20px



// footer //
#bloco_footer
    display: flex
    justify-content: space-between
    margin: 30px
    width: 100%
    max-width: 1000px
    margin-bottom: 50px
    border-top: 1px solid var(--cor-clube)
    p
        display: flex
    section
        width: 100%
        display: flex
        justify-content: flex-end
        padding: 2px
        margin-top: 20px
        margin-bottom: 20px
    section:first-child
        flex-direction: column
        text-align: center
        margin-right: 30px
    section ul
        display: flex
        flex-direction: column
        margin-bottom: 20px
        font-size: 1.1em
    section ul li
        margin-top: 15px
        display: flex
        flex-direction: row
        align-items: center
    section ul li a
        font-size: 1.5rem
        margin-right: 15px
    section ul li a svg
        fill: $corClube
    section ul li .link_container
        font-size: unset
        display: flex
        justify-content: center
        align-items: center
    section ul li .link_container figure
        margin-right: 15px
    section ul li,
    section ul li span
        font-size: 1.2em
        color: #333

#bloco_footer .ul_icones_mobile
    display: none

#bloco_footer .contato_mobile
    display: none

#bloco_footer .clube_centralizado
    display: flex
    flex-direction: row
    justify-content: space-around

//bloco_footer//
@media screen and (max-width: 700px)
    #bloco_footer
        flex-direction: column
        align-items: center
        justify-content: center
        width: 80%
    #bloco_footer section
        margin: 0px
    #bloco_footer section:first-child
        display: none
    #bloco_footer section ul
        width: 100%
        margin: 0px

@media screen and (max-width: 700px)
    #bloco_footer .ul_icones_mobile
        display: flex
        width: 100%
        justify-content: flex-start
        font-size: 25px
        ul, li
            display: flex
            flex-direction: row
            width: 60%
            padding: 25px 0px 10px
        ul, li a i svg
            fill: $corClube

@media screen and (max-width:1000px)
    #bloco_footer section ul span
        margin-right: 30px
@media screen and (max-width: 850px)
    #bloco_footer
        flex-direction: column
        align-items: center
        justify-content: center
        width: 80%
        margin-bottom: 100px
    #bloco_footer .contato_mobile
        display: flex
        width: 100%
        padding: 65px 0px 43px
        font-size: 2.5rem
    #bloco_footer section
        margin: 0px
    #bloco_footer section:first-child
        display: none
    #bloco_footer section ul
        width: 100%
        margin: 0px
@media scren and (max-width: 800px)
    #bloco_footer .contato_mobile
        display: flex
        width: 100%
        padding: 65px 0 43px
        font-size: 1.5rem
