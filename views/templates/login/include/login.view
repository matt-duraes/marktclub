<div id="popup_login">
    @ if( LOGIN_ESCOLHA ):
    <div id="bloco_escolha_login" class="bloco_form_login">
        <i class="fechar esquerda mobile popup_fechar">@iconeVoltar</i>
        <i class="fechar direita desktop popup_fechar">@iconeFechar</i>
        <i class="icone">@iconeUsuario(30)</i>
        <h1>Escolha um tipo de login</h1>
        <p>Escolha entre as opções abaixo para fazer seu login</p>
        @ if( API ):
        <a href="{{LINK_LOGIN}}" class="botao">{{BOTAO_LOGIN_USUARIO}}</a>
        @ else:
        <div class="botao botao_abrir_menu_normal">{{BOTAO_LOGIN_USUARIO}}</div>
        @ endif;
        @ if( MENU_DEPENDENTE ):
        <div class="botao botao_abrir_menu_normal">{{BOTAO_LOGIN_DEPENDENTE}}</div>
        @ endif;
        @ if( MENU_FUNCIONARIO && !empty(LINK_FUNCIONARIO) ):
        <div class="linha_funcionario"></div>
        <a href="{{LINK_FUNCIONARIO}}" class="botao">{{BOTAO_LOGIN_FUNCIONARIO}}</a>
        @ elseif( MENU_FUNCIONARIO ):
        <div class="botao botao_abrir_menu_normal">{{BOTAO_LOGIN_FUNCIONARIO}}</div>
        @ endif;
    </div>
    @ endif;
    <form id="bloco_form_login" class="bloco_form_login form_geral {!!LOGIN_ESCOLHA ? 'display_none' : ''!!}" action="/" method="post">
        <div class="conteudo">
            <header>
                <div class="bloco">
                    <i class="voltar display_none">@iconeVoltar</i>
                    <h1>FAÇA SEU LOGIN</h1>
                </div>
                <p>Digite seu CPF e sua senha para fazer login, caso não tenha senha, clique em "Primeiro acesso" para criar sua conta</p>
            </header>
            <i class="fechar popup_fechar">@iconeFechar</i>

            <input type="text" autocomplete="username" value="" class="input_hidden">
            <input type="password" autocomplete="current-password" value="" class="input_hidden">
            <input type="password" autocomplete="new-password" value="" class="input_hidden">

            @? formCpf(name: 'login', label: 'Login', placeholder: 'Digite seu CPF')
            @? formSenha(name: 'senha', label: 'Senha', placeholder: 'Digite sua senha')

            <div class="bloco_botao">
                <div class="botao" id="botao_fazer_login">Fazer Login</div>
            </div>

            <div class="bloco_link">
                <div class="botao" tabindex="-1" id="botao_esqueceu_senha">Esqueceu sua senha?</div>
                @ if( !empty(LINK_CADASTRO) ):
                <a class="botao" tabindex="-1" href="{!!LINK_CADASTRO!!}" target="_blank" rel="noopener noreferrer">Não tem cadastro?</a>
                @ endif;
            </div>
            <div class="bloco_ativar">
                <div class="ativar" id="botao_ativar_conta">Primeiro acesso</div>
            </div>
        </div>
    </form>
</div>
