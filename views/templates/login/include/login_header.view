<header id="header_principal">
    <figure class="logo">
        <a href="{{LINK}}"><img class="logo_mobile " src="{{CLUBE_LOGO}}" alt="Logo do CLUBE DE VANTAGENS MARKT CLUB"></a>
    </figure>
    <nav id="menu_principal">
        <div class="background" id="bloco_menu_mobile">
            <div class="conteudo">
                <a href="{!!route('login.ativar')!!}" class="botao">
                    <i class="cor_color">@iconePrimeiroAcesso</i>
                    <p>Primeiro Acesso</p>
                    <div class="borda"></div>
                </a>
                <a class="botao app" href="#baixar-app">
                    <i class="cor_color">@iconeBaixarApp()</i>
