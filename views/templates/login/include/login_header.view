                <a href="{!!route('login.logarUsuario')!!}" class="entrar_mobile">Entrar</a>
            </div>
        </div>
        <i class="botao_mobile" id="botao_abrir_menu">
            @iconeMenuMobile()
        </i>
        <a href="{!!route('login.logarUsuario')!!}" class="entrar">Entrar</a>
    </nav>
</header>
