                </a>
                <a href="{!!route('login.faq')!!}" target="_blank" class="botao">
                    <i  class="cor_color">@iconeFaq()</i>
                    <p>FAQ</p>
                    <div class="borda"></div>
                </a>
                <a href="{!!route('login.comoFunciona')!!}" target="_blank" class="botao">
