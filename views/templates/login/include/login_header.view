<header id="header_principal">
    <figure class="logo">
        <a href="{{LINK}}"><img class="logo_mobile " src="{{CLUBE_LOGO}}" alt="Logo do CLUBE DE VANTAGENS MARKT CLUB"></a>
    </figure>
    <nav id="menu_principal">
        <div class="background" id="bloco_menu_mobile">
            <div class="conteudo">
                <div class="botao_fazer_login entrar_mobile">Entrar</div>
                <div class="botao" id="botao_ativar_conta_home">
                    <i>@iconePrimeiroAcesso</i>
                    <p>Primeiro Acesso</p>
                    <div class="borda"></div>
                </div>
                <div class="botao app" id="botao_baixar_app">
                    <i>@iconeBaixarApp()</i>
                    <p>Baixe o App</p>
                    <div class="borda"></div>
                </div>
                <a href="{!!route('faq.index')!!}" class="botao {{$menu == 'faq' ? 'hover' : ''}}">
                    <i>@iconeFaq()</i>
                    <p>FAQ</p>
                    <div class="borda"></div>
                </a>
                <a href="{!!route('comoFunciona.index')!!}" class="botao {{$menu == 'ajuda' ? 'hover' : ''}}">
                    <i>@iconeComoFunciona</i>
                    <p>Como Funciona</p>
                    <div class="borda"></div>
                </a>
            </div>
        </div>
        <i class="botao_mobile" id="botao_abrir_menu">
            @iconeMenuMobile()
        </i>
        <div class="botao_fazer_login entrar">Entrar</div>
    </nav>
</header>
