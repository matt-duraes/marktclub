<footer id="bloco_footer">
    @if (!empty(CLUBE_LOGO_FOOTER)) :
    <div class="logo_footer">
        <img src="{{CLUBE_LOGO_FOOTER}}">
    </div>
    @endif;

    <div class="centralizar footer_home">
        <div class="bloco_contato">
            @ if (!empty(CONTATO_TELEFONE)) :
            <div class="dado_footer">
                <i class="icone_footer telefone">@iconeTelefoneLoja</i>
                <p>{{CONTATO_TELEFONE}}</p>
            </div>
            @ elseif (!empty(CONTATO_TELEFONE)) :
            <div class="dado_footer">
                <i class="icone_footer telefone">@iconeTelefoneLoja</i>
                <p>{{str_replace('(apenas WhatsApp)', '', CONTATO_WHATSAPP)}}</p>
            </div class="dado_footer">
            @ endif;

            @ if (!empty(CONTATO_WHATSAPP)) :
            <a class="dado_footer" href="https://wa.me/55{{str_replace('(apenas WhatsApp)', '', soNumero(CONTATO_WHATSAPP))}} ">
                <i class="icone_footer whatsapp">@iconeWhatsapp</i>
                <p>{{CONTATO_WHATSAPP}}</p>
            </a>
            @endif;

            @if (!empty(CONTATO_EMAIL)) :
            <div class="dado_footer">
                <i class="icone_footer email">@iconeEmail(15)</i>
                <p class="texto_email"> {{CONTATO_EMAIL}}</p>
            </div>
            @endif;

            @if (!empty(CONTATO_HORARIO)) :
            <div class="dado_footer">
                <i class="icone_footer horario">@iconeFaq(20)</i>
                <p>{{CONTATO_HORARIO}}</p>
            </div>
            @endif;
        </div>
        <div class="bloco_ajuda">
            @ if( MENU_COMO_FUNCIONA ):
            <a class="dado_footer" href="{!!route('comoFunciona.index')!!}">
                <i class="icone_footer interrogacao">@iconeComoFunciona</i>
                <p>Como Funciona</p>
            </a>
            @ endif;
            @if (!empty(CONTATO_ENDERECO)) :
            <div class="dado_footer">
                <i class="icone_footer localizacao"> @iconeMapa</i>
                <p>{{CONTATO_ENDERECO}} </p>
            </div>
            @endif;
        </div>
    </div>




    <div class="bloco_copyright">
        @ if( ADMINISTRADO ):
        <p>Administrado por:</p>
        <a href="https://youhuul.com.br" target="_blank" rel="noopener noreferrer"><img src="{{LINK_PADRAO}}/images/logo_youhuul.png" alt="[Administrado por YouHuul]" height="35"></a>
        @ endif;
        <p class="copy">
            @2011/{{date('Y')}} Todos os direitos reservados é de uso exclusivo {{str_replace('https://', '', LINK_PADRAO)}}<br>
            Proibida reprodução ou utilização e qualquer titulo sob as penas da lei.
        </p>
    </div>
</footer>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<input type="hidden" name="RECAPTCHA_SITE" id="RECAPTCHA_SITE" value="{{env('RECAPTCHA_SITE')}}">
<input type="hidden" name="LINK" id="LINK" value="{!!LINK!!}">
