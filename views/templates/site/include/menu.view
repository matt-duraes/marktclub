<div class="categoria">PRINCIPAL</div>
<a  class="{!!MENU_HOVER == 'home' ? 'cor_bg' : ''!!}" href="@route(index.index)">
    <i>@iconeSiteHome()</i>
    Início
</a>

@ if( MENU_LOJA || MENU_LOJA_PROXIMA || MENU_CUPOM || MENU_CASHBACK || MENU_EXTENSAO):
    <div class="categoria">DESCONTOS</div>

    @ if( MENU_LOJA ):
    <a class="{!!MENU_HOVER == 'loja' ? 'cor_bg' : ''!!}" href="@route(loja.index)">
        <i>@iconeLojaHome()</i>
        Lojas
    </a>
    @ endif;

    @ if( MENU_LOJA_PROXIMA ):
    <a  class="{!!MENU_HOVER == 'loja-proxima' ? 'cor_bg' : ''!!}" href="@route(loja.proxima)">
        <i>@iconeLojaProximaHome()</i>
        Lojas próximas
    </a>
    @ endif;

    @ if( MENU_CUPOM ):
    <a  class="{!!MENU_HOVER == 'cupom' ? 'cor_bg' : ''!!}" href="@route(cupom.index)">
        <i>@iconeCuponHome()</i>
        Cupons de desconto
    </a>
    @ endif;

    @ if( MENU_CASHBACK ):
    <a  class="{!!MENU_HOVER == 'cashback' ? 'cor_bg' : ''!!}" href="@route(cashback.index)">
        <i>@iconeCashbackHome()</i>
        Cashback Silium
    </a>
    @ endif;

    @ if( MENU_EXTENSAO ):
    <a  class="{!!MENU_HOVER == 'extensao' ? 'cor_bg' : ''!!}" href="@route(extensao.index)">
        <i>@iconeExtensaoHome()</i>
        Extensão
    </a>
    @ endif;
@ endif;

@ if( MENU_CINEMA || MENU_TURISMO || MENU_SALAVIP ):
    <div class="categoria">DIVERSÃO</div>

    @ if( MENU_CINEMA ):
    <a  class="{!!MENU_HOVER == 'cinema' ? 'cor_bg' : ''!!}" href="@route(cinema.index)">
        <i>@iconeCinemaHome()</i>
        Cinema
    </a>
    @ endif;

    @ if( MENU_TURISMO ):
    <a  class="{!!MENU_HOVER == 'turismo' ? 'cor_bg' : ''!!}" href="@route(turismo.index)">
        <i>@iconeTurismoHome()</i>
        Turismo
    </a>
    @ endif;

      

    @ if( MENU_SALAVIP ):
    <a  class="{!!MENU_HOVER == 'salavip' ? 'cor_bg' : ''!!}" href="@route(salavip.index)">
        <i>@iconeSalaVipHome</i>
        Sala Vip
    </a>
    @ endif;
@ endif;

@ if( MENU_CREDITO_SICOOB || MENU_CREDITO_CONSIGNADO || MENU_CREDITO_AUTOMOVEL ):
    <div class="categoria">CRÉDITO</div>

    @ if( MENU_CREDITO_SICOOB ):
    <a  class="{!!MENU_HOVER == 'sicoob' ? 'cor_bg' : ''!!}" href="@route(cinema.index)">
        <i>@iconeSicoobHome()</i>
        Sicoob
    </a>
    @ endif;

    @ if( MENU_CREDITO_CONSIGNADO ):
    <a  class="{!!MENU_HOVER == 'consignado' ? 'cor_bg' : ''!!}" href="@route(turismo.index)">
        <i>@iconeConsignadoHome()</i>
        Consignado
    </a>
    @ endif;

    @ if( MENU_CREDITO_AUTOMOVEL ):
    <a  class="{!!MENU_HOVER == 'automovel' ? 'cor_bg' : ''!!}" href="@route(salavip.index)">
        <i>@iconeAutomovelHome()</i>
        Automóvel
    </a>
    @ endif;
@ endif;

<div class="linha"></div>

<a class="footer" href="@route('pesquisa.satisfacao')">Pesquisa de satisfação</a>
<a class="footer" href="@route('pesquisa.satisfacao')">Sala VIP</a>
<a class="footer" href="@route('pesquisa.satisfacao')">SOS Mulher</a>

<div class="resto"></div>
