<div id="botao_swiped_esquerdo"></div>

<header id="header_principal">
    <i class="botao" id="botao_menu_mobile">@iconeMenuMobile</i>
    <figure class="bloco_logo_clube">
        <a href="@route(index.index)">
            <img src="{{CLUBE_LOGO_PRINCIPAL}}" alt="{{CLUBE_TITULO}}">
        </a>
    </figure>
</header>

@ if(!$melhorIdade) :
<nav id="menu_principal" class="menu_fechado">
    <div class="bg"></div>
    <div class="conteudo">
        <figure class="{{CLUBE_LOGO_CLASSE}}">
            <a href="@route(index.index)">
                <img class="tema_branco" src="{{CLUBE_LOGO_PRINCIPAL}}" alt="{{CLUBE_TITULO}}">
                <img class="tema_escuro" src="{{CLUBE_LOGO_SECUNDARIA}}" alt="{{CLUBE_TITULO}}">
            </a>
        </figure>
        <div class="perfil" id="bloco_perfil">
            <figure style="background-image: url({{USUARIO_IMAGEM}})"></figure>
            <div class="nome">{{USUARIO_NOME}}</div>
            <div class="email">{{USUARIO_EMAIL}}</div>
            @ if( MENU_PERFIL ):
            <i class="abrir desktop" id="botao_menu_perfil">@iconeOpcao(15)</i>
            @ endif;
        </div>

        @ if( MENU_PERFIL ):
            <div class="bloco_geral_sub_menu desktop display_none" id="bloco_menu_perfil">
                <a class="botao" id="botao_tema">
                    <i>@iconeTema</i>
                    Mudar Tema
                </a>
                <a href="@route(perfil.carteira)" class="botao">
                    <i>@iconeCarteirinha</i>
                    Carteirinha
                </a>
                @ if( !API ):
                <a class="botao {!!MENU_HOVER == 'perfil-dado' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.index)">
                    <i>@iconeUsuarioOutline(22)</i>
                    Alterar Dados
                </a>
                <a class="botao {!!MENU_HOVER == 'perfil-senha' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.senha)">
                    <i>@iconeSenhaOutline(22)</i>
                    Alterar Senha
                </a>
                @ endif;

                @ if( MENU_DEPENDENTE ):
                <a class="botao {!!MENU_HOVER == 'perfil-dependente' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.dependente)">
                    <i>@iconeDependenteOutline(22)</i>
                    Adicionar dependentes
                </a>
                @ endif;

                @ if( MENU_CASHBACK ):
                <a class="botao {!!MENU_HOVER == 'perfil-silium' ? 'cor_bg pagina_atual' : ''!!}" href="@route(cashback.extrato)">
                    <i>@iconeCashbackHome(22)</i>
                    Extrato do Silium
                </a>
                @ endif;

                @ if( MENU_INDICAR_USUARIO ):
                <a class="botao {!!MENU_HOVER == 'perfil-indicacao' ? 'cor_bg pagina_atual' : ''!!}" href="@route(site.indiqueAmigo)">
                    <i>@iconeIndiqueAmigoOutline(22)</i>
                    Indique um amigo
                </a>
                @ endif;

                @ if( MENU_SAIR ):
                <a class="botao" href="@route(sair.index)">
                    <i>@iconeSair(17)</i>
                    Sair do clube
                </a>
                @ endif;
            </div>
        @ endif;
        <div class="menu">
            @view site/geral/menu/index.view
        </div>

    </div>
</nav>

<main id="conteudo_principal">
@endif
