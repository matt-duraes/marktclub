<div id="botao_swiped_esquerdo"></div>

<header id="header_principal">
    <i class="botao" id="botao_menu_mobile">@iconeMenuMobile</i>
    <figure class="bloco_logo_clube">
        <a href="@route(index.index)">
            <img src="{{CLUBE_LOGO_PRINCIPAL}}" alt="{{CLUBE_TITULO}}">
        </a>
    </figure>
</header>

@ if(!$melhorIdade) :
<nav id="menu_principal" class="menu_fechado">
    <div class="bg"></div>
    <div class="conteudo">
        <figure class="{{CLUBE_LOGO_CLASSE}}">
            <a href="@route(index.index)" class="container_logo">
                <img class="tema_branco" src="https://apiv4.markt.club/aqiorvd.Qr5ceRUSr1vZkcWzCEctToo5lxTaPtsqqMBpq-wCFlBHfpZAE3Hv17r2vnsAthZB" alt="{{CLUBE_TITULO}}">
                <img class="tema_escuro" src="https://apiv4.markt.club/aqiorvd.Qr5ceRUSr1vZkcWzCEctToo5lxTaPtsqqMBpq-wCFlBHfpZAE3Hv17r2vnsAthZB" alt="{{CLUBE_TITULO}}">
            </a>
        </figure>
        <div class="perfil" id="bloco_perfil">
            <figure style="background-image: url({{USUARIO_IMAGEM}})"></figure>
            <div class="nome">{{USUARIO_NOME}}</div>
            <div class="email">{{USUARIO_EMAIL}}</div>
            @ if( MENU_PERFIL ):
            <i class="abrir desktop" id="botao_menu_perfil">@iconeOpcao(15)</i>
            @ endif;
        </div>

        @ if( MENU_PERFIL ):
            <div class="bloco_geral_sub_menu desktop display_none" id="bloco_menu_perfil">
                <a class="botao" id="botao_tema">
                    <i>@iconeTema</i>
                    Mudar Tema
                </a>
                <div id="bloco_menu_perfil">
                    @view site/geral/menu/perfil_menu.view
                </div>
            </div>
        @ endif;
        <div class="menu">
            <!-- MENU PRINCIPAL-->
            @view site/geral/menu/index.view
            <!-- PERFIL MENU QUANDO FOR MOBILE-->
            <div class="mobile" id="bloco_perfil_mobile">
                <div class="categoria">PERFIL</div>
                <div id="bloco_menu_perfil">
                    <a class="botao" id="botao_tema_mobile">
                        <i>@iconeTema</i>
                        Mudar Tema
                    </a>
                    @view site/geral/menu/perfil_menu.view
                </div>
            </div>
            <div class="linha"></div>
            <!-- SUBMENUS-->
            @view site/geral/menu/submenus.view
            <div class="resto"></div>
        </div>

    </div>
</nav>

<main id="conteudo_principal">
@endif
