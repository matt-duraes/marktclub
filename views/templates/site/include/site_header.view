<div id="botao_swiped_esquerdo"></div>

<header id="header_principal">
    <i class="botao" id="botao_menu_mobile">@iconeMenuMobile</i>
    <figure>
        <a href="@route(index.index)">
            <img src="{{CLUBE_LOGO}}" alt="{{CLUBE_TITULO}}">
        </a>
    </figure>
</header>

<nav id="menu_principal" class="menu_fechado">
    <div class="bg"></div>
    <div class="conteudo">
        <figure>
            <a href="@route(index.index)">
                <img src="{{CLUBE_LOGO}}" alt="{{CLUBE_TITULO}}">
            </a>
        </figure>
        <div class="perfil" id="bloco_perfil">
            <a href="@route(perfil.index)"></a>
            <figure style="background-image: url({{USUARIO_IMAGEM}})"></figure>
            <div class="nome">{{USUARIO_NOME}}</div>
            <div class="email">{{USUARIO_EMAIL}}</div>
            <i class="abrir" id="botao_menu_perfil">@iconeOpcao(15)</i>
        </div>

        <div class="bloco_geral_sub_menu desktop display_none" id="bloco_menu_perfil">
            <a href="@route(perfil.index)">
                <i>@iconeUsuarioOutline(22)</i>
                Alterar Dados
            </a>
            <a href="@route(perfil.senha)">
                <i>@iconeSenhaOutline(22)</i>
                Alterar Senha
            </a>
            <a href="@route(perfil.dependente)">
                <i>@iconeDependenteOutline(22)</i>
                Adicionar dependentes
            </a>
            <a href="@route(site.indiqueAmigo)">
                <i>@iconeIndiqueAmigoOutline(22)</i>
                Indique um amigo
            </a>
            <a href="@route(cashback.extrato)">
                <i>@iconeCashbackHome(22)</i>
                Extrato do Silium
            </a>
        </div>

        <div class="menu">
            <div class="categoria">PRINCIPAL</div>
            <a class="botao {!!MENU_HOVER == 'home' ? 'cor_bg pagina_atual' : ''!!}" href="@route(index.index)">
                <i>@iconeSiteHome</i>
                Início
            </a>

            <a class="botao {!!MENU_HOVER == 'acesso-rapido' ? 'cor_bg pagina_atual' : ''!!}" href="@route(acessoRapido.index)">
                <i>@iconeAcessoRapido(25)</i>
                Acesso Rápido
            </a>

            @ if( MENU_LOJA || MENU_LOJA_PROXIMA || MENU_CUPOM || MENU_CASHBACK || MENU_EXTENSAO):
            <div class="categoria">DESCONTOS</div>

            @ if( MENU_LOJA ):
            <a class="botao {!!MENU_HOVER == 'loja' ? 'cor_bg pagina_atual' : ''!!}" href="@route(loja.index)">
                <i>@iconeLojaHome</i>
                Lojas
            </a>
            @ endif;

            @ if( MENU_LOJA_PROXIMA ):
            <div class="botao botao_loja_proxima {!!MENU_HOVER == 'loja-proxima' ? 'cor_bg pagina_atual' : ''!!}">
                <i>@iconeLojaProximaHome</i>
                Lojas próximas
            </div>
            @ endif;

            @if(MENU_MEDICAMENTO):
            <a class="botao {!!MENU_HOVER == 'farmacia' ? 'cor_bg pagina_atual' : ''!!}" href="<?= route('farmacia.index') ?>">
                <i>@iconeMedicamento</i>
                Farmácia
            </a>
            @endif

            @ if( MENU_CUPOM ):
            <a class="botao {!!MENU_HOVER == 'cupom' ? 'cor_bg pagina_atual' : ''!!}" href="@route(cupom.index)">
                <i>@iconeCupomHome</i>
                Cupons de desconto
            </a>
            @ endif;

            @ if( MENU_CASHBACK ):
            <a class="botao {!!MENU_HOVER == 'cashback' ? 'cor_bg pagina_atual' : ''!!}" href="@route(cashback.index)">
                <i>@iconeCashbackHome</i>
                Cashback Silium
            </a>
            @ endif;

            @ if( MENU_CREDITO_AUTOMOVEL ):
            <a class="botao {!!MENU_HOVER == 'automovel' ? 'cor_bg pagina_atual' : ''!!}" href="@route(automovel.index)">
                <i>@iconeAutomovelHome</i>
                Automóvel
            </a>
            @ endif;

            @ endif;

            @ if( MENU_CINEMA || MENU_TURISMO ):
            <div class="categoria">DIVERSÃO</div>

            @ if( MENU_CINEMA ):
            <a class="botao {!!MENU_HOVER == 'cinema' ? 'cor_bg pagina_atual' : ''!!}" href="@route(cinema.index)">
                <i>@iconeCinemaHome</i>
                Cinema
            </a>
            @ endif;

            @ if( MENU_TURISMO ):
            <a class="botao {!!MENU_HOVER == 'turismo' ? 'cor_bg pagina_atual' : ''!!}" href="@route(turismo.index)">
                <i>@iconeTurismoHomeOutline</i>
                Turismo
            </a>
            @ endif;

            @ endif;

            @ if( MENU_CREDITO_SICOOB ):
            <div class="categoria">CRÉDITO</div>

            <a class="botao {!!MENU_HOVER == 'sicoob' ? 'cor_bg pagina_atual' : ''!!}" href="@route(sicoob.index)">
                <i>@iconeSicoobHome</i>
                Crédito
            </a>
            @ endif;

            @if(MENU_ODONTOLOGICO || MENU_SEGURO_DE_VIDA || MENU_MEDICAMENTO || MENU_FEDERAL_SAUDE):
                <div class="categoria">SAÚDE</div>
                @if(MENU_ODONTOLOGICO):
                <a class="botao {!!MENU_HOVER == 'odontologico' ? 'cor_bg pagina_atual' : ''!!}" href="<?= route('odontologico.index') ?>">
                    <i>@iconeDentista</i>
                    Plano Odontológico
                </a>
                @endif
                @if(MENU_SEGURO_DE_VIDA):
                <a class="botao {!!MENU_HOVER == 'saude' ? 'cor_bg pagina_atual' : ''!!}" href="<?= route('planosaude.index') ?>">
                    <i>@iconeSaude</i>
                    Plano de Saúde
                </a>
                @endif
            @endif
            <div class="categoria">PERFIL</div>
            <a class="botao mobile {!!MENU_HOVER == 'alterar_dados' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.index)">
                <i>@iconeUsuarioOutline(22)</i>
                Alterar Dados
            </a>
            <a class="botao mobile {!!MENU_HOVER == 'alterar_senha' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.senha)">
                <i>@iconeSenhaOutline(22)</i>
                Alterar Senha
            </a>
            <a class="botao mobile {!!MENU_HOVER == 'adicionar_dependentes' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.dependente)">
                <i>@iconeDependenteOutline(22)</i>
                Adicionar dependentes
            </a>
            <a class="botao mobile {!!MENU_HOVER == 'indicar_amigo' ? 'cor_bg pagina_atual' : ''!!}" href="@route(site.indiqueAmigo)">
                <i>@iconeIndiqueAmigoOutline(22)</i>
                Indique um amigo
            </a>
            @ if( MENU_EXTENSAO ):
            <div class="categoria">OUTROS</div>
            <a class="botao {!!MENU_HOVER == 'extensao' ? 'cor_bg pagina_atual' : ''!!}" target="_blank" href="https://chrome.google.com/webstore/detail/tem-mais-vantagens/ghhhocjedgofpmjjgkkkibcmjlldolpc">
                <i>@iconeExtensaoHome</i>
                Extensão
            </a>
            <a class="botao mobile {!!MENU_HOVER == 'extrato_silium' ? 'cor_bg pagina_atual' : ''!!}" href="@route(cashback.extrato)">
                <i>@iconeCashbackHome(22)</i>
                Extrato do Silium
            </a>
            @ endif;


            <div class="linha"></div>

            <div class="botao footer" id="abrePesquisaSatisfacao">Pesquisa de satisfação</div>
            <a class="botao footer" href="@route('loja.detalhe')/sala-vip-do-aeroporto-internacional-de-brasilia-presidente-juscelino-kubitschek-1">Sala VIP</a>
            <a class="botao footer" href="@route('sosmulher.index')">SOS Mulher</a>

            <div class="linha"></div>

            <a href="@route('sair.index')" class="botao sair">Sair do clube</a>

            <div class="resto"></div>
        </div>
    </div>
</nav>

<main id="conteudo_principal">
