</main>

<footer id="rodape_principal" class="{!!$webview ? 'display_none_webview' : ''!!}">
    <div class="rodape_conteudo">
    @ if( !empty(CONTATO_TELEFONE) || !empty(CONTATO_WHATSAPP) || !empty(CONTATO_EMAIL) || !empty(CONTATO_HORARIO)):
        <section class="bloco bloco_contato">
            <header>
                <h1>Contato</h1>
            </header>
            @ if( !empty(CONTATO_TELEFONE) ):
            <a class="dado mobile" href="tel:{{soNumero(CONTATO_TELEFONE)}}">
                <i>@iconeTelefoneLoja</i>
                <p class="texto_footer">{{CONTATO_TELEFONE}}</p>
            </a>
            <div class="dado desktop">
                <i>@iconeTelefoneLoja</i>
                <p class="texto_footer">{{CONTATO_TELEFONE}}</p>
            </div>
            @ endif;

            @ if( !empty(CONTATO_WHATSAPP) ):
            <a class="dado" href="https://wa.me/55{{soNumero(CONTATO_WHATSAPP)}}" target="_blank" rel="noopener noreferer">
                <i>@iconeWhatsapp(19)</i>
                <p class="texto_footer">{{CONTATO_WHATSAPP}}</p>
            </a>
            @ endif;

            @ if( !empty(CONTATO_EMAIL) ):
            <a class="dado" href="mailto:{{CONTATO_EMAIL}}">
                <i>@iconeEmail(15)</i>
                <p class="texto_footer">{{CONTATO_EMAIL}}</p>
            </a>
            @ endif;

            @ if( !empty(CONTATO_HORARIO) ):
            <div class="dado">
                <i>@iconeCalendario</i>
                <p class="texto_footer">{{CONTATO_HORARIO}}</p>
            </div>
            @ endif;

            <div class="dado redes_sociais">
                @ if( !empty(LINK_FACEBOOK) ):
                <a href="{{LINK_FACEBOOK}}" target="_blank" rel="noopener noreferer"><i>@iconeFacebook(15)</i></a>
                @ endif;

                @ if( !empty(LINK_INSTAGRAM) ):
                <a href="{{LINK_INSTAGRAM}}" target="_blank" rel="noopener noreferer"><i>@iconeInstagram(15)</i></a>
                @ endif;

                @ if( !empty(LINK_TWITTER) ):
                <a href="{{LINK_TWITTER}}" target="_blank" rel="noopener noreferer"><i>@iconeTwitter(15)</i></a>
                @ endif;

                @ if( !empty(LINK_YOUTUBE) ):
                <a href="{{LINK_YOUTUBE}}" target="_blank" rel="noopener noreferer"><i>@iconeYoutube(15)</i></a>
                @ endif;

                @ if( !empty(LINK_LINKEDIN) ):
                <a href="{{LINK_LINKEDIN}}" target="_blank" rel="noopener noreferer"><i>@iconeLinkedin(20)</i></a>
                @ endif;

                @ if( !empty(LINK_TIKTOK) ):
                <a href="{{LINK_TIKTOK}}" target="_blank" rel="noopener noreferer"><i>@iconeTiktok(20)</i></a>
                @ endif;
            </div>
        </section>
        @ endif;

        <section class="bloco bloco_indicacao">
            <header>
                <h1>Indicações</h1>
            </header>
            <a class="dado" id="botao_abrir_ajuda">
                <i>@iconeFaleConosco(20)</i>
                <p class="texto_footer">Fale Conosco</p>
            </a>

            @ if( MENU_INDICAR_USUARIO ):
            <a class="dado" href="@route(site.indiqueAmigo)">
                <i>@iconeIndiqueAmigoOutline(20)</i>
                <p class="texto_footer">Indicar um amigo</p>
            </a>
            @ endif;

            @ if( MENU_INDICAR_LOJA ):
            <a class="dado botao_indicar_loja">
                <i>@iconeLojaHome(15)</i>
                <p class="texto_footer">Indicar um parceiro</p>
            </a>
            @ endif;
        </section>

        <section class="bloco bloco_termo">
            <header>
                <h1>Termo</h1>
            </header>
            <a class="dado" href="@route(termo.termosite)" target="_blank" rel="noopener noreferrer">
                <i>@iconeTermoUso(19)</i>
                <p class="texto_footer">Termo de uso</p>
            </a>
            @ if( MENU_CASHBACK ):
            <a class="dado" href="@route(termo.termocashback)" target="_blank" rel="noopener noreferrer">
                <i>@iconeTermoUso(19)</i>
                <p class="texto_footer">Termo do Silium</p>
            </a>
            @ endif;
        </section>

    </div>
    <div class="linha"></div>

    @ if( MENU_BAIXAR_APP ):
    <p class="texto">Baixe o nosso aplicativo no seu smartphone e leve o {{CLUBE_TITULO}} com você</p>
    <div class="app">
        <a href="{!!LINK_APP_IOS!!}" target="_blank" rel="noopener noreferer"><img src="{{LINK_PADRAO}}/images/site/app_apple.png" alt="Apple Store"></a>
        <a href="{!!LINK_APP_ANDROID!!}" target="_blank" rel="noopener noreferer"><img src="{{LINK_PADRAO}}/images/site/app_google.png" alt="Google Play"></a>
    </div>

    <div class="linha"></div>
    @ endif;

    @ if( !empty(CONTATO_ENDERECO) ):
    <p class="texto">{{CONTATO_ENDERECO}}</p>
    @ endif;
    <p class="texto">{{CLUBE_TITULO}} - &copy; 2011/{{date('Y')}} Todos os direitos reservados</p>
</footer>
