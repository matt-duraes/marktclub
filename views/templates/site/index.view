<!DOCTYPE HTML>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <link rel="icon" href="{!!CLUBE_FAVICON!!}" type="image/png">

    <title>{{CLUBE_TITULO}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    @CSS
    @dir "/include/css.view"

</head>

<body>
    <div id="site">
        @php $melhorIdade = sessaoExiste('TEMPLATE') && sessao('TEMPLATE') == 'melhor-idade';
        @ if($melhorIdade) :
            @dir "/include/rapido_header.view"
        @ else :
            @dir "/include/site_header.view"
        @endif;

        [[VIEW]]

        @ if($melhorIdade) :
            @dir "/include/rapido_footer.view"
        @ else :
            @dir "/include/site_footer.view"
        @endif;
    </div>
    <div id="bloco_template_buscar"></div>

    @dir "/include/login.view"

    <form action="/" method="post">
        <input type="hidden" name="LINK" id="LINK" value="{!!LINK!!}">
        <input type="hidden" name="GOOGLE_CLIENT_ID" id="GOOGLE_CLIENT_ID" value="{!!env('GOOGLE_CLIENT_ID')!!}">
        <input type="hidden" name="CORCLUBE" id="CORCLUBE" value="{!!CLUBE_COR!!}">
    </form>

    <script src="https://apis.google.com/js/platform.js" async defer></script>
    <script src="https://apis.google.com/js/api.js"></script>
    <script src="https://apis.google.com/js/platform.js" async defer></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    @JS
    <div id="bloco_fw_calendario"></div>

    @ if( CHAT ):
    <a class="botao_chat" href="https://wa.me/5561993546881" target="_blank" rel="noopener noreferrer">@iconeWhatsapp(30)</a>
    @ endif;
</body>

</html>
