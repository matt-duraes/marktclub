#bloco_ajuda .conteudo
    width: 100%
    flexCol()
    align-items: center
    padding: 20px
    header
        margin-bottom: 40px
    p
        texto()
    .contato
        width: 100%
        border: 1px solid #DDD
        border-radius: 5px
        flexRow()
        margin: 10px 0
        align-items: center
        padding: 10px 20px
        cursor: pointer
        fill: $corPretoBranco
        &:hover
            background-color: $corClube
            border-color: $corClube
            fill: #FFF
            color: #FFF
    .contato .icone
        width: 30px
        height: 30px
        flexCenter()
    .contato span
        flexGrow()
        texto()
        margin-left: 20px
        width: calc(100% - 40px)
        word-wrap: break-word
    .contato .copiar
        width: 30px
        height: 30px
        flexCenter()
        border-radius: 5px
        display: none
        &:hover
            background-color: rgba(255,255,255,.2)
    .linha
        width: 100%
        margin: 30px 0
        position: relative
        flexCenter()
        texto()
        &::after
            content: ""
            width: 100%
            height: 1px
            position: absolute
            background-color: #DDD
            z-index: 1
    .linha span
        texto()
        z-index: 2
        background: #FFF
        padding: 0 10px
        color: #999
    .link
        width: 100%
        text-align: center
        boxShadow()
        textoFontSize()
        padding: 20px
        border: 1px solid #EEE
        border-radius: 5px
        margin-bottom: 20px
        &:hover
            background-color: $corClube
            color: #FFF
    .fechar
        width: 100%
        margin: 20px 0 10px
        cursor: pointer
        text-align: center
        color: #999
