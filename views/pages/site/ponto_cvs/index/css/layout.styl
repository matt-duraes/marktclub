@template "site"
@system "form"
@resource "site/tab"

.bloco_tem_mais_acao
    width: 100%
    max-width: $maxWidth
    .bloco_titulo_texto
        align-items: flex-start
        figure
            margin-bottom: 20px
        h1
            color: $corClube
        p
            margin: 2px 0
        strong
            texto()
            font-weight: bold
        a
            botaoPadraoPequeno()
            background-color: $corClube
            color: #FFF
            margin: 10px 0
    .atencao
        margin: 20px 0
    .bloco_solicitar .botao
        botaoPadraoGrande()
        background-color: $corClube
        color: #FFF
        margin-bottom: 10px
    .bloco_tabela
        margin-top: 20px

#bloco_resgatar_ponto .bloco_botao
    width: 100%
    flexRow()
    justify-content: flex-end
    margin-top: 10px
    .botao
        botaoPadraoGrande()
        background-color: $corClube
        color: #FFF
