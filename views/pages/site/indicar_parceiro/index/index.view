<div class="bloco_pagina_popup medio">
    <header class="header_pagina_popup">
        <h1>Indicação</h1>
        <i class="pagina_fechar">@iconeFechar</i>
    </header>
    <div class="conteudo_pagina_popup">
        <form id="form_indicar_loja" class="form_geral" method="post">
            <header>
                <h1>Não achou o que procura?</h1>
                <p>Preencha os campos abaixo e envie sua sugestão de loja.</p>
            </header>

            @? formInput(name: 'indicar_loja_nome', placeholder: 'Qual o nome do parceiro?', label: '', obrigatorio: true, class: 'busca_nome', local: 'Nome da loja')
            @? formTelefone(name: 'indicar_loja_telefone', placeholder: 'Você tem o telefone do parceiro?', label: '', class: 'busca_telefone', local: '6198177773')
            @? formEmail(name: 'indicar_loja_email', label: 'E-mail do parceiro', placeholder: 'Você tem o e-mail do parceiro?', local: 'email@loja.com')
            @? formTextarea(name: 'indicar_loja_nome_mensagem', placeholder: 'Digite uma mensagem', obrigatorio: true, label: 'Mensagem', local: 'Olá mundo!')

            <div class="footer_pagina_popup">
                <div id="botao_enviar_indicacao" class="botao_enviar_indicacao botao_geral_cor cor_bg">ENVIAR</div>
            </div>
        </form>
    </div>

</div>
