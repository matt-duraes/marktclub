<div class="bloco_pagina_popup medio" id="popup_contato_login">
    <header class="header_pagina_popup">
        <h1>ENTRAR EM CONTATO</h1>
        <i class="botao_fechar_popup">@iconeFechar</i>
    </header>
    <div class="popup_conteudo centralizado">
        <form id="formulario_contato" class="form_geral bloco_conteudo_geral centralizado" method="post">
            <header class="coluna texto">
                <p>Gostaria de divulgar a sua marca ou está querendo tirar alguma dúvida?<br>
                Basta preencher o formulário abaixo que entramos em contato</p>
            </header>

            <fieldset class="texto">
                @? formInput(name: 'nome', placeholder: 'Qual o seu nome?', label: '', class: 'busca_nome',obrigatorio: true ,value: '')
                @? formTelefone(name: 'telefone', placeholder: 'Insira o telefone do parceiro', label: '', class: 'busca_telefone', obrigatorio: true ,value: '')
                @? formEmail(name: 'email', label: 'E-mail do parceiro', placeholder: 'Insira o e-mail do parceiro?',obrigatorio: true,value: '')
            </fieldset>

            <fieldset class="texto">
                <h1 class="texto">MENSAGEM</h1>
                @? formTextarea(name: 'comentario', placeholder: 'Digite uma breve mensagem', label: 'Mensagem')
            </fieldset>

            <button id="botao_enviar_contato" class="botao_enviar_contato botao_geral_cor">ENVIAR</button>
        </form>
    </div>
</div>
