<div class="bloco_popup_geral medio">
    <header class="popup_header">
        <h1>ENTRAR EM CONTATO</h1>
        <i class="botao_fechar_popup">@iconeFechar</i>
    </header>
    <div class="popup_conteudo centralizado">
        <form id="formulario_contato" action="" class="form_geral bloco_conteudo_geral centralizado" method="post">
            <header class="coluna texto">
                <p>Gostaria de divulgar a sua marca ou está querendo tirar alguma dúvida?<br>
                Basta preencher o formulário abaixo que entramos em contato</p>
            </header>

            <fieldset class="texto">
                @formHash
                @? formInput(name: 'nome', placeholder: 'Qual o seu nome?', label: '', class: 'busca_nome', value: '')
                @? formTelefone(name: 'telefone', placeholder: 'Você tem o telefone do parceiro?', label: '', class: 'busca_telefone', value: '')
                @? formEmail(name: 'email', label: 'E-mail do parceiro', placeholder: 'Você tem o e-mail do parceiro?', value: '')
            </fieldset>

            <fieldset class="texto">
                <h1 class="texto">MENSAGEM</h1>
                @? formTextarea(name: 'comentario', placeholder: 'Digite uma breve mensagem', label: 'Mensagem')
            </fieldset>

            <button id="botao_enviar_contato" class="botao_enviar_contato botao_geral_cor">ENVIAR</button>
        </form>
    </div>
</div>
