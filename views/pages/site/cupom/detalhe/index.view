<div id="bloco_popup_detalhe" class="bloco_popup_geral">
    <header class="popup_header">
        <h1>CUPOM</h1>
        <i class="fechar">@iconeFechar</i>
    </header>
    <div class="popup_conteudo">
        <div class="conteudo">
            <input type="hidden" id="input_cupom_url" value="{{$dado->url}}">
            <figure><img src="{{$dado->imagem}}"></figure>
            <h2>{{$dado->titulo}}</h2>
            <p class="detalhe">{{$dado->texto}}</p>

            @ if( $dado->tipo === "cupom" ):
                @if (TIPO_USUARIO != 'indicado'):
                    <form action="/">
                        <span>cupom:</span>
                        <input type="text" readonly id="input_cupom_valor" value="{{$dado->cupom}}">
                        <div class="botao cor_bg botao_contar_click" data-botao="Copiar" id="botao_cupom_copiar">COPIAR CUPOM</div>
                    </form>
                @endif
            @ else:
            <div class="atencao bloco_atencao_geral">
                <p>Este parceiro aplica os descontos diretamente no site,
                    sem necessidade de cupom, para ver os desconto,
                    clique no botão abaixo</p>
            </div>
            @ endif;
            @if (TIPO_USUARIO != 'indicado'):
                <a href="{{$dado->url}}" class="botao_geral_cor cor_bg botao_contar_click" data-botao="Acessar" target="_blank" rel="nofollow noopener">Ir para loja</a>
            @endif
            @ if(TIPO_USUARIO == 'indicado')
                <div class="bloco_atencao_geral">
                    <p>Apenas associados possuem acesso a esse recurso</p>
                </div>
            @endif
        </div>
    </div>
</div>
