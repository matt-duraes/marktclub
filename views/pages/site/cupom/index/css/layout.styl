@template "site"
@system "Alerta"
@resource "site/loja/busca"
@resource "site/loja/parceiro"

#bloco_cupom
    maxWidth()

#bloco_cupom .atencao
    margin-bottom: 40px

#bloco_popup_detalhe
    max-width: 700px
    .bloco_atencao_geral
        margin-top: 20px
#bloco_popup_detalhe .conteudo
    width: 100%
    flexCol()
    align-items: center
    padding: 20px
    figure
        width: 100%
        height: 120px
        text-align: center
    figure img
        max-width: 100%
        max-height: 120px
    h2
        width: 100%
        text-align: center
        titulo()
        margin-top: 20px
    p
        width: 100%
        text-align: center
        texto()
    p.detalhe
        max-width: 400px
    form
        border: 2px dashed #CCC
        borderRadius()
        margin-top: 50px
        flexRow()
        position: relative
        margin-bottom: 30px
    form span
        position: absolute
        top: -20px
        left: 0
        font-size: 1.4rem
        color: #999
    form input
        height: 50px
        padding-left: 10px
        textoFontSize()
        flexGrow()
    form .botao
        height: 30px
        line-height: 30px
        padding: 0 15px
        borderRadius()
        cursor: pointer
        margin: 10px 10px 10px 0
    .atencao
        margin: 40px 0
    a
        margin-bottom: 10px
