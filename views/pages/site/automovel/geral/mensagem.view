<form id="formulario_indica_automovel" class="busca_automovel form_geral" method="post">
    <h1>Não achou o que procura?</h1>
    <p>Nos mande uma mensagem com os dados do veículo que iremos tentar achar o melhor preço para você</p>
    <div class="bloco">
        <div class="duplo_label">
            @? formSelect(name: 'endereco_estado', placeholder: 'Qual estado será feito a compra?', label: 'Estado', lista: (new \Helpers\ListaHelper)->add('', 'Escolha um estado')->estado()->r())
            @? formSelect(name: 'endereco_cidade', placeholder: 'Qual cidade será feito a compra?', label: 'Cidade', lista: ['' => 'Escolha um estado'])
        </div>
        <div class="duplo_label">
            @? formInput(name: 'montadora', placeholder: 'Qual a montadora?', label: 'Montadora')
            @? formInput(name: 'modelo', placeholder: 'Qual o modelo?', label: 'Modelo')
        </div>
        <div class="duplo_label">
            @? formInput(name: 'versao', placeholder: 'Existe alguma versão ou opcional?', label: 'Versão', class: 'busca_versao', value: '')
            @? formInput(name: 'cor', placeholder: 'Tem alguma cor em específico?', label: 'Cor', class: 'busca_cor', value: '')
        </div>
            @? formTextarea(name: 'mensagem', label: 'Mensagem', placeholder: 'Digite sua mensagem com todos os detalhes do veículo')
    </div>
    <div class="bloco footer">
        <button id="botao_enviar_automovel" class="botao_geral_cor cor_bg">Mandar mensagem</button>
    </div>
</form>
