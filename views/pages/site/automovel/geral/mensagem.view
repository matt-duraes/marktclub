<form id="form_solicitacao_automovel" class="busca_automovel form_geral cinza" method="post">
    <h1>Não achou o que procura?</h1>
    <p>Nos mande uma mensagem com os dados do veículo que iremos tentar achar o melhor preço para você</p>
    <div class="bloco">
        <div class="duplo_label">
            @? formSelect(name: 'solicitacao_endereco_estado', placeholder: 'Qual estado será feito a compra?', label: 'Estado', obrigatorio: true, lista: (new \Helpers\ListaHelper)->add('', 'Escolha um estado')->estado()->r())
            @? formSelect(name: 'solicitacao_endereco_cidade', placeholder: 'Qual cidade será feito a compra?', label: 'Cidade', obrigatorio: true, lista: ['' => 'Escolha um estado'])
        </div>
        <div class="duplo_label">
            @? formInput(local: 'Honda', name: 'solicitacao_montadora', placeholder: 'Qual a montadora?', label: 'Montadora', obrigatorio: true)
            @? formInput(local: 'Civic', name: 'solicitacao_modelo', placeholder: 'Qual o modelo?', label: 'Modelo', obrigatorio: true)
        </div>
        <div class="duplo_label">
            @? formInput(local: 'LXT', name: 'solicitacao_versao', placeholder: 'Existe alguma versão ou opcional?', label: 'Versão', class: 'busca_versao', value: '')
            @? formInput(name: 'solicitacao_cor', placeholder: 'Tem alguma cor em específico?', label: 'Cor', class: 'busca_cor', value: '')
        </div>
            @? formTextarea(local: 'Teste de mensagem...', name: 'solicitacao_mensagem', label: 'Mensagem', placeholder: 'Digite sua mensagem com todos os detalhes do veículo', obrigatorio: true)
    </div>
    <div class="bloco footer">
        <div id="botao_enviar_automovel" class="botao_geral_cor cor_bg">Mandar mensagem</div>
    </div>
</form>
