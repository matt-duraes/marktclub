@system "Form"
@template "site"
@resource "site/mixim"
@resource "site/automovel/mensagem"
@resource "site/variavel"
@resource "site/loja/parceiro"

#bloco_veiculo
    width: 100%
    maxWidth()

.bloco_aviso
    border: 1px dashed $corClube
    padding: 20px
    border-radius: 5px
    h1
        titulo()
    p
        texto()
        margin-top: 10px
@media screen and (max-width: 550px)
    .busca_automovel .duplo_label
        flex-direction: column
    .busca_automovel .duplo_label .bloco_input
        width: 100%
@media screen and (max-width: 425px)
    .busca_automovel .bloco.footer
        display: flex
        align-items: inherit
        margin-top: 10px
