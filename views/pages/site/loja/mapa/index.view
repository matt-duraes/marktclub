<div id="bloco_loja_mapa">
    <div id="botao_atualizar_mapa" class="atualizar display_none">Buscar nessa região</div>
    <div id="bloco_google_maps" class="mapa"></div>
    <input type="hidden" id="input_loja_latitude" value="{{$Busca->latitude}}">
    <input type="hidden" id="input_loja_longetude" value="{{$Busca->longitude}}">
    <div class="lista">
        @ foreach( $lista->mapa ?? [] as $r):
        <article
            data-latitude="{!!$r->latitude!!}"
            data-latitude="{!!$r->longitude!!}"
            data-id="{!!$r->id!!}"
            id="bloco_mapa_loja_{!!$r->id!!}"
            class="novo display_none"
        >
            <figure>{!!$r->imagem!!}</figure>
            <div class="dado">
                <header>
                    <h1>{{$r->titulo}}</h1>
                    <i>@iconeFechar</i>
                </header>
                <p>{{$r->desconto}}</p>
                <a href="{!!$r->link!!}">Acessar loja</a>
            </div>
        </article>
        @ endforeach;
    </div>
</div>
<!-- prettier-ignore -->
<script src="https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js"></script>
