<!DOCTYPE HTML>
<html lang="pt-br">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<title>ACESSO RÁPIDO</title>
    <link rel="shortcut icon" type="image" href="{!!LINK_PADRAO!!}/images/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    @CSS

</head>
<body>
	<header>
		<figure>
			<img src="https://arquivo.marktclub.com.br/construtor/logo_marktclub_tem_mais.png" alt="">
		</figure>
		<div class="bloco_botao">
			<a class="botao_geral_cor cor_bg" href="@route(index.index)">Navegação normal</a>
			<a class="botao_geral_cor cor_bg" href="@route(acessorapido.index)">Voltar</a>
		</div>
	</header>
	<div id="bloco_maioridade_popup">
		<div class="formulario-step">
			<form action="" id="myForm" method="GET">
				<fieldset id="primeiro" class="primeiro">
					<div class="mensagem">
						<div class="conteudo">
							<h1 class="color_cor">BEM VINDO(A)
								A NOSSA BUSCA
							</h1>
							<p>Fizemos uma seleção de convênios que podem ser de seu interesse,
								caso queira fazer uma busca personalizada, basta escolher a opção:
								"Quero fazer minha busca"</p>
						</div>
					</div>
					<article class="conteudo_formulario" >
						<a id="busca_personalizada" class="botao_trocar_proximo" >
							Quero fazer minha busca
						</a>
						<span>ou</span>
						<div class="opcao_categoria">
							@if($alimentacaoTag):
								@foreach($alimentacaoTag as $ind => $val):
									<a href="@route('loja.busca')?categoria=alimentacao&tag=<?=$alimentacaoTag[$ind]?>">
										<?= $val ?>
									</a>
								@endforeach
							@endif

							@if($veiculoTag):
								@foreach($veiculoTag as $ind => $val):
									<a href="@route('loja.busca')?categoria=veiculos&tag=<?=$veiculoTag[$ind]?>">
										<?= $val?>
									</a>
								@endforeach
							@endif

							@if($saudeTag):
								@foreach($saudeTag as $ind => $val):
									<a href="@route('loja.busca')?categoria=saude&acessorp=1&tag=<?=$saudeTag[$ind]?>">
										<?= $val?>
									</a>
								@endforeach
							@endif
						</div>
					</article>
				</fieldset>

				<fieldset id="bloco_seleciona_estado">
					<div class="mensagem">
						<div class="conteudo">
							<h1 class="color_cor"> ONDE VOCÊ GOSTARIA DE BUSCAR SEU CONVÊNIO? </h1>
							<p>Escolha entre todos "Em todo o mundo" para não restringir a busca ou em "Escolha um estado" pra filtrar por um estado brasileiro</p>
						</div>
					</div>
					<article class="conteudo_formulario">
						<div class="opcao_estado">
							<div class="input_radio_botao bloco_mundo">
								<label class="mundo" for="mundo">Em todo o mundo</label>
								<input type="radio" id="nao" name="escolhe_estado" value="nao">
							</div>
							<div class="input_radio_botao bloco_estado">
								<label class="estado" for="estado">Escolher um estado</label>
								<input type="radio" id="sim" name="escolhe_estado" value="sim">
							</div>
						</div>
						<div class="lista_estado">
							<div class="estado"  id="DF">
								<input type="radio" name="estado" value="DF">
								<label for="DF">DF</label>
							</div>
							<div class="estado"  id="AC">
								<input type="radio" name="estado" value="AC">
								<label for="AC">ACRE</label>
							</div>
							<div class="estado"  id="RJ">
								<input type="radio" name="estado" value="RJ">
								<label for="RJ">RJ</label>
							</div>
							<div class="estado"  id="SP">
								<input type="radio" name="estado" value="SP">
								<label for="SP">SAO PAULO</label>
							</div>
						</div>
						<div class="botao_footer">
							<button class="voltar botao_trocar_anterior" data-proximo="#primeiro">Voltar</button>
							<button class="color_cor border_cor botao_trocar_proximo" id="botaoAvancar">Avançar</button>
						</div>
					</article>
				</fieldset>
				<fieldset class="teste">
					<article class="conteudo_formulario">
						<div class="mensagem">
							<div class="conteudo">
								<h1 class="color_cor"> Escolha uma categoria </h1>
							</div>
						</div>
						<div class="opcao_categoria" id="estado_tag">
							@if($alimentacaoTag):
								@foreach($alimentacaoTag as $ind => $val):
									<a data-estado='' href="@route('loja.busca')?categoria=alimentacao&tag=<?=$alimentacaoTag[$ind]?>">
										<?= $val ?>
									</a>
								@endforeach
							@endif

							@if($veiculoTag):
								@foreach($veiculoTag as $ind => $val):
									<a data-estado='' href="@route('loja.busca')?categoria=veiculos&tag=<?=$veiculoTag[$ind]?>">
										<?= $val?>
									</a>
								@endforeach
							@endif

							@if($saudeTag):
								@foreach($saudeTag as $ind => $val):
									<a data-estado='' href="@route('loja.busca')?categoria=saude&acessorp=1&tag=<?=$saudeTag[$ind]?>">
										<?= $val?>
									</a>
								@endforeach
							@endif
						</div>
					</article>
				</fieldset>

			</form>
		</div>
	</div>
	@JS
</body>
</html>
