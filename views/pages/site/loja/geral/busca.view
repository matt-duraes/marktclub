<div class="busca_convenio">
    <form action="@route(loja.busca)" method="get" class="form_geral">
        <legend>Busque por um convênio</legend>
        <fieldset>
            @? formSelect(name: 'estado', placeholder: 'UF', label: 'UF', class: 'busca_estado', lista: (new \Helpers\ListaHelper)->add('UF')->uf()->r(), value: '')
            @? formSelect(name: 'categoria', placeholder: 'Categoria', label: 'Categoria', class: 'busca_categoria', lista: ['' => 'Todas as categoria'], value: '')
            @? formSelect(name: 'tag', placeholder: 'Subcategoria', label: 'Subcategoria', class: 'busca_tag', lista: ['' => 'Escolha uma categoria'], value: '')
            @? formSelect(name: 'estabelecimento', placeholder: 'Tipo de estabelecimento', class: 'busca_estabelecimento', label: 'Tipo', lista: ['' => 'Todas os tipos', 'fisico' => 'Fisico', 'online' => 'On-line'], value: '')
        </fieldset>
        <fieldset>
            @? formInput(name: 'pesquisa', placeholder: 'Busque por um convênio', label: 'Pesquisa', class: 'busca_pesquisa', value: '')
            @? formSelect(name: 'ordem', placeholder: 'Ordenar por', label: 'Ordem', class: 'busca_ordem', lista: (new \App\Classes\ParceiroLoja\Ordem)->select(), value: '')
            <button class="botao_geral_cor cor_bg">Buscar</button>
        </fieldset>
    </form>
</div>
