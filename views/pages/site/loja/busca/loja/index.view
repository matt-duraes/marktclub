<div class="bloco_buscar_geral bloco_buscar_loja {{isset($Busca) && $Busca->mapa ?? '' ? 'display_none' : ''}}" id="bloco_buscar">
    <form class="buscar form_geral botao_buscar_abrir">
        <p>Busque uma loja</p>
        @? formSelect(name: 'input_categoria_fake', id: 'bloco_input_categoria_fake', placeholder: 'Categoria', label: 'Categoria', class: 'botao_buscar_input busca_categoria_fake', lista: [])
        @? formInput(name: 'input_pesquisa_fake', id: 'bloco_input_pesquisa_fake', placeholder: 'Busque uma loja', label: 'Pesquisa', class: 'botao_buscar_input busca_pesquisa_fake')
        <div class="botao">Buscar</div>
    </form>

    <form action="@route(get.loja.buscar)" method="get" id="form_buscar" class="{{isset($Busca) && $Busca->mapa ? 'busca_mapa' : ''}} form_geral display_none">
        <div class="conteudo">
            <div class="centralizar">
                <header>
                    <i class="mobile botao_buscar_fechar">@iconeVoltar</i>
                    <h1>Busque por uma loja</h1>
                    <i class="desktop botao_buscar_fechar">@iconeFechar</i>
                </header>
                <div class="bloco_mapa">
                    <h2>Gostaria de buscar apenas lojas próximas a você? Para isso, basta marcar o botão abaixo:</h2>
                    @? formSwitch(name: '', id:'input_mapa', label: 'Buscar lojas próximas', check: isset($Busca) && $Busca->mapa)
                </div>
                <input type="hidden" id="input_latitude_erro" value="{{$Busca->latitude_erro ?? '' ? 'sim' : 'nao'}}">
                <input type="hidden" name="latitude" id="input_latitude" value="{{$Busca->latitude ?? ''}}">
                <input type="hidden" name="longitude" id="input_longitude" value="{{$Busca->longitude ?? ''}}">
                <input type="hidden" id="input_acessado" value="{{$Busca->acessado ?? '' ? 'sim' : 'nao'}}">
                <input type="hidden" id="input_favorito" value="{{$Busca->favorito ?? '' ? 'sim' : 'nao'}}">
                <fieldset>
                    @? formSelect(name: 'estado', placeholder: 'Estado', label: 'Estado', class: 'busca_estado', lista: (new \Helpers\ListaHelper)->add('', 'Escolha um estados')->estado()->r(), value: $Busca->estado ?? '')
                    @? formSelect(name: 'cidade', placeholder: 'Cidade', label: 'Cidade', class: 'busca_cidade', lista: ['' => 'Escolha um estado primeiro'], value: $Busca->cidade ?? '')
                    @? formSelect(name: 'categoria', placeholder: 'Categoria', label: 'Categoria', class: 'busca_categoria', lista: (new App\Classes\ParceiroLoja\Categoria)->select('Escolha uma categoria'), change: 'mudarCategoria', value: $Busca->categoria ?? '', id: 'bloco_input_categoria')
                    @? formSelect(name: 'subcategoria', placeholder: 'Subcategoria', label: 'Subcategoria', class: 'busca_tag', lista: ['' => 'Escolha uma categoria'], value: $Busca->subcategoria ?? '')
                    @? formSelect(name: 'estabelecimento', placeholder: 'Tipo de estabelecimento', class: 'busca_estabelecimento', label: 'Tipo', lista: (new App\Classes\ParceiroLoja\TipoEstabelecimento)->select('Escolha um tipo'), value: $Busca->estabelecimento ?? '')
                </fieldset>
                <fieldset>
                    @? formInput(name: 'pesquisa', placeholder: 'Busque por um convênio', label: 'Pesquisa', class: 'busca_pesquisa', value: $Busca->pesquisa ?? '', id: 'bloco_input_pesquisa')
                    @? formSelect(name: 'ordem', placeholder: 'Ordenar por', label: 'Ordem', class: 'busca_ordem', lista: $listaOrdem, value: $Busca->ordem ?? '')
                    <button class="botao_geral_cor cor_bg" id="botao_buscar_loja">Buscar</button>
                </fieldset>
            </div>
        </div>
    </form>
</div>

