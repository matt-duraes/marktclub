<div class="bloco_buscar_geral bloco_buscar_loja" id="bloco_buscar">
    <form class="buscar botao_buscar_abrir form_geral">
        <p>Busque uma loja</p>
        @? formSelect(name: 'input_categoria_fake', id: 'bloco_input_categoria_fake', placeholder: 'Categoria', label: 'Categoria', class: 'botao_buscar_input busca_categoria_fake', lista: [], value: '')
        @? formInput(name: 'input_pesquisa_fake', id: 'bloco_input_pesquisa_fake', placeholder: 'Busque por um convênio', label: 'Pesquisa', class: 'botao_buscar_input busca_pesquisa_fake', value: '')
        <div class="botao">Buscar</div>
    </form>
    <form action="@route(cashback.buscar)" method="get" id="form_buscar" class="form_geral display_none">
        <div class="conteudo">
            <div class="centralizar">
                <header>
                    <i class="mobile botao_buscar_fechar">@iconeVoltar</i>
                    <h1>Busque uma loja</h1>
                    <i class="desktop botao_buscar_fechar">@iconeFechar</i>
                </header>
                <fieldset>
                    @? formInput(name: 'pesquisa', placeholder: 'Busque por uma loja', label: 'Pesquisa', id: 'bloco_input_pesquisa', class: 'busca_pesquisa', value: $Busca->pesquisa ?? '')
                </fieldset>
                <fieldset>
                    @? formSelect(name: 'categoria', placeholder: 'Categoria', label: 'Categoria', id: 'bloco_input_categoria', class: 'busca_categoria', lista: (new App\Classes\ParceiroLoja\Categoria)->select('Escolha uma categoria'), value: $Busca->categoria ?? '')
                    @? formSelect(name: 'ordem', placeholder: 'Ordenar por', label: 'Ordem', class: 'busca_ordem', lista: $listaOrdem, value: $Busca->ordem ?? '')
                    <button class="botao_geral_cor cor_bg">Buscar</button>
                </fieldset>
            </div>
        </div>
    </form>
