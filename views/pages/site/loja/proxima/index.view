@php require ROOT . '/resources/php/site/icone.php'
<!DOCTYPE HTML>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>LOJAS PRÓXIMAS</title>
    <link rel="shortcut icon" type="image" href="{!!LINK_PADRAO!!}/images/favicon.png" />


    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    @CSS

</head>
<body>
<article id="bloco_convenio-mapa">

    <header class="bloco_header form_geral">

        <a class="voltar" href="{!!LINK_PADRAO!!}" target="_self"><i>@iconeFlechaEsquerda</i><span>VOLTAR</span></a>

        <form id="form_buscar" class="desktop" action="" method="post">

            <input type="hidden" name="raio" value="30">
            @? formInput(name: 'pesquisa', placeholder: 'Pesquisar', label: '', class: 'busca_pesquisa', value: '')
            @? formSelect(name: 'categoria', placeholder: 'Categoria', label: '', class: 'busca_categoria', lista: (new \App\Classes\ParceiroLoja\Categoria)->select('Escolha uma categoria'), value: '')

            <div class="cidade bloco_input">
                @? formInput(name: 'local', placeholder: 'Buscar por cidade ou local', label: '', class: 'busca_local', value: '')
                <button class="Buscar" data-ajuda="Buscar por cidade ou local"><i>@iconePesquisa</i></button>
            </div>

            <ul>
                <li></li>
            </ul>

        </form>

        <div class="raio" id="bloco_raio">
            @? formSelect(name: 'raio', placeholder: 'Raio', class: 'botao_raio', label: '', lista: ['2' => '2 KM', '5' => '5 KM', '10' => '10 KM', '30' => '30 KM','50' => '50 KM'], value: '30')
        </div>

        <i data-font="&#xe820;" class="botao_localizacao" id="botao_buscar_por_localizacao" data-ajuda="Ou compartilhe sua localização"></i>

    </header>


    <div class="bloco_mapa" id="mapa">
    </div>



    <div class="buscar_popup" data-ajuda="Buscar por cidade ou local">@iconePesquisa</div>

    <div class="bloco_parceiro" id="bloco_parceiro">
        <header>
            <i class="voltar mobile"">@iconeFlechaEsquerda</i>
            <h1 class="color_cor h1_voltar parceiro_titulo">Hype Idiomas</h1>
        </header>

        <article class="dado parceiro">
            <p class="parceiro_texto">Escola de idiomas.</p>
            <h2 class="parceiro_desconto">Inseção da taxa de matricula</h2>
            <figure><img class="parceiro_imagem" src="https://arquivo.marktclub.com.br/parceiro/65c3d3b6716418d6425dfa858214a963.jpg" alt=""></figure>
            <header>
                <h1 class="parceiro_texto"></h1>
            </header>

            <div class="botao">
                <a class="detalhe parceiro_link" href="" target="_self">DETALHES</a>
                <a class="rota parceiro_rota" href="" target="_blank"><i data-font="&#xf278;"></i>ABRIR ROTA</a>
            </div>
        </article>

        <div class="botao">
            <a class="detalhe parceiro_link" href="" target="_self">DETALHES</a>
            <a class="rota parceiro_rota" href="" target="_blank"><i data-font="&#xf278;"></i>ABRIR ROTA</a>
        </div>
    </div>

    <div class="bloco_previa" id="bloco_previa"><h1>NOME DO PARCEIRO</h1></div>
    <div id="atualizar_mapa">
        <button class="botao_atualizar_mapa botao_geral_cor">Pesquisar nesta área</button>
    </div>

</div>

<form action="/" method="post">
    <input type="hidden" name="LINK" id="LINK" value="{!!LINK!!}">
</form>


<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAkKA5ZteX4i5N7kY9-sdXsWLSRTYr8L5Q&callback=Function.prototype"></script>
<script src="https://clube.marktclub.com.br/js/site/convenio_mapa_markerclusterer.js?cache=134"></script>
@JS


</style>
</body>
</html>
