@template "site"
@resource "site/variavel"
@resource "site/busca"
@resource "site/loja/busca"
@resource "site/loja/parceiro"
@resource "site/loja/relacionado"
@resource "site/loja/detalhe"
@resource "site/parceiro_header"
@resource "site/texto_destaque"

#bloco_loja_detalhe
    margin-top: 20px

#bloco_loja_confirmar
    max-width: 700px
    .conteudo
        width: 100%
        padding: 20px
        flexCol()
        position: relative
    h2
        texto()
        margin-bottom: 20px
    .bloco
        width: 100%
        flexCol()
        margin-bottom: 20px
    .bloco h3
        subTitulo()
        color: $corClube
        font-weight: bold
    .bloco p
        texto()
