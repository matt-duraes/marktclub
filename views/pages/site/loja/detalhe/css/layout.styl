@template "site"
@system "Esqueleto"
@system "Ajuda"
@resource "site/variavel"
@resource "site/busca"
@resource "site/loja/busca"
@resource "site/loja/parceiro"
@resource "site/loja/relacionado"
@resource "site/parceiro_header"
@resource "site/texto_destaque"
@resource "site/pagina_popup"

.bloco_loja_detalhe
    width: 100%
    max-width: $maxWidth
    flexCol()
    align-items: center

.bloco_desconto_procedimento
    maxWidth()
    flexRow()
    justify-content: space-between
    espacoBottomPadrao()
    .bloco
        width: calc(50% - 10px)
@media screen and (max-width: 600px)
    .bloco_desconto_procedimento
        flexCol()
        .bloco
            width: 100%
            margin-top: 20px
            &:first-child
                margin-top: 0

.bloco_botao
    display: flex
    width: 100%
    flex-wrap: wrap
    justify-content: center
    padding-bottom: 10px
    .lista
        flexRow()
    .linha
        width: 1px
        height: 45px
        background-color: #CCC
        margin: 20px 20px 0 0
    .borda
        color: $corClube
        border-color: $corClube
        margin-right: 20px
        margin-top: 20px
        padding-right: 5px
        flexRow()
        align-items: center
        cursor: pointer
    .botao
        background: $corClube
        color: #FFF
        margin-top: 20px
        flexRow()
        align-items: center
        cursor: pointer
    .borda i
    .botao i
        width: 40px
        height: 40px
        flexCenter()
        fill: #FFF
    .borda i
        fill: $corClube
    .branco
        background-color: #FFF
        boxShadow()
        padding-left: 5px
    .branco i
        border-right: 1px solid #DDD
        margin-right: 15px
    .destaque
        padding-right: 10px
    .destaque i
        margin-left: 5px
@media screen and (max-width: 900px)
    .bloco_botao
        flex-wrap: wrap
        .linha
            width: 100%
            height: 1px
            margin-right: 0
        .lista
            width: 100%
            justify-content: center
        .borda
            margin: 0 10px
        .botao
            height: 60px
            line-height: 60px
@media screen and (max-width: 700px)
    .bloco_botao
        .lista
            justify-content: space-between
            flex-wrap: wrap
        .borda
            height: auto
            line-height: 1.5em
            padding: 0 10px
            justify-content: center
            margin: 0 0 20px 0
        .borda_1
            width: 100%
        .borda_3
            width: calc((100% / 3) - 10px)
        .borda_2
        .borda_4
            width: calc(50% - 10px)
        .linha
            margin-top: 0
@media screen and (max-width: 550px)
    .bloco_botao
        .borda_3
            width: calc(50% - 10px)
            &:nth-child(3)
                width: 100%
@media screen and (max-width: 400px)
    .bloco_botao
        .borda
            width: 100%
            height: auto
            line-height: 1.5em
            padding: 0
        .botao
            width: 100%
            align-items: center
            justify-content: center
#bloco_loja_confirmar
    max-width: 700px
    .conteudo
        width: 100%
        padding: 20px
        flexCol()
        position: relative
    h2
        texto()
        margin-bottom: 20px
    .bloco
        width: 100%
        flexCol()
        margin: 10px 0
        padding: 15px 20px
        border: 1px dashed $corClube
        border-radius: 5px
    .bloco h3
        subTitulo()
        color: $corClube
    .bloco p
        texto()

.bloco_loja_detalhe .bloco_mapa
    width: 100%
    margin-top: 40px
    position: relative
    flexCol()
    align-items: flex-start
    border-radius: 10px
    boxShadow()
    background: $corBrancoCinza
    overflow: hidden
    header
        width: 100%
        max-width: $maxWidth
        z-index: 2
        flexRow()
        align-items: center
        padding: 10px 15px
        border-bottom: 1px solid #DDD
    header h1
        titulo()
        line-height: 1em
    header .grow
        flexGrow()
    header .botao
        flexCenter()
        background-color: $corClube
        color: #FFF
        fill: #FFF
        padding: 0 5px 0 15px
        margin-left: 20px
        font-size: 1.4rem
        border-radius: 5px
        cursor: pointer
    header .botao i
        width: 30px
        height: 30px
        flexCenter()
    .detalhe
        max-width: calc(100% - 40px)
        min-height: 1.5em
        margin: 10px 20px
        display: flex
        align-items: center
    .detalhe p
        texto()
    .detalhe i.copiar
        width: 30px
        height: 30px
        flexCenter()
        border: 1px solid #CCC
        fill: $corClube
        border-radius: 3px
        margin-left: 10px
        cursor: pointer
    .detalhe .botao
        flexCenter()
        border: 1px solid $corClube
        color: $corClube
        fill: $corClube
        padding: 3px 3px 3px 8px
        margin-left: 20px
        font-size: 1.4rem
        border-radius: 5px
        cursor: pointer
    .detalhe .botao i
        width: 30px
        height: 30px
        flexCenter()
    .detalhe .resto
        flex-grow: 1
        flex-basis: 0%
    .mapa_falso
        width: calc(100% - 40px)
        height: 430px
        min-height: 380px
        max-height: calc(100vh - 240px)
        position: absolute
        bottom: 20px
        left: 20px
        z-index: 2
    .mapa
        width: 100%
        height: 450px
        min-height: 400px
        max-height: calc(100vh - 200px)
        position: relative
        z-index: 1
@media screen and (max-width: 900px)
    .bloco_loja_detalhe .bloco_mapa .detalhe
        width: 100%
        flex-wrap: wrap
        p
            flexGrow()
        .resto
            display: none
        .botao
            width: 100%
            margin-left: 0
            margin-top: 10px

.bloco_lista_texto_icone
    width: 100%
    flexCol()
    .linha
        width: 100%
        flexRow()
        border-left: 3px solid $corClube
        padding: 3px 0 3px 10px
        margin: 3px 0
        align-items: center
    .linha p
        flexGrow()
        texto()
        color: #666
    .linha strong
        width: 100%
        max-width: 200px
        texto()
        font-weight: bold
        color: #666
    .linha span
        width: 1px
        height: 10px
        background-color: #CCC
        margin: 0 10px
    .linha i
        width: 30px
        height: 30px
        flexCenter()
        &.botao
            cursor: pointer
        &.borda
            border: 1px solid #ddd
            border-radius: 3px
        svg
            fill: $corPretoBranco

@media screen and (max-width: 600px)
    .bloco_lista_texto_icone .linha
        gap: 20px
        flex-direction: column
        strong
            width: auto
            color: $corClube
        span
            display: none
        i.borda
            fill: $corBody

#bloco_endereco
    max-width: 900px
    .mensagem
        width: 100%
    .mensagem .zero
        texto()
        padding: 100px 0
        text-align: center
    form
        width: 100%
        flexRow()
        align-items: flex-start
        margin-bottom: 10px
        padding-bottom: 10px
        border-bottom: 1px solid #CCC
    form .bloco_input
        flexGrow()
        margin-right: 20px
        margin-top: 10px
        &:last-child
            margin-right: 0
    .conteudo
        margin-top: 20px
    .conteudo a
        padding: 8px 10px
        background-color: $corClube
        color: #FFF
        margin-left: 10px
        font-size: 1.3rem
        border-radius: 5px
@media screen and (max-width: 700px)
    #bloco_endereco form
        flexCol()
        .bloco_input
            width: 100%
