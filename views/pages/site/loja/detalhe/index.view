@template "site"

@ if( $tipo == 'loja' ):
@view site/loja/busca/loja/index.view
@ endif;

@ if($dado):
<div id="bloco_loja_detalhe" class="bloco_loja_detalhe">
    <input type="hidden" id="input_analytics_vinculo" value="{!!$dado->id!!}">
    <input type="hidden" id="input_loja_id" value="{!!$dado->id!!}">
    <input type="hidden" id="input_loja_url" value="{!!$dado->url!!}">
    <div class="bloco_parceiro_header">
        <section class="bloco_banner">
            @ if( !empty($dado->capa_desktop) ):
            <figure class="banner desktop"><img src="{{$dado->capa_desktop}}"></figure>
            @ endif;
            @ if( !empty($dado->capa_mobile) ):
            <figure class="banner mobile"><img src="{{$dado->capa_mobile}}"></figure>
            @ endif;
        </section>
        <figure class="logo {!!empty($dado->capa_desktop) && empty($dado->capa_mobile) ? 'vazio' : ''!!}"><img src="{{$dado->logo}}"></figure>
        <header class="bloco_header">
            <h1>{!!$dado->titulo!!}</h1>
            <p>{!!$dado->texto_descricao!!}</p>
        </header>
    </div>

    <div class="bloco_desconto_procedimento">
        <div class="bloco bloco_titulo_texto">
            <h1>Descontos</h1>
            <div class="texto_destaque">{!!$dado->texto_desconto!!}</div>
        </div>
        <div class="bloco bloco_titulo_texto">
            <h1>Procedimentos</h1>
            <div class="texto_destaque">{!!$dado->texto_procedimento!!}</div>
        </div>
    </div>

    @ if(TIPO_USUARIO != 'indicado'):
    <div class="bloco_botao display_none" id="bloco_botao_lista">
        <div class="lista">
            @ if( $dado->telefone ):
            <div class="botao_contar_click borda botao_geral_borda" id="botao_telefone_abrir" data-botao="telefone">Telefones<i>@iconeTelefoneLoja()</i></div>
            @ endif;
            @ if( $dado->email ):
            <div class="botao_contar_click borda botao_geral_borda" id="botao_email_abrir" data-botao="email">E-mails <i>@iconeEmail(15)</i></div>
            @endif;

            @ if( $dado->procedimento != $procedimento::WEBSITE && !empty($dado->link) ):
            <a href="{!!$dado->link!!}" target="_blank" rel="noopener noreferrer" class="botao_contar_click borda botao_geral_borda" data-botao="Abrir site secundario">
                Abrir Site
                <i>@iconeExtensaoHome</i>
            </a>
            @ endif;

            @ if(!empty($dado->arquivo)):
                @ if(count($dado->arquivo) > 1)
                <div id="botao_arquivo_abrir" class="botao_contar_click borda botao_geral_borda">
                    Download
                    <i>@iconeDownloadHome</i>
                </div>
                @ else
                <a href="{!!$dado->arquivo[0]->arquivo!!}" download rel="noopener noreferrer" class="botao_contar_click borda botao_geral_borda" data-botao="Abrir Arquivo">
                    Download
                    <i>@iconeDownloadHome</i>
                </a>
                @ endif
            @ endif
        </div>

        <div class="linha"></div>

        @ if( $dado->procedimento == $procedimento::MAIS_SAUDE ):
            <a href="@route('farmacia.carteirinha')" target="_blank" rel="nofollow noopener" class="botao_contar_click botao destaque botao_geral_cor cor_bg" >
                Abrir Carteirinha <i>@iconeDeclaracao(17)</i>
            </a>
        @ elseif ($dado->procedimento == $procedimento::DECLARACAO):
        <div id="botao_salvar_declaracao" class="botao_contar_click botao destaque botao_geral_cor cor_bg" data-botao="Declaração">Solicitar Declaração <i>@iconeDeclaracao(17)</i></div>
        @ elseif ($dado->procedimento == $procedimento::VOUCHER):
        <a href="@route('loja.voucher')/{{$dado->url}}" target="_blank" rel="nofollow noopener" class="botao_confirmar_abrir botao_contar_click botao destaque botao_geral_cor cor_bg" data-botao="Voucher">
            Gerar Voucher
            <i>@iconeShow</i>
        </a>
        @ elseif ($dado->procedimento == $procedimento::WEBSITE):
        <a href="{!!$dado->link!!}" target="_blank" rel="noopener noreferrer" class="botao_confirmar_abrir botao_contar_click botao destaque botao_geral_cor cor_bg" data-botao="Abrir Site">
            Abrir Site
            <i>@iconeExtensaoHome</i>
        </a>
        @ endif

    </div>
    @else
    <div class="bloco_atencao_geral">
        <p>Apenas associados possuem acesso a esse recurso</p>
    </div>
    @endif

    @ if( $dado->endereco ):
    <div class="bloco_mapa" id="bloco_mapa">
        <header>
            <h1 class="esqueleto">Endereço</h1>
            <div class="grow"></div>
            <div class="botao esqueleto" id="botao_endereco_abrir_popup">Buscar Endereço <i>@iconeBusca(20)</i></div>
        </header>
        <div class="detalhe esqueleto">
            <p id="bloco_endereco_completo"></p>
            <i class="copiar" id="botao_endereco_copiar">@iconeCopiar</i>
            <div class="resto"></div>
            <a href="" target="_blank" rel="nofollow noopener" id="botao_endereco_link" class="botao esqueleto">Como Chegar <i>@iconeMapa(20)</i></a>
        </div>
        <div class="mapa_falso esqueleto display_none"></div>
        <div class="mapa" id="bloco_endereco_google_map"></div>
    </div>
    @ endif;

    @view site/geral/relacionado.view
</div>
@ endif;

@view "site/loja/detalhe/arquivo"
@view "site/loja/detalhe/telefone"
@view "site/loja/detalhe/email"
@view "site/loja/detalhe/confirmar"
@view "site/loja/detalhe/endereco"

<!-- prettier-ignore -->
<script src="https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js"></script>
<script>(g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})
    ({key: "AIzaSyA8KZjnZT3zrHwBxK3cnIhc1giasJ6U6LI", v: "weekly"});</script>
