@template "site"

@view site/loja/geral/busca.view

<div id="bloco_loja_index">
    @ if( $banner ):
        @view site/geral/banner.view
    @ endif;

    <div class="bloco_especial {{$Busca->uso ? 'separar' : ''}}">
        <div class="scroll">
            <div class="conteudo">
                <div class="item cartao {{$Busca->mapa ? 'hover' : ''}} botao_loja_proxima">
                    <i>@iconeMapa(25)</i>
                    <p>Lojas próximas</p>
                </div>
                <a href="@route('loja.index')?favorito=sim" class="{{$Busca->favorito ? 'hover' : ''}} cartao item">
                    <i>@iconeFavorito(22)</i>
                    <p>Meus favoritos</p>
                </a>
                <a href="@route('loja.index')?acessado=sim" class="{{$Busca->acessado ? 'hover' : ''}} cartao item">
                    <i>@iconePromocao(20)</i>
                    <p>Mais acessados</p>
                </a>
            </div>
        </div>
        <div class="flex_grow"></div>
        @ if( $Busca->mapa ):
        <div class="mapa item" id="botao_visualizar_mapa">
            <i>@iconeMapaPapel(20)</i>
            <p>Visualizar mapa</p>
        </div>
        <div class="mapa item display_none" id="botao_visualizar_lista">
            <i>@iconeListaMista(18)</i>
            <p>Visualizar lista</p>
        </div>
        @ endif;
    </div>

    @view site/geral/parceiro.view
    @ if( $Busca->mapa ):
    @view site/loja/mapa/index.view
    @ endif;
</div>
