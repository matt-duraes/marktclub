@template "site"

@view site/loja/geral/busca.view

<div id="bloco_loja_index">
    @ if( $banner ):
        @view site/geral/banner.view
    @ endif;

    <div class="bloco_especial {{$Busca->uso ? 'separar' : ''}}">
        <div class="conteudo">
            <div class="item {{$Busca->mapa ? 'hover' : ''}} botao_loja_proxima">
                <i>@iconeMapa(25)</i>
                <p>Lojas próximas</p>
            </div>
            <a href="@route('loja.index')?favorito=sim" class="{{$Busca->favorito ? 'hover' : ''}} item">
                <i>@iconeFavorito(22)</i>
                <p>Meus favoritos</p>
            </a>
            <a href="@route('loja.index')?acessado=sim" class="{{$Busca->acessado ? 'hover' : ''}} item">
                <i>@iconePromocao(20)</i>
                <p>Mais acessados</p>
            </a>
        </div>
        @ if( $Busca->mapa ):
        <div class="mapa item">
            <i>@iconeMapaPapel(20)</i>
            <p>Visualizar mapa</p>
        </div>
        @ endif;
    </div>

    @view site/geral/parceiro.view
    @ if( $Busca->mapa ):
    @view site/loja/mapa/index.view
    @ endif;
</div>
