@template "site"

@ if( $tipo == 'loja' ):
    @view site/loja/busca/loja/index.view
@ elseif( $tipo == 'cashback' ):
    @view site/loja/busca/cashback/index.view
@ endif;

@if ($tipo == 'farmacia' && sessao('popupAlerta')) :
@php sessao('popupAlerta', false)
<div class="display_none" id="popup_medicamento">
</div>
@endif;

@ if( isset($Busca) && !empty($Busca->filtro) && !$Busca->mapa ):
<div class="buscar_convenio_lista">
    <h2>Filtros:</h2>
    <div class="scroll">
        <div class="conteudo">
            @ foreach( $Busca->filtro as $r ):
            <div class="item" data-indice="{{$r->indice}}" data-valor="{{$r->valor_real}}">
                <div class="nome">{!!$r->nome!!}</div>
                <div class="valor">{!!$r->valor!!}</div>
                <div class="remover">@iconeFechar(10)</div>
            </div>
            @ endforeach;
        </div>
    </div>
</div>
@ endif;

<div id="bloco_loja_index" class="{{isset($Busca) && $Busca->mapa ? 'bloco_mapa' : ''}}">
    <input type="hidden" id="input_tipo_geral" value="{{$tipo}}">
    @ if( $banner ):
        @view site/geral/banner.view
    @ endif;

    @ if( $tipo == 'loja' ):
    <div class="bloco_especial {{isset($Busca) && $Busca->filtro ? 'separar' : ''}}" id="bloco_especial">
        <div class="scroll">
            <div class="conteudo">
                <div class="bg">
                    <div class="comeco"></div>
                    @ if( isset($Busca) && $Busca->mapa ):
                    <div class="item" id="botao_visualizar_lista">
                        <i>@iconeListaMista(18)</i>
                        <p>Visualizar lista</p>
                    </div>
                    <div class="item display_none" id="botao_visualizar_mapa">
                        <i>@iconeMapaPapel(20)</i>
                        <p>Visualizar mapa</p>
                    </div>
                    <div class="item busca botao_buscar_abrir">
                        <i>@iconeBusca(18)</i>
                        <p>Buscar loja</p>
                    </div>
                    <div class="borda"></div>
                    @ endif;
                    <a class="item {{$todos ? 'hover' : ''}}" href="@route('loja.index')">
                        <i>@iconeLojaHome(20)</i>
                        <p>Todas as lojas</p>
                    </a>
                    <div class="item cartao {{isset($Busca) && $Busca->mapa ? 'hover' : ''}} botao_loja_proxima">
                        <i>@iconeMapa(25)</i>
                        <p>Lojas próximas</p>
                    </div>
                    <a href="@route('loja.index')?favorito=sim" class="{{isset($Busca) && $Busca->favorito ? 'hover' : ''}} cartao item">
                        <i>@iconeFavorito(22)</i>
                        <p>Meus favoritos</p>
                    </a>
                    <a href="@route('loja.index')?acessado=sim" class="{{isset($Busca) && $Busca->acessado ? 'hover' : ''}} cartao item">
                        <i>@iconePromocao(20)</i>
                        <p>Mais acessados</p>
                    </a>
                    <div class="final"></div>
                </div>
            </div>
        </div>
    </div>
    @ endif;

    @view site/geral/parceiro_novo.view

    @ if( isset($Busca) && $Busca->mapa ):
    @view site/loja/mapa/index.view
    @ endif;

    @ if( $tipo == 'automovel' ):
    @view site/automovel/geral/mensagem.view
    @ endif;
</div>
