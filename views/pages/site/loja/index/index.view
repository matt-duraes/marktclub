@template "site"

@view site/loja/geral/busca.view

<div id="bloco_loja_index" class="{{$Busca->mapa ? 'bloco_mapa' : ''}}">
    @ if( $banner ):
        @view site/geral/banner.view
    @ endif;

    <div class="bloco_especial {{$Busca->filtro ? 'separar' : ''}}" id="bloco_especial">
        <div class="scroll">
            <div class="conteudo">
                <div class="bg">
                    <div class="comeco"></div>
                    @ if( $Busca->mapa ):
                    <div class="item" id="botao_visualizar_lista">
                        <i>@iconeListaMista(18)</i>
                        <p>Visualizar lista</p>
                    </div>
                    <div class="item display_none" id="botao_visualizar_mapa">
                        <i>@iconeMapaPapel(20)</i>
                        <p>Visualizar mapa</p>
                    </div>
                    <div class="item busca botao_buscar_abrir">
                        <i>@iconeBusca(18)</i>
                        <p>Buscar loja</p>
                    </div>
                    <div class="borda"></div>
                    @ endif;
                    <a class="item {{$todos ? 'hover' : ''}}" href="@route('loja.index')">
                        <i>@iconeLojaHome(20)</i>
                        <p>Todas as lojas</p>
                    </a>
                    <div class="item cartao {{$Busca->mapa ? 'hover' : ''}} botao_loja_proxima">
                        <i>@iconeMapa(25)</i>
                        <p>Lojas próximas</p>
                    </div>
                    <a href="@route('loja.index')?favorito=sim" class="{{$Busca->favorito ? 'hover' : ''}} cartao item">
                        <i>@iconeFavorito(22)</i>
                        <p>Meus favoritos</p>
                    </a>
                    <a href="@route('loja.index')?acessado=sim" class="{{$Busca->acessado ? 'hover' : ''}} cartao item">
                        <i>@iconePromocao(20)</i>
                        <p>Mais acessados</p>
                    </a>
                    <div class="final"></div>
                </div>
            </div>
        </div>
    </div>

    @view site/geral/parceiro_novo.view
    @ if( $Busca->mapa ):
    @view site/loja/mapa/index.view
    @ endif;
</div>
