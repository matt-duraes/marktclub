@template "site"
@resource "site/banner"
@resource "site/busca"
@resource "site/loja/busca"
@resource "site/loja/parceiro"
@resource "site/automovel/mensagem"
@system "Esqueleto"
@system "Popup"

#bloco_medicamento
    maxWidth()
    .banner
        espacoBottomPadrao()
#popup_medicamento
    border-radius: 10px
    max-width: 600px
    header
        margin-bottom: 0
        display: flex
        justify-content: flex-end
        align-items: center
        background-color: $corClube
        height: 35px
        padding: 0 20px
        cursor: pointer
    i
        position: inherit
        color: $corBrancoPreto
        fill: $corBrancoPreto
    .conteudo_popup
        padding: 0
    .atencao
        font-size: 1.5em
        text-align: center
        margin-bottom: 10px
        display: flex
        flex-direction: column
        align-items: center
        header
            background-color: $corClube
        svg
            fill: $corClube
        h1
            background: $corClube
            color: $corBrancoPreto
            padding: 10px
            margin: 0
            width: 160px
            border-radius: 5px
            text-align: center
            font-size: 16px
            font-weight: 500
        p
            font-size: 20px
            color: $corCinzaCinza
            margin: 25px 10px
            max-width: 450px
.bloco_carregar_mais
    width: 100%
    maxWidth()
    position: relative
    flexCenter()
    margin-top: 20px
    z-index: 6
    &.bloco_carregar_mais_mapa
        position: fixed
        max-width: 50%
        bottom: 20px
        max-width: 50%
    .botao
        width: 100%
        max-width: 220px
        height: 60px
        line-height: 60px
        background-color: $corClube
        color: #FFF
        border-radius: 5px
        margin-left: 20px
        text-align: center
        textoFontSize()
        cursor: pointer
        user-select: none
    .botao.loading
        background: #CCC
        color: #333
        cursor: progress

#bloco_loja_index
    width: 100%
    min-height: 100vh
    flexCol()
    align-items: center
    .banner
        margin-bottom: 20px
        z-index: 2
    .bloco_geral_sem_resultado
        padding-top: 60px

#bloco_loja_index .bloco_especial
    maxWidth()
    flexRow()
    margin-bottom: 20px
    z-index: 6
    &.separar
        border-top: 1px solid #DDD
        padding-top: 20px
    .menu
        width: 60px
        display: none
        align-items: center
    .menu i
        width: 40px
        height: 40px
        flexCenter()
        margin-left: 10px
        fill: $corPretoBranco
        cursor: pointer
    .scroll
        min-width: 100%
        overflow-x: auto
        scrollBarHide()
    .conteudo
        flexRow()
        overflow: auto
    .conteudo .bg
        flexRow()
    .borda
        width: 1px
        min-width: 1px
        height: 45px
        background-color: #CCC
        margin-right: 20px
        position: relative
    .item
        border: 1px solid #999
        background-color: $corBody
        flexRow()
        borderRadius()
        align-items: center
        padding: 10px
        cursor: pointer
    .item i
        margin-right: 10px
        fill: $corCinzaCinza
    .item p
        texto()
        white-space: nowrap
    .item:hover
        border-color: $corClube
    .item:hover i
        fill: $corClube
    .item:hover p
        color: $corClube
    .item.hover
        border-color: $corClube
        background-color: $corClube
    .item.hover i
        fill: #FFF
    .item.hover p
        color: #FFF
    .conteudo .item
        margin-right: 20px
        &:last-child
            margin-right: 0
    .mapa
        border: 1px solid $corClube
        color: $corClube
        cursor: pointer
        position: relative
    .mapa i
        fill: $corClube
    .busca
        display: none

#bloco_loja_index.bloco_mapa .bloco_especial
    width: 100%
    max-width: calc(100% - 340px)
    border-top: none
    position: fixed
    top: 0
    margin-top: 0
    padding-top: 0
    right: 20px
    &.conteudo_webview
        max-width: calc(100% - 40px)
    .conteudo
        justify-content: flex-start
    .conteudo .bg
        background-color: $corBrancoPreto
        border-radius: 5px
        box-shadow: 0 5px 5px rgba(0,0,0,.2)
        padding: 20px 0 20px 20px
        margin: auto
    .busca
        display: flex
    .borda
        background: $corCinzaCinza
    .conteudo .item:last-child
        margin-right: 20px
#conteudo_acesso_rapido #bloco_loja_index .bloco_especial .conteudo
    margin-top: 20px

#conteudo_acesso_rapido #bloco_loja_index.bloco_mapa .bloco_especial
    top: 110px

@media screen and (max-width: 1250px)
    #bloco_loja_index.bloco_mapa .bloco_especial
        width: 100vw
        max-width: 100vw
        top: 0
        left: 0
        background-color: $corBrancoPreto
        &.conteudo_webview
            max-width: 100%
        .menu
            display: flex
        .scroll
            width: calc(100% - 60px)
            min-width: calc(100% - 60px)
        &.conteudo_webview .scroll
            width: 100%
            min-width: 100%
        .conteudo .bg
            border-radius: 0
            padding: 10px 20px 10px 0
            box-shadow: none
        &.conteudo_webview .bg
            padding-left: 20px
        .conteudo .bg .item
            padding: 0 10px
        .atualizar
            top: 85px

@media screen and (max-width: 900px)
    #bloco_loja_index .bloco_especial
        flex-wrap: wrap
        .scroll
            width: 100%
        .cartao
            flexGrow()
            min-width: 220px
        .cartao i
            margin: 0 20px
        .cartao p
            width: 100px
        .mapa
            width: 100%
            margin-top: 20px
            flexCenter()


.bloco_parceiro_loading
    z-index: 4
#bloco_loja_mapa
    width: calc(100vw - 310px)
    height: 100vh
    position: fixed
    top: 0
    right: 0
    z-index: 5
    background: #FFF
    &.conteudo_webview
        width: 100%
    .atualizar
        height: 30px
        line-height: 30px
        max-width: 200px
        z-index: 2
        text-align: center
        color: #FFF
        border-radius: 20px
        font-size: 1.3rem
        position: absolute
        background-color: $corClube
        left: 0
        right: 0
        top: 130px
        margin: auto
        cursor: pointer
    .icone_mapa
        width: 50px
        height: 50px
        border-radius: 50%
        overflow: hidden
        border: 5px solid #FFF
        box-shadow: 0 0 5px rgba(0,0,0,.5)
        background-size: contain
        background-color: #FFF
        background-position: center center
        background-repeat: no-repeat
    .mapa
        width: 100%
        height: 100%
        position: absolute
        top: 0
        right: 0
        z-index: 1

#bloco_loja_mapa .bloco_zoom
    position: fixed
    z-index: 10
    bottom: 20px
    right: 20px
    box-shadow: 0 0 5px rgba(0,0,0,.2)
    .botao
        width: 45px
        height: 45px
        flexCenter()
        background-color: #FFF
        cursor: pointer
        &:hover
            background-color: #EEE
        &:first-child
            border-radius: 5px 5px 0 0
            border-bottom: 1px solid #CCC
        &:last-child
            border-radius: 0 0 5px 5px
@media screen and (max-width: 900px)
    #bloco_loja_mapa .bloco_zoom .botao:hover
        background-color: #FFF

#conteudo_acesso_rapido
    position: relative
    .bloco_buscar_geral
        z-index: 5
        margin-top: 100px

#conteudo_acesso_rapido
    #bloco_loja_mapa
        width: 100vw
        .atualizar
            top: 240px
    .bloco_mapa  #bloco_especial
        max-width: 100%

#conteudo_acesso_rapido
    #bloco_loja_index.bloco_mapa .bloco_especial
        top: 90px

body.body_scroll_hidden #bloco_loja_mapa .mapa
    right: 10px
@media screen and (max-width: 1250px)
    #bloco_loja_mapa
        width: 100%
    body.body_scroll_hidden #bloco_loja_mapa .mapa
        width: calc(100% - 10px)
        right: 10px

#bloco_parceiro_previa
    width: calc(100% - 300px)
    position: fixed
    bottom: -100px
    right: 0
    opacity: 0
    padding: 0 20px
    z-index: 7
    flexRow()
    justify-content: center
    transition: opacity .3s ease-out, bottom .3s ease-out
    &.ativo
        opacity: 1
        bottom: 0
    .conteudo
        width: 100%
        max-width: 1000px
        border-radius: 15px 15px 0 0
        background: $corBrancoPreto
        box-shadow: 0 -5px 8px rgba(0,0,0,.2)
        flexRow()
        padding: 20px
    figure
        height: 100px
    figure img
        max-width: 100%
        max-height: 100%
    .dado
        flexCol()
        flexGrow()
        padding-left: 30px
        align-items: flex-start
    .dado header
        width: 100%
        flexRow()
    .dado header h1
        flexGrow()
        titulo()
        align-items: center
    .dado header i
        width: 30px
        height: 30px
        flexCenter()
        cursor: pointer
        fill: $corPretoBranco
    .dado p
        texto()
    .dado a
        botaoPadraoGrande()
        background-color: $corClube
        margin-top: 20px
        color: #FFF
body.body_scroll_hidden #bloco_loja_mapa .parceiro_previa
    width: calc(100% - 310px)
    right: 10px
@media screen and (max-width: 1250px)
    #bloco_parceiro_previa
        width: 100%
    body.body_scroll_hidden #bloco_loja_mapa .parceiro_previa
        width: calc(100% - 10px)
        right: 10px
