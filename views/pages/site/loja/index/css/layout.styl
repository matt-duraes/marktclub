@template "site"
@resource "site/banner"
@resource "site/busca"
@resource "site/loja/busca"
@resource "site/loja/parceiro"
@system "Esqueleto"

#form_buscar
    .bloco_mapa
        width: 100%
        margin: 20px 0 10px
        border-left: 5px solid $corClube
        padding-left: 15px
    .bloco_mapa h2
        texto()
    .bloco_mapa .bloco_switch
        margin-top: 10px
        margin-bottom: 0
    .busca_cidade
        display: none
#form_buscar.busca_mapa
    .busca_cidade
        display: flex
    .busca_estabelecimento
    .busca_ordem
        display: none

.bloco_carregar_mais
    width: 100%
    maxWidth()
    position: relative
    flexCenter()
    margin-top: 20px
    z-index: 6
    &.bloco_carregar_mais_mapa
        position: fixed
        bottom: 20px
    .botao
        width: 100%
        max-width: 220px
        height: 60px
        line-height: 60px
        background-color: $corClube
        color: #FFF
        border-radius: 5px
        margin-left: 20px
        text-align: center
        textoFontSize()
        cursor: pointer
        user-select: none
    .botao.loading
        background: #CCC
        color: #333
        cursor: progress

#bloco_loja_index
    width: 100%
    min-height: 100vh
    flexCol()
    align-items: center
    margin-top: 40px
    .banner
        margin-bottom: 40px
        z-index: 2
    .bloco_geral_sem_resultado
        padding-top: 60px

#bloco_loja_index .bloco_especial
    maxWidth()
    flexRow()
    margin: -20px 0 20px
    z-index: 6
    &.separar
        border-top: 1px solid #DDD
        padding-top: 20px
    .scroll
        min-width: 100%
        overflow-x: auto
        scrollBarHide()
    .conteudo
        flexRow()
    .conteudo .bg
        flexRow()
    .borda
        width: 1px
        min-width: 1px
        height: 45px
        background-color: #CCC
        margin-right: 20px
        position: relative
    .item
        border: 1px solid #999
        background-color: $corBody
        flexRow()
        border-radius: 5px
        align-items: center
        padding: 10px
        cursor: pointer
    .item i
        margin-right: 10px
        fill: #666
    .item p
        texto()
        white-space: nowrap
    .item:hover
        border-color: $corClube
    .item:hover i
        fill: $corClube
    .item:hover p
        color: $corClube
    .item.hover
        border-color: $corClube
        background-color: $corClube
    .item.hover i
        fill: #FFF
    .item.hover p
        color: #FFF
    .conteudo .item
        margin-right: 20px
        &:last-child
            margin-right: 0
    .mapa
        border: 1px solid $corClube
        color: $corClube
        cursor: pointer
        position: relative
    .mapa i
        fill: $corClube
    .busca
        display: none
    .final
        width: 1px
        min-width: 1px
        height: 20px
        display: none

#bloco_loja_index.bloco_mapa .bloco_especial
    width: 100%
    max-width: calc(100% - 340px)
    border-top: none
    position: fixed
    top: 10px
    margin-top: 0
    padding-top: 0
    right: 20px
    .conteudo
        justify-content: center
    .conteudo .bg
        background-color: $corBrancoPreto
        border-radius: 5px
        box-shadow: 0 5px 5px rgba(0,0,0,.2)
        padding: 20px 0 20px 20px
        margin: 10px 0
    .busca
        display: flex
    .borda
        background: #666

@media screen and (max-width: 1250px)
    #bloco_loja_index.bloco_mapa .bloco_especial
        max-width: 100%
        top: 50px
        right: 0
        .conteudo
            justify-content: flex-start
        .conteudo .bg
            border-radius: 0

@media screen and (max-width: 900px)
    #bloco_loja_index .bloco_especial
        flex-wrap: wrap
        .scroll
            width: 100%
        .cartao
            flexGrow()
            min-width: 200px
        .cartao i
            margin: 0 20px
        .cartao p
            width: 100px
        .mapa
            width: 100%
            margin-top: 20px
            flexCenter()

.bloco_parceiro_loading
    z-index: 4
#bloco_loja_mapa
    width: calc(100vw - 310px)
    height: 100vh
    position: fixed
    top: 0
    right: 0
    z-index: 5
    background: #FFF
    .atualizar
        height: 30px
        line-height: 30px
        max-width: 200px
        z-index: 2
        text-align: center
        color: #FFF
        border-radius: 20px
        font-size: 1.3rem
        position: absolute
        background-color: $corClube
        left: 0
        right: 0
        top: 130px
        margin: auto
        cursor: pointer
    .icone_mapa
        width: 50px
        height: 50px
        border-radius: 50%
        overflow: hidden
        border: 5px solid #FFF
        box-shadow: 0 0 5px rgba(0,0,0,.5)
        background-size: contain
        background-color: #FFF
        background-position: center center
        background-repeat: no-repeat
    .mapa
        width: 100%
        height: 100%
        position: absolute
        top: 0
        right: 0
        z-index: 1

#header_acesso_rapido
    position: fixed
    z-index: 77777
#conteudo_acesso_rapido
    #bloco_loja_mapa
        width: 100vw
    #bloco_loja_index  #bloco_especial
        z-index: 99999
        max-width: 100%
        top: 106px
        position: fixed
#bloco_loja_index
    .botao_chat_mapa
        width: 60px
        height: 60px
        flexCenter()
        background-color: #34af23
        fill: #FFFFFF
        border-radius: 60px
        position: fixed
        bottom: 20px
        right: 80px
        z-index: 20
body.body_scroll_hidden #bloco_loja_mapa .mapa
    right: 10px
@media screen and (max-width: 1250px)
    #bloco_loja_mapa
        width: 100%
    body.body_scroll_hidden #bloco_loja_mapa .mapa
        width: calc(100% - 10px)
        right: 10px

#bloco_parceiro_previa
    width: calc(100% - 300px)
    position: fixed
    bottom: -100px
    right: 0
    opacity: 0
    padding: 0 20px
    z-index: 7
    flexRow()
    justify-content: center
    transition: opacity .3s ease-out, bottom .3s ease-out
    &.ativo
        opacity: 1
        bottom: 0
    .conteudo
        width: 100%
        max-width: 1000px
        border-radius: 15px 15px 0 0
        background: #FFF
        box-shadow: 0 -5px 8px rgba(0,0,0,.2)
        flexRow()
        padding: 20px
    figure
        height: 100px
    figure img
        max-width: 100%
        max-height: 100%
    .dado
        flexCol()
        flexGrow()
        padding-left: 30px
        align-items: flex-start
    .dado header
        width: 100%
        flexRow()
    .dado header h1
        flexGrow()
        titulo()
        align-items: center
    .dado header i
        width: 30px
        height: 30px
        flexCenter()
        cursor: pointer
    .dado p
        texto()
    .dado a
        botaoPadraoGrande()
        background-color: $corClube
        margin-top: 20px
        color: #FFF
body.body_scroll_hidden #bloco_loja_mapa .parceiro_previa
    width: calc(100% - 310px)
    right: 10px

@media screen and (max-width: 1250px)
    #bloco_loja_mapa .parceiro_previa
        width: 100%
    body.body_scroll_hidden #bloco_loja_mapa .parceiro_previa
        width: calc(100% - 10px)
        right: 10px
