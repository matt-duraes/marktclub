@template "site"
@resource "site/banner"
@resource "site/loja/busca"
@resource "site/loja/parceiro"

#bloco_loja_index
    width: 100%
    flexCol()
    align-items: center
    .banner
        margin-bottom: 40px
    .bloco_favorito
        width: 30px
        height: 30px
        flexCenter()
        position: absolute
        top: 20px
        right: 20px
        z-index: 2
        cursor: pointer
    .bloco_favorito .marcado
        display: none
        fill: #FF6C60
    .bloco_favorito .desmarcado
        fill: #999
    .bloco_favorito.favorito_marcado .desmarcado
        display: none
    .bloco_favorito.favorito_marcado .marcado
        display: flex
