@template "site"
@resource "site/banner"
@resource "site/busca"
@resource "site/loja/busca"
@resource "site/loja/parceiro"

#bloco_loja_index
    width: 100%
    min-height: calc(100vh - 190px)
    flexCol()
    align-items: center
    margin-top: 40px
    .banner
        margin-bottom: 40px
        z-index: 2
    .bloco_geral_sem_resultado
        padding-top: 60px
        border-top: 1px solid #DDD

#bloco_loja_index .bloco_especial
    width: 100%
    maxWidth()
    flexRow()
    margin: -20px 0 20px
    z-index: 2
    &.separar
        border-top: 1px solid #DDD
        padding-top: 20px
    .conteudo
        flexRow()
        flexGrow()
    .item
        border: 1px solid #999
        background-color: $corBody
        flexRow()
        border-radius: 5px
        align-items: center
        padding: 10px
        cursor: pointer
    .item i
        margin-right: 10px
        fill: #666
    .item p
        texto()
    .item:hover
        border-color: $corClube
    .item:hover i
        fill: $corClube
    .item:hover p
        color: $corClube
    .item.hover
        border-color: $corClube
        background-color: $corClube
    .item.hover i
        fill: #FFF
    .item.hover p
        color: #FFF
    .conteudo .item
        margin-right: 20px
        &:last-child
            margin-right: 0
    .mapa
        border: 1px solid $corClube
        color: $corClube
        cursor: pointer
    .mapa i
        fill: $corClube

#bloco_loja_mapa
    width: calc(100vw - 310px)
    height: 100vh
    position: fixed
    top: 0
    right: 0
    z-index: 1
    .atualizar
        height: 30px
        line-height: 30px
        max-width: 200px
        z-index: 2
        text-align: center
        color: #FFF
        border-radius: 20px
        font-size: 1.3rem
        position: absolute
        background-color: $corClube
        left: 0
        right: 0
        bottom: 10px
        margin: auto
        cursor: pointer
    .mapa
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        z-index: 1
