        </div>
    </div>
    <div class="footer_pagina_popup">
        @ if( $dado->procedimento == $procedimento::VOUCHER ):
        <a href="@route('loja.voucher')/{{$dado->url}}" target="_blank" rel="nofollow noopener" class="botao botao_contar_click" data-botao="Confirmar Voucher">GERAR VOUCHER</a>
        @ elseif ($dado->procedimento == $procedimento::WEBSITE):
        <a href="{!!$dado->link!!}" target="_blank" rel="noopener noreferrer" class="botao botao_contar_click" data-botao="Confirmar abrir Site">Abrir Site</a>
        @ endif
    </div>
