    <div class="conteudo_pagina_popup footer">
        <div class="conteudo">
            <h2>Antes de continuar, confirme o procedimento de utilização, desconto e possíveis restrições da loja</h2>
            <div class="bloco">
                <h3>Descontos</h3>
                <div class="texto_destaque">{!!$dado->texto_desconto!!}</div>
            </div>
            <div class="bloco">
                <h3>Procedimento</h3>
                <div class="texto_destaque">{!!$dado->texto_procedimento!!}</div>
