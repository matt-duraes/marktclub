@template "site"

<div id="bloco_pagina_indicacao">
    <form action="/" method="post" class="form_geral" id="form_dependente">
        <header>
            <h1>Indique para um amigo</h1>
        </header>

        <p>O que você acha de liberar um acesso por 48 horas para um amigo?</p>
        <p>Isso mesmo, ele poderá acessar e visualizar o clube</p>
        <p>Basta colocar os dados do seu amigo, que a liberação do seu acesso será automática! Quando você indica, você também demonstra sua amizade!</p>

        @? formInput(name: 'nome', placeholder: 'Digite o nome do seu amigo', label: 'Nome', local: 'André Rodrigues')
        @? formTelefone(name: 'telefone', label: 'Telefone', placeholder: 'Digite o telefone do seu amigo');
        @? formEmail(name: 'email', placeholder: 'Digite o email do seu amigo', label: 'E-mail', local: 'andrerodrigues@andrerodrigues.com')

        <div class="bloco_botao">
            <div></div>
            <div id="botao_indicar_enviar" class="botao_geral_cor cor_bg">Enviar</div>
        </div>
    </form>
</div>

