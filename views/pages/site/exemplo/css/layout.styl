@system "Resetar"

body
    background-color: #F6F6F6
    font-family: Arial, Helvetica, sans-serif

#exemplo
    width: 100%
    display: flex
    flex-direction: column
    align-items: center
header
    display: flex
    align-items: center
    flex-direction: column
    margin-top: 40px
    h1
        font-size: 3rem
        color: #666
        font-weight: bold
    p
        max-width: 350px
        line-height: 1.5em
        font-size: 1.8rem
        color: #666
        margin-top: 10px
a.botao
    height: 40px
    line-height: 40px
    border-radius: 20px
    padding: 0 25px
    margin-top: 60px
    color: #FFF
    font-size: 1.4rem
    background-color: #169e91
