@template "login"

<div class="auth_bloco_geral_site" id="auth_bloco_ativar">
    <form id="auth_form_ativar" class="auth_form_geral form_geral" action="{{LINK}}/auth/ativar" method="post">
        <div class="auth_loading"><span></span></div>

        <header>
            <legend>PRIMEIRO ACESSO</legend>
            <p>Preencha os campos abaixo para completar seu cadastro</p>
        </header>

        <input type="text" value="" class="input_hidden">
        <input type="password" value="" class="input_hidden">

        <input type="hidden" name="hash" value="">

        <div class="bloco_buscar">
            <div class="bloco_input buscar">

                @if ($ativacao == 'siape' && false === $dependente) :

                    @? formInput(name: 'pesquisa', label: 'Digite seu siape', placeholder: 'Digite seu siape', attr: ['data-tipo' => 'siape'])

                @elseif ($ativacao == 'siape' && (true === $dependente)) :

                    @? formCpf(name: 'pesquisa', label: 'CPF', placeholder: 'Digite um CPF', attr: ['tipo' => 'cpf'])
                @elseif (in_array($ativacao, ['siape', 'matricula']) && (true === $dependente)) :

                    @? formCpf(name: 'pesquisa', label: 'CPF', placeholder: 'Digite um CPF', attr: ['tipo' => 'cpf'])

                @elseif ($ativacao == 'cpf') :

                    @? formCpf(name: 'pesquisa', label: 'CPF', placeholder: 'Digite um CPF', attr: ['tipo' => 'cpf'])

                @elseif ($ativacao == 'matricula') :
                    <label>
                        @if ($id_admin_empresa == 225) :
                            FUNCIONAL DO BANCO
                        @elseif ($id_admin_empresa == 233) :
                            DIGITE SEU CÓDIGO ABERT
                        @else:
                            DIGITE SUA MATRÍCULA
                        @endif;
                    </label>
                    @? formInput(name: 'pesquisa', label: 'Matrícula', placeholder: 'Digite sua matrícula', attr: ['tipo' => 'matricula'])

                @elseif($ativacao == 'email') :

                    @? formEmail(name: 'pesquisa', placeholder: 'Digite o email', label: 'Digite o email', value: '', attr: ['tipo' => 'email'])

                @else:
                    @? formEmail(name: 'pesquisa', placeholder: 'Digite o email ou cpf', label: 'Digite o email ou cpf', value: '', attr: ['tipo' => 'email-cpf'])

                @endif;
            </div>
            <div class="captcha" id="captcha_buscar"></div>
            <div class="botao_buscar" id="botao_buscar_usuario">BUSCAR</div>
        </div>

        <div class="bloco dados_pessoais">
            <h2>DADOS PESSOAIS</h2>
            <div class="bloco_input_container nome">
                @? formInput(name: 'nome', label: 'Nome', placeholder: 'Digite seu nome', obrigatorio: 1)
            </div>

            <div class="bloco_input_container cpf">
                @? formCpf(name: 'pesquisa', label: 'CPF', placeholder: 'Digite seu CPF', obrigatorio: 1)
            </div>

            <div class="bloco_input_container data nascimento">
                @? formData(name: 'data_nascimento', label: 'Data de nascimento', placeholder: 'Data de nascimento')
            </div>
            <div class="bloco_input_container sexo">
                @? formSelect(name: 'genero', label: 'Gênero', placeholder: 'Escolha seu gênero', value: '', lista: $genero)
            </div>
            <div class="bloco_input_container estado_civil">
                @? formSelect(name: 'tipo', placeholder: 'Selecione o estado civil', class: 'botao_raio', label: 'Estado civil', lista: ['solteiro' => 'Solteiro', 'casado' => 'Casado', 'separado' => 'Separados', 'divorciado' => 'Divorciado', 'viuvo' => 'Viúvo'], value: '')
            </div>
        </div>

        <div class="bloco contato">
            <h2>DADOS DE CONTATO</h2>
            <div class="bloco_input_container email email_pessoal">
                @? formEmail(name: 'email_pessoal', placeholder: 'Digite o email pessoal', label: 'Digite o email pessoal', value: '')
            </div>
            <div class="bloco_input_container email email_trabalho">
                @? formEmail(name: 'email_trabalho', placeholder: 'Digite o email de trabalho', label: 'Digite o emailde trabalho', value: '')
            </div>

            <div class="contato_telefone">

                @if ($id_admin_empresa == 94) :

                    <div class="bloco_input_container ddi">
                        <label>DDI - CELULAR<span data-ajuda="Obrigatório">*</span></label>
                        <select name="telefone_pessoal_ddi">
                            <option value=""></option>
                            @ foreach ($ddi as $p) :
                                <option value="{{$p}}">+{{$p}}</option>
                            @ endforeach;
                        </select>
                    </div>
                @ endif;
                <div class="bloco_input_container telefone telefone_celular">
                    @? formTelefone(name: 'telefone_celular', label: 'Telefone celular', placeholder: 'Digite um telefone celular');
                </div>
            </div>
            <div class="contato_telefone ">
                @if ($id_admin_empresa == 94) :
                    <div class="bloco_input_container ddi">
                        <label>DDI - FIXO</label>
                        <select name="telefone_trabalho_ddi">
                            <option value=""></option>
                            @ foreach ($ddi as $key => $p) :
                                <option value="{{$p;}}">+{{$p;}}</option>
                            @ endforeach;
                        </select>
                    </div>
                @ endif;
                <div class="bloco_input_container telefone telefone_fixo">
                    @? formTelefone(name: 'telefone_fixo', label: 'Telefone fixo', placeholder: 'Digite um telefone fixo');
                </div>
                <div class="bloco_input_container cpf_fake" style="display: none">
                </div>
            </div>
        </div>

        <div class="endereco">
            <h2>ENDEREÇO</h2>
            <div class="bloco_input_container cep">
                @? formInput(name: 'cep', placeholder: 'CEP', label: 'CEP', value: '')
            </div>
            <div class="bloco_input_container logradouro">
                @? formInput(name: 'logradouro', placeholder: 'Logradouro', label: 'Logradouro', value: '')
            </div>
            <div class="bloco_input_container numero">
                @? formInput(name: 'numero', placeholder: 'Número', label: 'Número', value: '')
            </div>
            <div class="bloco_input_container complemento">
                @? formInput(name: 'complemento', placeholder: 'Complemento', label: 'Complemento', value: '')
            </div>
            <div class="bloco_input_container bairro">
                @? formInput(name: 'bairro', placeholder: 'Bairro', label: 'Bairro', value: '')
            </div>
            <div class="bloco_input_container cidade">
                @? formInput(name: 'cidade', placeholder: 'Cidade', label: 'Cidade', value: '')
            </div>
            <div class="bloco_input_container estado">
                @? formSelect(name: 'estado', placeholder: 'UF', label: 'UF', class: 'busca_estado', lista: $uf, value: '')
            </div>
        </div>

        <div class="senha">
            <h2>SENHA</h2>
            <div class="dica">
                <p>Sua senha deve:</p>
                <ul>
                    <li>Ter pelo menos 8 caracteres</li>
                    <li>Ter pelo menos uma letra minúscula</li>
                    <li>Ter pelo menos uma letra maiúscula</li>
                    <li>Ter pelo menos um símbolo</li>
                    <li>Ter pelo menos um número</li>
                </ul>
            </div>
            <div data-tooltip aria-label="" class="bloco_input_container">
                @? formSenha(name: 'senha', label: 'Senha', placeholder: 'Senha');
            </div>
            <div class="bloco_input_container">
                @? formSenha(name: 'confirmar_senha', label: 'Confirmar senha', placeholder: 'Confirmar senha');
            </div>
        </div>

        <div class="botao between">
            <div class="termo">
                <input type="checkbox" id="termo_uso" value="">
                <label for="termo_uso">Aceito os Termos de acordo com a Lei 13.709/2018</label>
                <div class="botao_termo" id="botao_ver_termo">(termos)</div>
            </div>
            <button class="enviar" id="botao_ativar_cadastro" type="button">CADASTRAR</button>
        </div>
    </form>

    <form id="auth_form_adicionar_dependente" class="auth_form_geral form_geral" action="{{LINK}}/auth/salvar-dependente" method="post">
        <div class="auth_loading"><span></span></div>

        <header>
            <legend>ATIVAÇÃO CONCLUÍDA COM SUCESSO</legend>
            <h2>DESEJA ADICIONAR DEPENDENTES ANTES DE EFETUAR O LOGIN?</h2>
        </header>

        <div class="dependente bloco_dependente">
            <p>Adicione até 5 dependentes, sem nenhum custo adicional.</p>
            <p><span>Dependentes elegíveis para cadastro são os cônjuges e filhos.</span></p>

            <div class="botao_coluna">
                <p class="adicionar_dependente">Adicionar dependente</p>
                <p class="limite_dependente">Limite de dependentes antigindo</p>
                <a href="" class="efetuar_login">Efetuar Login</a>
            </div>
        </div>

        <section class="dependente_conteudo">
            <input type="hidden" name="empresa" value="{{$id_admin_empresa}}">
            <input type="hidden" name="titular" value="">
            <input type="hidden" name="client_id" value="{{$client_id;}}">
            <article>
                <div class="bloco_input_container">
                    @? formInput(name: 'nome_dependente', label: 'Digite o nome', placeholder: 'Digite o nome', attr: ['data-name' => 'nome_dependente'])
                </div>
                <div class="bloco_input_container">
                    @? formCpf(name: 'cpf_dependente', label: 'Digite o cpf', placeholder: 'Digite o cpf', attr: ['data-name' => 'cpf_dependente'])
                </div>
                <div class="bloco_input_container">
                    @? formEmail(name: 'email_dependente', placeholder: 'Digite o email', label: 'Digite o email', attr: ['data-name' => 'email_dependente'], value: '')
                </div>
                <div class="bloco_input_container">
                    @? formSelect(name: 'sexo_dependente', label: 'Gênero', placeholder: 'Escolha o gênero', value: '', lista: $genero)
                </div>
            </article>
            <button class="color_cor border_cor post_botao_salvar_dependente">Adicionar dependente</button>
        </section>

    </form>

    <a href="{{LINK}}" class="voltar">VOLTAR PARA LOGIN</a>
</div>

<div id="bloco_termo">
    <div class="conteudo">
        <div class="fechar"></div>
        <h1>Termo</h1>
        <p>Forneço meu consentimento específico, livre, informado e inequívoco, para que a Markt Tec Serviços em Tecnologia da Informação Ltda.</p>
        <p>(i) realize o tratamento de meus dados pessoais e dados sensíveis, com a finalidade de veicular, de modo mais adequado ao meu perfil, comunicações sobre parcerias e ofertas relativas a este Clube de Vantagens; e </p>
        <p>(ii) utilize os dados para confirmar à rede de parceiros e conveniados visando confirmar/identificar meu cadastros como beneficiário apto à utilização dos descontos como membro do programa de vantagens. Estou ciente que os dados tratados pela Markt Tec Serviços em Tecnologia da Informação Ltda incluem aqueles relativos ao preenchimento espontâneo de ficha de cadastro, bem como minhas eventuais atualizações.</p>
    </div>
</div>

