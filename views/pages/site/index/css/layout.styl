@template "site"
@system "Historico"
@resource "site/banner"
@resource "site/loja/parceiro"
@import "favorito"

.bloco_historico
    width: 100%
    margin-bottom: 20px
    position: relative
    .seta
        width: 30px
        height: 30px
        background: #FFF
        position: absolute
        boxShadow()
        top: 20px
        border-radius: 50%
        flexCenter()
        z-index: 2
    .seta.anterior
        left: 10px
    .seta.proximo
        right: 10px
#bloco_index
    maxWidth()
    .bloco
        width: 100%
        margin-top: 40px
    .bloco_favorito_zero
        margin: 60px 0 80px
.bloco_geral_imagem_esquerda
    height: auto
.bloco_plano
    flexCenter()
.bloco_atencao_geral
    margin-top: 25px

@media screen and (max-width: 800px)
    .bloco_plano
        padding: 20px
        figure
            display: none
    .final
        padding: 20px 0px

@media screen and (max-width: 450px)
    .bloco_geral_imagem_esquerda
        flex-direction: column
    .bloco_geral_imagem_esquerda header
        flex-grow: 1
        flex-basis: 0%
        padding-right: 0px
        margin-right: 0px
        padding-bottom: 20px
        border-right: none
        border-bottom: 1px solid #ddd
    .bloco_geral_imagem_esquerda .final
        width: 100%
        margin-right: 0px
        padding-left: 20px
        padding-top: 0px

#bloco_ajuda .conteudo
    width: 100%
    flexCol()
    align-items: center
    padding: 20px
    header
        margin-bottom: 40px
    p
        texto()
    .contato
        width: 100%
        border: 1px solid #DDD
        border-radius: 5px
        flexRow()
        margin: 10px 0
        align-items: center
        padding: 10px 20px
        cursor: pointer
        &:hover
            background-color: $corClube
            border-color: $corClube
            fill: #FFF
            color: #FFF
    .contato .icone
        width: 30px
        height: 30px
        flexCenter()
    .contato span
        flexGrow()
        texto()
        margin-left: 20px
    .contato .copiar
        width: 30px
        height: 30px
        flexCenter()
        border-radius: 5px
        display: none
        &:hover
            background-color: rgba(255,255,255,.2)
    .linha
        width: 100%
        margin: 30px 0
        position: relative
        flexCenter()
        texto()
        &::after
            content: ""
            width: 100%
            height: 1px
            position: absolute
            background-color: #DDD
            z-index: 1
    .linha span
        texto()
        z-index: 2
        background: #FFF
        padding: 0 10px
        color: #999
    .link
        width: 100%
        text-align: center
        boxShadow()
        textoFontSize()
        padding: 20px
        border: 1px solid #EEE
        border-radius: 5px
        margin-bottom: 20px
        &:hover
            background-color: $corClube
            color: #FFF
    .fechar
        width: 100%
        margin: 20px 0 10px
        cursor: pointer
        text-align: center
        color: #999
