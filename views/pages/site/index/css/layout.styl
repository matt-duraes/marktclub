@template "site"
@resource "site/banner"
@resource "site/loja/parceiro"
@import "favorito"

.bloco_historico
    width: 100%
    margin-bottom: 20px
    position: relative
    .seta
        width: 30px
        height: 30px
        background: #FFF
        position: absolute
        boxShadow()
        top: 20px
        border-radius: 50%
        flexCenter()
        z-index: 2
    .seta.anterior
        left: 10px
    .seta.proximo
        right: 10px
    .conteudo
        width: 100%
        overflow-x: auto
        overflow-y: hidden
        flexRow()
    .item
        width: 70px
        flexCol()
        margin-right: 20px
        cursor: pointer
        &:last-child
            margin-right: 0
    .item figure
        width: 70px
        height: 70px
        border: 3px solid $corClube
        border-radius: 50%
        flexCenter()
    .item.visto figure
        border-color: #CCC
    .item figure span
        width: 60px
        height: 60px
        flexCenter()
        overflow: hidden
        border-radius: 50%
        position: relative
        padding: 10px
        background-color: #FFF
    .item figure img
        width: 100%
        height: 100%
        max-width: 100%
        max-height: 100%
        z-index: 1
    .item .nome
        width: 100%
        height: 1.5em
        line-height: 1.5em
        margin-top: 5px
        text-align: center
        font-size: 1.2em
        overflow: hidden

#bloco_index
    maxWidth()
    .bloco
        width: 100%
        margin-top: 40px
    .bloco_favorito_zero
        margin: 60px 0 80px
.bloco_geral_imagem_esquerda
    height: auto
.bloco_plano
    flexCenter()
.bloco_atencao_geral
    margin-top: 25px
@media screen and (max-width: 800px)
    .bloco_plano
        padding: 20px
        figure
            display: none
    .final
        padding: 20px 0px

@media screen and (max-width: 450px)
    .bloco_geral_imagem_esquerda
        flex-direction: column
    .bloco_geral_imagem_esquerda header
        flex-grow: 1
        flex-basis: 0%
        padding-right: 0px
        margin-right: 0px
        padding-bottom: 20px
        border-right: none
        border-bottom: 1px solid #ddd
    .bloco_geral_imagem_esquerda .final
        width: 100%
        margin-right: 0px
        padding-left: 20px
        padding-top: 0px

.bloco_promocao
    width: 100%
    flexRow()
    justify-content: space-between
    .promocao
        width: calc(50% - 10px)
        height: 250px
        boxShadow()
        display: flex
        justify-content: center
        align-items: center
        background: #FFF
        border-radius: 10px
