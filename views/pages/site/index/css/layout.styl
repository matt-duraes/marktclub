@template "site"
@system "Historico"
@resource "site/banner"
@resource "site/loja/parceiro"
@import "favorito"

.bloco_historico
    width: 100%
    margin-bottom: 20px
    position: relative
    .seta
        width: 30px
        height: 30px
        background: #FFF
        position: absolute
        boxShadow()
        top: 20px
        border-radius: 50%
        flexCenter()
        z-index: 2
    .seta.anterior
        left: 10px
    .seta.proximo
        right: 10px
#bloco_index
    maxWidth()
    .bloco
        width: 100%
        margin-top: 40px
    .bloco_favorito_zero
        margin: 60px 0 80px
.bloco_geral_imagem_esquerda
    height: auto
.bloco_plano
    flexCenter()
.bloco_atencao_geral
    margin-top: 25px

@media screen and (max-width: 800px)
    .bloco_plano
        padding: 20px
        figure
            display: none
    .final
        padding: 20px 0px

@media screen and (max-width: 450px)
    .bloco_geral_imagem_esquerda
        flex-direction: column
    .bloco_geral_imagem_esquerda header
        flex-grow: 1
        flex-basis: 0%
        padding-right: 0px
        margin-right: 0px
        padding-bottom: 20px
        border-right: none
        border-bottom: 1px solid #ddd
    .bloco_geral_imagem_esquerda .final
        width: 100%
        margin-right: 0px
        padding-left: 20px
        padding-top: 0px

#pesquisa_satisfacao_popup fieldset
    display: flex
    text-align: start
    margin-bottom: 15px
    flex-direction: column
    align-items: center
    justify-content: center
#pesquisa_satisfacao_popup .conteudo
    width: 100%
    flexCol()
    p
        width: 100%
        margin-left: 17px
        line-height: 1.5em
        font-size: 1.6rem
        text-align: center
#pesquisa_satisfacao_popup fieldset
    h2
        texto()
        margin-top: 20px
    .pergunta
        width: 100%
        display: flex
        flex-wrap: wrap
        gap: 10px
        padding-left: 30px
    .pergunta .botao_input
        margin-top: 10px
        width: auto
        width: calc((100% / 3) - 17px)
        text-align: center
        height: 44px
        margin-right: 0px
    .pergunta .botao_input label
        font-size: 1.4rem

#pesquisa_satisfacao_popup .input_textarea textarea
    height: 40px

#pesquisa_satisfacao_popup .form_geral .bloco_input
    width: 90%
@media screen and (max-width: 425px)
    #pesquisa_satisfacao_popup .header_pagina_popup
        height: auto
    #pesquisa_satisfacao_popup .pergunta
        flex-direction: column
        align-items: center
        padding-left: 0px
    #pesquisa_satisfacao_popup .pergunta .botao_input
        width: 80%
