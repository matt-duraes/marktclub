@template "site"

<div id="bloco_index">
    @view site/loja/geral/banner.view

    <div class="bloco">
        <div class="bloco_geral_imagem_esquerda">
            <figure><img src="{{LINK_PADRAO}}/images/site/home_saude.jpg" alt=""></figure>
            <header>
                <h1>Que tal um plano de saúde feito para você?</h1>
                <p>Venha conhecer o plano de saúde que cabe no seu bolso</p>
            </header>
            <div class="final">
                <div class="valor">
                    <p class="apartir">Apartir</p>
                    <div class="preco">
                        <div class="sifrao">R$</div>
                        <div class="real">240,00</div>
                        <div class="asterisco">*</div>
                    </div>
                    <div class="observacao">*Para pessoas com idade de 36 anos</div>
                </div>
                <a href="" class="botao_geral_cor cor_bg">Fazer cotação</a>
            </div>
        </div>
    </div>

    <div class="bloco">
        <div class="bloco_geral_sem_resultado bloco_favorito">
            <i>@iconeGps(40)</i>
            <p>Você ainda não tem lojas favoritas, que tal aprender como salvar sua lojas favoritas?</p>
            <a class="botao_geral_cor cor_bg" href="">Salvar lojas favoritas</a>
        </div>
    </div>

    <div class="bloco">
        <header class="titulo_geral">
            <h1>LOJAS NOVAS</h1>
            <a class="cor_color" href="">Ver todas as lojas</a>
        </header>
        @php $parceiro = [1,1,1]
        @view site/loja/geral/parceiro.view
    </div>

    <div class="bloco">
        <header class="titulo_geral">
            <h1>PROMOÇÕES</h1>
            <a class="cor_color" href="">Ver todas as promoções</a>
        </header>
        <section class="bloco_promocao">
            <article class="promocao"><a href=""></a></article>
            <article class="promocao"><a href=""></a></article>
        </section>
    </div>

</div>
