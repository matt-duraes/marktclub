@template "site"
<div id="bloco_index">
    @if(TIPO_USUARIO == 'indicado'):
    <div class="bloco_atencao_geral">
        <p>Você está utilizando uma versão limitada do clube</p>
    </div>
    @endif

    <div class="bloco_historico" id="bloco_historico">
        <i class="seta anterior display_none">@iconeSetaEsquerda(18)</i>
        <div class="conteudo scrollbar_hidden bloco_scrollbar_item">
            @ laco(2)
            <div class="item">
                <figure>
                    <span><img src="https://arquivo.marktclub.com.br/parceiro/b9994388644c6d04bea5495a3ed1fe72.png" alt=""></span>
                </figure>
                <div class="nome">Parceiro...</div>
                <div class="lista">
                    <img class="visto" src="https://arquivo.marktclub.com.br/publicidade/0ae0826f5dd931e49c7796aa24bd618e.png" alt="">
                    <img src="https://arquivo.marktclub.com.br/publicidade/8863ad96a201ded0de113aa224420ed5.jpg" alt="">
                </div>
            </div>
            <div class="item">
                <figure>
                    <span><img src="https://arquivo.marktclub.com.br/parceiro/2a9eafaf7ce7401c7bd65357899bb5cb.png" alt=""></span>
                </figure>
                <div class="nome">Parceiro...</div>
                <div class="lista">
                    <img src="https://arquivo.marktclub.com.br/publicidade/575e638d5ad7a19ec4c29980080854a3.png" alt="">
                    <img src="https://arquivo.marktclub.com.br/publicidade/4d551cb9b66fefca6ed1757f23d24e38.png" alt="">
                    <img src="https://arquivo.marktclub.com.br/publicidade/2b3f3ae86a18370c1882ff2836958214.png" alt="">
                </div>
            </div>
            @ endlaco;
        </div>
        <i class="seta proximo display_none">@iconeSetaDireita(18)</i>
    </div>

    @view site/geral/banner.view

    <div class="bloco">
        <div class="bloco_geral_imagem_esquerda">
            <div class="bloco_plano">
                <figure>
                    <img src="{{LINK_PADRAO}}/images/site/home_saude.jpg" alt="">
                </figure>
                <header>
                    <h1>Que tal um plano de saúde feito para você?</h1>
                    <p>Venha conhecer o plano de saúde que cabe no seu bolso</p>
                </header>
            </div>
            <div class="final">
                <div class="valor">
                    <p class="apartir">Apartir</p>
                    <div class="preco">
                        <div class="sifrao">R$</div>
                        <div class="real">240,00</div>
                        <div class="asterisco">*</div>
                    </div>
                    <div class="observacao">*Para pessoas com idade de 36 anos</div>
                </div>
                @if(TIPO_USUARIO != 'indicado'):
                    <a href="@route('planosaude.index')" class="botao_geral_cor cor_bg">Fazer cotação</a>
                @endif
            </div>
        </div>
    </div>

    <div class="bloco {{$loja_favorita->lista ? '' : 'display_none'}}" id="bloco_favorito">
        <header class="titulo_geral">
            <h1>LOJAS FAVORITAS</h1>
            <a class="cor_color" href="@route(loja.index)?favorito=sim">Ver mais</a>
        </header>
        @php $lista = $loja_favorita;
        @view site/geral/parceiro.view
    </div>
    <div class="bloco_geral_sem_resultado bloco_favorito_zero {{$loja_favorita->lista ? 'display_none' : ''}}" id="bloco_favorito_faq">
        <i>@iconeFavoritoMarcado(60)</i>
        <p>Você ainda não tem lojas favoritas, que tal aprender como salvar sua lojas favoritas?</p>
        <div class="botao botao_geral_cor cor_bg" id="botao_favorito_tutorial">Salvar lojas favoritas</div>
    </div>

    <div class="bloco">
        <header class="titulo_geral">
            <h1>MAIS UTILIZADAS</h1>
            <a class="cor_color" href="@route('loja.index')?acessado=sim">Veja mais</a>
        </header>
        @php
            $lista = $mais_utilizada;
        @end
        @view site/geral/parceiro.view
    </div>
    <div class="bloco">
        <header class="titulo_geral">
            <h1>NOVAS LOJAS</h1>
            <a class="cor_color" href="@route('loja.index')?ordem=mais-novo">Veja mais</a>
        </header>
        @php
            $lista = $loja_nova;
        @end
        @view site/geral/parceiro.view
    </div>
</div>
