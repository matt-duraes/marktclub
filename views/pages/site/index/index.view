@template "site"

@view site/loja/busca/loja/index.view

<div id="bloco_index">
    @if(TIPO_USUARIO == 'indicado'):
    <div class="bloco_atencao_geral">
        <p>Você está utilizando uma versão limitada do clube</p>
    </div>
    @endif
    <div class="bloco_historico">
        <i class="seta anterior" id="botao_anterior_historico">@iconeSetaEsquerda(18)</i>
        <div class="conteudo scrollbar_hidden bloco_scrollbar_item" id="bloco_historico"></div>
        <i class="seta proximo" id="botao_proximo_historico">@iconeSetaDireita(18)</i>
    </div>

    @view site/geral/banner.view

    @ if( !empty($plano_saude) ):
    <div class="bloco">
        <div class="bloco_geral_imagem_esquerda">
            <div class="bloco_plano">
                <figure>
                    <img src="{{LINK_PADRAO}}/images/site/home_saude.jpg" alt="">
                </figure>
                <header>
                    <h1>Que tal um plano de saúde feito para você?</h1>
                    <p>Venha conhecer o plano de saúde que cabe no seu bolso</p>
                </header>
            </div>
            <div class="final">
                <div class="valor">
                    <p class="apartir">Apartir</p>
                    <div class="preco">
                        <div class="sifrao">R$</div>
                        <div class="real">{{$plano_saude}}</div>
                        <div class="asterisco">*</div>
                    </div>
                    <div class="observacao">*Para pessoas com idade de até 18 anos</div>
                </div>
                @if(TIPO_USUARIO != 'indicado'):
                    <a href="@route('planosaude.index')" class="botao_geral_cor cor_bg">Veja valores</a>
                @endif
            </div>
        </div>
    </div>
    @ endif;

    <div class="bloco" id="bloco_favorito">
        <header class="titulo_geral">
            <h1>LOJAS FAVORITAS</h1>
            <a class="cor_color" href="@route(loja.index)?favorito=sim">Ver mais</a>
        </header>
        <div class="bloco_parceiro bloco_geral_article" id="bloco_parceiro_favorito">
            @ laco(3)
            @view site/geral/parceiro_loading.view
            @ endlaco;
        </div>
    </div>
    <div class="bloco_geral_sem_resultado bloco_favorito_zero display_none" id="bloco_favorito_faq">
        <i>@iconeFavoritoMarcado(60)</i>
        <p>Você ainda não tem lojas favoritas, que tal aprender como salvar sua lojas favoritas?</p>
        <div class="botao botao_geral_cor cor_bg" id="botao_favorito_tutorial">Salvar lojas favoritas</div>
    </div>

    <div class="bloco">
        <header class="titulo_geral">
            <h1>MAIS UTILIZADAS</h1>
            <a class="cor_color" href="@route('loja.index')?acessado=sim">Veja mais</a>
        </header>
        <div class="bloco_parceiro bloco_geral_article" id="bloco_parceiro_acessado">
            @ laco(3)
            @view site/geral/parceiro_loading.view
            @ endlaco;
        </div>
    </div>
    <div class="bloco">
        <header class="titulo_geral">
            <h1>NOVAS LOJAS</h1>
            <a class="cor_color" href="@route('loja.index')?ordem=mais-novo">Veja mais</a>
        </header>
        <div class="bloco_parceiro bloco_geral_article" id="bloco_parceiro_novo">
            @ laco(3)
            @view site/geral/parceiro_loading.view
            @ endlaco;
        </div>
    </div>
</div>

@view site/geral/parceiro_clone.view
