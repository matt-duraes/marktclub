@template "site"
<div id="bloco_index">

    @view site/geral/banner.view

    @if(TIPO_USUARIO == 'indicado'):
    <div class="bloco_atencao_geral">
        <p>Você está utilizando uma versão limitada do clube</p>
    </div>
    @endif

    <div class="bloco">
        <div class="bloco_geral_imagem_esquerda">
            <div class="bloco_plano">
                <figure>
                    <img src="{{LINK_PADRAO}}/images/site/home_saude.jpg" alt="">
                </figure>
                <header>
                    <h1>Que tal um plano de saúde feito para você?</h1>
                    <p>Venha conhecer o plano de saúde que cabe no seu bolso</p>
                </header>
            </div>
            <div class="final">
                <div class="valor">
                    <p class="apartir">Apartir</p>
                    <div class="preco">
                        <div class="sifrao">R$</div>
                        <div class="real">240,00</div>
                        <div class="asterisco">*</div>
                    </div>
                    <div class="observacao">*Para pessoas com idade de 36 anos</div>
                </div>
                @if(TIPO_USUARIO != 'indicado'):
                    <a href="" class="botao_geral_cor cor_bg">Fazer cotação</a>
                @endif
            </div>
        </div>
    </div>

    <div class="bloco">
        @ if( $loja_favorita->lista ):
        <header class="titulo_geral">
            <h1>LOJAS FAVORITAS</h1>
            <a class="cor_color" href="@route(loja.index)?favorito=sim">Ver mais</a>
        </header>
        @php
            $lista = $loja_favorita;
        @end
        @view site/geral/parceiro.view
        @ else:
        <div class="bloco_geral_sem_resultado bloco_favorito_zero">
            <i>@iconeFavoritoMarcado(60)</i>
            <p>Você ainda não tem lojas favoritas, que tal aprender como salvar sua lojas favoritas?</p>
            <div class="botao botao_geral_cor cor_bg" id="botao_favorito_tutorial">Salvar lojas favoritas</div>
        </div>
        @ endif;
    </div>

    <div class="bloco">
        <header class="titulo_geral">
            <h1>MAIS UTILIZADAS</h1>
        </header>
        @php
            $lista = $loja_nova;
        @end
        @view site/geral/parceiro.view
    </div>
    <div class="bloco">
        <header class="titulo_geral">
            <h1>NOVAS LOJAS</h1>
            <a class="cor_color" href="@route('loja.index')?ordem=mais-novo">Veja mais</a>
        </header>
        @php
            $lista = $loja_nova;
        @end
        @view site/geral/parceiro.view
    </div>
</div>
