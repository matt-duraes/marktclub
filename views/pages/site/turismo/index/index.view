@template "site"

<div id="bloco_turismo">
    @view site/geral/banner.view

    <div class="bloco_chamada">
        <h1>Turismo com descontos especiais</h1>
        <p>Agora você tem desconto no maior portal de turismo do Brasil</p>
        @if(TIPO_USUARIO != 'indicado'):
        <a href="@route('turismo.redirecionar')" target="_blank" rel="noopener noreferrer" class="botao_geral_cor cor_bg">ACESSAR SITE</a>
        @else:
        <div class="bloco_atencao_geral">
            <p>Apenas associados possuem acesso a esse recurso</p>
        </div>
        @endif
    </div>

    <aside class="bloco_campanha" id="bloco_campanha">
        <header>
            <h1>Promoções especiais</h1>
        </header>
        <div class="conteudo">
            @laco(3)
            <article class="parceiro_esqueleto">
                <figure class="esqueleto"></figure>
                <header>
                    <h1 class="esqueleto"></h1>
                    <p class="esqueleto"></p>
                </header>
            </article>
            @endlaco
        </div>
    </aside>

    @view site/geral/relacionado.view
</div>
