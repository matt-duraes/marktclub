
<!-- CONTADOR -->
<section class="bloco_contador" id="bloco_contador">
    <figure style="background: url('https://clube.marktclub.com.br/images/login/bg_contador.jpg') no-repeat center center" class="imagem"></figure>
    <div class="bg"></div>

    <h1>O Maior Clube de Vantagens da América Latina</h1>

    <div class="bloco" id="bloco_contador_numero">
        <div class="item">
            <span>Mais de</span>
            <p class="loja contar" data_target=20000>0</p>
            <span>lojas</span>
        </div>
        <div class="item">
            <p class="parceria contar " data_target=1400>0</p>
            <span>parcerias</span>
        </div>
    </div>

    <h2>Nenhum outro oferece tantas opções</h2>
    @ if( !empty(LINK_CADASTRO) ):
    <a href="{!!LINK_CADASTRO!!}" target="_blank" rel="noopener" rel="noreferrer">Faça parte</a>
    @ endif;

    @if (CLUBE_FINALIDADE == 100) :
        @if (CLUBE_ID == '2dbd9e375eeabfbe859365dae0798f49') :
            <a href="#" rel="noopener" rel="noreferrer">Inscreva-se</a>
        @else:
            <a href="" target="_blank" rel="noopener" rel="noreferrer">Seja Cliente</a>
        @endif;
    @elseif (CLUBE_FINALIDADE == 101) :
        @if (CLUBE_ID == 'b45839ad9fe077f22c6f10e32c5dbe88') :
            <h3>Ainda não é sóci@?</h3>
            <a href="#" target="_blank" rel="noopener" rel="noreferrer">
                Associe-se agora
            </a>
        @else:
            <a href="#" target="_blank" rel="noopener" rel="noreferrer">
                Filiar agora
            </a>
        @endif;
    @endif;
</section>


<div class="span_mobile">
    <span>Nenhum outro oferece<br> tantas opções </span>
</div>
@if (CLUBE_ID == 'b45839ad9fe077f22c6f10e32c5dbe88') :
    <h3 id="titulo_link-cadastro">Ainda não é sóci@?</h3>
    <section class="a_mobile">
        <a href="#" target="_blank" rel="noopener" rel="noreferrer">Associe-se agora</a>
    </section>
@elseif (CLUBE_ID == '2dbd9e375eeabfbe859365dae0798f49') :
    <section class="a_mobile">
        <a href="#" rel="noopener" rel="noreferrer">Seja Cliente</a>
    </section>
@else:
    <section class="a_mobile">
        <a href="#" target="_blank" rel="noopener" rel="noreferrer">Faça
            parte</a>
    </section>
@endif

<hr noshade>
