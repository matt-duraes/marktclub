
@if ($temMais) :
    <section class="bloco_categoria" id="bloco_categoria">
        <div class="icone">
            @php
                $primeiro =  true;
            @end
            @foreach ($temMais as $r) :
                <i class="{{$primeiro ? 'cor_bg hover' : ''}}" data-id="{{ $r['id']}}">
                    <span>{!!$r['icone']!!}</span>
                </i>
                @php
                    $primeiro =  false;
                @end
            @endforeach;

        </div>

        <div class="conteudo">
            @php
                $primeiro =  true;
            @end
            @foreach ($temMais as $r) :

                <article class="cartao {{$primeiro ? 'categoria_atual' : '' }}" id="{{$r['id']}}">
                    <i>
                        <span>{!!$r['icone']!!}</span>
                    </i>
                    <div class="item">
                        <header>
                            <h1>
                                {{$r['titulo']}}
                            </h1>
                            <p>
                                {!!$r['texto']!!}
                            </p>
                        </header>

                        <div class="parceiro">
                            @foreach ($r['parceiro'] as $parceiro) :
                                <div class="imagem">
                                    <figure style="background-image: url({{$parceiro->imagem}})"></figure>
                                </div>
                            @endforeach;
                        </div>

                        <footer>
                            <h2>
                                {!!$r['desconto']!!}
                            </h2>
                            @if (array_key_exists('observacao', $r)) :
                                <p>
                                    {{$r['observacao']}}
                                </p>
                            @endif;
                        </footer>
                    </div>
                </article>
            @php
                $primeiro =  false;
            @end
            @endforeach;

        </div>
    </section>
@endif;

