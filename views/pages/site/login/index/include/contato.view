<section class="meu_parceiro">
    <div class="item">
        <img class="parceiro_mobile" src="{!!LINK_PADRAO!!}/images/login/parceiroNovo.png" height="70" alt="logo meu parceiro">
        <a target="_blank" href="https://meuparceiro.com.br" class="botao_saiba">
            Saiba mais
        </a>
    </div>
    <div class="item">
        <h1 class="h1_mobile">Ainda não é <br> nosso parceiro?</h1>
        <h2 class="beneficio_mobile">Aumente seu faturamento <br> sem pagar nada!</h2>
    </div>

</section>
<section class="duvida">
    <a data-href="@route('index.popup_formulario_contato')" class="abrirModalContato">Alguma dúvida ?</a>
</section>

<section class="mostra_mobile formulario_mobile">
    <h1>Entre em contato </h1>
    <form action="@route('post.index.contato')" class="form_geral" method="post">
        <input type="hidden" name="hash" value="uuid()">
        <input type="hidden" name="validacao" value="{{ uuid() }}">
        @? formInput(name: 'nome', placeholder: 'Qual seu nome?', label: 'Qual seu nome?', value: '')
        @? formEmail(name: 'email', placeholder: 'Qual seu email?', label: 'Qual seu email?', value: '')
        @? formTelefone(name: 'telefone', label: 'Qual seu telefone?', placeholder: 'Qual seu telefone?', value: '')
        @? formTextarea(name: 'mensagem', label: 'Digite uma breve mensagem', placeholder: 'Digite uma breve mensagem')
        <button class="cor_bg botao_enviar" id="indicar_parceiro">Enviar</button>
    </form>
</section>
