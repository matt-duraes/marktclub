
<div class="bloco_banner">
    @ if($banner_quantidade == 0):
    <div class="lista banner_loading" id="bloco_banner">
        <div class="esqueleto"></div>
    </div>
    @ else:
    <div class="lista banner_{{$banner_quantidade}}" id="bloco_banner">
        @foreach( $banner_lista as $imagem ):
        <figure data-bgimagem="@imagem $imagem"></figure>
        @endforeach;
    </div>
    @endif;
</div>
