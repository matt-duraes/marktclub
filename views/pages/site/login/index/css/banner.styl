#bloco_login .bloco_banner
    width: 100%
    padding: 150px 0 50px 0
    position: relative
    margin-bottom: 50px
    justifyCenter()
    .bg
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        z-index: 1
        opacity: 0.5
        background-color: #F6F6F6
    .degrade
        width: 100%
        height: 70%
        position: absolute
        bottom: 0
        left: 0
        z-index: 2
        background-image: linear-gradient(rgba(246, 246, 246, 0), rgba(246, 246, 246, 1))
    .lista
        width: calc(100% - 40px)
        max-width: 1300px
        position: relative
        display: grid
        grid-template-columns: 640px 20px 640px
        grid-template-rows: 310px 20px 310px
        z-index: 3
        overflow: hidden
    .lista figure
        border-radius: 15px
        overflow: hidden
        background-position: center center
        background-size: cover
        overflow: hidden
    .lista figure:nth-child(1)
        grid-column-start: 1
        grid-column-end: 1
        grid-row-start: 1
        grid-row-end: 4
    .lista figure:nth-child(2)
        grid-column-start: 3
        grid-column-end: 3
        grid-row-start: 1
        grid-row-end: 1
    .lista figure:nth-child(3)
        grid-column-start: 3
        grid-column-end: 3
        grid-row-start: 3
        grid-row-end: 3
        grid-row-end: -1
    .lista .banner_01:nth-of-type(1)
        grid-column-start: 1
        grid-column-end: -1
        grid-row-start: 1
        grid-row-end: -1

#bloco_login #banner_secundario
    width: 100%
    justifyCenter()
    .imagem
        width: calc(100% - 40px)
        position: relative
        border-radius: 20px
        overflow: hidden
        z-index: 2
    .imagem figure
        height: 100%
        background-size: cover
        background-repeat: no-repeat
        background-position: center center
    .imagem img
        width: 100%
        visibility:hidden



@media screen and (max-width: 700px)
    #bloco_login #banner_secundario
        display: none
    #bloco_login .bloco_banner
        margin-bottom: 10px
    #banner_mobile
        display: flex
        margin-bottom: 30px
        figure
            height: 100%
            background-size: contain
            background-repeat: no-repeat
            background-position: 100% 100%
            img
                width: 100%
                opacity: 0


@media screen and (max-width: 1340px)
    #bloco_login .bloco_banner .lista
        max-width: 1000px
        grid-template-columns: 490px 20px 490px
        grid-template-rows: 230px 20px 230px

@media screen and (max-width: 1040px)
    #bloco_login .bloco_banner
        display: none
