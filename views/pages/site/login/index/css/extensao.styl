#bloco_login .bloco_extensao
    width: 100%
    display: flex
    flex-direction: column
    justify-content: center
    align-items: center
    margin: 40px 0
    padding: 80px 0
    background-color: white
    .box_quebra_cabeca
        width: calc(100% - 40px)
        max-width: 700px
        display: flex
        align-items: center
        justify-content: space-between
    .box_quebra_cabeca figure
        width: 150px
        height: 150px
        mask-repeat: no-repeat
        -webkit-mask-repeat: no-repeat
        mask-size: contain
        -webkit-mask-size: contain
    .box_quebra_cabeca .texto_quebra_cabeca
        max-width: 480px
        text-align: center
        display: flex
        align-items: center
        flex-direction: column
        font-size: 1.5rem
        line-height: 1.5em
    .box_quebra_cabeca .texto_quebra_cabeca p
        color: #333
        font-size: 2.1rem
    .box_quebra_cabeca .botao_quebra_cabeca
        width: 250px
        flexCenter()
        border-radius: 25px
        color: white
        margin-top: 15px
        padding: 0 40px
        height: 50px
        font-size: 1.8rem

.span_baixar
    margin-top: 7px
    font-size: 1.5em
.escanei
    display: flex
    align-items: center
    flex-direction: column
    figure .celularmobile
        margin: 30px
        width: 245px
        display: flex

@media screen and (max-width: 700px)
    #bloco_login .bloco_extensao
        display: none
