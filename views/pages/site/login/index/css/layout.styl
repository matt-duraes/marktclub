@template "login"
@system "Form"
@system "Alerta"
@system "Loading"
@import "banner"
@import "contador"
@import "calculadora"
@import "cashback"
@import "extensao"
@import "categoria"
@import "app"
@import "contato"
@resource "site/popup"

#conteudo_principal
    width: 100%
    alignItemCenter()
    directionColumn()

#carrousel,
.span_mobile,
.a_mobile
    display: none

#bloco_login
    width: 100%
    min-height: 100vh
    flexCenter()
    directionColumn()
    padding-top: 20px
    form
        width: 100%
        max-width: 500px
        blocoShadow()
        flexCol()
    form > h1
        width: 100%
        titulo()
        font-weight: bold
    form > p
        width: 100%
        texto()
        margin-bottom: 15px
    form .botao
        height: 50px
        line-height: 50px
        background-color: #CCC
        color: #333
        border-radius: 5px
        margin-top: 15px
        text-align: center
        textoFontSize()
        cursor: pointer
    .duvida
        width: 100%
        display: flex
        align-items: center
        justify-content: center
        padding: 60px 0
        a
            border-radius: 6px
            color: #fff
            width: 300px
            height: 60px
            line-height: 60px
            border: 1px solid #fff
            font-size: 2rem
            text-align: center
            cursor: pointer

.bloco_copyright
    display: flex
    width: 100%
    flex-direction: column
    background-color: #f6f6f6
    justify-content: space-evenly
    align-items: center
    border-width: 5px
    border-top-style: solid
    padding: 50px 0px
    .copyright
        margin-bottom: 20px
    .copyright span
        display: flex
        justify-content: center
        font-size: 1.5em
        margin: inherit
        color: #666
    .span_direitos
        display: flex
        text-align: center
        color: #999
        font-size: 1.5em
.icone_footer
    width: 25px
    height: 25px
    mask-repeat: no-repeat
    -webkit-mask-repeat: no-repeat
    mask-size: contain
    -webkit-mask-size: contain
    &.interrogacao
        -webkit-mask-image: url(../images/login/INTERROGACAO.svg)
        mask-image: url(../images/login/INTERROGACAO.svg)
    &.horario
        -webkit-mask-image: url(../images/login/HORARIO.svg)
        mask-image: url(../images/login/HORARIO.svg)
    &.email
        -webkit-mask-image: url(../images/login/EMAIL.svg)
        mask-image: url(../images/login/EMAIL.svg)
    &.whatsapp
        -webkit-mask-image: url(../images/login/WHATSAPP.svg)
        mask-image: url(../images/login/WHATSAPP.svg)
    &.telefone
        -webkit-mask-image: url(../images/login/TELEFONE.svg)
        mask-image: url(../images/login/TELEFONE.svg)

.alguma_duvida
    display: flex
    padding: 20px
    margin-left: 20px

@media screen and (max-width: 1040px)
    #banner_secundario
        margin-top: 150px
@media screen and (max-width: 700px)
    #bloco_login .duvida
        display: none
    #bloco_login .form_formulario label
        width: 100%
        display: flex
        flex-direction: column
        align-items: center
        height: 40px
        border-color: 50px black
        border-radius: 6px


@media screen and (max-width: 700px)
    #bloco_login .botao_enviar
        width: 100px
        color: #fff
        height: 35px
        display: flex
        justify-content: center
        align-items: center
        padding: 3px

.mostra_mobile
    display:none
@media screen and (max-width:700px)
    #bloco_login .formulario_mobile
        display: flex
