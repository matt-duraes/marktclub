        text-align: center
        font-weight: bold
    h2
        font-size: 1em
        line-height: 1.5em
        text-align: center
    span
        font-size: 1em
        line-height: 1.5em
        text-align: center
    p
        text-align: center
        color: #333
        font-size: 2em
        line-height: 1.5em
        margin-top: 20px
        margin-bottom: 35px
    .link_app
        width: 100%
        display: flex
        flex-direction: column
        align-items: center
        text-align: center
        border: 1px solid #EEE
        background-color: white
        padding: 10px
        border-radius: 10px
        color: #333
        font-size: 3em
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        a
            width: 100%
            height: 100%
