            font-size: 24px
    .box_apple
        width: 180px
        height: 55px
        margin-bottom: 10px
        background-color: black
        cursor: pointer
        background: url(../../images/login/apple.png) no-repeat center top
        background-size: cover
        position: relative
    .box_google_link
        width: unset !important
        height: unset !important
    .box_link_app a
        width: unset
        height: unset
        display: block
        position: unset
    .box_google
        width: 180px
        height: 55px
        background-color: black
        cursor: pointer
        background: url(../../images/login/google.png) no-repeat center top
        background-size: cover
        margin-bottom: 25px
        position: relative
