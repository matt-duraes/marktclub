    h1
        font-size: 20px
        font-weight: bold
        text-align: center
        font-size: 2rem
    h2
        font-size: 1.5rem
        text-align: center
        color: #333
        margin-top: 30px
.alguma_duvida
    display: flex
    padding: 20px
    margin-left: 20px
