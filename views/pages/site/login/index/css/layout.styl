@template "login"
@system "Form"
@system "Alerta"
@system "Loading"
@import "banner"
@import "contador"
@import "calculadora"
@import "cashback"
@import "extensao"
@import "categoria"
@import "app"
@import "contato"
@resource "site/popup"

#header_principal
    width: 100%
    max-width: 1300px
    padding: 0 20px
    top: 0
    padding: 40px 20px 0
    display: flex
    flex-direction: row
    align-items: center
    z-index: 3
    position: absolute
    figure
        flex-grow: 1
        flex-basis: 0%
    figure img
        height: 60px
#menu_principal
    display: flex
    flex-direction: row
    align-items: center
    .conteudo
        flexRow()
    .conteudo .botao
        position: relative
        flexCol()
        align-items: center
        cursor: pointer
        padding: 0 12px 10px 12px
    .conteudo .botao i
        height: 30px
        font-size: 3em
        overflow: hidden
        fill: $corClube
    .conteudo .botao p
        textoFontSize()
        color: #666
        margin-top: 5px
    .conteudo .botao .borda
        width: calc(100% - 24px)
        height: 3px
        position: absolute
        bottom: -10px
        left: 12px
        background-color: $corClube
        opacity: 0
        transition: opacity .3s ease-out, bottom .3s ease-out
    .conteudo .botao:hover .borda
        opacity: 1
        bottom: 0
    .botao_mobile
        width: 40px
        height: 40px
        flexCenter()
        fill: #666
        cursor: pointer
        display: none
        position: absolute
        left: 20px
    .entrar
        height: 40px
        line-height: 40px
        padding: 0 25px
        color: #FFF
        background-color: $corClube
        textoFontSize()
        margin-left: 40px
        border-radius: 3px
@media screen and (max-width: 1040px)
    #menu_principal
        width: 100%
        position: fixed
        bottom: 0
        left: 0
        background: #FFF
        padding: 20px 20px 13px 20px
        box-shadow: 0 -4px 5px rgba(0,0,0,.1)
        justify-content: center
        .background
            width: 100%
            height: 100%
            position: fixed
            top: 0
            left: 0
            background: rgba(0,0,0,.7)
            display: none
            z-index: 1000
            opacity: 0
            transition: opacity .3s ease-out
            &.animar
                opacity: 1
            &.aberto
                display: flex
        .conteudo
            width: 100%
            height: 100vh
            max-width: 300px
            background: #FFF
            overflow-y: auto
            box-shadow: 0 5px 5px rgba(0,0,0,.5)
            flexCol()
            margin-left: -100px
            transition: margin-left .3s ease-out, opacity .3s ease-out
            opacity: 0
        .background.animar .conteudo
            margin-left: 0
            opacity: 1
        .conteudo .botao
            border-bottom: 1px solid #DDD
            padding: 20px
        .conteudo .botao .borda
            display: none
        .botao_mobile
            display: flex

#conteudo_principal
    width: 100%
    alignItemCenter()
    directionColumn()

#carrousel,
.span_mobile,
.a_mobile
    display: none

#bloco_login
    width: 100%
    min-height: 100vh
    flexCenter()
    directionColumn()
    form
        width: 100%
        max-width: 500px
        blocoShadow()
        flexCol()
    form > h1
        width: 100%
        titulo()
        font-weight: bold
    form > p
        width: 100%
        texto()
        margin-bottom: 15px
    form .botao
        height: 50px
        line-height: 50px
        background-color: #CCC
        color: #333
        border-radius: 5px
        margin-top: 15px
        text-align: center
        textoFontSize()
        cursor: pointer
    .duvida
        width: 100%
        display: flex
        align-items: center
        justify-content: center
        padding: 60px 0
        a
            border-radius: 6px
            color: #fff
            width: 300px
            height: 60px
            line-height: 60px
            border: 1px solid #fff
            font-size: 2rem
            text-align: center
            cursor: pointer

.bloco_copyright
    display: flex
    width: 100%
    flex-direction: column
    background-color: #f6f6f6
    justify-content: space-evenly
    align-items: center
    border-width: 5px
    border-top-style: solid
    padding: 50px 0px
    .copyright
        margin-bottom: 20px
    .copyright span
        display: flex
        justify-content: center
        font-size: 1.5em
        margin: inherit
        color: #666
    .span_direitos
        display: flex
        text-align: center
        color: #999
        font-size: 1.5em
.icone_footer
    width: 25px
    height: 25px
    mask-repeat: no-repeat
    -webkit-mask-repeat: no-repeat
    mask-size: contain
    -webkit-mask-size: contain
.alguma_duvida
    display: flex
    padding: 20px
    margin-left: 20px

@media screen and (max-width: 1040px)
    #banner_secundario
        margin-top: 150px
@media screen and (max-width: 700px)
    #bloco_login .duvida
        display: none
    #bloco_login .form_formulario label
        width: 100%
        display: flex
        flex-direction: column
        align-items: center
        height: 40px
        border-color: 50px black
        border-radius: 6px


@media screen and (max-width: 700px)
    #bloco_login .botao_enviar
        width: 100px
        color: #fff
        height: 35px
        display: flex
        justify-content: center
        align-items: center
        padding: 3px

.mostra_mobile
    display:none
@media screen and (max-width:700px)
    #bloco_login .formulario_mobile
        display: flex
