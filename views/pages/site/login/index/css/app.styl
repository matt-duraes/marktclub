#bloco_login .app
    width: calc(100% - 40px)
    display: flex
    max-width: 800px
    padding: 60px 0
    justify-content: space-between
    figure
        position: relative
    .qr_code
        position: absolute
        display: flex
        flex-direction: column
        align-items: center
        top: 60px
        left: 0px
        right: 0px
        margin: 0px
        justify-content: space-around
    .img_celular_app
        width: 130px
        height: 130px
        mask-repeat: no-repeat
        -webkit-mask-repeat: no-repeat
        mask-size: contain
        -webkit-mask-size: contain
        mask-position: center
        -webkit-mask-position: center
    .qr_code img
        margin-top: 50px
    .qr_code h1
        margin-top: 25px
        font-weight: bold
        font-size: 1.5rem
        color: #333

#bloco_login .app .bloco_esquerdo
    width: 280px
    justify-content: center
    flex-direction: column
    display: flex
    align-items: center
    h1
        font-size: 2rem
        text-align: center
        font-weight: bold
    h2
        font-size: 1em
        line-height: 1.5em
        text-align: center
    span
        font-size: 1em
        line-height: 1.5em
        text-align: center
    p
        text-align: center
        color: #333
        font-size: 2em
        line-height: 1.5em
        margin-top: 20px
        margin-bottom: 35px
    .link_app
        width: 100%
        display: flex
        flex-direction: column
        align-items: center
        text-align: center
        border: 1px solid #EEE
        background-color: white
        padding: 10px
        border-radius: 10px
        color: #333
        font-size: 3em
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        a
            width: 100%
            height: 100%
            display: none
            position: absolute
            top: 0px
            right: 0px
            left: 0px
            bottom: 0px
    .plataforma
        margin: 25px
        font-size: 20px
        color: #333
    .mobileicon
        margin-right: 10px
        width: 25px
    .mobiletexto
        margin-left: 10px
        span
            font-size: 10px
        h3
            font-size: 20px
        h2
            font-size: 24px
    .box_apple
        width: 180px
        height: 55px
        margin-bottom: 10px
        background-color: black
        cursor: pointer
        background: url(../../images/login/apple.png) no-repeat center top
        background-size: cover
        position: relative
    .box_google_link
        width: unset !important
        height: unset !important
    .box_link_app a
        width: unset
        height: unset
        display: block
        position: unset
    .box_google
        width: 180px
        height: 55px
        background-color: black
        cursor: pointer
        background: url(../../images/login/google.png) no-repeat center top
        background-size: cover
        margin-bottom: 25px
        position: relative

@media screen and (max-width: 700px)
    #bloco_login .app
        flex-direction: column
        align-items: center
        justify-content: center
    #bloco_login .app figure
        display: none
    #bloco_login .app .bloco_esquerdo .link_app
        .box_apple
        .box_google
            cursor: pointer
        a
            display: block
    #bloco_login .baixe_app
        position: relative
        padding: 0px 0px 30px
    #bloco_login .app_mobile
        position: relative
        margin-bottom: 10px
    #bloco_login .item_mobile
        display: flex
        flex-direction: column
        justify-content: flex-end
    #bloco_login .faturamento_mobile
        order: 3
    #bloco_login .parceiro_mobile
        width: max(50%,200px)
        height: unset
