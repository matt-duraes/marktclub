@template "login"
<div id="bloco_login">

    @view site/login/index/include/banner.view
    @view site/login/index/include/categoria.view
    @view site/login/index/include/contador.view
    @view site/login/index/include/calculadora.view


    @ if(MENU_CASHBACK):
        @view site/login/index/include/cashback.view
    @ endif;

    @ if( DISPOSITIVO_CRHOME ):
    @view site/login/index/include/extensao.view
    @ endif;

    @ if( MENU_BAIXAR_APP ):
    @view site/login/index/include/app.view
    @ endif;

    @ if( MENU_MEU_PARCEIRO ):
    @view site/login/index/include/contato.view
    @ endif;
</div>
