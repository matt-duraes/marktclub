@template "login"

<div id="bloco_login">
    <form action="" class="form_geral">
        <h1>LOGIN</h1>
        <p>Digite seu login e senha para continuar.</p>

        @? formCpf(name: 'login', placeholder: 'Digite seu CPF')
        @? formSenha(name: 'senha', placeholder: 'Digite sua senha')
        <div class="botao" id="botao_fazer_login">FAZER LOGIN</div>
    </form>
</div>
