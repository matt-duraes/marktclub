@system "Resetar"

html
    font-size: 62.5%
body
    width: 100%
    min-height: 100vh
    background-color: #F6F6F6
    font-family: Arial, Helvetica, sans-serif
.display_none
    display: none !important
.voltar
    width: 100%
    display: flex
    justify-content: center
    margin-top: 30px
    a
        background-color: #ffd700
        font-size: 1.4rem
        padding: 20px 40px
        border-radius: 5px
#site
    width: 100%
    display: flex
    justify-content: center
    align-items: flex-start
form
    width: 100%
    max-width: 500px
    margin: 40px 0
    background-color: #FFF
    box-shadow: 0 5px 5px rgba(0,0,0,.1)
    border-radius: 20px
    padding: 20px
    display: flex
    flex-direction: column
    align-items: flex-end
form .erro
    width: 100%
    min-height: 1.5em
    line-height: 1.5em
    font-size: 1.4rem
    margin-bottom: 10px
    color: red
form input
    width: 100%
    height: 50px
    line-height: 50px
    padding: 0 10px
    border-radius: 4px
    font-size: 1.5rem
    border: 1px solid #DDD
    margin-bottom: 20px
form .botao
    height: 40px
    line-height: 40px
    background-color: #ffd700
    padding: 0 25px
    border-radius: 5px
    font-size: 1.5rem
    cursor: pointer
