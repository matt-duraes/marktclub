<!DOCTYPE HTML>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">

    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    @ if( !empty(CLUBE_FAVICON) ):
        <link rel="icon" href="{!!CLUBE_FAVICON!!}" type="image/png">
    @endif
    <title>APP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    @CSS

</head>
<body>
<div id="site">
    <figure><img src="{!!CLUBE_LOGO_PRINCIPAL!!}" alt="{{TITULO}}"></figure>
    @ if( !empty(LINK_APP_IOS) && !empty(LINK_APP_ANDROID)):
    <h1 class="plataforma"> Selecione abaixo a plataforma desejada:</h1>
    @ endif;
    <div class="lista">
        @ if( !empty(LINK_APP_IOS) ):
        <div class="bloco">
            <a href="{!!LINK_APP_IOS!!}" target="_blank" rel="noopener noreferrer"><img src="{!!LINK!!}/images/login/apple.png" height="40" alt="Download APP IOS"></a>
            <p>ou leia o QR Code abaixo</p>
            <img src="https://qrcode.youhuul.com/link?link={!!LINK_APP_IOS!!}" height="120" alt="QR Code para download">
        </div>
        @ endif;
        @ if( !empty(LINK_APP_ANDROID) ):
        <div class="bloco">
            <a href="{!!LINK_APP_ANDROID!!}" target="_blank" rel="noopener noreferrer"><img src="{!!LINK!!}/images/login/google.png" height="40" alt="Download APP Android"></a>
            <p>ou leia o QR Code abaixo</p>
            <img src="https://qrcode.youhuul.com/link?link={!!LINK_APP_ANDROID!!}" height="120" alt="QR Code para download">
        </div>
        @ endif;
    </div>
</div>
</body>
</html>
