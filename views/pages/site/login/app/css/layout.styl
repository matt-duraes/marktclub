@system "Resetar"

*::-webkit-scrollbar
    width: 10px

*::-webkit-scrollbar-track
    background: transparent

*::-webkit-scrollbar-thumb
    background: transparent
    border-radius: 15px
    height: 150px

*:hover::-webkit-scrollbar-thumb
    background: #cfcfcf

body
    background: #F6F6F6
    font-family: 'Inter', sans-serif
    color: #495057

#site
    width: 100%
    padding: 40px 20px
    display: flex
    flex-direction: column
    align-items: center
    h1
        font-size: 2rem
        color: #666
        margin: 80px 0 20px
        text-align: center
    .lista
        width: 100%
        display: flex
        flex-direction: row
        justify-content: center
        align-items: center
    a
        margin: 0 10px
@media screen and (max-width: 700px)
    #site .lista
        flex-direction: column
        a
            margin: 10px 0
