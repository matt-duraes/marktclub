<form id="bloco_form_buscar" class="bloco_form_login form_geral" action="/" method="post">
    @hash(ATIVAR_BUSCAR_USUARIO)
    <div class="conteudo" >
        <header>
            <div class="bloco">
                <h1>BUSCAR CONTA</h1>
            </div>
            <p>Preencha os campos abaixo para buscar sua conta</p>
        </header>
        <i class="fechar pagina_fechar">@iconeFechar</i>
        <div class="bloco_escolha_usuario">
            <h1>Selecione o tipo de usuário:</h1>
            <div class="bloco_tipo_usuario">
                @ if( !API ):
                <div class="botao_tipo_usuario botao_titular" data-tipo="titular">
                    Titular
                </div>
                @ endif;

                @if(MENU_DEPENDENTE):
                <div class="botao_tipo_usuario botao_dependente" data-tipo="dependente">
                    Dependente
                </div>
                @endif;

                @if(MENU_INDICAR_USUARIO):
                <div class="botao_tipo_usuario botao_indicado" data-tipo="indicado">
                    Indicado
                </div>
                @endif;
            </div>
        </div>

        <div class="atencao bloco_atencao_geral display_none aviso_cadastro">
            <p>
                Por favor, verifique se o titular já realizou o seu cadastro no clube de vantagens.
            </p>
        </div>
        <div class="bloco_titular display_none" data-ativacao="{{ATIVACAO_TIPO ? ATIVACAO_TIPO : ''}}">
            <h1>Insira o dado solicitado:</h1>
            @if (ATIVACAO_TIPO === 'ciesc'):
            @? formSelect(name: 'local_trabalho', label: 'Local de trabalho/Lotação', placeholder: 'Local de trabalho/Lotação', lista: (new \App\Classes\Usuario\Ativar\Ciesc\LocalTrabalho())->select('Escolha seu local de trabalho ou lotação'), class: 'bloco_ciesc display_none')
            @endif;
            @? formCpf(name: 'buscar_cpf', label: 'Buscar', placeholder: 'Digite seu CPF');
            <div>
                @? formInput(name: 'buscar', label: 'Buscar', placeholder: 'Insira seus dados');
            </div>
            @if (ATIVACAO_TIPO === 'codigo'):
            @? formInput(name: 'codigo', label: 'Código de acesso', placeholder: 'Digite seu código de acesso')
            @endif;

            @if (ATIVACAO_TIPO === 'ciesc'):
            <div class="termo bloco_ciesc display_none">
                @?formCheckbox(name: 'termo_ativar_buscar', label: 'Aceito buscar meus dados pessoais para continuar com o primeiro acesso. Fique tranquilo, seus dados só serão salvos com sua permissão na próxima tela.')
            </div>
            @endif;
        </div>
        <div class="bloco_recaptcha display_none" id="bloco_captcha_ativar"></div>
    </div>
        <div class="bloco_botao">
            <div class="botao" id="botao_buscar_usuario">Buscar</div>
        </div>
    </div>

</div>
