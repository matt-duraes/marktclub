<section class="bloco_calculadora">
    <div class="bg" style="background-color: url({!!LINK_PADRAO!!}/images/login/bg_cashback.png) no-repeat center top"></div>
    <div class="container">
        <div class="topo">

            <figure class="img_calculadora cor_bg"
            style="mask-image: url({!!LINK_PADRAO!!}/images/login/calculadora.svg);
            -webkit-mask-image: url({!!LINK_PADRAO!!}/images/login/calculadora.svg)"></figure>
            <div class="texto">
                <h2 class="cor_color">Economia Familiar</h2>
                <p>Saiba quanto você pode economizar em média ao ano com nossos descontos</p>
            </div>
        </div>
        <div class="conteudo esconde">
            <h2>
                <span>Digite o valor médio ao ano</span> entre as categorias listadas abaixo e para calcular o desconto
            </h2>
            <form action="@route('post.index.calculadora')" method="post" id="calculadora">
                <fieldset class="campos">
                    <label for="">Academia</label>
                    <input type="text" name="academia" id="academia" data-mascara="dinheiro" inputmode="numeric" placeholder="R$ 0,00">
                </fieldset>
                <fieldset class="campos">
                    <label for="">Escola/Creche</label>
                    <input type="text" name="escola_creche" id="escola_creche" data-mascara="dinheiro" inputmode="numeric" placeholder="R$ 0,00">
                </fieldset>
                <fieldset class="campos">
                    <label for="">Farmácia</label>
                    <input type="text" name="farmacia" id="farmacia" data-mascara="dinheiro" inputmode="numeric" placeholder="R$ 0,00">
                </fieldset>
                <fieldset class="campos">
                    <label for="">Eletroeletrônico</label>
                    <input type="text" name="eletroeletronico" id="eletroeletronico" data-mascara="dinheiro" inputmode="numeric" placeholder="R$ 0,00">
                </fieldset>
                <fieldset class="campos">
                    <label for="">Idiomas</label>
                    <input type="text" name="idioma" id="idioma" data-mascara="dinheiro" inputmode="numeric" placeholder="R$ 0,00">
                </fieldset>
                <fieldset class="campos">
                    <label for="">Restaurante</label>
                    <input type="text" name="restaurante" id="restaurante" data-mascara="dinheiro" inputmode="numeric" placeholder="R$ 0,00">
                </fieldset>

                <button id="calcular">Calcular</button>
            </form>
        </div>
        <div id="fechar" class="fechar cor_bg esconde">
            <p>Fechar</p>
        </div>
    </div>
    <button id="abrir" class="cor_bg">
        Abrir
    </button>
</section>
