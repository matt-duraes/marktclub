@system "Resetar"

$corClube = var(--cor-clube)

body
    font-family: 'Inter', sans-serif
    background-color: #F6F6F6
    color: #333

#site
    width: 100%
    border-top: 10px solid $corClube
    display: flex
    flex-direction: column
    align-items: center
    figure
        margin: 80px 0
    h1
        width: 100%
        text-align: center
        font-size: 2.4rem
        color: $corClube
        font-weight: bold
    p
        width: 100%
        max-width: 500px
        line-height: 1.5
        text-align: center
        font-size: 1.8rem
        margin: 10px 0 40px
    .bloco_app
        display: flex
        flex-direction: row
    .bloco_app a
        min-width: 220px
        background-color: #212529
        border-radius: 5px
        margin: 0 10px
        text-align: center
        overflow: hidden
