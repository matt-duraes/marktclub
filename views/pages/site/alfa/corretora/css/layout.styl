@system "Form"
@template "site"
@resource "site/variavel"
@resource "site/banner"
@system "Alerta"
@system "Loading"
@system "Pagina"

#bloco_corretora_alfa
    flexCenter()
    flexCol()
    max-width: 1130px

#bloco_corretora_alfa .chamada
    width: 100%
    flexCenter()
    espacoTopPadrao()
    h1
        width: 100%
        max-width: 500px
        titulo()
        color: #333
        espacoBottomPadrao()
        text-align: center
        span.alfa
            font-weight: bold
            color: #000
    p, li, a
        titulo()

#bloco_corretora_alfa .conteudo
    width: 100%
    display: flex
    justify-content: space-between
    flex-direction: column
    .direito .paragrafo
        display: flex
        align-items: flex-start
        flex-direction: column
        espacoBottomPadrao()
        margin-left: 10px
    .direito .paragrafo h1
        subTitulo()
        color: #333
        span.alfa
            font-weight: bold
            color: #000
    .direito .paragrafo p
        textoTelaPequena()
        line-height: 1.2em
        color: #333
        span
            font-weight: bold
            color: #000
    .direito .paragrafo .lista
        display: flex
        align-items: flex-start
        justify-content: flex-start
        flex-direction: column
    .direito .paragrafo .lista li
        display: flex
        align-items: flex-start
        justify-content: flex-start
        flex-direction: column
        FontSizeTelaPequena()
        espacoBottomPadrao()
        color: #333
    .direito .paragrafo .lista li img
        margin-right: 10px
    .obs
        margin-left: 10px
        margin-bottom: 5px
        font-size: 1em
        line-height: 1.2em
        text-align: left
    .vantagens
        width: 100%
        height: 200px
        display: flex
        border: 1px solid #E8E8E8
        espacoBottomPadrao()
        @media screen and (max-width:800px)
            height: auto
        header
            height: 100%
            width: 50%
            flexCenter()
            flex-direction: column
            text-align: center
            color: #fff
            background: #fff
            margin: 0
            border-right: 1px solid #E8E8E8
            h1,
            p
                color: $corClube
            h1
                titulo()
            p
                subTitulo()
            @media screen and (max-width:800px)
                width: 100%
                height: auto

        section.lista_vantagens
            height: 100%
            width: 50%
            display: flex
            align-items: center
            justify-content: flex-start
            flex-wrap: wrap
            background-color: #fff
            borda-padrao()
            @media screen and (max-width:800px)
                width: 100%
            p
                width: 100%
                height: calc(100% / 3)
                display: flex
                align-items: center
                justify-content: flex-start
                padding-left: 5%
                padding-right: 5%
                text-align: left
                textoTelaPequena()
                border-bottom: 1px solid #eee
                @media screen and (max-width:800px)
                    height: 60px
                &:last-child
                    border: none
                i
                    flexCenter()
                    width: 40px
                    margin-right: 10px
                    font-size: 1.5em
                    &:after
                        width: auto


@media screen and (max-width: 950px)
    #bloco_corretora_alfa .conteudo
        flex-direction: column
    #bloco_corretora_alfa .conteudo .esquerdo
        display: flex
        align-items: flex-start
        justify-content: center
    #bloco_corretora_alfa .conteudo .direito
        spaceBetween()
    #bloco_corretora_alfa .conteudo .direito .paragrafo
        width: 100%

@media screen and (max-width: 600px)
    #bloco_corretora_alfa .conteudo .direito
        flex-direction: column
    #bloco_corretora_alfa .conteudo .direito
        align-items: flex-end

#bloco_corretora_alfa .conteudo.cobertura
    flex-direction: column
    margin-top: 40px
    h1
        subTituloMaiusculo()
    p
        subTitulo()
        border-bottom: 1px solid #000
    .lista_cobertura
        width: 100%
        display: flex
        padding-left: 20px
        espacoTopPadrao()
    .lista_cobertura article
        width: 100%
    .esquerdo .paragrafo
    .direito .paragrafo
        display: flex
        align-items: flex-start
        flex-direction: column
    .esquerdo .paragrafo .lista
    .direito .paragrafo .lista
        list-style-type: disc !important
    .esquerdo .paragrafo .lista li
    .direito .paragrafo .lista li
        display: list-item
        texto()
        margin-bottom: 10px
        margin-right: 10px
        color: #333
        span
            texto()
            font-weight: bold
            color: #000

@media screen and (max-width: 600px)
    #bloco_corretora_alfa .conteudo.cobertura .lista_cobertura
        flex-direction: column


#bloco_corretora_alfa .acessar_corretora
    width: 100%
    flexCenter()
    flex-direction: column
    espacamentoPadrao()
    a
        padding: 10px 20px
        font-size: 1.5em
        line-height: 1.5em
        color: #FFF
        border-radius: 20px
        background-color: $corClube
    .titulo_corretora
        width: 100%
        flexCenter()
        flex-direction: column
    .titulo_corretora h1
        max-width: 250px
        font-size: 2em
        line-height: 1.5em
        color: #333
        span
            font-size: 1em
            font-weight: bold
            color: #333
    .titulo_corretora p
        max-width: 500px
        color: #333
        font-size: 2em
        line-height: 1.5em
        text-align: center
    .container_acessa.consultoria
        espacamentoPadrao()

.banner_consultoria
    espacamentoPadrao()
