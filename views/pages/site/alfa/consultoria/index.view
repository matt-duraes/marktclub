@template "site"

<div id="bloco_consultoria_alfa">
    @view site/geral/banner.view

    <div class="bloco_titulo_texto_centralizado bloco_tipo">
        <h1>O que você procura?</h1>

        <p><span>Planejamento Financeiro</span>: educação financeira; organização pessoal; plano para quitar dívidas.</p>
        <p><span>Consultoria de Investimentos</span>: raio X do seu patrimônio financeiro; <br> alocação na estratégia de investimento B2; acompanhamento profissional.</p>

        <div class="bloco_botao_tipo" id="bloco_botao_tipo">
            <div class="botao_input">
                <input id="planejamento" name="tipo" type="radio" value="planejamento">
                <label for="planejamento">Planejamento Financeiro</label>
            </div>
            <div class="botao_input">
                <input id="consultoria" name="tipo" type="radio" value="consultoria">
                <label for="consultoria">Consultoria de Investimentos</label>
            </div>
        </div>

    </div>

    <div id="bloco_planejamento" class="display_none">
        @view site/alfa/consultoria/geral/planejamento.view
    </div>

    <div id="bloco_consultoria_financeira" class="display_none">
        @view site/alfa/consultoria/geral/consultoria_financeira.view
    </div>


</div>
