<div class="bloco_parceiro">
@ if($parceiro):
    @ foreach( $parceiro as $r ):
    <article class="parceiro" >
        <a class="link_cupom_parceiro" data-id="1" href="@route(loja.detalhe)/parceiro"></a>
        <figure><img src="https://arquivo.marktclub.com.br/parceiro/65c3d3b6716418d6425dfa858214a963.jpg" alt=""></figure>
        <header>
            <h1>Hyper Idiomas</h1>
        </header>
        <p>Desconto de até 10%</p>
        <div class="icone">
            <i class="favorito">@iconeFavorito</i>
        </div>
    </article>
    @ endforeach:
    <div class="fake"></div>
    <div class="fake"></div>
    <div class="fake"></div>
@ endif;
</div>
