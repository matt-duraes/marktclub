@template "site"
@system "Alerta"
@system "Loading"
@system "Banner"
@system "Popup"
@resource "site/item_lista"
@resource "site/pagina_popup"
@resource "site/banner"


#bloco_samsung
    width: 100%
    max-width: $maxWidth
    #banner_fixo
        margin-bottom: 30px
    .atencao
        text-align: center
    .atualizar
        margin: 20px 0
        flexCol()
        align-items: flex-start
    .atualizar .zero
        margin: 10px 0 15px
    .atualizar p span
        texto()
    .atualizar p strong
        texto()
        font-weight: bold
    .atualizar .botao
        botaoPadraoPequeno()
        background-color: $corClube
        color: #FFF
    #bloco_botao_samsung
        display: flex
        align-items: center
        gap: 20px
    .atualizar #bloco_botao_samsung a
        texto()
        justify-content: center
        flex: 1
        color: $corClube
    .bloco_botao
        width: 100%
        flexCol()
        align-items: center
    .bloco_botao a
        botaoPadraoGrande()
        background-color: $corClube
        color: #FFF
        gap: 5px
        flexCenter()

