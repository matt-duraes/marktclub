@template "site"
@system "Alerta"
@system "Loading"
@system "Banner"
@system "Popup"
@resource "site/item_lista"
@resource "site/pagina_popup"
@resource "site/banner"


#bloco_samsung
    width: 100%
    max-width: $maxWidth
    .atencao
        text-align: center
    .atualizar
        margin: 20px 0
        flexCol()
        align-items: flex-start
    .atualizar .zero
        margin: 10px 0 15px
    .atualizar p span
        texto()
    .atualizar p strong
        texto()
        font-weight: bold
    .atualizar .botao
        botaoPadraoPequeno()
        background-color: $corClube
        color: #FFF
        margin-bottom: 10px
    .bloco_botao
        width: 100%
        flexCol()
        align-items: center
    .bloco_botao a
        botaoPadraoDestaque()
        background-color: $corClube
        color: #FFF


@media screen and (max-width: 600px)
    .bloco_geral_banner .imagem.banner_desktop
        display: none
    #botao_banner_proximo_mobile
        width: 40px
        height: 40px
        position: absolute
        fill: #FFF
        border-radius: 50%
        flexCenter()
        background-color: rgba(0,0,0,.7)
        cursor: pointer
        z-index: 2
        opacity: 1
        transition: opacity .3s ease-out
    #botao_banner_anterior_mobile
        width: 40px
        height: 40px
        position: absolute
        fill: #FFF
        border-radius: 50%
        flexCenter()
        background-color: rgba(0,0,0,.7)
        cursor: pointer
        z-index: 2
        opacity: 1
        transition: opacity .3s ease-out
