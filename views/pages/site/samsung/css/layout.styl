@template "site"
@system "Alerta"
@system "Loading"
@system "Banner"
@system "Popup"
@resource "site/item_lista"
@resource "site/pagina_popup"
@resource "site/banner"


#bloco_samsung
    width: 100%
    max-width: $maxWidth
    .atencao
        text-align: center
    .atualizar
        margin: 20px 0
        flexCol()
        align-items: flex-start
    .atualizar .zero
        margin: 10px 0 15px
    .atualizar p span
        texto()
    .atualizar p strong
        texto()
        font-weight: bold
    .atualizar .botao
        botaoPadraoPequeno()
        background-color: $corClube
        color: #FFF
        margin-bottom: 10px
    .bloco_botao
        width: 100%
        flexCol()
        align-items: center
    .bloco_botao a
        botaoPadraoDestaque()
        background-color: $corClube
        color: #FFF

