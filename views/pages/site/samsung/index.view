@template "site"

<div id="bloco_samsung">
    @view site/geral/banner.view

    <div class="bloco_item_lista">
        <div class="scroll">
            <div class="conteudo">
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeUsuarioOutline(25)
                    </div>
                    <p>Verifique seu e-mail cadastrado.</p>
                    <div class="bola">@iconeSetaDireita(20)</div>
                </div>
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeLojaHome()
                    </div>
                    <p>Acesse o site da Samsung pelo botão abaixo.</p>
                    <div class="bola">@iconeSetaDireita(20)</div>
                </div>
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeEmail(18)
                    </div>
                    <p>Digite o mesmo e-mail que está cadastro aqui no site da Samsung.</p>
                    <div class="bola">@iconeSetaDireita(20)</div>
                </div>
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        #123
                    </div>
                    <p>Insira o codigo que recebeu por e-mail no campo informado</p>
                </div>
            </div>
        </div>
    </div>
    <div class="bloco_atencao_geral atencao">
        <p>Desconto já aplicado no site de parceria. Não perca tempo, aproveite e boas compras!</p>
        <p>O e-mail informado no site da Samsung deve ser o mesmo e-mail do seu cadastro.</p>
    </div>
    <div class="atualizar bloco_titulo_texto">
        <div class="bloco_atencao_geral atencao {!! empty($dado->email) ? '' : 'display_none' !!} zero" id="bloco_email_zero">
            <p>Você não tem e-mail cadastrado, cadastre um e-mail antes de continuar.</p>
        </div>

        <p class="{!! empty($dado->email) ? 'display_none' : '' !!}" id="bloco_email_lista">
            Seus e-mails cadastrados são:<br>
            <strong>{!!implode('</strong>/<strong>', $dado->email)!!}</strong>
        </p>
        <div class="botao" id="botao_samsung_atualizar">{!! empty($dado->email) ? 'Atualizar e-mail' : 'Cadastrar e-mail' !!}</div>
    </div>

    <div class="bloco_botao {!! empty($dado->email) ? 'display_none' : '' !!}" id="bloco_botao">
        <a href="" target="_blank" rel="noopener noreferrer" class="botao_acessar">Acessar site</a>
    </div>
</div>

<div class="bloco_pagina_popup display_none" id="bloco_atualizar_email">
    <div class="conteudo_pagina_popup conteudo_popup">
        <header>
            <h1>Atualizar e-mail</h1>
            <p>Atualize seus e-mails para poder usar a parceria</p>
            <i class="popup_fechar fechar">@iconeFechar</i>
        </header>
        <form action="/" method="POST" class="form_geral">
            @? formEmail(name: 'email_pessoal', label: 'E-mail pessoal', placeholder: 'Digite seu e-mail pessoal', value: '')
            @? formEmail(name: 'email_trabalho', label: 'E-mail de trabalho', placeholder: 'Digite seu e-mail de trabalho', value: '')
        </form>
        <div class="footer_pagina_popup">
            <div></div>
            <div class="botao botao_atualizar_email">Atualizar</div>
        </div>
    </div>
</div>
