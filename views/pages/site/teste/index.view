    <hr>

    <div class="row">
        <button class="botao" id="botao_alerta">ALERTA</button>
        <button class="botao" id="botao_mensagem">MENSAGEM</button>
    </div>

    <hr>

    <form action="">
        <input type="text" class="data data_geral" data-mascara="00/00/0000" placeholder="data" inputmode="numeric">
        <input type="text" class="data data_geral" data-mascara="00/00/0000" placeholder="data" inputmode="numeric">
        <input type="text" class="data" data-mascara="00/00/0000" placeholder="data" inputmode="numeric" id="data">
        <input type="text" class="data" data-mascara="00/00/0000" placeholder="data de" inputmode="numeric" id="data_de">
        <input type="text" class="data" data-mascara="00/00/0000" placeholder="data ate" inputmode="numeric" id="data_ate">
        <input type="text" class="data" data-mascara="00/00/0000 00:00:00" placeholder="data e hora" inputmode="numeric" id="data_hora">
        <input type="text" class="data" data-mascara="00/00/0000" placeholder="data minima 01/01/2024" inputmode="numeric" id="data_minima">
        <input type="text" class="data" data-mascara="00/00/0000" placeholder="data maxima 01/01/2024" inputmode="numeric" id="data_maxima">
        <input type="text" class="data" data-mascara="00/00/0000" placeholder="data de 01/12/2024 31/12/2024" inputmode="numeric" id="data_minima_maxima">
    </form>

    <hr>
    <div class="bloco_esqueleto" id="esqueleto">
        <div class="esqueleto"></div>
        <div class="esqueleto"></div>
        <div class="esqueleto"></div>
    </div>

    <hr>

    <form class="form_geral" action="">
        @? formInput(name: 'input', label: 'Input')
        @? formSelect(name: 'select', label: 'Select', lista: ['teste-1' => 'Número 1', 'teste-2' => 'Número 2'])
        @? formCor(name: 'cor', label: 'Cor', padrao: 'Colocar cor padrão')
    </form>

    <script src="https://apis.google.com/js/platform.js" async defer></script>
    <script src="https://apis.google.com/js/api.js"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    @JS
</body>
</html>
