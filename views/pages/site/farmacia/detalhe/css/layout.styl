@system "Form"
@template "site"
@resource "site/variavel"
@system "Form"
@resource "site/loja/parceiro"
@resource "site/loja/detalhe"

h1
    titulo()
    color: $corClube

p, li
    texto()

.conteudo_principal
    max-width: $maxWidth
    header
        espacoBottomPadrao()
        figure
            width: 100%
            height: 250px
            blocoShadow()
            display: flex
            justify-content: flex-start
            align-items: flex-end
            img
                position: relative
                bottom: -45px
                width: 105px
                height: 105px
                border-radius: 50%
                border: 2px solid white
        .conteudo_medicamento
            espacoVerticalPadrao()
            blocoShadow()
            min-height: 210px
            .informacao_medicamento
                height: 40px
                display: flex
                justify-content: flex-start
                align-items: center
                h1
                    width: 50%
                    titulo()
                    position: relative
                    left: -2
                    color: $corClube
                .icones
                    display: flex
                    width: 50%
                    justify-content: flex-end
                    svg
                        margin: 10px
                        cursor: pointer
            .descricao_medicamento
                margin-top: 10px
            a
                espacoTopPadrao()
                width: 250px
                height: 40px
                text-align: center
                border-radius: 5px 
                texto()
                line-height: 40px
                float: right
                margin-right: 5px
    .bloco_regra_medicamento
        display: flex
        min-height: 270px
        .desconto
            margin-right: 10px
            blocoShadow()
            .bloco_titulo_desconto
                height: 40%
            .bloco_fique_atento
                padding-top: 25px
                height: 60%
                span
                    margin-bottom: 15px
                    texto()
                    color: $corClube
                li
                    padding-top: 10px
        .procedimento
            margin-left:10px
            blocoShadow()
            .bloco_titulo_procedimento
                height: 40%
            .bloco_fique_atento
                padding-top: 25px
                height: 60%
                span
                    texto()
                    color: $corClube
                li
                    padding-top: 10px
    .bloco_mais_medicamento
        .titulo
            display: flex
            height: 40px
            align-items: center
            espacoVerticalPadrao()
            h1
                width: 50%
            a   
                texto()
                cursor: pointer
                color: $corClube
                width: 50%
                display: flex
                justify-content: flex-end
        .bloco_parceiro
            width: 100%
            flexRow()
            flex-wrap: wrap
            justify-content: space-between
            espacoTopPadrao()


/*MODAL CARTEIRINHA*/
$tamanho = calc((100vh - 200px)/2)
#bloco_fw_pagina
    .bloco_carteirinha
        width: 400px
        margin-top: $tamanho
        background: rgb(43,86,161)
        background: linear-gradient(90deg, rgba(43,86,161,1) 0%, #2c7caa 35%, #418a99 100%)
        border-radius: 10px
        height: 200px
        .bloco_info
            height: 80%
            display: flex
            align-items: center
            justify-content: center
            figure
                width: 48%
                height: 100%
                background-image: url("../images/site/tem_mais_saude.png")
                background-size: 50%
                background-position: center
                background-repeat: no-repeat
            .borda_meio
                height: 90px
                border: 2px solid #06789a
            .bloco_cpf
                background-image: url("../images/site/bonequinho.png")
                background-size: 50%
                background-position: right
                background-repeat: no-repeat
                height: 100%
                width: 48%
                flexCenter()
                h1
                    color: white
                    texto()
                    font-weight: bold
        .bloco_nome
            text-align: center
            h1
                color: white
                font-weight: bold
                texto()

/*RESPONSIVIDADE*/

@media screen and (max-width: 930px)
    .conteudo_medicamento
        min-height: 250px !important

@media screen and (max-width: 750px)
    .conteudo_medicamento
        min-height: 300px !important
    .bloco_regra_medicamento
        flex-direction: column
        gap: 25px
        .desconto
            margin-right: 0px !important
            margin: auto
        .procedimento
            margin: auto
            margin-left: 0px !important
    .bloco_parceiro .parceiro
        width: calc((100%/2) - 15px)

@media screen and ( max-width: 500px)
    .bloco_mais_medicamento
        .titulo
            flex-direction: column
            height: 100px !important
            text-align: center
            h1
                width: 100% !important
            a
                margin-top: 25px
    .conteudo_principal .bloco_mais_medicamento .bloco_parceiro
        flexCol()
    .bloco_parceiro .parceiro
        width: calc((100% / 1) - 15px)
        margin: 12px auto 

@media screen and (max-width: 406px)
    .bloco_carteirinha
        rotate: 270deg
        height: 255px !important
        margin-top: calc((100vh - 255px)/2)

@media screen and (max-width: 377px)
    #conteudo_principal
        padding: 0px
        .conteudo_medicamento
            margin-top: 25px
            min-height: 450px !important
            .informacao_medicamento
                height: 120px
                flexCenter()
            button
                width: 100%
                margin: 25px auto
