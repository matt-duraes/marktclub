@system "Form"
@template "site"
@resource "site/variavel"

.bloco_loja_detalhe
    width: 100%
    flexCol()
    align-items: center

.bloco_loja_detalhe .bloco_topo
    maxWidth()
    boxShadow()
    border-radius: 10px
    overflow: hidden
    espacoBottomPadrao()
    background-color: #FFF

.bloco_loja_detalhe .bloco_topo .bloco_banner
    width: 100%
    flexCol()
    align-items: center
    position: relative
    .banner
        width: 100%
        height: 100%
        background-position: center center
        background-size: cover
        &.mobile
            display: none
    .banner img
        width: 100%
    .logo
        width: 250px
        position: absolute
        boxShadow()
        background-color: #FFF
        borderRadius()
        flexCenter()
        bottom: -25px
        padding: 10px
    .logo img
        max-width: 100%
        max-height: 150px
.bloco_loja_detalhe .bloco_topo .bloco_header
    width: 100%
    padding: 45px 20px 20px 20px
    flexCol()
    align-items: center
    h1
        titulo()
        text-align: center
    p
        texto()
        text-align: center
        max-width: 600px
        margin: 10px 0

.bloco_desconto_procedimento
    maxWidth()
    flexRow()
    justify-content: space-between
    espacoBottomPadrao()
    .bloco
        width: calc(50% - 10px)

.bloco_loja_detalhe .bloco_botao
    flexRow()
    align-items: center
    espacoBottomPadrao()
    .linha
        width: 1px
        height: 30px
        background-color: #CCC
        margin-left: 20px
    .botao
        flexRow()
        align-items: center
        cursor: pointer
    .botao i
        width: 40px
        height: 40px
        flexCenter()
    .branco
        background-color: #FFF
        boxShadow()
        padding-left: 5px
        margin-left: 20px
    .branco i
        border-right: 1px solid #DDD
        margin-right: 15px
    .destaque
        padding-right: 10px
    .destaque i
        margin-left: 5px
@media screen and (max-width: 768px)
    .bloco_desconto_procedimento
        flex-direction: column
        .bloco
            width: 100%
            margin-bottom: 25px
@media screen and (max-width: 468px)
    .bloco_loja_detalhe
        .bloco_botao
            flex-direction: column
            .branco
                width: calc((100vw / 2) + 50px)
                margin-left: 0px
                margin-bottom: 25px
            .linha
                display: none
