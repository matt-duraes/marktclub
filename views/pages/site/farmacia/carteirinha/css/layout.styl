@template "site"
@resource "site/variavel"

.bloco_carteirinha
    width: 400px
    margin-top: $tamanho
    background: rgb(43,86,161)
    background: linear-gradient(90deg, rgba(43,86,161,1) 0%, #2c7caa 35%, #418a99 100%)
    height: 200px
    position: relative
    margin: 10px
    border-radius: 5px
    boxShadow()
    .bloco_info
        height: 80%
        display: flex
        align-items: center
        justify-content: center
        figure
            width: 48%
            height: 100%
            background-image: url("../images/site/tem_mais_saude.png")
            background-size: 50%
            background-position: center
            background-repeat: no-repeat
        .borda_meio
            height: 90px
            border: 2px solid #06789a
        .bloco_cpf
            background-image: url("../images/site/bonequinho.png")
            background-size: 50%
            background-position: right
            background-repeat: no-repeat
            height: 100%
            width: 48%
            flexCenter()
            h1
                color: white
                texto()
                font-weight: bold
    .bloco_nome
        position: absolute
        width: 100%
        height: 50px
        bottom: 0
        flexCenter()
        background-color: #fff
        text-transform: uppercase
        font-size: 1.5em
        font-weight: 700
        z-index: 9999
        border-radius: 5px
        h1
            color: #003d78
            texto()

@media screen and ( max-width: 425px)
    .bloco_carteirinha
        rotate: 90deg
        height: 250px
        margin-top: calc(50vh - 125px)
