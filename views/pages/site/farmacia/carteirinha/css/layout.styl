@template "site"
@resource "site/variavel"
    
.bloco_carteirinha
    width: 400px
    margin-top: $tamanho
    background: rgb(43,86,161)
    background: linear-gradient(90deg, rgba(43,86,161,1) 0%, #2c7caa 35%, #418a99 100%)
    height: 200px
    position: relative
    margin: 10px
    boxShadow()
    .bloco_info
        height: 80%
        display: flex
        align-items: center
        justify-content: center
        figure
            width: 48%
            height: 100%
            background-image: url("../images/site/tem_mais_saude.png")
            background-size: 50%
            background-position: center
            background-repeat: no-repeat
        .borda_meio
            height: 90px
            border: 2px solid #06789a
        .bloco_cpf
            background-image: url("../images/site/bonequinho.png")
            background-size: 50%
            background-position: right
            background-repeat: no-repeat
            height: 100%
            width: 48%
            flexCenter()
            h1
                color: white
                texto()
                font-weight: bold
    .bloco_nome    
        position: absolute
        width: 100%
        height: 50px
        bottom: 0
        flexCenter()
        background-color: #fff
        text-transform: uppercase
        font-size: 1.5em
        font-weight: 700
        z-index: 9999
        h1
            color: #003d78
            texto()


@media screen and (max-width: 767px)
	.bloco_carteirinha
		width: 100vh
		height: 100vw
		transform: rotate(90deg) translateY(-100%)
		transform-origin: top left
		margin: 0px
	.bloco_carteirinha .bloco_info
		height: 100%
	.bloco_carteirinha .bloco_info figure
		top: 50%
		margin-top: -60px
	.bloco_carteirinha .bloco_info .borda_meio
		top: 50%
		height: 150px
		margin-top: -75px
		height: 250px
	.bloco_carteirinha .bloco_info .bloco_cpf
		top: 50%
		margin-top: -140px


@media only screen and (max-device-width : 1000px) and (orientation : landscape)
	.bloco_carteirinha
		width: 100vw
		height: 100vh
		transform: rotate(0deg) translateY(0%)
		transform-origin: bottom left
		margin: 0px
	.bloco_carteirinha .bloco_info figure
		top: 50%
		margin-top: -60px
	.bloco_carteirinha .bloco_info .borda_meio
		top: 50%
		margin-top: -95px
	.bloco_carteirinha .bloco_info .bloco_cpf
		top: 50%
		margin-top: 20px
		right: 20px

@media only screen and (max-device-width : 850px) and (orientation : landscape)	
	.bloco_carteirinha .bloco_info .sombra
		width: 100%
	.bloco_carteirinha .bloco_info figure
		top: 50%
		margin-top: -60px
	.bloco_carteirinha .bloco_info .borda_meio
		top: 50%
		margin-top: -95px
		height: 250px
	.bloco_carteirinha .bloco_info .bloco_cpf
		top: 50%
		margin-top: -95px
		right: 40px
		