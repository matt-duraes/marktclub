@system "Form"
@template "site"
@resource "site/banner"
@resource "site/loja/parceiro"
@system "Popup"

#bloco_medicamento
    maxWidth()
    .banner
        espacoBottomPadrao()

#popup_medicamento
    border-radius: 10px
    max-width: 600px

    header
        margin-bottom: 0
        display: flex
        justify-content: flex-end
        align-items: center
        background-color: $corClube
        height: 35px
        padding: 0 20px
    i
        position: inherit
        color: $corBrancoPreto
        fill: $corBrancoPreto

    .conteudo_popup
        padding: 0
    .atencao
        font-size: 1.5em
        text-align: center
        margin-bottom: 10px
        display: flex
        flex-direction: column
        align-items: center

        header
            background-color: $corClube
        svg
            fill: $corClube
        h1
            background: $corClube
            color: $corBrancoPreto
            padding: 10px
            margin: 0
            width: 160px
            border-radius: 5px
            text-align: center
            font-size: 16px
            font-weight: 500
        p
            font-size: 20px
            color: $corCinzaCinza
            margin: 25px 10px
            max-width: 450px
