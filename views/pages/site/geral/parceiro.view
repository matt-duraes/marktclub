<div class="bloco_parceiro bloco_geral_article {{isset($Busca->mapa) && $Busca->mapa ? 'display_none' : ''}}">
    @ if(isset($lista) && count($lista->lista) > 0):
        @ foreach( $lista->lista as $r ):

    <article class="parceiro botao_abrir_parceiro" data-url="{{$r->id}}">
        @ if( $lista->tipo == 'automovel-versao' && $dado->procedimento_voucher ):
            <a href="@route('loja.voucher')/{{$loja}}" target="_blank" rel="noopener noreferrer"></a>
        @ elseif( !in_array($lista->tipo, ['cupom', 'automovel-versao']) ):
            <a href="{!!$r->link!!}"></a>
        @endif;
        @if( in_array($r->tipo, ['automovel-versao', 'automovel-modelo', 'operadora', 'sosmulher']) ):
            <figure class="completo"><img src="{!!$r->imagem!!}" alt=""></figure>
        @else:
            <figure class="logo"><img src="{!!$r->imagem!!}" alt=""></figure>
        @endif;
        <header>
            <h1>{{$r->titulo}}</h1>
            @ if( $r->tipo == 'cupom' ):
                <p>{{$r->texto}}</p>
            @ endif;
        </header>

        @ if( $r->tipo == 'automovel-versao'):
        <div class="margem"></div>
        @ endif;
        @ if( $r->tipo == 'automovel-versao' && $dado->procedimento_cheque_bonus):
        <span>Cheque bônus de:</span>
        <p class="valor_destaque">{{$r->valor_por}}</p>
        @ elseif( $r->tipo == 'automovel-versao' && !empty($r->valor_de)):
        <span>de:</span>
        <p class="valor">{{$r->valor_de}}</p>
        <span>por:</span>
        <p class="valor_destaque">{{$r->valor_por}}</p>
        @ elseif( $r->tipo == 'automovel-versao'):
        <p class="valor_destaque">{{$r->valor_por}}</p>
        @ endif;

        @ if( $r->tipo == 'cashback' ):
        <p>Receba de volta</p>
        <p class="destaque cor_color">{{$r->desconto}}%</p>
        <p>Revertido em pontos SILIUM</p>

        @ elseif( $r->tipo == 'cupom' ):
        <p>Válido até:</p>
        <p class="destaque cor_color">{{$r->validade}}</p>

        @ elseif( in_array($lista->tipo, ['veiculo']) ):
        <p>{{$r->de}}</p>
        <p class="destaque cor_color">{{$r->por}}</p>

        @ elseif( in_array($r->tipo, ['loja', 'farmacia']) ):
        <p>{{$r->desconto}}</p>
        @ endif;

        @ if( in_array($r->tipo, ['loja', 'farmacia', 'automovel']) ):
        <div class="bloco_favorito botao_favorito {!!$r->favorito == 'sim' ? 'favorito_marcado' : ''!!}" data-url="{{$r->id}}">
            <i class="marcado">@iconeFavoritoMarcado</i>
            <i class="desmarcado">@iconeFavorito</i>
        </div>
        @ endif;

        <div class="linha cor_bg"></div>
    </article>

        @ endforeach:

    <div class="article_fake"></div>
    <div class="article_fake"></div>
    @ elseif(isset($Busca) && $Busca->existe):
    <div class="bloco_geral_sem_resultado">
        <h1>Sem lojas por sua busca</h1>
        <i>@iconeBuscar(50)</i>
        <p>Não encontramos nenhuma loja pela busca, tente fazer uma nova busca ou limpar a busca atual</p>
        <a href="@route('loja.index')" class="botao botao_geral_cor cor_bg">Limpar busca</a>
        <p>Caso não ache a loja que procura, nos indique a loja deseja</p>
        <a href="" class="botao botao_geral_borda">Indicar uma loja</a>
    </div>
    @else
    <div class="article_fake"></div>
    <div class="article_fake"></div>
    @ endif;
</div>
