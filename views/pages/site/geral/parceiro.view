<div class="bloco_parceiro bloco_geral_article">
@ if($lista):
    @ foreach( $lista->lista as $r ):
    <article class="parceiro" data-url="{{$r->id}}">
        @ if( in_array($lista->tipo, ['modelo', 'cupom']) ):
        <div class="link_cupom_parceiro" data-id="{!!$r->id!!}"></div>
        @ else:
        <a class="link_cupom_parceiro" href="{!!$r->link!!}"></a>
        @ endif;

        @ if( in_array($lista->tipo, ['veiculo', 'modelo']) ):
        <figure class="completo"><img src="{!!$r->imagem!!}" alt=""></figure>
        @ else:
        <figure class="logo"><img src="{!!$r->imagem!!}" alt=""></figure>
        @endif;

        <header>
            <h1>{{$r->titulo}}</h1>
            @ if( $lista->tipo == 'cupom' ):
            <p>{{$r->texto}}</p>
            @ endif;
        </header>

        @ if( $lista->tipo == 'cashback' ):
        <p>Receba de volta</p>
        <p class="destaque cor_color">{{$r->desconto}}</p>
        <p>Revertido em pontos SILIUM</p>

        @ elseif( $lista->tipo == 'cupom' ):
        <p>Válido até:</p>
        <p class="destaque cor_color">{{$r->validade}}</p>

        @ elseif( in_array($lista->tipo, ['veiculo', 'modelo']) ):
        <p>{{$r->de}}</p>
        <p class="destaque cor_color">{{$r->por}}</p>

        @ elseif( $lista->tipo == 'loja' ):
        <p>{{$r->desconto}}</p>
        <div class="icone">
            <i class="favorito">@iconeFavorito</i>
        </div>
        @ endif;

        <div class="linha cor_bg"></div>
    </article>
    @ endforeach:
    <div class="article_fake"></div>
    <div class="article_fake"></div>
    <div class="article_fake"></div>
    @ elseif(isset($busca) && $busca)
    <div class="sem_parceiro">
        <i>@iconeImagem</i>
    </div>
@ endif;
</div>
