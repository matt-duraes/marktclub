@if($loja_favorita == null)
    <div class="bloco_geral_sem_resultado bloco_favorito">
        <i>@iconeFavorito(40)</i>
        <p>Você ainda não tem lojas favoritas</p>
    </div>
@else
    <div class="bloco_parceiro bloco_geral_article article_favoritos">
        @foreach ($loja_favorita as $r):
        <article class="parceiro parceiro_favorito" data-url="{{$r->id}}">
            <a class="link_cupom_parceiro" href="{!!$r->link!!}"></a>
            <figure class="logo"><img src="{!!$r->imagem!!}" alt=""></figure>
            <header>
                <h1>{{$r->titulo}}</h1>
            </header>
            <p>{{$r->desconto}}</p>
            <div class="icone bloco_favorito" data-url="{{$r->id}}">
                @if($r->favorito == 1)
                    <i class="favorito favorito_marcado">@iconeFavorito</i>
                @else
                    <i class="favorito">@iconeFavorito</i>
                @endif
            </div>
            <div class="linha cor_bg"></div>
        </article>
        @endforeach
    </div>
@endif



