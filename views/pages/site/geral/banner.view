
@if ( $banner->desktop || $banner->mobile):
<div class="bloco_geral_banner banner">
    <div class="conteudo">
        @ if( count($banner->desktop ?? []) > 1 ):
        <div class="seta anterior botao_banner_desktop" id="botao_banner_anterior">@iconeSetaEsquerda(40)</div>
        <div class="seta proximo botao_banner_desktop" id="botao_banner_proximo">@iconeSetaDireita(40)</div>
        @ endif;

        @ if( $banner->desktop ?? [] ):
        <div class="imagem banner_desktop" id="bloco_banner_desktop">
            @ foreach( $banner->desktop as $r )
            <figure>
                <img src="{!!$r->imagem!!}">
                @ if( !empty($r->link) ):
                <a href="{!!$r->link!!}"></a>
                @ endif;
            </figure>
            @ endforeach;
        </div>
        @ endif;
        @ if( $banner->mobile ?? []):
        <div class="imagem banner_mobile" id="bloco_banner_mobile">
            @ foreach( $banner->mobile as $r )
            <figure>
                <img src="{!!$r->imagem!!}">
                @ if( !empty($r->link) ):
                <a href="{!!$r->link!!}"></a>
                @ endif;
            </figure>
            @ endforeach;
        </div>
        @ endif;
    </div>
</div>
@ endif;
