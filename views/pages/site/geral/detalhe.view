@ if($dado):
<div id="bloco_loja_detalhe" class="bloco_loja_detalhe">
    <div class="bloco_topo">
        <section class="bloco_banner">
            <figure class="banner desktop"><img src="{{$dado->capa_desktop}}"></figure>
            <figure class="banner mobile"><img src="{{$dado->capa_mobile}}"></figure>
            <figure class="logo"><img src="{{$dado->logo}}"></figure>
        </section>
        <header class="bloco_header">
            <h1>{{$dado->titulo}}</h1>
            <p>{{$dado->texto_descricao}}</p>
        </header>
    </div>

    <div class="bloco_desconto_procedimento">
        <div class="bloco bloco_titulo_texto">
            <h1>Descontos</h1>
            <p>{{$dado->texto_desconto}}</p>
        </div>
        <div class="bloco bloco_titulo_texto">
            <h1>Procedimentos</h1>
            <p>{{$dado->texto_procedimento}} </p>
        </div>
    </div>
    @if(TIPO_USUARIO != 'indicado'):
        <div class="bloco_botao">
            @if ($dado->procedimento == 'declaracao'):
                <a href="" target="_blank" rel="nofollow noopener" id="botao_abrir_declaracao" class="botao destaque botao_geral_cor cor_bg">Solicitar Declaração <i>@iconeDeclaracao(17)</i></a>
            @elseif ($dado->procedimento == 'voucher'):
                <a href="" target="_blank" rel="nofollow noopener" id="botao_abrir_voucher" class="botao destaque botao_geral_cor cor_bg">Gerar Voucher <i>@iconeVoucher(17)</i></a>
            @elseif ($dado->procedimento == 'on-line'):
                <div class="botao branco botao_geral_cor"><i>@iconeTelefone()</i> Abrir Site</div>
            @endif
            <div class="botao branco botao_geral_cor"><i>@iconeTelefoneLoja()</i> Ver telefone</div>
            <div class="botao branco botao_geral_cor"><i>@iconeEmail(15)</i> Ver e-mail</div>

        </div>
    @else
        <div class="bloco_atencao_geral">
            <p>Apenas associados possuem acesso a esse recurso</p>
        </div>
    @endif

    @if($dado->endereco)
    <div class="bloco_mapa">
        <header>
            <h1>Endereços</h1>
            <div class="grow"></div>
            <div class="botao botao_geral_cor cor_bg" id="botao_endereco">Buscar endereço <i>@iconeBusca(20)</i></div>
            <a href="_blank" rel="nofollow noopener" id="como_chegar" class="botao destaque botao_geral_cor cor_bg">Como Chegar <i>@iconeMapa(20)</i></a>
        </header>
        <div class="mapa"></div>
    </div>
    @endif

</div>
