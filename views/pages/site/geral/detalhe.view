@ if($dado):
<div id="bloco_loja_detalhe" class="bloco_loja_detalhe">
    <input type="hidden" id="input_analytics_vinculo" value="{!!$dado->id!!}">
    <input type="hidden" id="input_loja_id" value="{!!$dado->id!!}">
    <input type="hidden" id="input_loja_url" value="{!!$dado->url!!}">
    <div class="bloco_parceiro_header">
        <section class="bloco_banner">
            @ if( !empty($dado->capa_desktop) ):
            <figure class="banner desktop"><img src="{{$dado->capa_desktop}}"></figure>
            @ endif;
            @ if( !empty($dado->capa_mobile) ):
            <figure class="banner mobile"><img src="{{$dado->capa_mobile}}"></figure>
            @ endif;
        </section>
        <figure class="logo {!!empty($dado->capa_desktop) && empty($dado->capa_mobile) ? 'vazio' : ''!!}"><img src="{{$dado->logo}}"></figure>
        <header class="bloco_header">
            <h1>{{$dado->titulo}}</h1>
            <p>{!!$dado->texto_descricao!!}</p>
        </header>
    </div>

    <div class="bloco_desconto_procedimento">
        <div class="bloco bloco_titulo_texto">
            <h1>Descontos</h1>
            <div class="texto_destaque">{!!$dado->texto_desconto!!}</div>
        </div>
        <div class="bloco bloco_titulo_texto">
            <h1>Procedimentos</h1>
            <div class="texto_destaque">{!!$dado->texto_procedimento!!}</div>
        </div>
    </div>

    @ if(TIPO_USUARIO != 'indicado'):
    <div class="bloco_botao">
        @ if( $tipo == 'farmacia' ):
            <a href="@route('farmacia.carteirinha')" target="_blank" rel="nofollow noopener" class="botao_contar_click botao destaque botao_geral_cor cor_bg" >
                Abrir Carteirinha <i>@iconeDeclaracao(17)</i>
            </a>
        @ elseif ($dado->procedimento == $procedimento::DECLARACAO):
        <div id="botao_salvar_declaracao" class="botao_contar_click botao destaque botao_geral_cor cor_bg" data-botao="Declaração">Solicitar Declaração <i>@iconeDeclaracao(17)</i></div>
        @ elseif ($dado->procedimento == $procedimento::VOUCHER):
        <a href="@route('loja.voucher')/{{$dado->url}}" target="_blank" rel="nofollow noopener" class="botao_confirmar_abrir botao_contar_click botao destaque botao_geral_cor cor_bg" data-botao="Voucher">
            Gerar Voucher
            <i>@iconeShow</i>
        </a>
        @ elseif ($dado->procedimento == $procedimento::WEBSITE):
        <a href="{!!$dado->link!!}" target="_blank" rel="noopener noreferrer" class="botao_confirmar_abrir botao_contar_click botao destaque botao_geral_cor cor_bg" data-botao="Abrir Site">
            Abrir Site
            <i>@iconeExtensaoHome</i>
        </a>
        @ endif

        @ if( $telefone && count($telefone) == 1):
        <div class="botao_contar_click botao botao_geral_cor" data-botao="Telefone"><i>@iconeTelefoneLoja()</i> {{$telefone[0]}}</div>
        @ elseif( $telefone ):
        <div class="botao_contar_click botao botao_geral_cor" data-botao="Telefone"><i>@iconeTelefoneLoja()</i> Ver telefone</div>
        @ endif;

        @ if( $email && count($email) == 1 ):
        <div class="botao_contar_click botao botao_geral_cor" data-botao="E-mail"><i>@iconeEmail(15)</i> {{$email[0]}}</div>
        @ elseif( $email ):
        <div class="botao_contar_click botao botao_geral_cor" data-botao="E-mail"><i>@iconeEmail(15)</i> Ver e-mail</div>
        @ endif;

        @ if( $dado->procedimento != $procedimento::WEBSITE && !empty($dado->link) ):
        <a href="{!!$dado->link!!}" target="_blank" rel="noopener noreferrer" class="botao_contar_click botao botao_geral_cor" data-botao="Abrir site secundario">
            Abrir Site
            <i>@iconeExtensaoHome</i>
        </a>
        @ endif;

    </div>
    @else
    <div class="bloco_atencao_geral">
        <p>Apenas associados possuem acesso a esse recurso</p>
    </div>
    @endif

    <div class="bloco_mapa display_none" id="bloco_mapa">
        <header>
            <h1 class="esqueleto">Endereço</h1>
            <div class="grow"></div>
            <div class="botao esqueleto" id="botao_endereco_buscar">Buscar endereço <i>@iconeBusca(20)</i></div>
            <a href="" target="_blank" rel="nofollow noopener" id="botao_endereco_link" class="botao esqueleto">Como Chegar <i>@iconeMapa(20)</i></a>
        </header>
        <div class="endereco esqueleto" id="bloco_endereco_texto"></div>
        <div class="mapa_falso esqueleto display_none"></div>
        <div class="mapa" id="bloco_endereco_google_map"></div>
    </div>

    @view site/geral/relacionado.view
</div>
@ endif;

