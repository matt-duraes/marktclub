@ if($dado):
<div id="bloco_loja_detalhe" class="bloco_loja_detalhe">
    <div class="bloco_parceiro_header">
        <section class="bloco_banner">
            @ if( !empty($dado->capa_desktop) ):
            <figure class="banner desktop"><img src="{{$dado->capa_desktop}}"></figure>
            @ endif;
            @ if( !empty($dado->capa_mobile) ):
            <figure class="banner mobile"><img src="{{$dado->capa_mobile}}"></figure>
            @ endif;
        </section>
        <figure class="logo {!!empty($dado->capa_desktop) && empty($dado->capa_mobile) ? 'vazio' : ''!!}"><img src="{{$dado->logo}}"></figure>
        <header class="bloco_header">
            <h1>{{$dado->titulo}}</h1>
            <p>{{$dado->texto_descricao}}</p>
        </header>
    </div>

    <div class="bloco_desconto_procedimento">
        <div class="bloco bloco_titulo_texto">
            <h1>Descontos</h1>
            <p>{{$dado->texto_desconto}}</p>
        </div>
        <div class="bloco bloco_titulo_texto">
            <h1>Procedimentos</h1>
            <p>{{$dado->texto_procedimento}} </p>
        </div>
    </div>
    @ if(TIPO_USUARIO != 'indicado'):
    <div class="bloco_botao">
        @ if( $tipo == 'farmacia' ):
        <div id="botao_abrir_saude" class="botao destaque botao_geral_cor cor_bg">Abrir carteirinha <i>@iconeDeclaracao(17)</i></div>
        @ elseif ($dado->procedimento == $procedimento::DECLARACAO):
        <div id="botao_abrir_declaracao" class="botao destaque botao_geral_cor cor_bg">Solicitar Declaração <i>@iconeDeclaracao(17)</i></div>
        @ elseif ($dado->procedimento == $procedimento::VOUCHER):
        <a href="@route('loja.voucher')/{{$dado->url}}" target="_blank" rel="nofollow noopener" id="botao_abrir_voucher" class="botao destaque botao_geral_cor cor_bg">Gerar Voucher <i>@iconeVoucher(17)</i></a>
        @ elseif ($dado->procedimento == $procedimento::WEBSITE):
        <a href="" target="_blank" rel="noopener noreferrer" class="botao destaque botao_geral_cor cor_bg">Abrir Site<i>@iconeLink()</i></a>
        @ endif

        @ if( $telefone && count($telefone) == 1):
        <div class="botao branco botao_geral_cor"><i>@iconeTelefoneLoja()</i> {{$telefone[0]}}</div>
        @ elseif( $telefone ):
        <div class="botao branco botao_geral_cor"><i>@iconeTelefoneLoja()</i> Ver telefone</div>
        @ endif;

        @ if( $email && count($email) == 1 ):
        <div class="botao branco botao_geral_cor"><i>@iconeEmail(15)</i> {{$email[0]}}</div>
        @ elseif( $email ):
        <div class="botao branco botao_geral_cor"><i>@iconeEmail(15)</i> Ver e-mail</div>
        @ endif;

        @ if( $dado->procedimento != $procedimento::WEBSITE ):
        <a href=""target="_blank" rel="noopener noreferrer" class="botao branco botao_geral_cor"><i>@iconeTelefone()</i> Abrir Site</a>
        @ endif;

    </div>
    @else
    <div class="bloco_atencao_geral">
        <p>Apenas associados possuem acesso a esse recurso</p>
