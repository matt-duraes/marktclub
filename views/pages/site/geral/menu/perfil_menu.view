@if (MENU_CARTEIRA):
<a href="@route(perfil.carteirinha)" class="botao" target="_blank" data-test="test_botao_carteirinha">
    <i>@iconeCarteirinha</i>
    Carteirinha
</a>
@endif;
@ if( !API ):
<a class="botao {!!MENU_HOVER == 'perfil-dado' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.index)">
    <i>@iconeUsuarioOutline(22)</i>
    Alterar Dados
</a>
<a class="botao {!!MENU_HOVER == 'perfil-senha' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.senha)">
    <i>@iconeSenhaOutline(22)</i>
    Alterar Senha
</a>
@ endif;

@ if( MENU_DEPENDENTE  && TIPO_USUARIO != 'dependente' && TIPO_USUARIO != 'indicado' ):
<a class="botao {!!MENU_HOVER == 'perfil-dependente' ? 'cor_bg pagina_atual' : ''!!}" href="@route(perfil.dependente)" data-test="adicionar_dependente_botao">
    <i>@iconeDependenteOutline(22)</i>
    Adicionar dependentes
</a>
@ endif;
@ if (MENU_PONTO_MAIS_ACAO) :
<a id="container_mais_acao" class="botao {!!MENU_HOVER == 'ponto-mais-acao' ? 'cor_bg pagina_atual' : ''!!}" href="@route(pontoCvs.index)">
    <i id="icone_mais_acao">@iconeCvs(22)</i>
    <p class="texto_menu_mais_acao">Ponto + Ação</p>
</a>
@ endif;

@ if( MENU_CASHBACK ):
<a class="botao {!!MENU_HOVER == 'perfil-silium' ? 'cor_bg pagina_atual' : ''!!}" href="@route(cashback.extrato)">
    <i>@iconeCashbackHome(22)</i>
    Extrato do Silium
</a>
@ endif;

@ if( MENU_INDICAR_USUARIO && TIPO_USUARIO != 'indicado' ):
<a class="botao {!!MENU_HOVER == 'perfil-indicacao' ? 'cor_bg pagina_atual' : ''!!}" href="@route(site.indiqueAmigo)">
    <i>@iconeIndiqueAmigoOutline(22)</i>
    Indique um amigo
</a>
@ endif;

@ if( MENU_SAIR ):
    <a href="{{LINK_BOTAO_SAIR ? route('sair.sairPersonalizado') : route('sair.index')}}"class="botao sair desktop sair_perfil">
        <i>@iconeSair</i>
        Sair do clube
    </a>
@ endif;

