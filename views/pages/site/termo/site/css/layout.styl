@charset "UTF-8"

@system "Resetar"
@system "Pagina"

@resource "site/mixim"
@resource "site/geral"

body
    background-color: #F0F0F0
    font-size: 62.5%
    display: flex
    align-items: center
    justify-content: flex-start


#bloco-termo__app
    width: 100%
    display: flex
    flex-direction: column

#bloco-termo__app header 
    width: 100%
    display: flex
    align-items: center
    justify-content: center
    background-color: #FFF

#bloco-termo__app section 
    width: 100%
    display: flex
    align-items: center
    justify-content: center
    flex-direction: column
    position: relative
    margin-top: 40px
    margin-bottom: 100px
    h1
        font-size: 1.8em
        line-height: 1.8em
        font-weight: bold
    p
        max-width: 500px
        font-size: 1.4em
        line-height: 1.4em
    article 
        width: calc(100% - 40px)
        max-width: 500px
        display: flex
        flex-direction: column
        margin-top: 20px
        h2
            font-size: 1.5em
            line-height: 1.5em
            font-weight: bold
            margin-top: 20px
        h2:nth-child(1)
            margin-top: 0px
        p
            font-size: 1.4em
            line-height: 1.4em

#bloco-termo__app section.regulamento
    article 
        align-items: center
        justify-content: center
        margin-bottom: 20px
        border-bottom: 1px solid #DDD
        &:last-of-type
            border-bottom: none

@media screen and (max-width: 600px)
    #bloco-termo__app header figure 
        height: 100px
        display: flex
        justify-content: center
        align-items: center
    #bloco-termo__app section
        width: 100%
        padding-left: 20px
        padding-right: 20px
    #bloco-termo__app section p
        width: 100%
        max-width: 100%
    #bloco-termo__app section article 
        width: 100%
        max-width: 100%
        justify-content: center

@media screen and (max-width: 340px)
    #bloco-termo__app 
        width: auto


.pl10
    padding-left: 10px
.titulo-normal
    margin-top: 5px

.sair
    padding: 10px 20px
    margin-top: 40px
    border: 1px solid #CCC
    background-color: #ddd
    border-radius: 3px
    font-size: 1.2em