@template "site"
<div id="bloco_simulacao_saude">
    <input type="hidden" value="{{$plano}}" id="input_plano_saude">
    <form class="form_geral cinza bloco_simulacao conteudo" id="bloco_simulacao">
        <header>
            <h1>PREENCHA AS INFORMAÇÕES</h1>
            <p>Preencha os dados abaixo e clique em "Fazer Simulação" para comparar os preços dos planos</p>
        </header>
        <div class="bloco_dado titular">
            <h2>Titular</h2>
            <p>Digite a data de nascimento do titular</p>
            @? formData(name: 'data_titular', placeholder: 'Data de nascimento do titular', label: 'Nascido em', obrigatorio: true)
        </div>

        <div class="bloco_dado">
            <h2 class="dependente">Dependentes</h2>
            <p class="pequeno">
                Todo associado (a) pode aderir ao convênio e incluir como dependentes: esposo (a), filhos (as) solteiros (as) com até 28 anos, netos (as) com até 18 anos, filhos (as) maiores de 28 anos comprovadamente inválidos, pai e mãe desde que dependente no Imposto de Renda (IR).
            </p>
            <div class="botao" id="botao_adicionar_dependente">Adicionar Dependente</div>
            <div class="bloco_dependente" id="bloco_lista_dependente">
                <div class="zero" id="bloco_sem_dependente">Sem dependentes no momento</div>
            </div>
        </div>

        <div class="bloco_botao">
            @? $Botao->botao(texto: 'Fazer simulação', id: 'botao_fazer_simulacao')
        </div>
    </form>
    <div class="conteudo bloco_resultado display_none" id="bloco_resultado">
        <header>
            <h1>RESULTADO</h1>
            <p>Compare os planos abaixo e escolha o ideal para fazer sua solicitação</p>
        </header>

        <div class="bloco_escolher">
            <div class="plano_lista" id="bloco_plano_lista">
            </div>
        </div>

        <div class="bloco_botao">
            @? $Botao->botao(class: 'botao_voltar', texto: 'Refazer simulação', id: 'botao_refazer_simulacao')->voltar()
        </div>
    </div>
</div>

<div class="display_none">
    <div class="linha_dependente" id="bloco_dependente_padrao">
        @? formData(name: 'dependente', placeholder: 'Data de nascimento do dependente', label: 'Nascido em', class: 'data_nascimento data_dependente', obrigatorio: true, value: '')
        <div class="remover">@iconeFechar()</div>
    </div>

    <div class="plano" id="bloco_plano_padrao">
        <header>
            <h2></h2>
        </header>
        <div class="dinheiro">
            <span class="sifrao">R$</span>
            <span class="valor"></span>
            <span class="virgula">,</span>
            <span class="centavo"></span>
        </div>

        <h3>Valor detalhado:</h3>
        <div class="valor_lista">
        </div>

        <div class="botao">
            @? $Botao->botao(texto: 'Escolher plano')->destaque()
        </div>

        <table class="borda detalhe">
        </table>
    </div>

    <div class="valor_linha" id="bloco_plano_valor_padrao">
        <div class="indice">
            <div class="dado">
                <div class="nome"></div>
                <div class="data"></div>
            </div>
            <div class="ponto"></div>
        </div>
        <div class="valor"></div>
    </div>

    <table>
        <tr id="bloco_plano_item_padrao">
            <td class="indice"></td>
            <td class="valor">Enfermagem</td>
        </tr>
    </table>
</div>
