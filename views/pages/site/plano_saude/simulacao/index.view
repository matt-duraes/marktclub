@template "site"

<div id="bloco_simulacao">
@ if( $operadora == 'unimed-vitoria' ):
    @view site/plano_saude/unimedvitoria/simulacao.view
@ endif;
@ if( $operadora == 'unimed-florianopolis' ):
    @view site/plano_saude/unimedflorianopolis/simulacao.view
@ endif;
@ if( $operadora == 'amil' ):
    @view site/plano_saude/amil/simulacao.view
@ endif;
@ if( $operadora == 'unimed-seguros' ):
    @view site/plano_saude/unimedSeguro/simulacao.view
@ endif;

<input type="hidden" name="operadora" id="operadora" value="{{$operadora}}">

</div>
@view site/plano_saude/geral/voltarDetalhe.view

