        <div class="bloco_lista">
            <header>
                <h1>Afinidade Básica</h1>
            </header>
            <div class="lista_passo_a_passo">
                <ul class="bloco_geral_ul">
                    <li><p><span>Segmento:</span> Ambulatorial Hospitalar com Obstetrícia</p></li>
                    <li><p><span>Abrangência Geográfica:</span> Nacional</p></li>
                    <li><p><span>Padrão de Acomodação:</span> Coletivo (Enfermaria)</p></li>
                    <li><p><span>Abrangência:</span> Rede Referenciada Nacional e Reembolso</p></li>
                    <li><p><span>Serviços e Coberturas Adicionais:</span> Garantia Funeral, SEA - Seguro de Extensão Assistencial, ASSIST Internacional, AMT - Aconselhamento Médico por telefone, APH - Atendimento Pré-Hospitalar, desconto em farmárcias, Assistência domiciliar.</p></li>
                </ul>
            </div>
        </div>
        <div class="bloco_lista">
            <header>
                <h1>Afinidade Prático</h1>
            </header>
            <div class="lista_passo_a_passo">
                <ul class="bloco_geral_ul">
                    <li><p><span>Segmento:</span> Ambulatorial Hospitalar com Obstetrícia</p></li>
                    <li><p><span>Abrangência Geográfica:</span> Nacional</p></li>
                    <li><p><span>Padrão de Acomodação:</span> Individual (apartamento)</p></li>
                    <li><p><span>Abrangência:</span> Rede Referenciada Nacional e Reembolso</p></li>
                    <li><p><span>Serviços e Coberturas Adicionais:</span> Garantia Funeral, SEA - Seguro de Extensão Assistencial, ASSIST Internacional, AMT - Aconselhamento Médico por Telefone, APH - Atendimento Pré-Hospitalar, Desconto em Farmácias, Assistência Domiciliar.</p></li>
                </ul>
            </div>
        </div>
        <div class="bloco_lista">
            <header>
                <h1>Afinidade Versátil</h1>
            </header>
            <div class="lista_passo_a_passo">
                <ul class="bloco_geral_ul">
                    <li><p><span>Segmento:</span> Ambulatorial Hospitalar com Obstetrícia</p></li>
                    <li><p><span>Abrangência Geográfica:</span> Nacional</p></li>
                    <li><p><span>Padrão de Acomodação:</span> Individual (Apartamento)</p></li>
                    <li><p><span>Abrangência:</span> Rede Referenciada Nacional e Reembolso</p></li>
                    <li><p><span>Serviços e Coberturas Adicionais:</span> Garantia Funeral, SEA - Seguro de Extensão Assistencial, ASSIST Internacional, AMT - Aconselhamento Médico por Telefone, APH - Atendimento Pré-Hospitalar, Desconto em Farmácias, Assistência Domiciliar e Assistência Residencial.</p></li>
                </ul>
            </div>
        </div>
    </div>

