    <section class="bloco_plano_saude">
        <header>
            <h1>Fator Moderador</h1>
            <p>Você sabia que pode receber um auxílio ressarcimento* de acordo com sua faixa salarial e idade? Veja a tabela abaixo:</p>
        </header>
        <div class="bloco_tabela_geral">
            <table>
                <thead>
                    <tr>
                        <th>Procedimentos</th>
                        <th>Descrição</th>
                        <th>Percentual</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Fisioterapia</td>
                        <td>A partir da 61ª (sexagéssima primeira) sessão, <br> por segurado, por ano de vigência da apólice </td>
                        <td>30%</td>
                    </tr>
                    <tr>
                        <td>Acupuntura</td>
                        <td>A partir da 61ª (sexagéssima primeira) sessão, <br> por segurado, por ano de vigência da apólice</td>
                        <td>30%</td>
                    </tr>
                    <tr>
                        <td>Pisiquiátrica</td>
                        <td>Ultrapassando 30 (trinta) dias de internação <br>no transcorrer de 1 (um) ano de contrato</td>
                        <td>30%</td>
                    </tr>
                    <tr>
                        <td>Demais procedimentos</td>
                        <td>-</td>
                        <td>0%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="bloco_simulacao container_scroll">
        <h1>GOSTARIA DE FAZER UMA SIMULAÇÃO?</h1>
        <p>Faça uma simulação sua e seus dependentes e veja os valores.</p>
        @if(TIPO_USUARIO != 'indicado'):
            <a class="botao_geral_cor cor_bg" href="@route(planosaude.simulacao)/unimed-seguros">Fazer Simulação</a>
        @else
            <div class="bloco_atencao_geral">
                <p>Apenas associados possuem acesso a este recurso</p>
            </div>
        @endif
    </section>
    @if(TIPO_USUARIO != 'indicado'):
        <a href="@route(planosaude.simulacao)/unimed-seguros" class="botao_geral_cor botao_fixo_bottom cor_bg botao_scroll">SIMULAR AGORA</a>
    @endif
</div>
