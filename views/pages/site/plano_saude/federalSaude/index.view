<div class="bloco_federal_saude">
    @view site/geral/banner.view
    <header class="titulo_saude">
        <h1>O QUE DESEJA FAZER?</h1>
        <p>Caso queira simular o plano da Federal Clube, clique em "Contratar o Federal Saúde" ou
            se já possui o plano, clique em "Solicitar 2° via do Boleto"</p>
    </header>
    <div class="bloco_opcao">
        <button class="botao botao_geral_cor cor_bg" data-opcao="contratar">Contratar o Federal Saúde</button>
        <button class="botao botao_geral_cor cor_bg" data-opcao="solicitar">Solicitar 2° Via do Boleto</button>
    </div>
</div>

<div class="contratacao display_none">
    <div class="contratar_federal">
        <header class="titulo_saude">
            <h1>Para continuar, escolha entre uma das operadoras abaixo:</h1>
        </header>

        @view site/geral/parceiro.view
    </div>
    <div class="bloco_video_teleorientacao">
        <h1>Teleorientação Médica 24hrs</h1>
        <p>Um serviço da Seguros Unimed para os seus clientes. Assista o vídeo abaixo:</p>
        <iframe width="560" height="315" src="https://www.youtube.com/embed/wnppH0USXfM" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        <div class="link_teleorientacao">
            <a class="botao botao_geral_cor_auto_height cor_bg" href="{!!LINK_ARQUIVO!!}/download/programa_seguros_unimed.pdf" target="_blank">Clique e veja o cuidado da Seguros Unimed com os beneficiários</a>
            <br>
            <a class="botao botao_geral_cor_auto_height cor_bg" href="{!!LINK_ARQUIVO!!}/download/manual_acesso_unimed_seguro.pdf" target="_blank">Clique e veja o Manual de acesso ao Apps da Seguros Unimed</a>
        </div>
    </div>
</div>
<div class="boleto display_none">
    <header class="titulo_saude">
        <h1>Escolha sua operadora para gerar o boleto:</h1>
    </header>
    @php $lista = $saudeBoleto
    @view site/geral/parceiro.view
</div>


