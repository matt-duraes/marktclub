    <section class="bloco_simulacao container_scroll">
		<h1>GOSTARIA DE FAZER UMA SIMULAÇÃO?</h1>
		<p>Faça uma simulação sua e seus dependentes e veja os valores.</p>
        @if(TIPO_USUARIO != 'indicado')
            <a class="botao_geral_cor cor_bg" href="@route(planosaude.simulacao)/unimed-florianopolis">Fazer Simulação</a>
        @endif
	</section>
    @if(TIPO_USUARIO == 'indicado'):
        <div class="bloco_atencao_geral">
            <p>Apenas associados possuem acesso a este recurso</p>
        </div>
    @endif
    @if(TIPO_USUARIO != 'indicado'):
        <a href="@route(planosaude.simulacao)/central-nacional-unimed-florianopolis" target="_blank" class="botao_geral_cor botao_fixo_bottom cor_bg botao_scroll">SIMULAR AGORA</a>
    @endif
</div>
