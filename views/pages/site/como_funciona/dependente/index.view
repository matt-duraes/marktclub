@template "login"

<section class="tutorial">
    <div class="bloco_menu">
        <p class="cor_color">O que deseja fazer?</p>
        <a href="#ativar">Como ativar</a>
        <a href="#login">Fazer login</a>
        <a href="#senha">Recuperar senha</a>
    </div>
    <div class="tutorial__ativar cor_bg" id="ativar">
        <div class="ativar">
            <div class="ativar--centralizar">
                <article class="ativar--texto">
                    <h1 class="inicio">Para começar a utilizar basta</h1>
                    <h1 class="segundo"><span class="">COMPLETAR SEU CADASTRO</span></h1>
                </article>
                <article class="ativar--link">
                    <div class="link">
                        <a href="{!!LINK_PADRAO!!}" class="cor_bg" target="_blank">CLIQUE AQUI</a>
                    </div>
                </article>
            </div>
            <div class="ativar--tutorial cor_border">
                <div class="passo">
                    <figure><img height="80" src="https://clube.marktclub.com.br/images/tutorial/primeiro_passo.png"></figure>
                    <header>
                        <div class="centralizar">
                            <div class="logo">
                                <figure><img src="{{LINK_ARQUIVO}}/construtor/logo_marktclub_tem_mais.png" height="60" alt=""></figure>
                            </div>
                            <div class="esquerdo">
                                <p>Primeiro Acesso</p>
                                <p class="login cor_bg">Entrar</p>
                            </div>
                        </div>
                        <div class="banner">
                            <figure style="background-image: url(https://clube.marktclub.com.br/images/tutorial/barra_banner.png)"></figure>
                        </div>
                    </header>
                </div>
                <div class="passo">
                    <figure><img height="80" src="https://clube.marktclub.com.br/images/tutorial/segundo_passo.png"></figure>
                    <figure class="print"><img src="https://clube.marktclub.com.br/images/tutorial/print_segundo_passo.png"></figure>
                </div>
                <div class="passo" id="login">
                    <figure><img height="80" src="https://clube.marktclub.com.br/images/tutorial/terceiro_passo.png"></figure>
                    <figure class="print"><img src="https://clube.marktclub.com.br/images/tutorial/print_terceiro_passo.png"></figure>
                </div>
                <div class="passo" id="senha">
                    <figure><img height="120" src="https://clube.marktclub.com.br/images/tutorial/quarto_passo.png"></figure>
                    <figure class="print"><img src="https://clube.marktclub.com.br/images/tutorial/print_quarto_passo.png"></figure>
                </div>
                <div class="passo">
                    <figure><img height="120" src="https://clube.marktclub.com.br/images/tutorial/quinto_passo.png"></figure>
                    <figure class="print"><img src="https://clube.marktclub.com.br/images/tutorial/print_quinto_passo.png"></figure>
                </div>
            </div>
        </div>
    </div>
</section>
