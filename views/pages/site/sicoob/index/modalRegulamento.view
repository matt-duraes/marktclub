
<div class="bloco_pagina_popup">
    <header class="header_pagina_popup">
		<h1 class="h1_voltar">REGULAMENTO</h1>
        <i class="fechar botao_fechar_popup" id="botao_visualizar_fechar">@iconeFechar</i>
    </header>
        
    <div class="conteudo_pagina_popup voucher">
        <article class="bloco-popup__conteudo">
            @ if($tipo == 'novo'):
                <p>Financiamento limitado a 70% do valor do veículo novo (Nota Fiscal).</p>
                <p>Registro Detran, Gravame e Seguro.</p>
                <p style="font-weight:bold;">*Taxa exclusiva para cadastro positivo.</p>
            @ elseif($tipo == 'consignado'):
                <p>Garantias: CCB (Cédula de Crédito Bancário).</p>
                <p>Exclusivo para novos contratos. Parcela limitada até 30% da renda.</p>
                <p>Este empréstimo abrange diversas finalidades. Solicite a sua proposta, que entraremos em contato para encontrar a melhor forma de atender a sua necessidade.</p>
                <p style="font-weight:bold;">*Taxa exclusiva para cadastro positivo.</p>
            @ elseif($tipo == 'pessoal'):
                <p>Garantias: CCB (Cédula de Crédito Bancário) ou Aval.</p>
                <p>Este empréstimo abrange diversas finalidades. Solicite a sua proposta, que entraremos em contato para encontrar a melhor forma de atender a sua necessidade.</p>
                <p style="font-weight:bold;">*Taxa exclusiva para cadastro positivo.</p>
            @ elseif($tipo == 'seminovo'):
                <p>Garantias: Alienação do veículo e seguro.</p>
                <p>Veículos com até 05 anos de uso.</p>
                <p>Financiamento limitado a 70% do valor da tabela FIPE.</p>
                <p>Registro Detran, Gravame e Seguro.</p>
                <p style="font-weight:bold;">*Taxa exclusiva para cadastro positivo.</p>
            @ endif;
        </article>
    </div>

</div>

