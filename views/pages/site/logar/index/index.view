@template "login"


<div id="auth_api_login_site" >

    <div class="auth_bloco_geral_site" id="auth_bloco_login">

        <form id="auth_form_login" class="auth_form_geral form_geral" action="{{LINK}}/auth/login" method="post">
            <div class="auth_loading"><span></span></div>

            <legend>FAÇA SEU LOGIN</legend>
            @ if ($tipo === 'ANABB') :
                <p>Digite sua matrícula no campo abaixo e clique em continuar para fazer seu login</p>
            @ elseif ($client_id == 'KPrsQbkiB6PIDoAW0Ri47g' && (false === $dependente)) :
                @php
                $txt_indicacao_topo = !$indicacao ?
                'Ative seu cadastro no primeiro acesso ou digite seu código ABERT' : 'Digite seu E-mail';
                @end
                <p>{{$txt_indicacao_topo}} no campo abaixo e clique em continuar para fazer seu login</p>
            @ elseif ($client_id == 'KPrsQbkiB6PIDoAW0Ri47g' && (true === $dependente)) :
                <p>Ative seu cadastro no primeiro acesso ou digite seu cpf ou e-mail</p>
            @ else :
                @php
                    $txt_indicacao_topo = !$indicacao ? 'Digite seu CPF' : 'Digite seu E-mail';
                @end
                <p>{{$txt_indicacao_topo}} no campo abaixo e clique em continuar para fazer seu login</p>
            @ endif;

            <input type="text" value="" class="input_hidden">
            <input type="text" value="" class="input_hidden">
            <input type="password" value="" class="input_hidden">

            <div class="bloco_login login">
                @ if ($tipo === 'ANABB') :
                    @? formInput(name: 'email_cpf', id: 'input_login', label: 'Digite sua matrícula', placeholder: 'Digite sua matrícula')
                @ elseif (in_array($client_id, ['Nz1lc1dKkXuW14buEullpa']) && (false === $dependente)) :
                    @? formCpf(name: 'cpf', id: 'input_login', label: 'Digite seu cpf', placeholder: 'Digite seu cpf')
                @ elseif ($client_id == 'KPrsQbkiB6PIDoAW0Ri47g'  && (false === $dependente)) :
                    @php
                        $txt_indicacao = !$indicacao ? 'DIGITE SEU CÓDIGO ABERT'  : 'DIGITE SEU E-MAIL';
                    @end
                    @? formInput(label: $txt_indicacao, placeholder: $txt_indicacao)
                @ elseif ($client_id == 'KPrsQbkiB6PIDoAW0Ri47g'  && (true === $dependente)) :
                    @? formInput(name: 'email_cpf', id: 'input_login', label: 'Digite seu e-mail ou cpf', placeholder: 'Digite seu e-mail ou cpf', id: 'input_login_recuperar_senha')
                @ else :
                    @php
                        $txt_indicacao = !$indicacao ? 'DIGITE SEU E-MAIL OU CPF' : 'DIGITE SEU E-MAIL';
                    @end
                    @? formInput(name: 'email_cpf', id: 'input_login', label: 'Digite seu e-mail ou cpf', placeholder: 'Digite seu e-mail ou cpf')
                @ endif;
            </div>
            @ if (!$indicacao) :
                <div class="bloco_login senha">
                    @? formSenha(name: 'password', id: 'input_senha', label: 'Digite sua senha', placeholder: 'Digite sua senha')
                </div>
            @ endif;

            <div class="captcha" id="recaptcha_login"></div>

            @if ($tipo === 'ANABB') :
                <div class="botao">
                    <button class="enviar" id="botao_fazer_login" type="button">LOGAR</button>
                </div>
            @else :
                <div class="botao">
                    <button class="enviar"  id="botao_fazer_login">LOGAR</button>
                </div>
            @endif;
            <div class="link_acao">
                @if (!$indicacao && $tipo !== 'ANABB') :
                    <button class="botao_texto" tabindex="-1" type="button" id="botao_ir_codigo">Esqueceu sua senha?</button>
                @endif;
                @if ($link_cadastro && !$indicacao) :
                    <a class="botao_texto" tabindex="-1" href="{!!$link_cadastro!!}">Não tem cadastro?</a>
                @endif;
            </div>

            @if (!$indicacao && $client_id != 'U6t5Dcu15JjyISqmZl79jT' && $tipo !== 'ANABB') :
                <div class="bloco_ativar">
                    @if (false === $dependente) :
                        <a id="botao_ativar_cadastro" href="{!!route('login.ativar')!!}">PRIMEIRO ACESSO</a>
                    @else :
                        <a id="botao_ativar_cadastro" href="{!!route('login.ativar')!!}?&dependente=sim">PRIMEIRO ACESSO</a>
                    @endif;
                </div>
            @endif;

            @if ($tipo == 'browser' && !$indicacao) :
                <a href="{{LINK}}" class="voltar">VOLTAR</a>
            @else :
                <div class="footer"></div>
            @endif;
        </form>

    </div>
    <div class="auth_bloco_geral_site" id="auth_bloco_codigo">
        <form id="auth_form_codigo" autocomplete="off" class="auth_form_geral form_geral" action="{!!route('login.enviarCodigo')!!}" method="post">
            <div class="auth_loading"><span></span></div>


            <legend>ENVIAR CÓDIGO</legend>
            <p>Para recuperar sua senha, solicite um código digitando seu login e clicando no botão abaixo:</p>

            <input type="text" class="input_hidden">
            <input type="password" class="input_hidden">

            <div class="bloco_input login">
                @? formInput(name: 'email_cpf', label: 'Digite seu e-mail ou cpf', placeholder: 'Digite seu e-mail ou cpf', id: 'input_login_recuperar_senha')
            </div>

            <div class="captcha" id="recaptcha_recuperar_senha"></div>

            <div class="botao botao_centralizado botao_codigo">
                <button class="enviar" id="botao_enviar_codigo" type="button">ENVIAR CÓDIGO</button>
            </div>

            <button type="button" id="botao_voltar_codigo_senha" class="voltar">VOLTAR</button>
        </form>
    </div>

    <div class="auth_bloco_geral_site" id="auth_bloco_validar_codigo">
        <form id="auth_form_validar_codigo" autocomplete="off" class="auth_form_geral form_geral" action="{!!route('login.validarCodigo')!!}" method="get">
            <div class="auth_loading"><span></span></div>


            <legend>VALIDAR CÓDIGO</legend>
            <p>Digite o código nos campos abaixo. O código foi enviado para o e-mail <strong id="email_recuperacao"></strong> e tem validade de 20 minutos. Caso esteja demorando a chegar, verifique sua caixa de spam.</p>

            <input type="text" class="input_hidden">
            <input type="password" class="input_hidden">

            <input type="text" class="codigo_escondido" id="input_codigo" value="">
            <div class="codigo">
                <input type="text" inputmode="numeric" name="codigo[]" value="">
                <input type="text" inputmode="numeric" name="codigo[]" value="">
                <input type="text" inputmode="numeric" name="codigo[]" value="">
                <input type="text" inputmode="numeric" name="codigo[]" value="">
                <input type="text" inputmode="numeric" name="codigo[]" value="">
                <input type="text" inputmode="numeric" name="codigo[]" value="">
            </div>

            <div class="botao botao_centralizado bloco_validar_codigo">
                <button class="enviar" id="botao_validar_codigo" type="button">VALIDAR CÓDIGO</button>
            </div>

            <button type="button" id="botao_voltar_validar_codigo_codigo" class="voltar">VOLTAR</button>
        </form>
    </div>

    <div class="auth_bloco_geral_site" id="auth_bloco_nova_senha">
        <form id="auth_form_nova_senha" autocomplete="off" class="auth_form_geral form_geral" action="{{LINK}}/auth/nova-senha" method="post">
            <div class="auth_loading"><span></span></div>

            <legend>NOVA SENHA</legend>
            <p>Digite sua nova senha nos campos abaixo</p>

            <div class="senha_dica">
                <p>Sua senha deve:</p>
                <ul>
                    <li>Ter pelo menos 8 caracteres</li>
                    <li>Ter pelo menos uma letra minúscula</li>
                    <li>Ter pelo menos uma letra maiúscula</li>
                    <li>Ter pelo menos um símbolo</li>
                    <li>Ter pelo menos um número</li>
                </ul>
            </div>
            <input type="text" class="input_hidden">
            <input type="password" class="input_hidden">

            <div class="nova_senha">
                @? formSenha(name: 'password', id: 'input_senha', label: 'Digite a sua nova senha', placeholder: 'Digite a sua nova senha')
            </div>
            <div class="repetir_senha">
                @? formSenha(name: 'password', id: 'input_senha', label: 'Repita e confirme a nova senha', placeholder: 'Repita e confirme a nova senha')
            </div>

            <div class="botao botao_centralizado">
                <button class="enviar" id="botao_enviar_senha" type="button">SALVAR SENHA</button>
            </div>

            <button type="button" id="botao_voltar_nova_senha_senha" class="voltar">VOLTAR</button>
        </form>
    </div>

</div>
