@template "site"
@resource "site/variavel"
p,div
    margin: 0px
    padding: 0px
    font-size: 16px

.texto_claro
    color: #FFF
    font-weight: bold

#carteirinha_clube
    width: 100%
    height: 100%
    padding: 20px
    box-sizing: border-box

#carteirinha_clube .bloco_frente
    height: 250px
    width: 500px
    border-radius: 10px
    box-shadow: 3px 2px 11px 3px rgba(0,0,0,0.3)
    background-size: cover
    border-top: 10px solid #ff6000
    display: flex
    justify-content: flex-end
    flex-direction: column

#carteirinha_clube .bloco_frente .bloco_logo
    height: 30%
    text-align: center
    width: 100%
    padding-top: 10px

#carteirinha_clube .bloco_frente .bloco_dados
    height: 70%
    display: flex
    flex-direction: column
    justify-content: flex-end

.bloco_frente .dados_carteirinha
    padding: 5px
    background-color: #eee
    border-radius: 5px

.bloco_nome .dados_carteirinha
    width: 60%

.bloco_cpf .dados_carteirinha
    width: 80%

.bloco_data_emissao .dados_carteirinha
    width: 80%

#carteirinha_clube .bloco_dados .bloco_nome
    flex-direction: column

.bloco_dados .bloco_nome, .bloco_dados .bloco_estado
    height: 20%
    width: 100%

.bloco_dados .bloco_nome
    padding-left: 20px

.bloco_dados .bloco_estado
    text-align: center

.bloco_dados .dois_blocos
    display: flex
    width: 100%
    height: 60%
    padding-top: 10px

.dois_blocos .bloco_cpf, .dois_blocos .bloco_data_emissao
    flex-direction: column
    width: 50%

.dois_blocos .bloco_cpf
    padding: 20px 0px 0px 20px

.dois_blocos .bloco_data_emissao
    display: flex
    align-items: flex-start
    justify-content: flex-start
    padding: 20px 20px 0px 0px

@media screen and (max-width: 560px)
    #carteirinha_clube
        display: flex
        justify-content: center
        align-items: center

@media screen and (max-width: 425px)
    #carteirinha_clube
        rotate: 90deg
    #carteirinha_clube .bloco_frente
        width: 486px
        height: 250px
        left: 50%
        position: absolute

