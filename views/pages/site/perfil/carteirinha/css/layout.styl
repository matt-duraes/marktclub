@resource "site/variavel"

#carteirinha_clube p,div
    margin: 0px
    padding: 0px

.texto_claro
    color: #FFF
    font-weight: bold

#carteirinha_clube
    width: 100%
    height: 100%
    box-sizing: border-box

#carteirinha_clube .bloco_frente
    min-height: 250px
    height: 250px
    width: 500px
    border-radius: 10px
    box-shadow: 3px 2px 11px 3px rgba(0,0,0,0.3)
    background-size: cover
    display: flex
    flex-direction: column

#carteirinha_clube .bloco_frente .bloco_logo
    height: 20%
    text-align: center
    width: 100%
    padding-top: 5px

#carteirinha_clube .bloco_frente .bloco_dados
    height: 80%
    display: flex
    flex-direction: column

.bloco_dados .dois_blocos
    display: flex
    width: 100%
    height: 60%
    padding-top: 10px

.dois_blocos .bloco_cpf, .dois_blocos .bloco_data_emissao
    flex-direction: column
    width: 50%

.dois_blocos .bloco_cpf
    padding: 20px 0px 0px 20px

.dois_blocos .bloco_data_emissao
    display: flex
    align-items: flex-start
    justify-content: flex-start
    padding: 20px 20px 0px 0px

.bloco_infos
    padding: 2px
    max-width: 60%
    margin-left: 10px
    color: black
    border-radius: 6px
    flex-direction: column
    padding-left: 20px
    margin-top: 5px
    background-color: #fff

@media screen and (max-width: 560px)
    #carteirinha_clube
        display: flex
        justify-content: center
        align-items: center

@media screen and (max-width: 425px)
    #carteirinha_clube
        rotate: 90deg
    #carteirinha_clube .bloco_frente
        width: 486px
        height: 250px
        left: 50%
        position: absolut
