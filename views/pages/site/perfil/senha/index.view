@template "site"

<div id="bloco_pagina_senha">
    <form action="/" method="post" class="form_geral" id="form_dependente">
        <header>
            <h1>Alterar senha</h1>
            <p>Preencha os campos abaixo para resetar sua senha.</p>
        </header>
        <p>Sua senha deve ter:</p>
        <ul class="bloco_geral_ul">
            <li>Ter pelo menos 8 caracteres</li>
            <li>Ter pelo menos uma letra minúscula</li>
            <li>Ter pelo menos uma letra maiúscula</li>
            <li>Ter pelo menos um símbolo</li>
            <li>Ter pelo menos um número</li>
        </ul>
        @? formSenha(name: 'senha_atual', label: 'Senha atual', placeholder: 'Digite sua senha atual', obrigatorio: 1);
        @? formSenha(name: ['senha_nova', 'senha_repetir'], label: 'Nova senha', placeholder: ['Digite sua senha nova', 'Repita sua nova senha'], obrigatorio: 1);
        <div class="bloco_botao">
            <div></div>
            <div id="botao_salvar_senha" class="botao_geral_cor cor_bg">Cadastrar dependente</div>
        </div>
    </form>
</div>
