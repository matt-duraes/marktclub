@resource "site/variavel"
@resource "site/mixim"
@template "site"
@resource "site/form_geral"
@resource "site/tabela"

h1
    titulo()
p, button
    texto()
.bloco_tem_mais_acao,
.bloco_tabela_cvs
    blocoShadow()
    width: 100%
    max-width: $maxWidth
.titulo
    bold()
.bloco_tem_mais_acao
    .valores_troca
        margin: 20px 0px
    .link_regulamento
        texto()
        border-bottom: 1px solid $corClube
        color: $corPretoBranco
        cursor: pointer
        margin-top: 10px
    .bloco_saldo
        margin-bottom: 20px
.bloco_tabela_cvs
    margin-top: 20px
    .vazio td
        width: 100%
        height: 150px
        text-align: center
        vertical-align: middle
        padding: 0 10px
        font-size: 1rem
        font-weight: bold
        color: #D1D1D1
    label
        texto()
        font-weight: bold
        border-right: 1px solid #ccc
        border-bottom: 1px solid #ccc
        text-align: center
        cursor: pointer
        padding: 10px
        border-radius: 5px
        &:checked
            background-color: #ccc
            color: $corClube
        &:last-child
            margin-left: 20px
        &:hover
            background-color: #ccc
            color: $corClube
#tabela_historico
    display: none
