                </tbody>
            </table>
            <?php if (isset($r->pagina) && $r->pagina && isset($r->pagina->total) && $r->pagina->total > 1) : ?>
                <div class="bloco_paginacao">
                    <?php if ($r->pagina->atual == 1) : ?>
                        <div class="texto atual busca_mais" data-atual="1">PRIMEIRA</div>
                    <?php else : ?>
                        <p class="texto busca_mais" data-atual="1">PRIMEIRA</p>
                    <?php endif; ?>
                    <?php for ($i = 1; $i <= $r->pagina->total; $i++) : ?>
                        <?php if ($i == $r->pagina->atual) : ?>
                            <div class="numero atual busca_mais" data-atual="<?= $i ?>"><?= $i ?></div>
                        <?php elseif ($r->pagina->atual == 1) : ?>
                            <p class="numero busca_mais" data-atual="<?= $i ?>"><?= $i ?></p>
                        <?php else : ?>
                            <p class="numero busca_mais" data-atual="<?= $i ?>"><?= $i ?></p>
                        <?php endif; ?>
                    <?php endfor; ?>
                    <?php if ($r->pagina->total == $r->pagina->atual) : ?>
                        <div class="texto atual busca_mais" data-atual="<?= $r->pagina->total ?>">ÚLTIMA</div>
                    <?php else : ?>
                        <p class="texto busca_mais" data-atual="<?= $r->pagina->total ?>">ÚLTIMA</p>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
