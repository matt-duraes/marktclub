                        <div class="numero atual busca_mais" data-atual="<?= $i ?>"><?= $i ?></div>
                    @elseif ($r->pagina->atual == 1)
                        <p class="numero busca_mais" data-atual="<?= $i ?>"><?= $i ?></p>
                    @else
                        <p class="numero busca_mais" data-atual="<?= $i ?>"><?= $i ?></p>
                    @endif
                @endfor
                @if ($r->pagina->total == $r->pagina->atual)
                    <div class="texto atual busca_mais" data-atual="<?= $r->pagina->total ?>">ÚLTIMA</div>
                @else
                    <p class="texto busca_mais" data-atual="<?= $r->pagina->total ?>">ÚLTIMA</p>
