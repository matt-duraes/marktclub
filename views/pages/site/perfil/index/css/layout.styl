@system "Loading"
@system "Pagina"
@system "Alerta"
@template "site"
@system "Form"
@resource "site/variavel"
@resource "site/loja/busca"

#bloco_pagina_perfil
	width: 100%
	max-width: $maxWidth
	espacoBottomPadrao()
	.conteudo
		padding: 0px 20px
	.conteudo .foto
		flexRow()
		figure
			width: 150px
			height: 150px
			flexRow()
			padding-bottom: 20px
			backgroundCoverCenterNotRepeat()
			border-radius: 50%
			boxShadow()
		.legenda
			alignItemStart()
			justify-content: center
			margin-left: 20px
		.legenda article
			flexCol()
			h1
				texto()
				text-transform: capitalize
			p
				texto()
				color: #666
			p:nth-child(1)
				margin-top: 10px
		.legenda .google
			display: flex
			height: 40px
			texto()
			blocoShadow()
			espacoVerticalPadrao()
			cursor: pointer
			.texto, i
				height: 100%
				flexCenter()
				padding: 0px 14px
			.texto
				flexCenter()
				padding: 0px
				font-dize: 1em
				color: #808080
			.logo-google
				width: 40px
				height: 100%
				flexCenter()
			.logo-google img
				width: 25px
	.conteudo form
		width: 100%
		flexCol()
		max-width: 700px
		espacoTopPadrao()
		button
			buttonCard()
			align-self: start
		button:hover
			hoverButtonPadrao()
		p
			subTitulo()
		fieldset
			width: 100%
			flexCol()
			blocoShadow()
			margin-bottom: 20px
			border-radius: 15px
			background-color: $branco
			.duplo_label
				width: 100%
				spaceBetween()
				.bloco_input:nth-child(1)
					margin-right: 20px
