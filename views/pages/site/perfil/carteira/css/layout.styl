@resource "site/variavel"
@resource "site/mixim"

p,div
    margin: 0px
    padding: 0px
#carteirinha_clube
    width: 100%
    height: 100%
    box-sizing: border-box
#carteirinha_clube .bloco_frente
    height: 250px
    width: 500px
    border-radius: 10px
    box-shadow: 3px 2px 11px 3px rgba(0,0,0,0.3)
    background-size: cover
#carteirinha_clube .bloco_frente
    width: 450px
    height: 250px
    .bloco_logo
        height: 30%
        text-align: center
        width: 100%
        padding-top: 10px
    .bloco_dados
        height: 70%
        display: flex
        flex-direction: column
        justify-content: flex-end
        .dados_carteirinha
            padding: 5px 0px 0px 10px
        .bloco_nome
            flex-direction: column
        .bloco_nome,.bloco_estado
            height: 20%
            width: 100%
        .bloco_nome
            padding-left: 20px
        .bloco_estado
            text-align: center
        .dois_blocos
            display: flex
            width: 100%
            height: 60%
            .bloco_cpf, .bloco_data_emissao
                flex-direction: column
                width: 50%
            .bloco_cpf
                padding: 20px 0px 0px 20px
            .bloco_data_emissao
                display: flex
                align-items: flex-end
                justify-content: flex-start
                padding: 20px 20px 0px 0px
@media screen and (max-width: 525px)
    #carteirinha_clube
        height: 100%
        width: 100%
        display: flex
        justify-content: center
    #carteirinha_clube .bloco_frente
        width: 60%
        height: 300px
        font-size: 1.3rem
