@resource "site/variavel"
@resource "site/mixim"

#bloco_carteirinha
    width: 100%
    display: flex
    padding: 10px
.bloco_frente, .bloco_atras
    width: 450px
    height: 250px
    margin-right: 20px
    border-radius: 5px
    box-shadow: 3px 2px 11px 3px rgba(0,0,0,.1)

/*CARTEIRA SINPOLDF*/

#container_sinpol_frente
    height: 100%
    width: 100%
    display: flex
    justify-content: flex-end
    align-items: flex-end
    flex-direction: column
    color: white
    .um_bloco
        width: 100%
        height: 20%
        p
            color: white
            font-weight: bold
            margin-left: 8px
            font-size: 0.73rem
        .dados_carteirinha
            width: 80%
            background-color: white
            border-radius: 5px
            margin-top: 5px
            padding: 5px
            color: black
    .dois_blocos
        display: flex
        width: 100%
        height: 30%
        margin-top: 20px
        p
            color: white
            font-weight: bold
            margin-left: 8px
            margin-top: 7px
            font-size: 0.73rem
        .dados_carteirinha
            width: 70%
            background-color: white
            border-radius: 5px
            margin-top: 5px
            height: 18px
            text-align: center
            padding: 2px
            color: black
        .data_filiacao_sinpol
            width: 50%
        .matricula_sinpol
            width: 50%
            .dados_carteirinha
                width: 80%
                min-height: 15px
#container_sinpol_fundo
    height: 100%
    margin-top: 25px
    width: 100%
    justifyCenter()
    flex-direction: column
    color: white
    .um_bloco
        width: 100%
        height: 20%
        .data_nascimento
            width: 100%
            height: 100%
        p
            color: white
            font-weight: bold
            margin-left: 16px
            font-size: 0.73rem
        .dados_carteirinha
            width: 40%
            margin-left: 16px
            text-align: center
            max-heigth: 18px
            background-color: white
            border-radius: 5px
            margin-top: 3px
            padding: 2px
            height: 18px
            color: black
    .dois_blocos
        display: flex
        width: 100%
        height: 30%
        p
            color: white
            font-weight: bold
            text-align center
            margin-left: 8px
            margin-top: 7px
            font-size: 0.73rem
            height: 18px
        .dados_carteirinha
            width: 80%
            margin: auto
            background-color: white
            border-radius: 5px
            margin-top: 5px
            min-height: 8px
            text-align center
            padding: 2px
            color: black
        .rg
            width: 50%
        .cpf
            width: 50%
            .dados_carteirinha
                width: 80%
    .data_emissao
        text-align: center
        margin-top: 15px

/*FIM SINPOLDF*/


/*CARTEIRA CEMECARD*/

#dados_cemecard
    width: 100%
    height: 85%
    padding: 15px
    display: flex
#dados_cemecard .bloco_esquerda
    width: 30%
    justifyCenter()
    flex-direction: column
    text-align: center
#dados_cemecard .bloco_esquerda .bloco_status
    flexCenter()
    height: 20%
    width: 100%
#dados_cemecard .bloco_esquerda .bloco_status .status
    flexCenter()
    background-color: white
    width: 80%
    height: 70%
    border-radius: 5px
    .circulo_status
        margin-right: 5px
        width: 10px
        border-radius: 50%
        height: 10px
        background-color:green
    .circulo_status_inativo
        margin-right: 5px
        width: 10px
        border-radius: 50%
        height: 10px
        background-color:red
    p
        font-weight: bold
#dados_cemecard .bloco_esquerda .bloco_qrcode
    height: 60%
    width: 100%
    flexCenter()
    .qrcode
        border-radius: 10px
        width: 80%
        height: 80%
        background-color: white
        img
            width: 100%
            height: 100%
#dados_cemecard .bloco_esquerda .bloco_tipo
    height: 20%
    width: 100%
    flexCenter()
    h2
        text-transform: uppercase
        color: white
        font-weight: bold
        font-size: 12px
#dados_cemecard .bloco_direita
    width: 70%
    height: 100%
    .bloco_nome
        height: 60%
        width: 100%
        alignItemCenter()
        justify-content: flex-end
        p
            border-right: 3px solid white
            padding-right: 5px
            margin-top: 20px
            width: 70%
            font-size: 16px
            color: white
            font-weight: bold
            text-align: end
#dados_cemecard .bloco_direita .bloco_info
    height: 40%
    width: 100%
    display: flex
    .data_cemecard
        flexCol()
        align-items: center
        width: 50%
        height: 100%
        p
            opacity: 0.9
            margin: 5px
            font-size: 10px
            font-style: u
            color: white
        h2
            font-weight: bold
            color: white
            font-size: 15px
    .numero_cartao
        width: 50%
        height: 100%
        flexCol()
        align-items: center
        p
            opacity: 0.9
            margin: 5px
            font-size: 10px
            font-style: u
            color: white
        h2
            font-weight: bold
            color: white
            font-size: 15px

/*FIM CEMECARD*/

/*CARTEIRA SINDFAZENDA*/
#carteirinha_sindfazenda
    border-radius: 5px
    flexCol()
    font-size: 1.4em
    height: 100%
#carteirinha_sindfazenda .titulo_dados
    margin-bottom: 5px
    font-weight: bold
    font-size: 1.2rem
    color: #104580
#carteirinha_sindfazenda .documento .titulo_dados
    font-size: 0.9rem
    margin-left: 5px
#carteirinha_sindfazenda .bloco_logo
    height: 20%
    padding-top: 5px
    margin: auto

#carteirinha_sindfazenda .bloco_dado_duplo
    flexCol()
    justify-content: flex-end
    margin-left: 20px
    height: 40%

#carteirinha_sindfazenda .bloco_dados
    flexCol()
    justify-content: flex-end
    height: 40%
    align-items: center
    margin-right: 45px

/*FIM SINDFAZENDA*/

/*CARTEIRINHA PADRÃO*/
#carteirinha_padrao
    height: 100%
    width: 100%
    flexCol()
    margin: 0px
    .bloco_dado
        flex: 1
        width: 100%
        display: flex
        align-items: flex-end
        justify-content: center

