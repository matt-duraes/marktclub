@system "Loading"
@system "Pagina"
@system "Form"
@system "Alerta"
@template "site"
@resource "site/variavel"
@resource "site/tabela_div"
@resource "site/form_geral"

#bloco_pagina_dependente
    width: 100%
    max-width: $maxWidth
    flexCol()
@media screen and (max-width: 1000px)
    .form_geral .bloco_grupo
        flexCol()
        > div
            margin-right: 0

.bloco_zero
    margin-top: 40px

.bloco_dependente
    margin-top: 40px
    .nome
        width: calc(100% - 250px)
        min-width: 300px
    .status
        width: 150px
        min-width: 150px
        flexCol()
        align-items: flex-start
    .status p
        color: #FFF
        padding: 2px 10px
        border-radius: 30px
        texto()
    .status p.ativo
        background-color: $corVerde
    .status p.inativo
        background-color: $corVermelho
    .status span
        texto()
        margin-top: 5px
        cursor: pointer
    .deletar
        width: 100px
        min-width: 100px
        flexRow()
        justify-content: center
    .deletar i
        width: 30px
        height: 30px
        flexCenter()
        border-radius: 50%
        &:hover
            background: #EEE
            cursor: pointer

