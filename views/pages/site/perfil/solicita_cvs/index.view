<div class="bloco_popup_geral medio" id="popup_solicita_cvs">
    <header class="header_pagina_popup">
        <h1>Resgatar</h1>
        <i class="fechar botao_fechar_popup" id="botao_visualizar_fechar">@iconeFechar</i>
    </header>

    <div class="popup_conteudo centralizado conteudo_pagina_popup" id="popup_solicitacao">
        <header class="header_padrao_popup">
            <h1>Valor mínimo para resgate: 1 ponto</h1>
        </header>
        @? formInput(name: 'nome', placeholder: 'Nome', label: 'nome', obrigatorio: true, value: '')
        @? formInput(name: 'email', placeholder: 'Email', label: 'email', obrigatorio: true, value: '')
        @? formInput(name: 'quantidade', placeholder: 'Quantidade', label: 'quantidade', obrigatorio: true, value: '')
        <button id="enviar_solicitacao"> Fazer solicitação</button>
    </div>

</div>

