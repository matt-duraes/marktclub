@system "Form"
@template "site"
@resource "site/variavel"
@resource "site/loja/busca"
@resource "site/loja/parceiro"
@resource "site/loja/relacionado"
@resource "site/loja/detalhe"


#bloco_loja_confirmar
    max-width: 700px
    .conteudo_confirmar
        flexCol()
        align-items: center
        padding: 20px
    .conteudo_confirmar h1
        titulo()
    .conteudo_confirmar p
        texto()
    .conteudo_confirmar a
        margin-top: 30px

@media screen and ( max-width: 600px )
    .bloco_desconto_procedimento
        flex-direction: column
    .bloco_desconto_procedimento .bloco
        width: 100%
        &:first-child
            margin-bottom: 20px
