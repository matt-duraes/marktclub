@system "Form"
@template "site"
@resource "site/variavel"
@resource "site/loja/busca"
@resource "site/loja/parceiro"
@resource "site/loja/relacionado"
@resource "site/loja/detalhe"
#bloco_sos
    width: 100%
    max-width: $maxWidth
.bloco_banner
    width: 100%
    img
        width: 100%
    .desktop
        display: block
    .mobile
        display: none

.bloco_informacoes
    blocoShadow()
    width: 100%
    margin: 20px 0px
    display: flex
    align-items: center
    .logo
        img
            border-radius: 50%
            width: 100px
    .bloco_header
        flex: 1
        text-align: center
        p
            texto()
        h1
            titulo()

.bloco_atencao_geral
    text-align: center
#bloco_sos .bloco_botao
    margin-top: 30px
    flexCenter()
    gap: 20px
    .botao_sos
        width: 150px
        height: 40px
        border-radius: 5px
        gap: 20px
        flexCenter()
        svg, p
            texto()

@media screen and (max-width: 630px)
    .bloco_informacoes
        flexCol()
@media screen and (max-width: 375px)
    #bloco_sos .bloco_botao
        flex-direction: column
        margin-left: 10px
        .botao_sos
            width: 100%
