@template "site"

<div id="bloco_loja_detalhe" class="bloco_loja_detalhe">
    <div class="bloco_topo">
        <section class="bloco_banner">
            <figure class="banner desktop"><img src="https://clube.marktclub.com.br/images/denuncia_index_banner_parceiro.png"></figure>
            <figure class="banner mobile"><img src="https://clube.marktclub.com.br/images/denuncia_index_banner_parceiro.png"></figure>
            <figure class="logo"><img src="https://clube.marktclub.com.br/images/denuncia_index_capa_parceiro.png"></figure>
        </section>
        <header class="bloco_header">
            <h1>{{$dado->descricao->titulo}}</h1>
            <p>{{$dado->descricao->subtitulo}}</p>
        </header>
    </div>

    <div class="bloco_desconto_procedimento">
        <div class="bloco bloco_titulo_texto">
            <h1>{{$dado->como_utilizar->titulo}}</h1>
            <p>{{$dado->como_utilizar->texto}}</p>
        </div>
        <div class="bloco bloco_titulo_texto">
            <h1>{{$dado->atendimento->titulo}}</h1>
            <p>{{$dado->atendimento->texto}}</p>
        </div>
    </div>

    <div class="bloco_atencao_geral">
        <p>{{$dado->aviso->texto}}</p>
    </div>
    <div class="bloco_botao">
        <a href="" target="_blank" rel="nofollow noopener"  class="botao destaque botao_geral_cor cor_bg">
            <i>@iconeTelefone(17)</i>
            Ligar
        </a>
        <a href="" target="_blank" rel="nofollow noopener"  class="botao destaque botao_geral_cor cor_bg">
            <i>@iconeTelefone(17)</i>
            Chat
        </a>

    </div>
    @view site/geral/relacionado.view
</div>
