@template "site"

<div id="bloco_loja_detalhe" class="bloco_loja_detalhe">
    <div class="bloco_topo">
        <section class="bloco_banner">
            <figure class="banner desktop"><img src="https://clube.marktclub.com.br/images/denuncia_index_banner_parceiro.png"></figure>
            <figure class="banner mobile"><img src="https://clube.marktclub.com.br/images/denuncia_index_banner_parceiro.png"></figure>
            <figure class="logo"><img src="https://clube.marktclub.com.br/images/denuncia_index_capa_parceiro.png"></figure>
        </section>
        <header class="bloco_header">
            <h1>PRECISA DE AJUDA?</h1>
            <p>Atenção! Esta página é voltada ao suporte à mulher. <br>
                Em caso de emergência, ligue para o 180.
            </p>
        </header>
    </div>

    <div class="bloco_desconto_procedimento">
        <div class="bloco bloco_titulo_texto">
            <h1>Como Utilizar?</h1>
            <p>
                Agende uma conversa.
                Para utilizar essa ferramente, basta apertar o botão encontrar parceiros.
                Aqui você localiza empresas que disponibilizam o serviço de atendimento online.
            </p>
        </div>
        <div class="bloco bloco_titulo_texto">
            <h1>Atendimento online</h1>
            <p>Aqui você será redirecionada para o chat do Ministério dos Direitos Humanos.
                Ao entrar em contato por esse campo, você encontra uma forma mais silenciosa e segura de denunciar.
            </p>
        </div>
    </div>

    <div class="bloco_atencao_geral">
        <p>
            Os canais acima não são do Markt Club.
            Você será redirecionado aos órgãos responsáveis pelo atendimento.
        </p>
    </div>

    @view site/geral/relacionado.view
</div>
