<div class="bloco_popup_geral medio" id="popup_enquete">
    <header class="header_pagina_popup">
        <h1>Título do Popup</h1>
        <i class="fechar botao_fechar_popup" id="botao_visualizar_fechar">@iconeFechar</i>
    </header>

    <div class="popup_conteudo centralizado conteudo_pagina_popup">
        <header class="header_padrao_popup">
            <h1>Texto popup</h1>
        </header>
        <form id="form_buscar_mobile" action="" class="form_geral" method="post">

            @? formTextarea(name: 'mensagem', numeroLinha: 4, placeholder: 'Digite uma mensagem', label: 'Digite uma mensagem', value: '')

            <ul>
                <li></li>
            </ul>

            <div class="resto"></div>

            <div class="footer_pagina_popup">
                <button class="button enviar botao_geral_cor cor_bg" id="busca_resgate">RESGATAR</button>
            </div>
        </form>
    </div>

</div>

