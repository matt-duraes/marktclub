@template "site"
@system "Alerta"
@system "Loading"
@system "Banner"
@system "Popup"
@resource "site/item_lista"
@resource "site/pagina_popup"
@resource "site/banner"

#bloco_lg
    width: 100%
    max-width: $maxWidth
    #banner_fixo
        margin-bottom: 30px
    .atencao
        text-align: center
    .atualizar
        margin: 20px 0
        flexCol()
        align-items: flex-start
    .atualizar .zero
        margin: 10px 0 15px
    .atualizar p span
        texto()
    .atualizar p strong
        texto()
        font-weight: bold
    .atualizar .botao
        botaoPadraoPequeno()
        background-color: $corClube
        color: #FFF
    #bloco_botao_lg
        display: flex
        align-items: center
        gap: 20px
    #bloco_botao_lg a
        texto()
        justify-content: center
        align-items: center
        display: flex
        flex: 1
        color: $corClube
        border: 1px solid $corClube
        border-radius: 5px
        padding: 2px 10px
        height: 28px
    .bloco_botao
        width: 100%
        flexCol()
        align-items: center
        margin-top: 16px
    .bloco_botao a
        botaoPadraoGrande()
        background-color: $corClube
        color: #FFF
        gap: 5px
        flexCenter()

@media screen and (max-width: 400px)
    #bloco_lg #bloco_botao_lg
        flex-direction: column
        gap: 10pxs
        width: 100%
    #bloco_lg .atualizar
        padding: 10px
    #bloco_lg .atualizar .botao,
    #bloco_lg #bloco_botao_lg a
        width: 100%
    #bloco_lg #bloco_botao_lg a
        margin-bottom: 20px
    #bloco_lg .atencao
        text-align: left
        padding-bottom: 0px
    .bloco_atencao_geral.atencao p:not(last-child)
        margin-bottom: 10px
