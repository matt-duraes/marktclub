@template "site"
<div class="conteudo_principal_acesso_rapido" id="acesso_rapido">
    <section class="info_acesso">
        <h1>Bem-vindo(a), {{USUARIO_NOME}}</h1>
        <p>O que você deseja fazer hoje? Selecione uma das opções abaixo.</p>
    </section>

    <nav class="links_acesso_rapido">
        <a class="botao" id="botao_tema">
            <i>@iconeTema</i>
            Mudar Tema
        </a>
        @view site/geral/menu/index.view
        @view site/geral/menu/perfil_menu.view
        @view site/geral/menu/submenus.view
    </nav>
</div>
