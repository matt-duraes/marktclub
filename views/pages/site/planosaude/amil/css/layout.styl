/*CSS MODAL*/
.popup_modal_saude
    font-family: Arial, sans-serif
    overflow: auto

.table_modal_preco
    width: 100%
    border-collapse: collapse
    margin-top: 20px

.table_modal_preco th, .table_modal_preco td
    padding: 10px
    text-align: center
    border: 1px solid #ddd

.table_modal_preco th
    font-weight: bold
    background-color: #f2f2f2
    color: #333

.table_modal_preco tr:nth-child(even)
    background-color: #f2f2f2

.titulo_table
    font-weight: bold
    background-color: #ddd
    color: #333

.titulo_table th
    text-align: center

.table_modal_preco td:first-child
    font-weight: bold
    text-align: left

.table_modal_preco th:first-child
    text-align: left
    font-weight: bold


    .bloco_botao_plano button
        margin: 0px 10px

@media screen and (max-width: 830px)
    .bloco_titulo_texto_centralizado .bloco_botao_plano
        flex-direction: column
        button
            margin-right: 0px
            width: 80vw
