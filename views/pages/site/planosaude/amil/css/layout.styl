@system "Form"
@template "site"
@resource "site/loja/busca"
@resource "site/variavel"
@resource "site/saude/operadora"
@resource "site/tabela"
@resource "site/popup"

.bloco_titulo_texto_centralizado
    espacoTopPadrao()
    blocoShadow()
    min-height: 100px
    h1
        text-align: center
    .bloco_botao_plano
        flexCenter()
        margin-top: 5px
        min-height: 100px
        text-align: center
        button
            text-align: center
            margin-top: 25px
            width: 200px
            margin-right: 20px
            border-radius: 10px
            height: 50px

/*REEMBOLSO*/
.bloco_reembolso
    espacoTopPadrao()
    blocoShadow()
    min-height: 700px
    overflow: auto
    width: 100%
    table
        border-collapse: collapse
        margin: 20px 0
        thead tr th,
        tbody tr td
            padding: 10px
            text-align: center
            border: 1px solid #ccc
    table thead tr th
        font-weight: bold
    table tbody tr:nth-child(even)
        background-color: #f2f2f2
    table tbody tr td:first-child
        font-weight: bold

