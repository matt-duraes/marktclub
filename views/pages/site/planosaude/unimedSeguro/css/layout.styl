@system "Form"
@template "site"
@resources "site/loja/busca"
@resources "site/variavel"
@resource "site/saude/padraoIndex"

#bloco_federal_saude
    h1
        titulo()
    p 
        texto()
.bloco_federal_saude
    width: 100%
    max-width: $maxWidth
    blocoShadow()
    .imagem_banner
        width: 100%
        height: 200px
        img
            width: 100%
            height: 100%
            object-fit: cover
    h1,p
        espacoTopPadrao()
        text-align: center
    .bloco_opcao
        text-align: center
        button
            min-height: 55px
            texto()
            min-width: 250px
            border-radius: 5px
            margin: 25px
.inativo
    display: none
.ativo
    display: block

.container_contratacao
    width: 100%
    max-width: $maxWidth
    .bloco_contratar_federal
        width: 100%
        blocoShadow()
        h1
            text-align: center
            espacoBottomPadrao()
        .bloco_card_plano
            espacoBottomPadrao()
            flexCenter()
            .card_plano_saude
                margin: 0px 25px
                height: 200px
                width: 300px
                flexCenter()
                boxShadow()
                &:hover
                    border: 1px solid #ccc
                figure
                    height: 60px
                    width: 180px
                    margin: auto
                h1
                    padding-top: 20px
    .bloco_video_teleorientacao
        flexCenter()
        flexCol()
        margin-top: 25px
        blocoShadow()
        width: 100%
        h1
            margin-bottom: 0px
        p
            margin-bottom: 25px
        iframe
            margin-bottom: 25px 
        .link_teleorientacao
            width: 100%
            display: flex
            justify-content: center
            align-items: center
            a
                font-size: 1.2rem
                vertical-align: middle
                text-align: center
                margin: 25px
                padding: 20px
                border-radius: 5px
                max-width: 300px
.bloco_solicitar_federal
    width: 100%
    blocoShadow()
    h1
        text-align: center
        espacoBottomPadrao()
    .bloco_card_plano
        espacoBottomPadrao()
        flexCenter()
        .card_plano_saude
            margin: 0px 25px
            height: 200px
            width: 300px
            flexCenter()
            boxShadow()
            &:hover
                border: 1px solid #ccc
            figure
                height: 60px
                width: 180px
                margin: auto
            h1
                padding-top: 20px
@media screen and (max-width:650px)
    .bloco_card_plano
        flex-direction: column
    .bloco_card_plano .card_plano_saude
        width: 100% !important
        margin: 25px !important
    .link_teleorientacao
        flexCol()
    iframe 
        width: 100%

@media screen and (max-width:485px)
    .bloco_federal_saude
        height: 550px

.bloco_saude .bloco_explore_rede
    border-top-left-radius: 0px
    border-top-right-radius: 0px
.bloco_saude .bloco_plano_saude .bloco_lista 
    box-shadow: none
    margin: 0px
    .lista_passo_a_passo
        margin: 0px
        ul li
            font-size: 1.6rem
        ul li span
            font-size: 1em
            bold()
.table_container p
    margin-top: 10px
