@template "site"

@php
if(!function_exists('componenteLoading')) {
    function componenteLoading($lista) {
        foreach($lista as $r) {
            if(!file_exists(ROOT . '/views/site/pagina/componente/' . $r->tipo . '.view')) {
                continue;
            }
            $View = new ResourcesSite\Componente\View($r);
            include ROOT . '/files/build/views/site_pagina_componente_' . $r->tipo . '.php';
        }
    }
}
@end

<form action="">
    <input type="hidden" id="input_url" value="{{$url}}">
</form>
<div id="bloco_pagina">
    @php
        componenteLoading($html);
    @end
</div>
