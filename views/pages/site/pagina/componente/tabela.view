@php

$tabela = $r->tabela ?? [];
$tamanho = [];
$tamanhoTotal = 0;
$existeHeader = false;
$auto = [];
$header = $tabela['header'] ?? [];
$linhaLista = $tabela['linha'] ?? [];

if(!function_exists('comTabelaLinha')) {
    function comTabelaLinha($lista, $classeTr, $tamanho, $tamanhoTotal, $auto) {
        $classeTr = !empty($classeTr) ? $classeTr . ' ' : '';
        echo '<div class="' . $classeTr . 'tr" data-fwcss="min-width: ' . $tamanhoTotal . 'px">';
        foreach($lista as $i => $r) {
            $classe = ['td'];
            $width = 'data-fwcss="width: ' . $tamanho[$i] . 'px"';
            if(in_array($i, $auto)) {
                $width = 'data-fwcss="min-width: ' . $tamanho[$i] . 'px"';
                $classe[] = "td_auto";
            }
            echo '<div class="' . implode(' ', $classe) . '" ' . $width . '>' . strLang($r['valor']) . '</div>';
        }
        echo '</div>';
    }
}

foreach($header as $i => $r) {
    if(!empty($r['valor'])) {
        $existeHeader = true;
    }
    if($r['auto']) {
        $auto[] = $i;
    }
    $tamanho[$i] = $r['tamanho'];
    $tamanhoTotal += $r['tamanho'] > 0 ? $r['tamanho'] : 0;
}

$viewTabela = $View->class();
$hash = $View->api();

echo $View->css();
echo <<<HTML
<div $viewTabela data-hash="$hash">
    <div class="com_tabela_scroll">
        <div class="com_tabela_conteudo">
HTML;
if($existeHeader) {
    comTabelaLinha($header, 'header', $tamanho, $tamanhoTotal, $auto);
}
foreach($linhaLista as $linha) {
    comTabelaLinha($linha, '', $tamanho, $tamanhoTotal, $auto);
}
echo <<<HTML
        </div>
    </div>
</div>
HTML;
@end
