@system "Form"
@template "site"
@system "Pagina"
@resource "site/banner"
@resource "site/variavel"
@resource "site/tab"
@resource "site/tabela"
@resource "site/geral"
@system "Variavel"

#bloco_pagina_cashback
    width: 100%
    flexCenter()
    position: relative

#bloco_pagina_cashback .conteudo
    maxWidth()
    figure
        flexCenter()
        espacoBottomPadrao()

#bloco_pagina_cashback .conteudo .bloco_saldo
    width: 100%
    gap: 20px
    .regulamento
        width: 230px
        flexCenter()
        bordaSolida()
        color: $corClube
    .saldo_conta
        margin: 20px 0px 10px
        p
            texto()
            font-weight: bold
        span
            texto()
            font-weight: bold
            margin-left: 5px

div#botao_popup_resgate
    width: 190px
    height: 40px
    border-radius: 5px
    background-color: $corClube
    flexCenter()
    color: #fff
    cursor: pointer
    texto()

.bloco_atencao_geral
    margin: 20px 0px
    background: $corBrancoCinza
#botao_popup_resgate
    margin-bottom: 10px
.bloco_extrato
    padding: 10px 0px 20px
    espacoTopPadrao()
    blocoShadow()
    background: $corBrancoCinza
    h1
        titulo()
        color: $corClube
        margin-bottom: 20px

@media screen and (max-width: 425px)
    #bloco_pagina_cashback .conteudo .saldo
        flex-direction: column
        align-items: flex-start
        margin: 10px 0px 40px
        .saldo_conta
            border: none
            justify-content: flex-start

#bloco_pagina_cashback  .bloco_tabela_geral
    table
        box-shadow: none
        text-align: center
        min-width: auto
    table thead tr th
        background: $corBoxShadow
        font-weight: bold
        text-align: center
        vertical-align: middle
        border: 1px solid #eaeef1
        width: 200px
    table .bloco_status
        text-align: center
        width: 20px
        height: 20px
        border-radius: 50%
        margin: auto
    table .creditado
        background: green
    table .negado
        background: red
    table .aguardando
        background: #ff6f00



.bloco_tab_geral .bloco_botao
    .botao.ativo, .botao:hover
        background: $corBrancoCinza
    .botao.ativo .texto_ativo,
    .botao:hover .texto_ativo
        color: $corClube

[data-theme="dark"] .bloco_tab_geral .bloco_botao
    .botao.ativo .texto_ativo,
    .botao:hover .texto_ativo
        color: $corPretoBranco

[data-theme="dark"] #conteudo_principal
    background: $corBrancoPreto

.bloco_geral_banner figure
    background-size: 60% auto
    background-repeat: no-repeat

.bloco_popup_geral .popup_conteudo
    padding: 20px
    form
        flexCenter()
        directionColumn()
    form button
        alignSelfEnd()
        width: 180px
        espacoTopPadrao()

#bloco_resgatar_ponto
    background: $corBrancoPreto
    div#botao_solicitar_ponto
        width: 200px
        height: 40px
        border-radius: 5px
        background-color: $corClube
        flexCenter()
        color: #fff
        cursor: pointer
        texto()
#bloco_resgatar_ponto .form_geral .bloco_input label
    background-color: $corBrancoCinza

#select_resgaste
    border: 1px solid #ccc
    height: 40px
    #select_resgaste
        width: 100%

.titulo_dados_bancarios
    subTituloFontSize()
    margin-top: 20px
    color: $corClube
    &:first-child
        margin-top: 0px
fieldset
    padding: 0px 10px

.conteudo_pagina_popup .bloco_botao
    display: flex
    align-items: center
    justify-content: space-between
    margin-top: 20px
    a
        texto()
@media screen and ( max-width: 425px )
    .conteudo_pagina_popup .bloco_botao
        flex-direction: column

#botao_popup_metodo
    width: 200px
    height: 40px
    border-radius: 5px
    background-color: $corClube
    flexCenter()
    color: #fff
    cursor: pointer
    texto()
    margin-top: 20px

@media screen and (max-width: 1024px)
    #bloco_pagina_cashback .bloco_tabela_geral
        overflow-x: auto
