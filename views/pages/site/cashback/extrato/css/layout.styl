@system "Form"
@template "site"
@system "Pagina"
@resource "site/banner"
@resource "site/variavel"
@resource "site/tab"
@resource "site/tabela"
@resource "site/geral"
@template "painel"
@system "Variavel"

#bloco_pagina_cashback
    width: 100%
    flexCenter()
    position: relative

#bloco_pagina_cashback .conteudo
    maxWidth()
    figure
        flexCenter()
        espacoBottomPadrao()

#bloco_pagina_cashback .conteudo .bloco_saldo
    width: 100%
    gap: 20px
    .regulamento
        width: 230px
        flexCenter()
        bordaSolida()
        color: $corClube
    .saldo_conta
        margin: 20px 0px
        p
            texto()
            font-weight: bold
        span
            texto()
            color: red
            margin-left: 5px

.bloco_atencao_geral
    margin-top: 30px
    background: $corBrancoCinza

.bloco_extrato
    padding: 10px 0px 20px
    espacoTopPadrao()
    blocoShadow()
    background: $corBrancoCinza
    h1
        font-size: $tituloFontSize
        color: $corClube
        margin-bottom: 20px

@media screen and (max-width: 425px)
    #bloco_pagina_cashback .conteudo .saldo
        flex-direction: column
        align-items: flex-start
        margin: 10px 0px 40px
        .saldo_conta
            border: none
            justify-content: flex-start


#bloco_pagina_cashback  .bloco_tabela_geral
    width: 100%
    overflow-x: hidden
    table
        box-shadow: none
    table thead tr th
        background: $corBoxShadow

.bloco_tab_geral .bloco_botao
    .botao.ativo, .botao:hover
        background: $corBrancoCinza
    .botao.ativo .texto_ativo,
    .botao:hover .texto_ativo
        color: $corClube

[data-theme="dark"] .bloco_tab_geral .bloco_botao
    .botao.ativo .texto_ativo,
    .botao:hover .texto_ativo
        color: $corPretoBranco

[data-theme="dark"] #conteudo_principal
    background: $corBrancoPreto

.bloco_geral_banner figure
    background-size: 60% auto
    background-repeat: no-repeat

.bloco_popup_geral .popup_conteudo
    padding: 20px
    form
        flexCenter()
        directionColumn()
    form button
        alignSelfEnd()
        width: 180px
        espacoTopPadrao()
