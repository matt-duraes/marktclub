                <div id="bloco_nome_01" class="conteudo">
                    <div class="bloco_tabela_geral">
                        <table>
                            <thead>
                                <tr>
                                    <th>Empresa Parceira</th>
                                    <th>Valor da Compra</th>
                                    <th>Pontos Adquiridos</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if(!empty($extratoCompra)):
                                @foreach ($extratoCompra as $r) :
                                <tr>
                                    <td>{{$r->parceiro}}</td>
                                    <td>R$ {{$r->valor_compra}}</td>
                                    <td>{{$r->pontuacao}}</td>
                                    <td>
                                        {{$r->status}}
                                    </td>
                                </tr>
                                @endforeach
                            @else:
                                <tr class="vazio">
                                    <td colspan="12">SEM EXTRATO NO MOMENTO</td>
                                </tr>
                            @endif;
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="bloco_nome_02" class="conteudo display_none">
                    <div class="bloco_tabela_geral">
                        <table>
                            <thead>
                                <tr>
                                    <th>Pontos Trocados</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if(!empty($extratoSaque)):
                                @foreach ($extratoSaque as $r):
                                    <tr>
                                        <td>{{$r->saque->pontuacao}}</td>
                                        <td>{{$r->status}}</td>
                                    </tr>
                                @endforeach
                            @else
                            <tr class="vazio">
                                <td colspan="12">SEM EXTRATO NO MOMENTO</td>
                            </tr>
