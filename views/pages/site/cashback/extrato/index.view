@template "site"

<div id="bloco_pagina_cashback">
    
    <div class="conteudo">
        @view site/cashback/geral/banner.view

        <section class="panel">
            <header>
				<p>Você tem acesso a dezenas de parceiros que oferecem % do valor da sua compra em pontos SILIUM, que poderão ser resgatados em dinheiro!</p>
				<p>Para efetuar o resgate, basta acumular 10.000 pontos e solicitar a transferência. Sendo que cada 100 pontos SILIUM equivalem a 1 Real".</p>
				<p>SILIUM, aqui você sempre tem Mais Vantagens!</p>
				<p>* Os pagamentos serão feitos sempre nos dias 10 e 25 de cada mês.
                Para você receber no dia 10 do mesmo mês, faça a sua solicitação até dia 05. Para receber até dia 25 do mesmo mês, faça sua solicitação até dia 20.</p>
            </header>
        </section>
        
		<a href="#" target="_blank" class="regulamento">REGULAMENTO SILIUM</a>

		<div class="saldo">
			<div class="saldo_conta">
				<p>SALDO EM CONTA:</p><span>{{ $saldo }}</span>
			</div>
			@ if($saldo >= 10000):
				<div class="botao_resgata">
					<button class="botao">
						<span>SOLICITAR RESGATE</span>
					</button>
				</div>
            @ else:
				<div class="saldo_zero">
					<p>VOCÊ PRECISA ACUMULAR 10.000 PONTOS PARA SOLICITAR RESGATE.</p>
				</div>
            @ endif;
		</div>

		<div class="tabs">
		
			<div class="tab">
				<button class="tabLink active" data-tab="#tab1">Extrato de compra</button>
				<button class="tabLink normal" data-tab="#tab2">Extrato de saque</button>
			</div>

			<div id="tab1" class="tabConteudo active">
				<div class="table_container">
					<table>
						<thead>
							<tr>
								<th>Convênios</th>
								<th>Pontos</th>
								<th>Data</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td data-label="Convênios">Fisioterapia</td>
								<td data-label="Pontos">10</td>
								<td data-label="Data">23/06/2013</td>
								<td data-label="Status">Em processamento</td>
							</tr>
							<tr>
								<td data-label="Convênios">Acupuntura</td>
								<td data-label="Pontos">10</td>
								<td data-label="Data">23/10/2014</td>
								<td data-label="Status">Resgatado</td>
							</tr>
							<tr>
								<td data-label="Convênios">Pisiquiátrica</td>
								<td data-label="Pontos">10</td>
								<td data-label="Data">23/10/2015</td>
								<td data-label="Status">Resgatado</td>
							</tr>
							<tr>
								<td data-label="Convênios">Pet Shop</td>
								<td data-label="Pontos">13</td>
								<td data-label="Data">23/01/2019</td>
								<td data-label="Status">Resgatado</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<div id="tab2" class="tabConteudo">
				<div class="table_container">
					<table>
						<thead>
							<tr>
								<th>Conta</th>
								<th>Valor</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td data-label="Conta">
									Banco: 2222 </br>
									Agência: 2222-22 </br>
									Conta: 222222 </br>
									Tipo de conta: Conta Corrente </br>
									Titular: Fulano e ciclano </br>
									CPF: 331.804.330-35 </br>
								</td>
								<td data-label="Valor">100,00</td>
								<td data-label="Status">Concluído</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>


		</div>

    
    </div>

</div>
