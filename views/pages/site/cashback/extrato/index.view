                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bloco_pagina_popup display_none" id="bloco_escolher_metodo">
    <div class="conteudo_pagina_popup conteudo_popup">
        <header>
            <h1>Escolha o tipo de resgate</h1>
            <i class="popup_fechar fechar">@iconeFechar</i>
        </header>
        <form class="form_geral">
            <div class="bloco">
                @? formSelect(name: 'tipo_resgate', label: 'Tipo de Resgate', placeholder: 'Escolha o tipo de resgate', obrigatorio: true, lista: (new \App\Classes\SiliumDeposito\TipoResgate())->select('Selecione um tipo de resgate'));
            </div>
        </form>
        <div class="botao" id="botao_popup_metodo">Escolher método</div>
    </div>
</div>


<div class="bloco_pagina_popup display_none" id="bloco_resgatar_ponto">
    <div class="conteudo_pagina_popup conteudo_popup">
        <header>
            <h1>Resgatar pontos</h1>
            <p>Preencha o formulário abaixo para solicitar resgate de pontos</p>
            <i class="popup_fechar fechar">@iconeFechar</i>
        </header>
        <form class="form_geral">
            <div class="bloco">
                <h1 class="titulo_dados_bancarios">Dados Pessoais</h1>
                @? formInput(name: 'ponto_nome', label: 'Nome', placeholder:'Digite seu nome', value: '', local: 'André Rodrigues')
                @? formInput(name: 'ponto_email', label: 'E-mail', placeholder:'Digite seu E-mail', obrigatorio: true, value: '', local: 'andre@markt.club')
                @? formNumero(name: 'ponto_quantidade', label: 'Pontos', placeholder: 'Digite a quantidade de pontos', obrigatorio: true, value: '', local: 1)
                <div class="resgate_dinheiro display_none">
                    <h1 class="titulo_dados_bancarios">Dados Bancários</h1>
                    @? formInput(name: 'titular', label: 'Nome', placeholder:'Digite o nome do titular', obrigatorio: true, value: '', local: 'André Rodrigues')
                    @? formCpf(name: 'cpf_conta', label: 'CPF', placeholder: 'CPF', obrigatorio: true, value: '', local: '123.456.789-00')
                    @? formInput(name: 'banco', label: 'Banco', placeholder:'Digite o nome do banco', obrigatorio: true, value: '', local: 'InterSA')
                    @? formNumero(name: 'conta', label: 'Conta Bancária', placeholder:'Digite a sua conta bancária ', maximo: 15, obrigatorio: true, value: '', local: '123456789')
                    @? formNumero(name: 'agencia', label: 'Agência', placeholder:'Digite a sua agência bancária ', obrigatorio: true, value: '', local: '14320')
                    @? formSelect(name: 'tipo', label: 'Tipo de Conta', placeholder: 'Escolha o tipo de conta', obrigatorio: true, lista: (new \App\Classes\SiliumDeposito\TipoConta())->select('Selecione um tipo de conta'));
                </div>
            </div>
        </form>

        <div class="bloco_botao">
            @if($disponibilidadeDesconto == '1' && ($saldo >= $minPontosDinheiro && $saldo >= $minPontosMensalidade)):
                <a class="botao_voltar_cashback">Voltar</a>
            @endif;
            <div class="botao cor_bg botao" id="botao_solicitar_ponto">Solicitar resgate</div>
        </div>
    </div>
</div>
