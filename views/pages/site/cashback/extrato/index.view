@template "site"


<div id="bloco_pagina_cashback">
    <div class="conteudo">
        <figure>
            <img src="{!!LINK!!}/images/site/logo_silium.png" height="80" alt="Logo Silium">
        </figure>

        <section class="bloco_titulo_texto">
            @if($disponibilidadeDesconto == '1'):
                <p>
                    Você tem acesso a dezenas de parceiros que oferecem % do valor da sua compra em pontos SILIUM, que poderão ser
                    resgatados em dinheiro ou desconto na sua anuidade.
                    Para efetuar o resgate, basta acumular {{$minPontosDinheiro}} pontos e solicitar a transferência ou {{$minPontosMensalidade}}
                    para solicitar desconto na sua anuidade.
                    Sendo que cada 100 pontos SILIUM equivalem a 1 Real.
                </p>
            @else:
                <p>
                    Você tem acesso a dezenas de parceiros que oferecem % do valor da sua compra em pontos SILIUM, que poderão ser
                    resgatados em dinheiro.
                    Para efetuar o resgate, basta acumular {{$minPontosDinheiro}} pontos e solicitar a transferência. Sendo que cada
                    100 pontos SILIUM equivalem a 1 Real.
                </p>
            @endif;
            <p>SILIUM, aqui você sempre tem Mais Vantagens!</p>
            <p>
                * Os pagamentos serão feitos sempre nos dias 10 e 25 de cada mês.
                Para você receber no dia 10 do mesmo mês, faça a sua solicitação até dia 05.
                Para receber até dia 25 do mesmo mês, faça sua solicitação até dia 20.
            </p>
            <div class="bloco_saldo">
                <a href="@route(termo.termocashback)" target="_blank" class="regulamento botao_pequeno_borda">REGULAMENTO SILIUM</a>
                <div class="saldo_conta">
                    <p>SALDO EM CONTA:
                        <span>
                            @php echo($saldo);
                        </span>
                    </p>
                </div>
                @if($disponibilidadeDesconto == '1'):
                    @if($saldo >= $minPontosDinheiro && $saldo >= $minPontosMensalidade)
                        <div class="botao botao_resgate_cashback" id="botao_popup_resgate">Escolher resgate</div>
                    @elseif($saldo >= $minPontosMensalidade):
                        <div class="bloco_atencao_geral">
                            <p>
                                Você precisa acumular {{$minPontosDinheiro}} pontos para solicitar resgate em dinheiro.
                                No entanto, já pode realizar o resgate de desconto na sua anuidade.
                            </p>
                        </div>
                        <div class="botao botao_resgate_cashback" id="botao_popup_resgate_mensalidade">Solicitar desconto</div>
                    @elseif($saldo >= $minPontosDinheiro):
                        <div class="bloco_atencao_geral">
                            <p>
                                Você precisa acumular {{$minPontosMensalidade}} pontos para solicitar desconto na anuidade.
                                No entanto, já pode realizar o resgate em dinheiro.
                            </p>
                        </div>
                        <div class="botao botao_resgate_cashback" id="botao_popup_resgate_dinheiro">Solicitar resgate</div>
                    @endif;
                @else:
                    @if($saldo >= $minPontosDinheiro):
                        <div class="botao botao_resgate_cashback" id="botao_popup_resgate_dinheiro">Solicitar resgate</div>
                    @endif;
                @endif;
            </div>
        </section>
        @if($saldo <= $minPontosDinheiro && $saldo <= $minPontosMensalidade)
            <div class="bloco_atencao_geral">
                @if($disponibilidadeDesconto == '1'):
                <p>
                    Você precisa acumular {{$minPontosDinheiro}} pontos para solicitar o resgate em dinheiro ou {{$minPontosMensalidade}}
                    para solicitar desconto na anuidade.
                </p>
                @else:
                    <p>Você precisa acumular {{$minPontosDinheiro}} pontos para solicitar o resgate em dinheiro.</p>
                @endif;
            </div>
        @endif;
        <div class="bloco_extrato">
            <h1>ACOMPANHE SEUS EXTRATOS</h1>
            <div class="bloco_tab_geral bloco_procedimento">
                <div class="bloco_botao">
                    <button class="botao ativo" data-id="bloco_nome_01">
                        <span class="texto_inativo">Compra</span>
                        <span class="texto_ativo">Compra</span>
                    </button>
                    <button class="botao" data-id="bloco_nome_02">
                        <span class="texto_inativo">Saque</span>
                        <span class="texto_ativo">Saque</span>
                    </button>
