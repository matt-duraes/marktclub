@template "site"


<div id="bloco_pagina_cashback">
    <input type="hidden" id="input_ponto_saldo" value="{$saldo}">
    <div class="conteudo">
        <figure>
            <img src="{!!LINK!!}/images/site/logo_silium.png" height="80" alt="Logo Silium">
        </figure>

        <section class="bloco_titulo_texto">
            <p>Você tem acesso a dezenas de parceiros que oferecem % do valor da sua compra em pontos SILIUM, que poderão ser resgatados em dinheiro!</p>
            <p>Para efetuar o resgate, basta acumular 10.000 pontos e solicitar a transferência. Sendo que cada 100 pontos SILIUM equivalem a 1 Real".</p>
            <p>SILIUM, aqui você sempre tem Mais Vantagens!</p>
            <p>* Os pagamentos serão feitos sempre nos dias 10 e 25 de cada mês.
            Para você receber no dia 10 do mesmo mês, faça a sua solicitação até dia 05. Para receber até dia 25 do mesmo mês, faça sua solicitação até dia 20.</p>
            <div class="bloco_saldo">
                <a href="@route(termo.termocashback)" target="_blank" class="regulamento botao_pequeno_borda">REGULAMENTO SILIUM</a>
                <div class="saldo_conta">
                    <p>SALDO EM CONTA: <span>0</span> </p>
                </div>
                @if ($saldo >= 10000):
                <div class="botao" id="botao_popup_resgate">Solicitar resgate</div>
                @else:
                <div class="bloco_atencao_geral">
                    <p>VOCÊ PRECISA ACUMULAR 10.000 PONTOS PARA SOLICITAR RESGATE.</p>
                </div>
                @endif;
            </div>
        </section>

        <div class="bloco_extrato">
            <h1>ACOMPANHE SEUS EXTRATOS</h1>
            <div class="bloco_tab_geral bloco_procedimento">
                <div class="bloco_botao">
                    <button class="botao ativo" data-id="bloco_nome_01">
                        <span class="texto_inativo">Compra</span>
                        <span class="texto_ativo">Compra</span>
                    </button>
                    <button class="botao" data-id="bloco_nome_02">
                        <span class="texto_inativo">Saque</span>
                        <span class="texto_ativo">Saque</span>
                    </button>
                </div>

                <div id="bloco_nome_01" class="conteudo">
                    <div class="bloco_tabela_geral">
                        <table>
                            @if(isset($extrato_compra) && $extrato_compra != ''):
                            <thead>
                                <tr>
                                    <th>Empresa Parceira</th>
                                    <th>Valor da Compra</th>
                                    <th>Pontos Adquiridos</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach ($extrato_compra as $r) :
                                <tr>
                                    <td>{{$r->parceiro}}</td>
                                    <td>R$ {{$r->valor_compra}}</td>
                                    <td>{{$r->comissao_usuario}}</td>
                                    <td>
                                        <div class="bloco_status {{$r->status}}"></div>
                                    </td>
                                </tr>
                                @endforeach
                            @else:
                                <tr class="vazio">
                                    <td colspan="12">SEM EXTRATO NO MOMENTO</td>
                                </tr>
                            @endif;
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="bloco_nome_02" class="conteudo display_none">
                    <div class="bloco_tabela_geral">
                        <table>
                            @if(isset($extrato_saque) && $extrato_saque != ''):
                            <thead>
                                <tr>
                                    <th>Pontos Trocados</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach ($extrato_saque as $r) :
                                    <tr>
                                        <td>{{$r->pontuacao}}</td>
                                        <td>R${{$r->valor}}</td>
                                        <td>
                                            <div class="bloco_status {{$r->status}}"></div>
                                        </td>
                                    </tr>
                                @endforeach
                            @else
                            <tr class="vazio">
                                <td colspan="12">SEM EXTRATO NO MOMENTO</td>
                            </tr>
                            @endif
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bloco_pagina_popup display_none" id="bloco_resgatar_ponto">
    <div class="conteudo_pagina_popup conteudo_popup">
        <header>
            <h1>Resgatar pontos</h1>
            <p>Preencha o formulário abaixo para solicitar resgate de pontos</p>
            <i class="popup_fechar fechar">@iconeFechar</i>
        </header>
        <form class="form_geral">
            <div class="bloco">
                <h1 class="titulo_dados_bancarios">Dados Pessoais</h1>
                <fieldset>
                    @? formInput(name: 'ponto_nome', label: 'Nome', placeholder:'Digite seu nome', obrigatorio: true, value: '', local: 'André Rodrigues')
                    @? formInput(name: 'ponto_email', label: 'E-mail', placeholder:'Digite seu E-mail',  obrigatorio: true, value: '', local: 'andre@markt.club')
                    @? formNumero(name: 'ponto_quantidade', label: 'Pontos', placeholder: 'Digite a quantidade de pontos', obrigatorio: true, value: '', local: 1)
                </fieldset>
                <h1 class="titulo_dados_bancarios">Dados Bancários</h1>
                <fieldset>
                    @? formInput(name: 'titular', label: 'Nome', placeholder:'Digite o nome do titular', obrigatorio: true, value: '', local: 'André Rodrigues')
                    @? formCpf(name: 'cpf_conta', label: 'CPF', placeholder: 'CPF')
                    @? formInput(name: 'banco', label: 'Banco', placeholder:'Digite o nome do banco', obrigatorio: true, value: '', local: 'InterSA')
                    @? formNumero(name: 'conta', label: 'Conta Bancária', placeholder:'Digite a sua conta bancária ', maximo: 35, obrigatorio: true, value: '', local: '21321321312312-9')
                    @? formNumero(name: 'agencia', label: 'Agência', placeholder:'Digite a sua agência bancária ', obrigatorio: true, value: '', local: '14320')
                    @? formSelect(name: 'tipo', label: 'Tipo de Conta', placeholder: 'Escolha o tipo de conta', obrigatorio: true, lista: ['Corrente', 'Poupança']);
                </fieldset>

            </div>
        </form>
        <div class="bloco_botao">
            <div class="botao cor_bg botao" id="botao_solicitar_ponto">Solicitar ponto</div>
        </div>
    </div>
</div>

