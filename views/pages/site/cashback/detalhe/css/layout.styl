@system "Form"
@template "site"
@resource "site/busca"
@resource "site/variavel"
@resource "site/loja/parceiro"
@resource "site/cashback/busca"
@resource "site/loja/relacionado"
@resource "site/parceiro_header"
@resource "site/passo_passo"
@resource "site/item_lista"

#bloco_cashback_detalhe
    maxWidth()
    margin-top: 30px

#bloco_cashback_detalhe .bloco_item_lista
    margin: -20px 0 5px

#bloco_cashback_detalhe .header_detalhe
    blocoShadow()
    width: 100%
    flexRow()
    align-items: center
    espacoBottomPadrao()
    figure
        width: 200px
        text-align: center
        margin-right: 20px
    figure img
        max-width: 100%
        max-height: 130px
    .texto_cashback
        flexGrow()
        flexCol()
        align-items: flex-start
    .texto_cashback h1
        titulo()
    .texto_cashback p
        texto()
        margin: 10px 0 20px

#bloco_cashback_detalhe .bloco_dado
    padding-bottom: 20px
    .bloco_acessar
        flexRow()
        margin-top: 15px
        align-items: center
    .bloco_acessar p
        texto()
    .bloco_acessar .botao
        margin-left: 20px
    .atencao
        margin-top: 20px
@media screen and (max-width: 425px)
    #bloco_cashback_detalhe .bloco_dado .bloco_acessar
        flex-direction: column
        gap: 20px
        margin-top: 0px
        align-items: flex-start
        .botao
            margin: 0px
            width: 100%
    .botao_parceiro
        height: auto
#bloco_input_categoria_fake
    width: 300px
@media screen and (max-width: 800px)
    #bloco_input_categoria_fake
        display: none
#bloco_input_pesquisa_fake
    flex: 1
