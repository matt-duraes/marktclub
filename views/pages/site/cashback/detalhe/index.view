@template "site"
<div id="bloco_cashback_detalhe">
    <div class="header_detalhe">
        <figure class="logo_cashback"><img src="https://arquivo.marktclub.com.br/parceiro/65c3d3b6716418d6425dfa858214a963.jpg" alt=""></figure>
        <div class="texto_cashback">
            <h1>NOME LOJA</h1>
            <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Temporibus id modi tenetur exercitationem, voluptatem optio atque eos neque officia enim quam in fugit pariatur, iure asperiores earum labore alias! Eum.
            Optio aliquid nam, sapiente odio, fuga laborum cupiditate error dolorum consequuntur animi in molestiae nemo porro eos hic laboriosam dolores nostrum eum, deserunt esse facere corporis voluptatem quisquam ex. Molestiae.
            Excepturi architecto fugit temporibus. </p>
            @if(TIPO_USUARIO != 'indicado'):
                <a href="" class="botao_pequeno_borda cor_border">Regulamento do SILIUM</a>
            @endif
        </div>
    </div>
    <div class="bloco_passo_a_passo">
        <div class="descricao_passo_a_passo">
            <div class="imagem_redonda">
                @iconeLojaHome()
            </div>
            <p>Acesse o site do parceiro pelo Clube para ativar.</p>
        </div>
        <div class="bola">@iconeSetaDireita(20)</div>
        <div class="descricao_passo_a_passo">
            <div class="imagem_redonda">
                @iconeLojaHome()
            </div>
            <p>Escolha e compre os produtos que possuam cashback.</p>
        </div>
        <div class="bola">@iconeSetaDireita(20)</div>
        <div class="descricao_passo_a_passo">
            <div class="imagem_redonda">
                @iconeLojaHome()
            </div>
            <p>Receba o % de retorno em pontos SILIUM em até 30 dias.</p>
        </div>
        <div class="bola">@iconeSetaDireita(20)</div>
        <div class="descricao_passo_a_passo">
            <div class="imagem_redonda">
                @iconeLojaHome()
            </div>
            <p>Acompanhe seu saldo e as regras de resgate. Você pode transformar SILIUM em $ na conta!</p>
        </div>
    </div>
    <div class="bloco_dado bloco_titulo_texto">
        <h1>Receba de volta</h1>
        @if(TIPO_USUARIO != 'indicado'):
            <div class="bloco_acessar">
                <p>10% em SILIUM</p>
                <a class="botao_geral_cor cor_bg botao" target="_blank" rel="nofollow noopener">Acessar parceiro para acumular pontos</a>
            </div>
            <div class="atencao bloco_atencao_geral">
                <p>Não contempla venda de produtos ofertados via hostsites, apralelos ao site principal.
                    Os pontos referentes à compras via boletos bancários serão computados apenas após o
                    pagamento do mesmo</p>
            </div>
        @else
            <div class="bloco_atencao_geral_centralizado">
                <p>Apenas associados possuem acesso a esse recurso</p>
            </div>
        @endif
    </div>

    @view site/geral/relacionado.view

</div>
