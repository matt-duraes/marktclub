@template "site"
@view site/cashback/geral/busca.view

<div id="bloco_cashback_detalhe">
    <div class="bloco_parceiro_header ">
        <figure class="logo vazio"><img src="{{$dado->logo}}"></figure>
        <header class="bloco_header">
            <h1>{{$dado->titulo}}</h1>
            <p>{!!$dado->texto_descricao!!}</p>
            @if(TIPO_USUARIO != 'indicado'):
            <a href="" data-botao="Regulamento" class="botao_pequeno_borda cor_border botao_contar_click">Regulamento do SILIUM</a>
            @endif
        </header>
    </div>

    <div class="bloco_item_lista">
        <div class="scroll">
            <div class="conteudo">
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeLojaHome()
                    </div>
                    <p>Acesse o site do parceiro pelo Clube para ativar.</p>
                    <div class="bola">@iconeSetaDireita(20)</div>
                </div>
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeLojaHome()
                    </div>
                    <p>Escolha e compre os produtos que possuam cashback.</p>
                    <div class="bola">@iconeSetaDireita(20)</div>
                </div>
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeLojaHome()
                    </div>
                    <p>Receba o % de retorno em pontos SILIUM em até 30 dias.</p>
                    <div class="bola">@iconeSetaDireita(20)</div>
                </div>
                <div class="descricao_item_lista">
                    <div class="imagem_redonda">
                        @iconeLojaHome()
                    </div>
                    <p>Acompanhe seu saldo e as regras de resgate. Você pode transformar SILIUM em $ na conta!</p>
                </div>
            </div>
        </div>
    </div>
    <div class="bloco_dado bloco_titulo_texto">
        <h1>Receba de volta</h1>
        @if(TIPO_USUARIO != 'indicado'):
            <div class="bloco_acessar">
                <p>{{$dado->desconto}}% em SILIUM</p>
                <a class="botao_geral_cor cor_bg botao botao_contar_click" data-botao="Acessar" href="{!!$dado->link!!}" target="_blank" rel="nofollow noopener">Acessar parceiro para acumular pontos</a>
            </div>
            @ if( !empty($dado->texto_outro) ):
            <div class="texto_destaque">{!!$dado->texto_outro!!}</div>
            @ endif;

            @ if( !empty($dado->texto_restricao) ):
            <div class="atencao bloco_atencao_geral">
                <p>{!!$dado->texto_restricao!!}</p>
            </div>
            @ endif;
        @else
            <div class="bloco_atencao_geral">
                <p>{{$dado->desconto}}% em SILIUM</p>
                <p>Apenas associados possuem acesso a esse recurso</p>
            </div>
        @endif
    </div>

    @view site/geral/relacionado.view

</div>
