<div class="bloco_buscar_geral bloco_buscar_loja" id="bloco_buscar">
    <form class="buscar botao_buscar_abrir form_geral">
        <p>Busque uma loja</p>
        @? formSelect(name: 'input_categoria_fake', id: 'bloco_input_categoria_fake', placeholder: 'Categoria', label: 'Categoria', class: 'botao_buscar_input busca_categoria_fake', lista: [])
        @? formInput(name: 'input_pesquisa_fake', id: 'bloco_input_pesquisa_fake', placeholder: 'Busque por um convênio', label: 'Pesquisa', class: 'botao_buscar_input busca_pesquisa_fake')
        <div class="botao">Buscar</div>
    </form>

    <form action="@route(cashback.buscar)" method="get" id="form_buscar" class="form_geral display_none">
        <div class="conteudo">
            <div class="centralizar">
                <header>
                    <i class="mobile botao_buscar_fechar">@iconeVoltar</i>
                    <h1>Busque uma loja</h1>
                    <i class="desktop botao_buscar_fechar">@iconeFechar</i>
                </header>
                <fieldset>
                    @? formInput(name: 'pesquisa', placeholder: 'Busque por uma loja', label: 'Pesquisa', id: 'bloco_input_pesquisa', class: 'busca_pesquisa', value: '')
                </fieldset>
                <fieldset>
                    @? formSelect(name: 'categoria', placeholder: 'Categoria', label: 'Categoria', id: 'bloco_input_categoria', class: 'busca_categoria', lista:  (new \App\Classes\ParceiroCashback\Categoria)->select('Escolha uma opção'), value: '')
                    @? formSelect(name: 'ordem', placeholder: 'Ordenar por', label: 'Ordem', class: 'busca_ordem', lista: (new \App\Classes\ParceiroCashback\Ordem)->select(), value: '')
                    <button class="botao_geral_cor cor_bg">Buscar</button>
                </fieldset>
            </div>
        </div>
    </form>
</div>
@ if( isset($Busca) && $Busca->uso ):
<div class="buscar_convenio_lista">
    <h2>Filtros:</h2>
    @ foreach( $Busca->uso as $r ):
    <div class="item" data-indice="{{$r['indice']}}" data-valor="{{$r['valor']}}">
        <div class="nome">{{$r['nome']}}</div>
        <div class="valor">{{$r['valor_real']}}</div>
        <div class="remover">@iconeFechar(10)</div>
    </div>
    @ endforeach;
</div>
@ endif;
