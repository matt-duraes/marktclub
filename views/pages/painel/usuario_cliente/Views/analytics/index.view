@ if( painelPermissao('usuario_cliente_analytics', erro: false) ):
<div class="bloco_fieldset" id="bloco_analytics">
    <header class="header_fieldset">
        <h2>Analytics</h2>
    </header>
    <div class="lista_dado lista_dado_analytics" id="bloco_analytics_lista_index">
    </div>
    <div class="botao_link botao_analytics_abrir">Abrir Analytics</div>
</div>

<div id="bloco_analytics_visualizar" class="display_none">
    <div class="bloco_pagina_popup conteudo">
        <header class="header_pagina_popup">
            <h1>ANALYTICS</h1>
            <i class="fechar" id="botao_analytics_fechar">@iconeFechar</i>
        </header>
        <div class="conteudo_pagina_popup">
            <form action="" class="form_geral">
                @? formData(name: ['relatorio_data_de', 'relatorio_data_ate'], label: 'Data para filtro', separador: 'até');
                <div class="botao" id="botao_buscar_analytics">BUSCAR</div>
            </form>
            <div class="lista_dado_analytics" id="bloco_analytics_lista_geral">

            </div>
            <div class="carregar_mais display_none botao_carregar_mais">CARREGAR MAIS</div>
        </div>
    </div>
</div>
@ endif;
