            </div>

            <form action="/" class="form_geral">
                @hash('PAGAMENTO_HASH', 'pagamento')
                <h2>Cadastrar novo debito</h2>
                <p>Preencha os campos abaixo para salvar novo valor a esse usuário</p>

                <input type="hidden" id="input_pagamento_usuario" value="{{$dado->id}}">
