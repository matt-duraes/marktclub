<div id="bloco_pagamento_visualizar">
    <div class="bloco_pagina_popup conteudo">
        <header class="header_pagina_popup">
            <h1>PAGAMENTO</h1>
            <i class="fechar" id="botao_pagamento_visualizar_fechar">@iconeFechar</i>
        </header>
        <div class="conteudo_pagina_popup">
            <div class="lista" id="bloco_pagamento_lista">
                <h2>Pagamentos abertos</h2>
                @ ifforeach($dado->pagamento as $r):
                <div class="pagamento" data-id="{{$r->id}}">
                    <div class="data">{{$r->data}}</div>
                    <div class="linha"></div>
                    <div class="valor">{{$r->valor}}</div>
                    <div class="botao botao_pagamento_baixar">DAR BAIXA</div>
                </div>
                @ elseforeach:
                <div class="zero">Sem pagamentos pendentes para esse usuário</div>
