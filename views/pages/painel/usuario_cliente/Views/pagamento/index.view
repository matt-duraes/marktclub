                @? formInput(name: 'pagamento_valor', label: 'Valor', placeholder: 'Valor', mascara: 'dinheiro')

                <div class="botao" id="botao_pagamento_salvar">Salvar</div>
            </form>
        </div>
    </div>
</div>
