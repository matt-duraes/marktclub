#bloco_analytics
    justify-content: flex-start
    align-items: flex-start
    .zero
        margin-top: 10px
.lista_dado_analytics .linha
    width: 100%
    flexRow()
    padding: 5px 20px 5px 14px
    align-items: center
    &:hover
        background-color: #F6F6F6
    .icone
        width: 30px
        height: 30px
        flexCenter()
    .pagina
        texto()
        flexGrow()
        padding: 0 20px 0 10px
    .data
        font-size: 1.2rem
        line-height: 1.5em

#bloco_analytics_visualizar
    width: 100%
    height: 100%
    position: fixed
    top: 0
    left: 0
    flexCenter()
    z-index: 10000
    background: rgba(0,0,0,.7)
    opacity: 0
    transition: opacity .3s ease-out
    &.abrir
        opacity: 1
    .conteudo
        max-width: 700px
    .conteudo_pagina_popup
        width: 100%
        flexCol()
        align-items: center
        padding: 10px 0 20px
    form
        width: 100%
        flexRow()
        padding: 0 20px 20px
    form .botao
        height: 45px
        line-height: 45px
        textoFontSize()
        bgDegradeVerde()
        color: #FFF
        padding: 0 15px
        border-radius: 3px
        margin: 20px 0 0 10px
        cursor: pointer
    .lista_dado_analytics
        width: 100%
        flexCol()
        margin-bottom: 20px
        padding-left: 5px
    .carregar_mais
        height: 50px
        line-height: 50px
        padding: 0 20px
        textoFontSize()
        bgDegradeVerde()
        color: #FFF
        border-radius: 25px
        cursor: pointer
