@template "painel"

<div id="bloco_album_index">
    @hash('DELETAR_ALBUM')
    <div class="bloco_lista" id="bloco_lista">
        @ ifforeach($album as $r):
            <article data-id="{!!$r->id!!}">
                <div class="imagem">
                    @ if( $podeDeletar ):
                    <div class="check">
                        <div class="icone">@iconeCheck</div>
                    </div>
                    @ endif;
                    <div class="bg"></div>
                    <div class="grade"></div>
                    <figure style="background-image: url({!!$r->imagem!!})"></figure>
                    <a href="@route('galeria.index')/{{$r->id}}"></a>
                </div>
                <p>{{$r->titulo}}</p>
            </article>
        @ endforeach:
            @laco(4)
            <div class="article_fake"></div>
            @endlaco
        @else
        <div class="zero">
            <i>@iconeImagem(60)</i>
            <h1>Sem álbuns no momento</h1>
            <p>Crie um novo álbum para adicionar suas imagens</p>
        </div>
        @ endif;
    </div>
</div>

@? botaoControle(app: $app, add: 'botao_adicionar_album', addLink: LINK . '/app/add/album-galeria', deletar: 'botao_deletar_album')
