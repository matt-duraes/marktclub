#bloco_view .bloco_conteudo
    width: 100%
    flexCol()
    article
        width: calc(100% - 20px)
        margin: 10px 0 0 10px
        background-color: #F6F6F6
        border-left: 2px solid $cor
        padding-left: 2px
        position: relative
    article article
        background-color: rgba(0,0,0,.05)
    article header
        flexRow()
        align-items: center
    article header .drag
        cursor: pointer
        width: 30px
        height: 30px
        flexCenter()
        fill: #999
    article header h1
        texto()
        flexGrow()
        padding-right: 20px
    article header .status
        width: 40px
        height: 12px
        background-color: #FFF
        border-radius: 15px
        position: relative
        position: relative
        border: 1px solid #CCC
        flexRow()
        cursor: pointer
        margin-right: 10px
    article header .status span
        width: 22px
        height: 22px
        position: relative
        background-color: #999
        border-radius: 50%
        top: -6px
        left: 0
        transition: left .3s ease-out
    article header .status.ativo span
        background-color: $cor
        left: calc(100% - 18px)
    article header .icone
        height: 30px
        width: 30px
        cursor: pointer
        flexCenter()
        font-size: 2rem
        &:hover
            background-color: rgba(0, 0, 0, .05)
    article header:hover .icone
        display: flex
    article .lista
        flexCol()
        padding-bottom: 10px
        position: relative

#bloco_view .bloco_botao_direita
    flexRow()
    justify-content: flex-end
    margin-right: 10px
    .botao
        bgDegradeVerde()
        height: 50px
        line-height: 50px
        margin-top: 20px
        padding: 0 20px
        border-radius: 25px
        color: #FFF
        textoFontSize()
        cursor: pointer

#bloco_view_add
    width: 100%
    max-width: 600px
    .linha
        width: 100%
        height: 1px
        margin: 10px 0
        background-color: #CCC
    h2
        width: 100%
        texto()
        font-weight: bold
        margin-top: 20px
    .bloco_row
        flexRow()
    .bloco_api_metodo
        max-width: 130px
        margin-right: 20px
    .bloco_api_status
        margin-top: 10px
    .bloco_link_empresa
        max-width: 120px
        margin-right: 10px
    .bloco_link_url
        max-width: calc(100% - 230px)
        margin-right: 10px
    .bloco_botao_direita
        flexRow()
        justify-content: flex-end
        margin-top: 30px
        border-top: 1px solid #CCC
        padding-top: 20px
    .bloco_botao_direita .botao
        bgDegradeVerde()
        height: 50px
        line-height: 50px
        padding: 0 20px
        border-radius: 25px
        color: #FFF
        textoFontSize()
        cursor: pointer

.fw_form_tabela
    width: 100%
    flexCol()
    margin-top: 20px
    .fw_form_tabela_botao
        height: 30px
        line-height: 30px
        padding: 0 20px
        border-radius: 4px
        border: 1px solid $cor
        cursor: pointer
    .fw_form_botao_linha_conula
        margin-bottom: 10px
    .fw_form_botao_linha_conula .fw_form_tabela_botao
        margin-right: 10px
    .fw_form_tabela_row
        width: 100%
        flexRow()
    .fw_form_tabela_scroll
        max-width: 100%
        overflow-x: auto
        border-bottom: 1px solid #CCC
    .fw_form_tabela_header
    .fw_form_tabela_conteudo
        width: 100%
        flexCol()
    .fw_form_tabela_linha
        width: 100%
        flexRow()
        align-items: center
        position: relative
        border: 1px solid #CCC
        border-bottom: none
        padding: 0 10px
    .fw_form_tabela_linha .fw_form_tabela_drag
        cursor: pointer
        width: 30px
        height: 30px
        flexCenter()
        fill: #999
    .fw_form_tabela_linha .fw_form_tabela_remover
        cursor: pointer
        width: 30px
        height: 30px
        flexCenter()
        fill: #999
    .fw_form_tabela_linha .fw_form_tabela_linha_conteudo
        width: calc(100% - 60px)
        flexRow()
    .fw_form_tabela_linha .fw_form_tabela_coluna
        width: 350px
        flexRow()
        border-right: 1px solid #CCC
        align-items: center
    .fw_form_tabela_linha .fw_form_tabela_coluna .fw_form_tabela_texto
        width: 100%
        height: 40px
        padding: 0 10px
    .fw_form_tabela_header .fw_form_tabela_linha .fw_form_tabela_coluna .fw_form_tabela_texto
        width: calc(100% - 90px)
    .fw_form_tabela_linha .fw_form_tabela_coluna .fw_form_tabela_tamanho
        width: 40px
        height: 30px
        border: 1px solid #CCC
        text-align: center
        margin-right: 5px
        border-radius: 4px
    .fw_form_tabela_header .fw_form_tabela_linha .fw_form_tabela_coluna .fw_form_tabela_remover
        margin-right: 5px
    .fw_form_tabela_header .fw_form_tabela_linha .fw_form_tabela_coluna .fw_form_tabela_drag
        margin-left: 10px
        transform: rotate(90deg)

