#bloco_view .bloco_conteudo
    width: 100%
    flexCol()
    .loading
        width: 100%
        padding: 10px 20px 0
        texto()
        color: #666
    article
        width: calc(100% - 20px)
        margin: 10px 0 0 10px
        background-color: #F6F6F6
        border-left: 2px solid $cor
        padding-left: 2px
        position: relative
    article article
        background-color: rgba(0,0,0,.05)
    article header
        flexRow()
        align-items: center
    article header .drag
        cursor: pointer
        width: 30px
        height: 30px
        flexCenter()
        fill: #999
    article header h1
        texto()
        flexGrow()
        padding-right: 20px
    article header .status
        width: 40px
        height: 12px
        background-color: #FFF
        border-radius: 15px
        position: relative
        position: relative
        border: 1px solid #CCC
        flexRow()
        cursor: pointer
        margin-right: 10px
    article header .status span
        width: 22px
        height: 22px
        position: relative
        background-color: #999
        border-radius: 50%
        top: -6px
        left: 0
        transition: left .3s ease-out
    article header .status.ativo span
        background-color: $cor
        left: calc(100% - 18px)
    article header .icone
        height: 30px
        width: 30px
        cursor: pointer
        flexCenter()
        font-size: 2rem
        user-select: none
        &:hover
            background-color: rgba(0, 0, 0, .05)
    article header:hover .icone
        display: flex
    article .lista
        flexCol()
        padding-bottom: 10px
        position: relative

#bloco_view .bloco_botao_direita
    flexRow()
    justify-content: flex-end
    margin-right: 10px
    .botao
        bgDegradeVerde()
        height: 50px
        line-height: 50px
        margin-top: 20px
        padding: 0 20px
        border-radius: 25px
        color: #FFF
        textoFontSize()
        cursor: pointer

#bloco_view_add
    width: 100%
    max-width: 1200px
    flexCol()
    align-items: center
    .linha
        width: 100%
        height: 1px
        margin: 10px 0
        background-color: #CCC
    h2
        width: 100%
        texto()
        font-weight: bold
        margin-top: 20px
    .bloco_row
        flexRow()
    .bloco_api_metodo
        max-width: 130px
        margin-right: 20px
    .bloco_api_status
        margin-top: 10px
    .bloco_link_empresa
        max-width: 120px
        margin-right: 10px
    .bloco_link_url
        max-width: calc(100% - 230px)
        margin-right: 10px
    .bloco_botao_direita
        flexRow()
        justify-content: flex-end
        margin-top: 30px
        border-top: 1px solid #CCC
        padding-top: 20px
    .bloco_botao_direita .botao
        bgDegradeVerde()
        height: 50px
        line-height: 50px
        padding: 0 20px
        border-radius: 25px
        color: #FFF
        textoFontSize()
        cursor: pointer
    .bloco_icone_tipo
        max-width: 180px
        margin-right: 20px
    .bloco_icone_tamanho
        max-width: 120px
        margin-right: 20px
    .bloco_icone_nome
        flexGrow()
        margin-right: 20px
    .bloco_icone_altura
        max-width: 120px
    .bloco_api_titulo
        margin-top: 30px
