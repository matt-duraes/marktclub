@template "painel"

#bloco_data_policy_proposicao_detalhe
    width: 100%
    display: flex
    flex-direction: column
    align-items: center
    padding: 20px 20px 0 20px

#bloco_data_policy_proposicao_detalhe > header
    width: 100%
    max-width: 700px
    padding: 0 20px
    h1
        line-height: 1.5em
        font-size: 2.4rem
        text-align: center

#bloco_data_policy_proposicao_detalhe .lista
    width: 100%
    display: flex
    flex-direction: row
    flex-wrap: wrap
    align-items: flex-start
    justify-content: center
    margin-top: 40px
    .link
        width: 100%
        display: flex
        margin-bottom: 20px
        justify-content: center
        margin-top: -20px
    .link a
        display: flex
        align-items: center
        background: $corLink
        color: #FFF
        padding: 12px 20px
        border-radius: 30px
        fill: #FFF
    .link a i
        margin-right: 10px
    .link a p
        font-size: 1.4rem
    .bloco
        max-width: 350px
        border-radius: 4px
        background: #FFF
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        padding: 10px
        margin: 10px
        cursor: default
    .bloco span
        width: 100%
        font-size: 1.4rem
        color: #666
    .bloco p
        height: 1.5em
        line-height: 1.5em
        font-size: 1.6rem
        color: #333
        overflow: hidden
    .linha
        width: 100%
        height: 1px
        position: relative
        display: flex
        justify-content: center
        margin: 10px 0
        &::after
            width: 100%
            max-width: 100px
            height: 1px
            background: #DDD
            content: ""
            position: absolute
            top: 0

@media screen and (max-width:1000px)
    #bloco_data_policy_proposicao_detalhe .lista
        flex-direction: column
        .bloco
            width: 100%
            margin: 10px 0
        .linha
            margin: 10px 0
            &::after
                max-width: 100%

#bloco_data_policy_proposicao_detalhe .bloco_texto
    width: 100%
    max-width: 1000px
    max-height: 400px
    position: relative
    display: flex
    flex-direction: column
    margin: 40px 0
    padding: 40px 20px
    background: #FFF
    display: flex
    flex-direction: column
    align-items: center
    border-radius: 15px
    box-shadow: 0 4px 5px rgba(0,0,0,.2)
    overflow: hidden
    &.abrir
        max-height: none
    .texto
        width: 100%
        max-width: 800px
    .texto p
        width: 100%
        font-size: 1.8rem
        line-height: 1.5em
        margin: 20px 0
@media screen and (max-width:1000px)
    #bloco_data_policy_proposicao_detalhe .bloco_texto
        margin-bottom: 0
        border-radius: 0
        box-shadow: none

#bloco_data_policy_proposicao_detalhe .tramitacao
    width: 100%
    max-width: 1000px
    max-height: 400px
    position: relative
    margin: 40px 0
    overflow: hidden
    &.abrir
        max-height: none
    h2
        width: 100%
        font-size: 2rem
        color: #666
        border-bottom: 1px solid #CCC
        padding-bottom: 10px
    article
        width: 100%
        min-height: 30px
        background: #FFF
        position: relative
        padding: 20px 100px 20px 20px
        border-radius: 5px
        display: flex
        flex-direction: column
        justify-content: center
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        margin-top: 20px
    article h1
        font-size: 1.6rem
        line-height: 1.5em
        color: #333
    article .data
        font-size: 1.4rem
        color: #666
        margin-top: 10px
    article a
        width: 60px
        height: 30px
        line-height: 30px
        position: absolute
        right: 20px
        background: $cor
        color: #FFF
        text-align: center
        border-radius: 15px
        font-size: 1.4rem
@media screen and (max-width:1000px)
    #bloco_data_policy_proposicao_detalhe .tramitacao article
        padding: 20px
        .data
            position: relative
            padding-top: 15px
            margin-top: 15px
            &::after
                width: 100%
                max-width: 60px
                content: ""
                height: 1px
                top: 0
                left: 0
                position: absolute
                background-color: #CCC
        a
            position: relative
            right: auto
            margin-top: 20px
#bloco_data_policy_proposicao_detalhe .degrade
    width: 100%
    height: 100px
    position: absolute
    bottom: 0
    left: 0
    background-image: linear-gradient(to bottom, #FFFFFF00, #FFFFFF80, #FFFFFF)
    z-index: 10
    &.hide
        display: none

#bloco_data_policy_proposicao_detalhe .botao_mostrar
    width: 150px
    height: 40px
    line-height: 40px
    position: absolute
    bottom: 10px
    left: 0
    right: 0
    margin: auto
    z-index: 11
    background: $cor
    color: #FFF
    font-size: 1.4rem
    text-align: center
    border-radius: 20px
    box-shadow: 0 4px 5px rgba(0,0,0,.2)
    cursor: pointer
    &.hide
        display: none

@media screen and (max-width:1000px)
    #bloco_data_policy_proposicao_detalhe
        padding: 20px 0 0 0
        > header
        .lista
        .tramitacao
            padding: 0 20px
