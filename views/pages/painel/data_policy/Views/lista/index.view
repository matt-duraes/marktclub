@template "painel"

<div id="bloco_data_policy_contexto">
    <header>
        <p>LISTAR TAG:</p>
        <h1>{{$tag}}</h1>
    </header>

    <div class="lista">
        @ if( $lista ):
            @ foreach( $lista as $r ):
        <article>
            <a href="{!!$r->link!!}">
                <header>
                    <h1>{{$r->nome}}</h1>
                </header>
                <p>{{$r->titulo}}</p>
            </a>
        </article>
            @ endforeach;
        @ else:
        <div class="bloco_zero_geral">
            <i>@iconeFechar(30)</i>
            <h1>Sem dados</h1>
            <p>Não existe dados cadastradas no momento</p>
        </div>
        @ endif;
    </div>
    @ if( $lista ):
    <div class="controle">
        @ if( !empty($pagina->anterior) ):
        <a href="{!!$pagina->anterior!!}">ANTERIOR</a>
        @ else:
        <div class="grow"></div>
        @ endif;
        <a href="{!!$pagina->proximo!!}">PRÓXIMO</a>
    </div>
    @ endif;
</div>
