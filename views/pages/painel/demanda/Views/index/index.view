@template "painel"

<div id="bloco_demanda_index">
    <div class="conteudo_geral">

        <section class="bloco_coluna">
            <header>
                <h1>Backlog</h1>
                <div class="flex"></div>
                <button id="botao_add_tarefa" class="botao">Add</button>
            </header>
            <div class="conteudo">
                @ifforeach($nova as $r):
                @view painel/demanda/index/tarefa.view
                @elseforeach;
                <div class="tarefa_zero">Sem itens<br> no momento</div>
                @endif;
            </div>
        </section>

        <section class="bloco_coluna">
            <header>
                <h1>Liberada</h1>
            </header>
            <div class="conteudo">
                @ifforeach($liberada as $r):
                @view painel/demanda/index/tarefa.view
                @elseforeach;
                <div class="tarefa_zero">Sem itens<br> no momento</div>
                @endif;
            </div>
        </section>

        <section class="bloco_coluna">
            <header>
                <h1>Em andamento</h1>
            </header>
            <div class="conteudo">
                @ifforeach($andamento as $r):
                @view painel/demanda/index/tarefa.view
                @elseforeach;
                <div class="tarefa_zero">Sem itens<br> no momento</div>
                @endif;
            </div>
        </section>

        <section class="bloco_coluna">
            <header>
                <h1>Finalizada</h1>
            </header>
            <div class="conteudo">
                @ifforeach($finalizada as $r):
                @view painel/demanda/index/tarefa.view
                @elseforeach;
                <div class="tarefa_zero">Sem itens<br> no momento</div>
                @endif;
            </div>
        </section>

    </div>
</div>
