@template "painel"

<input type="hidden" id="input_area" value="{{$area}}">

<div class="bloco_pagina_popup display_none" id="bloco_filtro">
    <header class="header_pagina_popup">
        <h1 id="h1_motivo">FILTRAR DADOS</h1>
        <i class="popup_fechar fechar botao_fechar">@iconeFechar</i>
    </header>

    <div class="form_geral conteudo_pagina_popup form_motivo">
        @? formData(name: ['demanda_filtro_data_inicio', 'demanda_filtro_data_fim'], label: 'Data de criação', placeholder: 'Escolha uma data', separador: 'até')
        @? formSelect(name: 'demanda_filtro_tipo_tarefa', label: 'Tipos de tarefa', placeholder: 'Escolha o tipo de tarefa', lista: (new \App\Classes\DemandaTarefa\Tipo())->select('Escolha uma opção'))
        @? formSelect(name: 'demanda_filtro_empresa', placeholder: 'Escolha um cliente', label: 'Empresa', lista: $empresa)
        @? formSelect(name: 'demanda_filtro_equipe', placeholder: 'Escolha um usuario', label: 'Equipe', lista: $equipe)

        @if($area == \App\Classes\DemandaDado\Area::TECNOLOGIA)
        @? formSelect(name: 'demanda_filtro_tipo_demanda', label: 'Tipo de demanda', placeholder: 'Escolha o tipo de demanda', lista: (new \App\Classes\DemandaDado\Tipo())->selectTecnologia ('Escolha uma opção'))
        @elseif($area == \App\Classes\DemandaDado\Area::CRIACAO)
        @? formSelect(name: 'demanda_filtro_tipo_demanda', label: 'Tipo de demanda', placeholder: 'Escolha o tipo de demanda', lista: (new \App\Classes\DemandaDado\Tipo())->selectCriacao ('Escolha uma opção'))
        @elseif($area == \App\Classes\DemandaDado\Area::CONVENIO)
        @? formSelect(name: 'demanda_filtro_tipo_demanda', label: 'Tipo de demanda', placeholder: 'Escolha o tipo de demanda', lista: (new \App\Classes\DemandaDado\Tipo())->selectConvenio ('Escolha uma opção'))
        @endif
    </div>

    <div class="footer_pagina_popup">
        <div class="flex"></div>
        <button class="button salvar" id="botao_buscar_filtro">Buscar</button>
    </div>
</div>

@ if( $visualizacao == 'lista' )
@include "painel_demanda_index_lista.php"
@ else
@include "painel_demanda_index_quadro.php"
@ endif;

<div class="display_none">
    @view painel/demanda/sprint-salvar/index.view
    @view painel/demanda/demanda-salvar/index.view
    @view painel/demanda/demanda-editar/index.view
    @view painel/demanda/demanda-cancelar/index.view
    @view painel/demanda/tarefa-salvar/index.view
    @view painel/demanda/tarefa-recusar/index.view

    <div class="tarefa_zero" id="clone_item_erro">Erro ao<br> buscar lista</div>
    <div class="tarefa_zero" id="clone_item_zero">Sem itens<br> no momento</div>

    <!-- LINHA LISTA -->
    <div class="linha" id="clone_tarefa_lista">
        <div class="lista geral">
            <div class="header">
                <div class="drag botao_drag">@iconeDrag(10)</div>
                <figure class="tarefa_perfil"></figure>
                <h1 class="tarefa_titulo"></h1>
                <div class="botao_acao abrir">@iconeSetaBaixo(6)</div>
                <div class="botao_acao fechar">@iconeSetaCima(6)</div>
            </div>
            <div class="conteudo">
                <div class="bloco_data">
                    <div class="data">Criado em: <span class="tarefa_data_criacao"></span></div>
                    <div class="data entrega bloco_data_entrega display_none">Prazo: <span class="tarefa_data_entrega"></span></div>
                </div>
                <div class="tarefa_texto texto bloco_noticia_texto">
                </div>
                <div class="bloco_botao">
                    <div class="botao botao_ver_demanda">Ver demanda</div>
                    <div class="botao sprint botao_sprint_add">Add sprint</div>
                    <div class="botao remover botao_sprint_remover">Remover sprint</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTAO FILTRAR -->
    <button class="buscar" id="botao_filtrar">
        @iconeFiltrar(16)
    </button>
    <!-- TAREFA INDEX -->
    <article class="bloco_tarefa_item bloco_kambam_item" data-id="" id="clone_tarefa_quadro">
        <header>
            <div class="botao_drag drag">@iconeDrag(8)</div>
            <h1 class="tarefa_titulo titulo"></h1>
        </header>
        <div class="bloco_data">
            <figure class="perfil tarefa_perfil"><span></span></figure>
            <div class="data bloco_entrega display_none">@iconeRelogio(15) <span class="tarefa_data_entrega"></span></div>
            <div class="data">@iconeCalendario(14) <span class="tarefa_data_criacao"></span></div>
        </div>
    </article>

    <!-- TAREFA NA DEMANDA -->
    <article class="tarefa" id="clone_demanda_tarefa_item">
        <div class="bloco_botao bloco_dono">
            <i class="botao botao_editar">@iconeEditar(15)</i>
            <i class="botao botao_deletar">@iconeDeletar</i>
        </div>
        <figure class="item_equipe"></figure>
        <div class="conteudo">
            <h1 class="item_titulo"></h1>
            <div class="dado">
                <div class="item">
                    <span>Tipo:</span>
                    <p class="item_tipo"></p>
                </div>

                <div class="item">
                    <span>Status:</span>
                    <p class="item_status"></p>
                </div>

                <div class="linha"></div>

                <div class="item bloco_data_inicio display_none">
                    <span>Iniciado:</span>
                    <p class="item_data_inicio"></p>
                </div>

                <div class="item bloco_data_final display_none">
                    <span>Finalizado:</span>
                    <p class="item_data_final"></p>
                </div>
            </div>

            <div class="texto bloco_noticia_texto item_texto">
            </div>


            <div class="bloco_teste display_none">
                <p>Testado por:</p>
                <i class="botao_like like" data-ajuda="Aprovar tarefa">@iconeLike</i>
                <div class="bloco_imagem">

                </div>
                <i class="botao_deslike deslike" data-ajuda="Reprovar tarefa">@iconeDeslike</i>
            </div>
        </div>

        <div class="check display_none item_play" data-ajuda="Começar a trabalhar">@iconePlay(40)</div>
        <div class="check display_none item_finalizar" data-ajuda="Finalizar tarefa">@iconeCheck(15)</div>
        <div class="check display_none item_concluido" data-ajuda="Tarefa Finalizada">@iconeCheck(20)</div>
    </article>
</div>
