#bloco_demanda_nova
    max-width: 1100px
    h2
        width: 100%
        text-align: center
        titulo()
        margin-top: 20px
    h3
        width: 100%
        texto()
        margin-top: 40px
        font-weight: bold
        color: #666
    .chamada
        width: 100%
        texto()
        color: #333
    .observacao
        width: 100%
        background: rgba(255,0,0,.2)
        padding: 10px
        border-radius: 4px
    .observacao strong
    .observacao p
        texto()
    .bloco
        width: 100%
        flexRow()
        flex-wrap: wrap
        align-items: flex-start
    .bloco .quebra
        width: 100%
    .botao_lista
        width: 100%
        flexRow()
        flex-wrap: wrap
        align-items: center
        justify-content: center
    .botao_lista .botao
        height: 40px
        line-height: 40px
        padding: 0 20px
        border: 1px solid #CCC
        border-radius: 20px
        margin: 10px
        textoFontSize()
        cursor: pointer
        &:hover
        &.hover
            background: $cor
            color: #FFF
            border-color: $cor
    .observacao
        margin-top: 10px
    .dominio_proprio
        width: auto
        flexGrow()
    .link_login
        flexCol()
    .tipo_dominio
        max-width: 200px
        margin-right: 20px
    .sub_dominio
        flexRow()
    .sub_dominio p
        height: 45px
        line-height: 45px
        textoFontSize()
        margin-top: 20px
        color: #666
    .sub_dominio .bloco_input
        margin: 20px 10px 0 10px
        max-width: 200px
    .checkbox
        width: 100%
        flexRow()
        flex-wrap: wrap
    .checkbox .input_checkbox
        width: calc(25% - 20px)
        margin: 20px 20px 0 0
