.bloco_coluna
    .conteudo article
        width: 100%
        position: relative
        background: #FFF
        box-shadow: 0 4px 4px rgba(0,0,0,.1)
        border-radius: 4px
        margin-bottom: 20px
        cursor: pointer
        transition: opacity .3s ease-out
        overflow: hidden
        &:first-child
            margin-top: 0
        &.prioridade_1
            border-color: #FF6C60
        &.prioridade_2
            border-color: #00aced
        &.prioridade_3
            border-color: #169e91
    .conteudo:hover article
        opacity: .5
    .conteudo:hover article:hover
        opacity: 1
    .conteudo article .botao_mover
        width: 30px
        height: 30px
        border: 1px solid #DDD
        background: rgba(255,255,255,.7)
        cursor: move
        border-radius: 3px
        position: absolute
        top: 5px
        right: 5px
        z-index: 10
        flexCenter()
        fill: #999
        opacity: 0
        transition: opacity .3s ease-out
    .conteudo article:hover .botao_mover
        opacity: 1
    .conteudo article > figure
        width: 100%
        height: 150px
        background-size: cover
        background-position: center center
    .conteudo article header
        width: 100%
        padding: 15px 20px 0 0
        flexRow()
        align-items: center
    .conteudo article header .drag
        width: 30px
        height: 30px
        display: none
        fill: #999
        margin: 0 5px 0 10px
    .conteudo article header h1
        width: 100%
        font-size: 1.5rem
        color: #333
        font-weight: bold
        padding-left: 20px
    .conteudo article.drag header h1
        padding-left: 0
    .conteudo article header p
        width: 100%
        max-height: 4.5em
        line-height: 1.5em
        font-size: 1.5rem
        color: #999
        margin-top: 10px
        overflow: hidden
    .conteudo article header .porcentagem
        width: 100%
        height: 6px
        position: relative
        border-radius: 5px
        background: #DDD
        overflow: hidden
    .conteudo article header .porcentagem span
        height: 6px
        background-color: $corAzul
        position: absolute
        top: 0
        left: 0
    .conteudo article .bloco_data
        width: 100%
        flexRow()
        flex-wrap: wrap
        border-top: 1px solid #ddd
        margin-top: 10px
        padding: 10px 5px 15px 10px
        align-items: center
    .conteudo article .bloco_data figure
        width: 30px
        height: 30px
        flexCenter()
        background-size: cover
        background-position: center center
        background-color: #EEE
        border-radius: 30px
        margin-right: 5px
    .conteudo article .bloco_data .data
        border: 1px solid #CCC
        border-radius: 15px
        padding: 5px 10px
        font-size: 1.2rem
        color: #333
        fill: #777
        margin-right: 5px
        flexCenter()
        &.bloco_entrega
            fill: #FFF
            color: #FFF
            border-color: $corErro
            background-color: $corErro
    .conteudo article .bloco_data .data svg
        margin-right: 5px
    .conteudo article footer
        width: 100%
        display: flex
        flex-direction: row
        align-items: center
        border-top: 1px solid #DDD
        margin-top: 15px
        padding: 10px 20px
    .conteudo article footer i
        width: 30px
        height: 30px
        border-radius: 50%
        display: flex
        align-items: center
        justify-content: center
        fill: #FFF
        &.tipo.bug-outro
            background: $corErro url(../images/painel/demanda_bug.png) center center no-repeat
            background-size: 25px 25px
        &.tipo.novo-cliente
            background: $corVerde url(../images/painel/demanda_cliente.png) center center no-repeat
            background-size: 19px 19px
        &.tipo.novo-associacao
            background: $corAzul url(../images/painel/demanda_associacao.png) center center no-repeat
            background-size: 24px 24px
        &.tipo.outro
            background: $marrom url(../images/painel/demanda_outro.png) center center no-repeat
            background-size: 21px 21px
    .conteudo article footer figure
        width: 34px
        height: 34px
        border-radius: 50%
        background-color: #EEE
        background-size: cover
        background-position: center center
        border: 2px solid #FFF
        &.dev
            margin-right: -15px
            transition: margin-right .3s ease-out
    .conteudo article footer .bloco_dev
        flex-grow: 1
        flex-basis: 0%
        display: flex
        flex-direction: row
    .conteudo article footer .bloco_dev:hover figure.dev
        margin-right: 5px
    .conteudo article footer .resto
        flex-grow: 1
        flex-basis: 0%
    .conteudo article footer .linha
        width: 1px
        height: 20px
        background: #CCC
        margin: 0 10px
.bloco_coluna.drag
    .conteudo article header .drag
        flexCenter()
    .conteudo article header h1
        padding-left: 0

.bloco_coluna
    .conteudo article.bloco_loading
        padding: 20px
        h1
            height: 30px
            margin-bottom: 30px
        p
            height: 20px
            margin-top: 10px
        p:nth-child(2)
            width: 50%
        p:nth-child(4)
            width: 30%
