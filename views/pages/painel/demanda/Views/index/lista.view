<div id="bloco_app_lista_detalhe" class="bloco_coluna_geral bloco_visualizar_lista" data-status="nova">
    @ laco(3)
    <div class="lista geral loading display_none">
        <div class="header">
            <div class="drag esqueleto">@iconeDrag</div>
            <figure class="esqueleto"></figure>
            <h1><p class="esqueleto">{{nomeCompletoAleatorio()}}</p></h1>
            <div class="botao_acao abrir esqueleto"></div>
        </div>
    </div>
    @ endlaco;
</div>
<div id="bloco_botao_salvar">
    <button class="botao add" id="botao_add_tarefa">
        <i>@iconeAdd(13)</i>
        <p>ADD</p>
    </button>
</div>
