<article data-id="{!!$r->id!!}">
    <header>
        <h1 class="tarefa_titulo">{{$r->titulo}}</h1>
        <p>{{$r->tarefa}} {{$r->tarefa > 1 ? 'tarefas' : 'tarefa'}}</p>
    </header>
    <div class="bloco_area">
        @ foreach($r->area as $area):
        <div class="area">{{$Area->nome($area)}}</div>
        @ endforeach;
    </div>
    <footer>
        <figure class="cliente" style="background-image: url({!!$r->empresa->imagem!!})" data-ajuda="{{$r->empresa->nome}}"></figure>
        <div class="linha"></div>
        <figure class="equipe" data-ajuda="{{$r->dono->nome}}" style="background-image: url({!!$r->dono->imagem!!})"></figure>
        @ if($r->equipe):
        <div class="linha"></div>
        @ endif;
        <div class="bloco_dev">
            @foreach($r->equipe as $equipe):
            <figure class="dev" data-ajuda="{{$equipe->nome}}" style="background-image: url({!!$equipe->imagem!!})"></figure>
            @endforeach;
        </div>
        <i class="tipo {{$r->tipo}}" data-ajuda="{!!$Tipo->nome($r->tipo)!!}"></i>
    </footer>
</article>
