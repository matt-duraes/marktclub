<article class="bloco_tarefa_item" data-id="{!!$r->id!!}">
    <header>
        <h1 class="tarefa_titulo">{{$r->titulo}}</h1>
        @ if( !empty($r->tarefa_total) ) :
        <p>{{$r->tarefa_total}} {{$r->tarefa_total > 1 ? 'tarefas' : 'tarefa'}}</p>
        @ endif;

        @ if( !empty($r->tarefa_total) && in_array($r->status, ['nova', 'liberada', 'andamento']) ) :
        <div class="porcentagem" data-ajuda="{!!empty($r->tarefa_concluida) ? 0 : $r->tarefa_concluida!!} de {{$r->tarefa_total}} {{$r->tarefa_total > 1 ? 'tarefas concluídas' : 'tarefa concluída'}} ({!!porcentagem($r->tarefa_concluida, $r->tarefa_total)!!}%)"><span style="width: {!!porcentagem($r->tarefa_concluida, $r->tarefa_total)!!}%;"></span></div>
        @ endif;
    </header>
    <div class="bloco_data">
        <div class="data">@iconeCalendario(14) {{dataBr($r->data_criacao)}}</div>
        @ if( !empty($r->data_entrega) ):
        <div class="data">@iconeRelogio(15) {{dataBr($r->data_entrega)}}</div>
        @ endif;
    </div>
    <footer>
        <figure class="cliente" style="background-image: url({!!$r->empresa->imagem!!})" data-ajuda="{{$r->empresa->nome}}"></figure>
        <div class="linha"></div>
        <figure class="equipe" data-ajuda="{{$r->dono->nome}}" style="background-image: url({!!$r->dono->imagem!!})"></figure>
        @ if($r->equipe):
        <div class="linha"></div>
        @ endif;
        <div class="bloco_dev">
            @foreach($r->equipe as $equipe):
            <figure class="dev" data-ajuda="{{$equipe->nome}}" style="background-image: url({!!$equipe->imagem!!})"></figure>
            @endforeach;
        </div>
        <i class="tipo {{$r->tipo}}" data-ajuda="{!!$Tipo->nome($r->tipo)!!}"></i>
    </footer>
</article>
