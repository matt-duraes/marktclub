@template "painel"

#bloco_app_lista_detalhe
    width: 100%
    flexCol()
    padding-top: 20px
#bloco_app_lista_detalhe .linha
    width: 100%
    padding: 5px 20px
    .lista
        width: 100%
        display: flex
        flex-direction: column
    .lista.geral
        width: 100%
        background: #fff
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.1)
        border-radius: 5px
        align-items: center
        border: 1px solid #fff
        opacity: 1
        transition: opacity 0.3s ease-out
    &:hover .lista.geral
        border: 1px solid $cor
    .lista .header
        width: 100%
        min-height: 50px
        flexRow()
        padding-left: 20px
        align-items: center
    .lista .header .drag
        width: 35px
        fill: #999
        cursor: pointer
    .lista .header figure
        width: 30px
        height: 30px
        border-radius: 50%
        background-position: center center
        background-size: cover
        background-color: #EEE
    .lista .header h1
        font-size: 1.7rem
        line-height: 1.5em
        padding: 0 10px
        flexGrow()
    .lista .header .botao_acao
        width: 30px
        height: 30px
        flexCenter()
        cursor: pointer
        margin-right: 10px
        fill: #999
        border-radius: 5px
        &:hover
            background-color: #F6F6F6
    .lista .header .abrir
        display: flex
    .lista .header .fechar
        display: none
    .lista.aberto .header .abrir
        display: none
    .lista.aberto .header .fechar
        display: flex
    .lista .conteudo
        width: 100%
        padding: 0 20px 10px
        display: none
    .lista.aberto .conteudo
        flexCol()
    .lista .conteudo .texto
        color: #666
    .lista .conteudo .bloco_botao
        width: 100%
        flexRow()
        justify-content: flex-end
    .lista .conteudo .bloco_botao .botao
        height: 35px
        line-height: 35px
        border: 1px solid #CCC
        border-radius: 5px
        cursor: pointer
        margin-left: 10px
        textoFontSize()
        padding: 0 10px
        &.sprint
            background-color: $cor
            border-color: $cor
            color: #FFF

#bloco_botao_salvar .botao.sprint
    background-color: $corAzul
    &:hover
        width: 120px
