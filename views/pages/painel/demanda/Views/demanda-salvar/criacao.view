@? formSelect(name: 'empresa_criacao', placeholder: 'Escolha um cliente', label: 'Cliente', obrigatorio: 1, lista: $empresa)
@? formSelect(name: 'categoria', placeholder: 'Escolha uma categoria', label: 'Categoria', obrigatorio: 1, lista: ['' => 'Escolha uma opção', 'social' => 'Rede Social', 'site' => 'Site', 'impresso' => 'Impressos', 'kit' => 'Kit de Boas-Vindas', 'video' => 'Vídeo', 'outro' => 'Outros'], change: 'criacao_categoria')

<div class="bloco_site display_none">
    <h3>Dimensão da peça</h3>
    @? formNumero(name: ['site_largura', 'site_altura'], separador: 'por', label: 'Dimensão do peça', placeholder: ['Largura', 'Altura'], mascara: ['numero', 'numero'], obrigatorio: 1)
</div>
<div class="bloco_social display_none">
    @? formSwitch(name: 'digital_stories', label: 'Stories', check: false)
    @? formSwitch(name: 'digital_feed', label: 'Feed', check: false)
    @? formSwitch(name: 'digital_banner', label: 'Banner', check: false)
</div>
<div class="bloco_feed display_none">
    <h3>Feed de qual rede social?</h3>
    @? formCheckbox(name: 'feed_whatsapp', label: 'WhatsApp', check: false)
    @? formCheckbox(name: 'feed_instagram', label: 'Instagram', check: false)
    @? formCheckbox(name: 'feed_facebook', label: 'Facebook', check: false)
    @? formCheckbox(name: 'feed_linkedin', label: 'LinkedIn', check: false)
    @? formCheckbox(name: 'feed_twitter', label: 'Twitter', check: false)
    @? formCheckbox(name: 'feed_youtube', label: 'YouTube', check: false)
    @? formCheckbox(name: 'feed_tiktok', label: 'TikTok', check: false)
</div>
<div class="bloco_impreso display_none">
    @? formSwitch(name: 'impresso_voucher', label: 'Voucher', check: false)
    @? formSwitch(name: 'impresso_folder', label: 'Folder', check: false)
    @? formSwitch(name: 'impresso_banner', label: 'Banner', check: false)
    @? formSwitch(name: 'impresso_revista', label: 'Revista', check: false)
    @? formSwitch(name: 'impresso_outro', label: 'Outro', check: false)
</div>
<div class="bloco_kit display_none">
    @? formSwitch(name: 'kit_email', label: 'E-mail', check: false)
    @? formSwitch(name: 'kit_stories', label: 'Stories', check: false)
    @? formSwitch(name: 'kit_feed', label: 'Feed', check: false)
    @? formSwitch(name: 'kit_como_acessar', label: 'Como acessar', check: false)
    @? formSwitch(name: 'kit_baixe_app', label: 'Baixe o APP', check: false)
    @? formSwitch(name: 'kit_previa', label: 'Prévia', check: false)
    @? formSwitch(name: 'kit_video', label: 'Vídeo padrão', check: false)
</div>
<div class="bloco_video display_none">
    @? formSelect(name: 'video_formato', label: 'Formato do vídeo', placeholder: 'Formato do vídeo', lista: ['' => 'Escolha uma opção', 'horizontal' => '16:9 Horizontal', 'vertical' => '9:16 Vertical', 'outro' => 'Outro'], change: 'criacao_video_formato', obrigatorio: 1)

    @? formNumero(name: ['video_largura', 'video_altura'], separador: 'por', label: 'Dimensão do peça', placeholder: ['Largura', 'Altura'], mascara: ['numero', 'numero'], class: 'display_none', id: 'bloco_video_dimensao', obrigatorio: 1)
</div>
