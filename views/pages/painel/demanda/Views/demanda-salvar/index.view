<div id="bloco_demanda_nova" class="bloco_pagina_popup bloco_demanda_nova">
    <header class="header_pagina_popup">
        <h1>NOVA DEMANDA</h1>
    </header>
    <form class="form_geral conteudo_pagina_popup">
        <input type="hidden" id="input_tipo">
        <div class="botao_lista {{$area == 'tecnologia' ? '' : 'display_none'}}" id="bloco_tipo_demanda_tecnologia">
            <h2>Qual tipo de tarefa deseja criar?</h2>
            <p>Para facilitar a vida de todos, tenha certeza de abrir a demanda na categoria correta!</p>

            <div class="botao" data-tipo="cliente">Novo Cliente</div>
            <div class="botao" data-tipo="associacao">Site Associação</div>
            <div class="botao" data-tipo="bug">Bug</div>
            <div class="botao" data-tipo="feature">Feature</div>
            <div class="botao" data-tipo="outro">Outros</div>
        </div>
        <div class="botao_lista {{$area == 'criacao' ? '' : 'display_none'}}" id="bloco_tipo_demanda_criacao">
            <h2>Qual tipo de tarefa deseja criar?</h2>
            <p>Para facilitar a vida de todos, tenha certeza de abrir a demanda na categoria correta!</p>

            <div class="botao" data-tipo="criacao">Criação</div>
            <div class="botao" data-tipo="sorteio">Sorteio</div>
        </div>

        <div class="botao_lista {{$area == 'convenio' ? '' : 'display_none'}}" id="bloco_tipo_demanda_convenio">
            <div class="botao" data-tipo="evento">Evento</div>
            <div class="botao" data-tipo="campanha">Campanha desconto</div>
            <div class="botao" data-tipo="brinde">Brindes</div>
            <div class="botao" data-tipo="indicacao">Indicação</div>
            <div class="botao" data-tipo="autoindicacao">Auto Indicação</div>
            <div class="botao" data-tipo="cotacao-carro">Cotação - Carro</div>
            <div class="botao" data-tipo="cotacao-produto">Cotação - Produto</div>
            <div class="botao" data-tipo="auditoria">Auditoria</div>
        </div>

        <div class="geral display_none" id="bloco_geral_header">
            <h3>Título da demanda</h3>
            @? formInput(name: 'titulo', placeholder: 'Título curto e específico do que deseja criar', label: 'Título', obrigatorio: true)
        </div>

        <div class="bloco_conjunto display_none" id="bloco_tipo_associacao">
            @view "painel/demanda/demanda-salvar/associacao"
        </div>

        <div class="bloco_conjunto display_none" id="bloco_tipo_cliente">
            @view "painel/demanda/demanda-salvar/cliente"
        </div>

        <div class="bloco_conjunto display_none" id="bloco_tipo_bug">
            @view "painel/demanda/demanda-salvar/bug"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_tipo_outro">
            @view "painel/demanda/demanda-salvar/outro"
        </div>

        <div class="bloco_conjunto display_none" id="bloco_criacao">
            @view "painel/demanda/demanda-salvar/criacao"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_sorteio">
            @view "painel/demanda/demanda-salvar/sorteio"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_evento">
            @view "painel/demanda/demanda-salvar/evento"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_campanha">
            @view "painel/demanda/demanda-salvar/campanha"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_brinde">
            @view "painel/demanda/demanda-salvar/brinde"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_indicacao">
            @view "painel/demanda/demanda-salvar/indicacao"
        </div>
        <div class="bloco_conjunto display_none" id="bloco_autoindicacao">
            @view "painel/demanda/demanda-salvar/autoindicacao"
        </div>

        <div class="geral display_none" id="bloco_geral_footer">
            <h3>Outros dados</h3>
            @? formEditor(name: 'texto', label: 'Descrição da demanda', placeholder: 'Digite outras informacões', bar: 'bold,italic,underline,Strikethrough,|,fontColor,|,alignment,|,link,removeFormat,|,insertTable,codeBlock,|,horizontalLine,FwObservacao,|,numberedList,bulletedList', barBalao: 'bold,italic,underline,Strikethrough,|,fontColor,|,link,removeFormat')
        </div>
    </form>
    <div class="footer_pagina_popup">
        <div class="button voltar popup_fechar" id="botao_demanda_fechar">CANCELAR</div>
        <div class="button voltar display_none" id="botao_demanda_voltar">VOLTAR</div>
        <div class="button display_none salvar" id="botao_demanda_salvar">SALVAR</div>
    </div>
</div>
