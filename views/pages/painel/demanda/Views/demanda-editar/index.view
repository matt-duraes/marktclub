<div id="bloco_demanda_editar" class="bloco_pagina_popup">
    <header class="header_pagina_popup">
        <h1>EDITAR DEMANDA</h1>
    </header>
    <form class="form_geral conteudo_pagina_popup">
        @? formInput(name: 'demanda_editar_titulo', placeholder: 'Título curto e específico do que deseja criar', label: 'Título', obrigatorio: true)
        <div class="row2">
            @? formSelect(name: 'demanda_editar_empresa', placeholder: 'Escolha um cliente', label: 'Empresa', lista: $empresa)
            @? formSelect(name: 'demanda_editar_equipe', placeholder: 'Escolha um dono para a demanda', label: 'Dono da demanda', lista: $equipe)
        </div>
        <div class="row_livre">
            @? formSwitch(name: 'demanda_editar_com_prazo', label: 'A demanda tem prazo?', check: false)
            @? formData(name: 'demanda_editar_data_entrega', label: 'Data da entrega', placeholder: 'Prazo de entrega', class: 'bloco_input_data_entrega')
        </div>
        @? formEditor(name: 'demanda_editar_texto', label: 'Descrição da demanda', placeholder: 'Digite outras informacões', bar: 'bold,italic,underline,Strikethrough,|,fontColor,|,alignment,|,link,removeFormat,|,insertTable,codeBlock,|,horizontalLine,FwObservacao,|,numberedList,bulletedList', barBalao: 'bold,italic,underline,Strikethrough,|,fontColor,|,link,removeFormat')
    </form>
    <div class="footer_pagina_popup">
        <div class="button voltar popup_fechar" id="botao_cancelar_edicao">CANCELAR</div>
        <div class="button salvar" id="botao_editar_tarefa">SALVAR</div>
    </div>
</div>
