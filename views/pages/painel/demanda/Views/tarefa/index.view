<div id="bloco_demanda_tarefa">
    <input type="hidden" id="input_demanda_id" value="{{$r->id}}">
    <header>
        <i class="fechar mobile">@iconeVoltar</i>
        <h1>{{$r->titulo}}</h1>
        <i class="fechar desktop">@iconeFechar</i>
    </header>

    <div class="bloco_equipe">
        <figure style="background-image: url({!!$r->empresa->imagem!!});" data-ajuda="{{$r->empresa->nome}}"></figure>
        <div class="linha"></div>
        <figure style="background-image: url({!!$r->dono->imagem!!});" data-ajuda="{{$r->dono->nome}}"></figure>
        @ if( $r->equipe ):
        <div class="linha"></div>
        <div class="bloco_grupo">
            @ foreach( $r->equipe as $equipe ):
            <figure style="background-image: url({!!$equipe->imagem!!});" data-ajuda="{{$equipe->nome}}"></figure>
            @ endforeach;
        </div>
        @ endif;
        @ if( $r->seguindo ):
        <div class="linha"></div>
        <div class="bloco_grupo">
            @ foreach( $r->seguindo as $seguindo ):
            <figure style="background-image: url({!!$seguindo->imagem!!});" data-ajuda="{{$seguindo->nome}}"></figure>
            @ endforeach;
        </div>
        @ endif;

        <div class="resto"></div>

        @ if( !$r->sou_dev && !$r->sou_dono ):
        <div class="botao {!!$r->estou_seguindo ? 'sim' : 'nao'!!}">{!!$r->estou_seguindo ? 'seguindo' : 'seguir'!!}</div>
        @ endif;
        <div class="botao {!!$r->estou_seguindo ? 'nao' : 'nao'!!}">{!!$r->estou_seguindo ? 'seguir' : 'seguir'!!}</div>
    </div>

    <div class="bloco_tarefa">
        <h2>Tarefas</h2>
        <div class="botao_add">Nova Tarefa</div>
        @ foreach( $r->tarefa as $tarefa ):
        <article class="tarefa" data-id="{{$tarefa->id}}">
            <div class="bloco_botao">
                <i class="botao botao_editar">@iconeEditar(15)</i>
                <i class="botao botao_deletar">@iconeDeletar</i>
            </div>
            <figure style="background-image: url({!!$tarefa->dev->imagem!!});" data-ajuda="{{$tarefa->dev->nome}}"></figure>
            <div class="conteudo">
                <h1>{{$tarefa->titulo}}</h1>
                <div class="dado">
                    <div class="item">
                        <span>Tipo:</span>
                        <p>{{$Tipo->nome($tarefa->tipo)}}</p>
                    </div>

                    @ if( !empty($tarefa->hora_producao_estimada) ):
                    <div class="item">
                        <span>Tempo estimado:</span>
                        <p>{{$tarefa->hora_producao_estimada}} {{$tarefa->hora_producao_estimada > 1 ? 'horas' : 'hora'}}</p>
                    </div>
                    @ endif;

                    @ if( !empty($tarefa->hora_producao_real) && $tarefa->status == 'done'):
                    <div class="item">
                        <span>Tempo executado:</span>
                        <p>{{$tarefa->hora_producao_real}} {{$tarefa->hora_producao_real > 1 ? 'horas' : 'hora'}}</p>
                    </div>
                    @ endif;

                    <div class="item">
                        <span>Status:</span>
                        <p>{{$Status->nome($tarefa->status)}}</p>
                    </div>

                    @ if(!empty($tarefa->data_producao_final) || ( $tarefa->status == 'done' && !empty($tarefa->data_producao_final ))):
                    <div class="linha"></div>
                    @ endif;

                    @ if( !empty($tarefa->data_producao_inicio) ):
                    <div class="item">
                        <span>Iniciado:</span>
                        <p>{{dataBr($tarefa->data_producao_inicio)}}</p>
                    </div>
                    @ endif;

                    @ if( $tarefa->status == 'done' && !empty($tarefa->data_producao_final) ):
                    <div class="item">
                        <span>Finalizado:</span>
                        <p>10/10/2010</p>
                    </div>
                    @ endif;
                </div>
                <div class="texto bloco_noticia_texto">
                    {!!$tarefa->texto!!}
                </div>
            </div>
            <div class="botao play">@iconePlay(40)</div>
            <div class="botao display_none pause">@iconePause</div>
            <div class="botao display_none check">@iconeCheck</div>
        </article>
        @ endforeach;
    </div>

    <div class="bloco_arquivo">
        <h2>Arquivo</h2>
        <div class="botao">
            <input type="file" multiple>
            <div class="lista"></div>
        </div>
    </div>

    @php painelHistorico($r->id, 'demanda_dado', boxShadow: false)
</div>
