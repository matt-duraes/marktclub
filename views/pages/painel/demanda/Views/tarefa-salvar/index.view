<div id="bloco_demanda_nova" class="bloco_pagina_popup">
    <header class="header_pagina_popup">
        <h1>SALVAR TAREFA</h1>
    </header>
    <form class="form_geral conteudo_pagina_popup">
        <input type="hidden" id="input_id_demanda" value="{{$demanda}}">
        @? formInput(name: 'titulo', placeholder: 'Título curto e específico do que deseja criar', label: 'Título', obrigatorio: true)
        @? formEditor(name: 'texto', label: 'Texto', obrigatorio: true, placeholder: 'Digite outras informacões', bar: 'bold,italic,underline,Strikethrough,|,fontColor,|,alignment,|,link,removeFormat,|,insertTable,codeBlock,|,horizontalLine,FwObservacao,|,numberedList,bulletedList', barBalao: 'bold,italic,underline,Strikethrough,|,fontColor,|,link,removeFormat')
        <div class="row2">
            @? formSelect(name: 'tipo', label: 'Tipo de tarefa', obrigatorio: true, placeholder: 'Escolha uma opção', lista: $tipoLista)
            @? formNumero(name: 'minuto', label: 'Quantos minutos?', placeholder: 'Quantos minutos são preciso para a tarefa?')
        </div>
    </form>
    <div class="footer_pagina_popup">
        <div class="button voltar" id="botao_tarefa_salvar_cancelar">CANCELAR</div>
        <div class="button salvar" id="botao_tarefa_salvar_salvar">SALVAR</div>
    </div>
</div>
