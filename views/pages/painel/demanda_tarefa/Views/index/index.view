@template "painel"

<div id="bloco_demanda_index">
    <div class="conteudo_geral">
        @laco(6)
        <section class="bloco_coluna">
            <header>
                <h1>@iflaco [Backlog, Liberado, Em Progresso, Review, Teste, Deploy]</h1>
                @ if($i1 == 0):
                <button id="botao_add" class="botao">Add</button>
                @ endif;
                <div class="flex"></div>
                <i class="botao_encolher {!!$tarefa[$i1] ? '' : 'hide'!!}">+</i>
            </header>
            <div class="conteudo">
                @ foreach($tarefa[$i1] as $r):
                <article class="prioridade_{{$r->prioridade}}" id="tarefa_{!!$r->id!!}" data-url="{!!$r->url!!}">
                    <figure style="background-image: url({!!USUARIO_IMAGEM!!})"></figure>
                    <header>
                        <h1 class="tarefa_titulo">{{$r->titulo}}</h1>
                        <p>{{$r->texto}}</p>
                    </header>
                    <footer>
                        <figure class="equipe" style="background-image: url({!!USUARIO_IMAGEM!!})"></figure>
                        <figure class="dev" style="background-image: url({!!USUARIO_IMAGEM!!})"></figure>
                        <div class="linha"></div>
                        <figure class="cliente" style="background-image: url({!!USUARIO_IMAGEM!!})"></figure>
                        <div class="linha"></div>
                        <i class="tipo bug">@iconeBug</i>
                    </footer>
                </article>
                @endforeach
                <div class="tarefa_zero {!!$tarefa[$i1] ? 'hide' : ''!!}">Sem itens<br> no momento</div>
            </div>
        </section>
        @endlaco
    </div>
</div>
