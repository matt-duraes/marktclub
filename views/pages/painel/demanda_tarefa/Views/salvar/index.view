<div id="bloco_demanda_salvar">
    <div class="conteudo">
        <div class="topo" id="bloco_topo">
            <div class="bg"></div>
            <h1>CRIAR TAREFA</h1>
            <i class="botao icone" id="botao_fechar_salvar">@iconeFechar</i>
        </div>

        <div class="bloco_geral">
            <div class="bloco_opcao"></div>
            <article class="bloco_opcao esquerda" id="bloco_escolha">
                <header>
                    <h1>CRIAR DEMANDA</h1>
                    <p>Escolha uma das opções abaixo</p>
                </header>

                <div class="lista_item">
                    <button>CLUBE</button>
                    <button>APP</button>
                    <button>SITE DE ASSOCIAÇÃO</button>
                    <button>BUG</button>
                    <button>OUTROS</button>
                </div>
            </article>
            <article class="bloco_opcao form_geral" id="bloco_clube">
                <header>
                    <h1>CRIAR CLUBE</h1>
                    <p>Escolha as opções abaixo</p>
                </header>

                <div class="pergunta">
                    <h2>Qual a empresa?</h2>
                    @? formSelect(name: 'empresa', label: 'Empresa', placeholder: 'Escolha uma opção', lista: [])
                </div>

                <div class="pergunta">
                    <h2>Qual nome para o Clube?</h2>
                    @? formInput(name: 'nome', label: 'Nome', placeholder: 'Nome do clube')
                </div>

                <div class="pergunta">
                    <h2>O domínio será próprio ou Tem Mais Vantagens?</h2>
                    <div class="opcao">
                        <div class="botao">Domínio próprio</div>
                        <div class="botao">Tem Mais Vantagens</div>
                    </div>
                </div>

                <div class="pergunta">
                    <h2>Quem vai comprar o domínio?</h2>
                    <div class="opcao">
                        <div class="botao">Markt Club</div>
                        <div class="botao">Cliente</div>
                    </div>
                </div>

                <div class="pergunta">
                    <h2>Qual vai ser o domínio?</h2>
                    @? formUrl(name: 'url')
                </div>

                <div class="pergunta">
                    <h2>Qual vai ser o domínio?</h2>
                    @? formUrl(name: 'url_fake')
                    <p>.temmaisvantagens.com.br</p>
                </div>

                <div class="pergunta">
                    <h2>Que tipo de login será?</h2>
                    <div class="opcao">
                        <div class="botao">Por API</div>
                        <div class="botao">Pela nossa base</div>
                    </div>
                </div>

                <div class="pergunta">
                    <h2>O que terá no clube?</h2>
                    <div class="opcao">
                        @? formCheckbox(name: 'menu_01', label: 'Menu 01', check: false)
                        @? formCheckbox(name: 'menu_02', label: 'Menu 02', check: false)
                        @? formCheckbox(name: 'menu_03', label: 'Menu 03', check: false)
                        @? formCheckbox(name: 'menu_04', label: 'Menu 04', check: false)
                    </div>
                </div>
            </article>
        </div>
    </div>
</div>
