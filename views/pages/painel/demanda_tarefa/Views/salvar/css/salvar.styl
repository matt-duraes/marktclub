#bloco_demanda_salvar
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    overflow-y: auto
    .conteudo
        width: calc(100% - 40px)
        max-width: 1000px
        position: relative
        display: flex
        flex-direction: column
        background-color: #FFF
        border-radius: 5px
        margin: 20px auto
        box-shadow: 0 4px 5px rgba(0,0,0,1)
        overflow: hidden

#bloco_demanda_salvar .topo
        width: 100%
        height: 50px
        display: flex
        flex-direction: row
        align-items: center
        padding: 0 20px
        background: #FFF
        box-shadow: 0 4px 5px rgba(0,0,0,.05)
        z-index: 20
    .topo h1
        font-size: 1.6rem
        flex-grow: 1
        flex-basis: 0%
    .topo .icone
        width: 30px
        height: 30px
        display: flex
        align-items: center
        justify-content: center
        margin-left: 10px
        z-index: 2
        &:first-child
            margin-left: 0
        &.botao
            cursor: pointer

#bloco_demanda_salvar .bloco_geral
    width: 3000px
    margin-left: -1000px
    display: flex
    flex-direction: row
#bloco_demanda_salvar .bloco_opcao
    width: 1000px
    height: calc(100vh - 90px)
    overflow-y: auto
    transition: margin-left .5s ease-out, opacity .3s ease-out
    &.esquerda
        margin-left: -1000px
        opacity: 0
    &.direita
        margin-left: 1000px
        opacity: 0
    header
        width: 100%
    header h1
        width: 100%
        margin-top: 50px
        text-align: center
        font-size: 3rem
        color: #999
    header p
        width: 100%
        text-align: center
        font-size: 1.6rem
        margin-top: 10px
        color: #666

#bloco_escolha
    .lista_item
        width: 100%
        margin-top: 80px
        padding: 0 20px
        display: flex
        flex-direction: row
        justify-content: center
    .lista_item button
        height: 50px
        line-height: 50px
        padding: 0 30px
        font-size: 1.4rem
        color: #666
        border-radius: 25px
        border: 1px solid #CCC
        margin: 0 5px
        &:hover
            bgDegradeVerde()
            color: #FFF
            border-color: #FFF
