<div class="bloco_arquivo_popup" id="bloco_demanda_detalhe_renomar">
    <div class="conteudo">
        <header>
            <h1>Renomar arquivo</h1>
        </header>
        <p>Digite um novo nome para o arquivo.</p>
        @hash('ARQUIVO_RENOMEAR')
        <input type="hidden" id="input_arquivo_id">
        <input type="text" maxlength="150" id="input_arquivo_renomear" placeholder="Digite o nome">
        <footer>
            <div class="cancelar" id="botao_arquivo_renomear_cancelar">Cancelar</div>
            @? botaoLoading('Salvar', 'botao_arquivo_renomear_confirmar')
        </footer>
    </div>
</div>

<div class="bloco_arquivo_popup" id="bloco_demanda_detalhe_seguindo">
    <div class="conteudo">
        <header>
            <h1>Gerenciar seguidores</h1>
        </header>
        <input type="hidden" id="input_arquivo_id">
        @hash('ARQUIVO_SEGUINDO')

        <div class="lista form_geral">
            <div class="dono" id="bloco_seguindo_dono">
                <h2>Dono da tarefa:</h2>
                <figure style="background-image: url({!!$equipe->dono->imagem!!})"></figure>
                <p>{{$equipe->dono->nome}}</p>
            </div>
            @ if($equipe->dev)
            <div class="dono" id="bloco_seguindo_dev">
                <h2>Desenvolvedor:</h2>
                <figure style="background-image: url({!!$equipe->dev->imagem!!})"></figure>
                <p>{{$equipe->dev->nome}}</p>
            </div>
            @ endif

            <div class="linha"></div>

            @ if($equipe->lista)
            @ foreach($equipe->lista as $rEquipe)
            <div class="bloco liberado" id="bloco_seguidor_{!!$rEquipe->id!!}">
                <div class="check">
                    @? formCheckbox(name: 'check_' . $rEquipe->id, label: $rEquipe->nome, check: in_array($rEquipe->id, $equipe->seguindo), value: $rEquipe->id, html: '<figure style="background-image: url(' . $rEquipe->imagem . ')"></figure>')
                </div>
            </div>
            @endforeach
            @ endif
        </div>

        <footer>
            <div class="cancelar" id="botao_seguindo_cancelar">Cancelar</div>
            @? botaoLoading('Salvar', 'botao_seguindo_confirmar')
        </footer>
    </div>
</div>
