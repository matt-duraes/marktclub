@template "painel"

@ if ( temPermissaoEmpresa('relatorio_acesso') ):
<div class="bloco_pagina_popup display_none" id="bloco_empresas">
    <header class="header_pagina_popup">
        <h1>Empresas</h1>
        <i class="popup_fechar fechar botao_fechar">@iconeFechar</i>
    </header>

    <div class="form_geral conteudo_pagina_popup form_motivo" id="popup_empresas">
        <div class="bloco_checkbox">
            @ifforeach($empresa as $k => $e):
            @? formCheckbox(name: "", label: "{$e}", value: "{$k}");
            @endifforeach;
        </div>
    </div>
</div>
@ endif;

<div class="bloco_app_relatorio">
    <header>
        @ if ( temPermissaoEmpresa('relatorio_acesso') ):
            <form action="/" class="empresas form_geral">
                <div class="bloco_busca">
                    <i class="botao" id="botao_buscar_relatorio">@iconeBuscar</i>
                    <div class="empresas_busca"></div>
                </div>

                <div class="bloco_filtros">
                    <div class="bloco_linha">
                        @? formData(name: ['relatorio_data_de', 'relatorio_data_ate'], label: '', value: [$de, $ate], separador: 'até');
                    </div>

                    <button class="botao_empresa" type="button">
                        Empresas
                    </button>
                </div>
            </form>
        @ else:
            <form action="/" class="form_geral">
                <div class="bloco_linha">
                    @? formData(name: ['relatorio_data_de', 'relatorio_data_ate'], label: '', value: [$de, $ate], separador: 'até');
                </div>
                <i class="botao" id="botao_buscar_relatorio">@iconeBuscar</i>
            </form>
        @ endif;
    </header>

    <div class="lista">
        <div id="grafico_acesso" class="fw_grafico fw_grafico_grande">
            <div class="fw_grafico_titulo">Páginas acessadas</div>
            <div class="loading_geral">
                <p>Carregando grafico</p>
            </div>
        </div>

        <div id="lista_acesso_pagina" class="fw_grafico fw_grafico_medio">
            <div class="fw_grafico_titulo">Páginas mais acessadas</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
        <div id="lista_acesso_usuario" class="fw_grafico fw_grafico_medio">
            <div class="fw_grafico_titulo">Usuários com mais acesso</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>

        <div id="lista_acesso_parceiro" class="fw_grafico fw_grafico_pequeno">
            <div class="fw_grafico_titulo">Parceiros mais acessados</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>

        <div id="lista_acesso_parceiro_online" class="fw_grafico fw_grafico_pequeno">
            <div class="fw_grafico_titulo">Parceiros Online mais acessados</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>

        <div id="lista_acesso_parceiro_fisico" class="fw_grafico fw_grafico_pequeno">
            <div class="fw_grafico_titulo">Parceiros Físicos mais acessados</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>

        <div class="linha"></div>

        <div id="grafico_dispositivo" class="fw_grafico fw_grafico_pequeno">
            <div class="fw_grafico_titulo">Acesso por dispositivo</div>
            <div class="fw_grafico_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
        <div id="grafico_navegador" class="fw_grafico fw_grafico_pequeno">
            <div class="fw_grafico_titulo">Acesso por navegador</div>
            <div class="fw_grafico_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
        <div id="grafico_os" class="fw_grafico fw_grafico_pequeno">
            <div class="fw_grafico_titulo">Acesso por Sistema Operacional</div>
            <div class="fw_grafico_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
    </div>
</div>
