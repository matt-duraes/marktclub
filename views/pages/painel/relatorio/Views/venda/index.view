@template "painel"

<div class="bloco_pagina_popup display_none" id="popup_filtros">
    <header class="header_pagina_popup">
        <h1>Empresas</h1>
        <i class="popup_fechar fechar botao_fechar">@iconeFechar</i>
    </header>

    <div class="form_geral conteudo_pagina_popup" id="bloco_filtros">
        <div class="bloco_linha">
            @? formData(name: ['relatorio_data_de', 'relatorio_data_ate'], label: 'Data', value: [$de, $ate], separador: 'até');
        </div>
        @ if ($parceiroPermissao):
        <form id="form_parceiro">
            @? formSelect(name: 'parceiro', label: 'Selecione um parceiro', placeholder: 'Selecione um parceiro', lista: array_merge(['' => 'Selecione um parceiro'], $parceiro));
        </form>
        <div class="tag_lista" id="lista_parceiro"></div>
        @ endif;

        @ if ( temPermissaoEmpresa('relatorio_acesso') ):
        <div class="bloco_empresas">
            @? formCheckbox(name: "marcar_todos", label: "Marcar/Desmarcar todos", value: "");
            <div class="bloco_checkbox">
                @ifforeach($empresa as $k => $e):
                @? formCheckbox(name: "", label: "{$e}", value: "{$k}");
                @endifforeach;
            </div>
        </div>
        @ endif;
    </div>

    <div class="footer_pagina_popup">
        <div class="flex"></div>
        <div class="button salvar" id="botao_buscar_relatorio">BUSCAR</div>
    </div>
</div>

<div class="bloco_app_relatorio">
    <div class="lista">
        <div id="grafico_mes" class="fw_grafico fw_grafico_grande">
            <div class="fw_grafico_titulo">Dados por mês</div>
            <div class="loading_geral">
                <p>Carregando grafico</p>
            </div>
        </div>

        <div id="lista_loja_valor" class="fw_grafico fw_grafico_medio">
            <div class="fw_grafico_titulo">Valor por loja</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
        <div id="lista_loja_tiket" class="fw_grafico fw_grafico_medio">
            <div class="fw_grafico_titulo">Ticket médio por loja</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
    </div>

</div>
