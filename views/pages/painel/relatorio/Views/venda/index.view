@template "painel"

@ if ( temPermissaoEmpresa('relatorio_acesso') ):
    <div class="bloco_pagina_popup display_none" id="bloco_empresas">
        <header class="header_pagina_popup">
            <h1>Empresas</h1>
            <i class="popup_fechar fechar botao_fechar">@iconeFechar</i>
        </header>

        <div class="form_geral conteudo_pagina_popup form_motivo" id="popup_empresas">
            <div class="bloco_checkbox">
                @ifforeach($empresa as $k => $e):
                @? formCheckbox(name: "", label: "{$e}", value: "{$k}");
                @endifforeach;
            </div>
        </div>
    </div>
@ endif;

<div class="bloco_app_relatorio">
    <header>
        <form action="/" class="form_geral">
            @ if ( temPermissaoEmpresa('relatorio_loja_venda') ):
            <button class="botao_empresa" type="button">
                Empresas
            </button>
            @ endif;
            <div class="bloco_linha">
                @? formData(name: ['relatorio_data_de', 'relatorio_data_ate'], label: '', value: [$de, $ate], separador: 'até');
            </div>
            <i class="botao" id="botao_buscar_relatorio">@iconeBuscar</i>
        </form>
    </header>

    <div class="lista">
        <div id="grafico_mes" class="fw_grafico fw_grafico_grande">
            <div class="fw_grafico_titulo">Dados por mês</div>
            <div class="loading_geral">
                <p>Carregando grafico</p>
            </div>
        </div>

        <div id="lista_loja_valor" class="fw_grafico fw_grafico_medio">
            <div class="fw_grafico_titulo">Valor por loja</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
        <div id="lista_loja_tiket" class="fw_grafico fw_grafico_medio">
            <div class="fw_grafico_titulo">Ticket médio por loja</div>
            <div class="fw_grafico_bloco_lista">
                <div class="loading_geral">
                    <p>Carregando grafico</p>
                </div>
            </div>
        </div>
    </div>

</div>
