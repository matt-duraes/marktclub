            @ foreach( $r->seguindo as $equipe ):
            <figure style="background-image: url({!!$equipe->imagem!!});" data-ajuda="{{$equipe->nome}}"></figure>
            @ endforeach;
        </div>
        @ endif;

        <div class="resto"></div>

        <div class="botao {!!$r->dono ? 'display_none' : ''!!}" id="botao_seguir_demanda">{{$r->estouSeguindo ? 'seguindo' : 'seguir'}}</div>
