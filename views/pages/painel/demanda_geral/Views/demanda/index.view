    <header>
        <i class="fechar mobile pagina_fechar">@iconeVoltar</i>
        <h1 id="bloco_demanda_titulo">{{$r->titulo}}</h1>
        @ if( (sessao('USUARIO.gerente', padrao: 'nao') == 'sim' || $r->dono == 'sim') && !in_array($r->status, ['teste', 'concluido'])):
        <div class="botao_topo">
            <i id="botao_editar_demanda" data-ajuda="Editar demanda">@iconeEditar(15)</i>
        </div>
