<h3>Cliente</h3>
@? formSelect(name: 'empresa_sorteio', placeholder: 'Escolha um cliente', label: 'Cliente', obrigatorio: 1, lista: $empresa)

<h3>Prazo Entrega</h3>
@? formData(name: 'sorteio_data_entrega', label: 'Prazo limite', obrigatorio: 1)

<div class="bloco_coluna">
    <h3>Datas do sorteio</h3>
    @? formDataHora(name: ['data_inicio', 'data_final'], placeholder: ['Data de início da campanha', 'Data final da campanha'], label: 'Data da campanha')
    @? formDataHora(name: 'data_sorteio', label: 'Data do sorteio', placeholder: 'Data do sorteio')
</div>

<h3>Como o sorteio irá funcinar?</h3>
@? formInput(name: 'como_participar', label: 'Como participar', placeholder: 'Como o usuário participa do sorteio?')
@? formSelect(name: 'sorteio_motivacao', placeholder: 'Escolha uma motivação', label: 'Motivação', obrigatorio: 1, lista: ['' => 'Escolha uma opção', 'Campanha de ativação' => 'Campanha de ativação', 'Dia comemorativo' => 'Dia comemorativo', 'Campanha de acesso' => 'Campanha de acesso', 'outro' => 'Outro'])
@? formInput(name: 'sorteio_motivacao_outro', placeholder: 'Motivação do sorteio', class: 'display_none', id: 'bloco_sorteio_motivacao_outro')

<h3>Dados do prémio</h3>
@? formInput(name: 'premio_item', label: 'Qual será o prémio', placeholder: 'Qual será o prémio')
@? formSelect(name: 'premio_compra', label: 'Quem dará o prémio?', placeholder: 'Quem dará o prémio?', lista: ['' => 'Escolha uma opção', 'Markt Club' => 'Markt Club', 'Cliente' => 'Cliente'])
@? formSelect(name: 'premio_entrega', label: 'Onde será a entrega?', placeholder: 'Onde será a entrega?', lista: ['' => 'Escolha uma opção', 'Residência do usuário' => 'Residência do usuário', 'Sede do cliente' => 'Sede do cliente', 'outro' => 'Outro'])
@? formInput(name: 'premio_entrega_outro', label: 'Local de entrega', placeholder: 'Local de entrega do prémio', class: 'display_none', id: 'bloco_premio_entrega_outro')
