<div id="bloco_sprint_nova" class="bloco_pagina_popup">
    <header class="header_pagina_popup">
        <h1>SPRINT</h1>
    </header>
    <form class="form_geral conteudo_pagina_popup">
        <input type="hidden" id="input_tarefa_id">
        @? formInput(name: 'sprint_titulo', placeholder: 'Título para a sprint', label: 'Título', obrigatorio: true, local: 'Nome da sprint')
        @? formData(name: 'sprint_data_inicio', label: 'Data de começo', obrigatorio: true, placeholder: 'Data de começo', local: hoje())
        @? formData(name: 'sprint_data_final', label: 'Data final', obrigatorio: true, placeholder: 'Data final', local: hoje(mais: 10))
    </form>
    <div class="footer_pagina_popup">
        <div class="button voltar popup_fechar">CANCELAR</div>
        <div class="button salvar" id="botao_sprint_salvar_salvar">SALVAR</div>
    </div>
</div>
