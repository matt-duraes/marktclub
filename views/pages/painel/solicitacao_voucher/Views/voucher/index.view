<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VOUCHER - {{$dado->parceiro->titulo}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    @CSS
</head>
<body>
    <div id="bloco-voucher">
        <header>
            <figure>
                <img height="60" src="{!!$dado->construtor->link_logo!!}" alt="">
            </figure>
        </header>

        @ if (!empty($dado->parceiro->link_logo)) :
            <div class="logo">
                <figure>
                    <img height="60" src="{!!$dado->parceiro->link_logo!!}" alt="PARCEIRO">
                </figure>
            </div>
        @ endif;

        <section class="voucher-container">
            <div class="voucher-imagem">
                <img src="{!!$dado->qr_code!!}" alt="codigo">
            </div>
        </section>

        @ if (isset($dado->codigo) && !empty($dado->codigo)) :
            <div class="voucher-codigo">
                <p>{{$dado->codigo}}</p>
            </div>
        @ endif;

        <section class="voucher-titulo">

            <h2 class="color_cor">{{$dado->usuario->nome}}</h2>
            <h1 class="color_cor">{{$dado->usuario->cpf}}</h1>

            <div class="data">
                <div class="data--caixa">
                    <p>CRIADO EM</p>
                    <p>{{dataBr($dado->data_criacao)}}</p>
                </div>
                @ if (!empty($dado->data_vencimento)) :
                    <div class="data--caixa">
                        <p>VÁLIDO ATÉ</p>
                        <p class="color_cor bold">{{dataBr($dado->data_vencimento)}}</p>
                    </div>
                @ endif;
            </div>
        </section>

        <section class="voucher-descricao">
            <article class="caixa-descricao">
                <p>{{nl2br($dado->texto_desconto)}}</p>
            </article>
        </section>
        @ if (!empty($dado->texto_voucher)) :
            <section class="voucher-descricao">
                <article class="caixa-descricao">
                    <p>{{nl2br($dado->texto_voucher)}}</p>
                </article>
            </section>
        @ endif;

        <section class="voucher-termo">
            <article class="caixa-termo imagem">
                <p>Administrado por:</p>
                <figure>
                    <img height="60" src="{!!$dado->construtor->link_logo_marktclub!!}" alt="MARKTCLUB">
                </figure>
            </article>
            @ if( !empty($dado->texto_juridico) ):
            <article class="caixa-termo">
                <p>{{$dado->texto_juridico}}</p>
            </article>
            @ endif;

            <article class="caixa-termo">
                <p>{{$dado->texto_validar}}</p>
            </article>
        </section>
    </div>
</body>
</html>
