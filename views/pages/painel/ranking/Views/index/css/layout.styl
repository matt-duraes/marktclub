@template "painel"

#bloco_app_lista
    width: 100%
    display: flex
    flex-flow: column nowrap
    margin: 2rem 0 0 0
    .lista
        display: flex
        flex-flow: row nowrap
        justify-content: space-around
        align-items: center
        border-radius: .25rem
        padding: 1.25rem 1.5rem
        margin: .5rem 1.75rem
        transition: all 100ms ease-in-out
        h1
            width: 100%
            min-width: 128px
            font-size: 2.5rem
            font-weight: 700
            color: #666

        h3
            width: 100%
            min-width: 512px
            font-size: 1.5rem
            font-weight: 500
            color: #666

        p
            width: 100%
            min-width: 128px
            font-size: 1.5rem
            font-weight: 500
            color: #666

    .lista.header
        background-color: #eee
        border: 1px solid #ddd
        h1
            font-size: 2.5rem
            font-weight: 700
            color: #666

        h3
            font-size: 2.5rem
            font-weight: 700
            color: #666

        p
            font-size: 2.5rem
            font-weight: 700
            color: #666

    .lista.body.amarelo
        background-color: #fdeb71
        background-image: linear-gradient( 135deg, #fdeb71 10%, #f8d800 100%)

    .lista.body.vermelho
        background-color: #feb692
        background-image: linear-gradient( 135deg, #feb692 10%, #ea5455 100%)

    .lista.body.verde
        background-color: #81fbb8
        background-image: linear-gradient( 135deg, #81fbb8 10%, #28c76f 100%)

    .lista.body.cinza
        background-color: #efefbb
        background-image: linear-gradient( 135deg, #efefbb 10%, #d4d3dd 100%)
