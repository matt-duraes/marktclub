@template "painel"

<!--Bloco do popup standby -->
<div class="bloco_pagina_popup display_none bloco_motivo">
    <div class="conteudo_pagina_popup popup_conteudo">
        <header class="header_pagina_popup">
            <h1 id="h1_motivo">Motivo Stand BY</h1>
            <i class="popup_fechar fechar botao_fechar">@iconeFechar</i>
        </header>
        <form class="form_geral conteudo_pagina_popup form_motivo">
            @? formInput(name: 'motivo', label: 'Motivo Stand BY', placeholder: 'Digite o motivo do stand by', value: '')
            <div class="footer_pagina_popup">
                <div class="flex"></div>
                <button id="botao_atualizar_motivo" class="botao_atualizar">Atualizar</button>
            </div>
        </form>
    </div>
</div>

<div class="bloco_kambam_index" id="bloco_comercial_prospeccao">
    <div class="conteudo_geral">
        <section class="bloco_coluna">
            <header>
                <h1>Pesquisa <span>({!!count($pesquisa)!!})</span></h1>
                <div class="flex"></div>
                <a href="{{LINK}}/app/add/comercial-prospeccao" class="botao">Add</a>
            </header>
            <div class="conteudo coluna_drop" id="bloco_pesquisa" data-prospeccao="pesquisa">
                @ifforeach($pesquisa as $r):
                @view painel/comercial_prospeccao/index/item.view
                @endifforeach;
                <div class="tarefa_zero {{$pesquisa ? 'display_none' : ''}}">Sem itens<br> no momento</div>
