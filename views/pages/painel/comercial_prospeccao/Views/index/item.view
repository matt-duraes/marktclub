<article class="bloco_kambam_item" data-id="{!!$r->id!!}">
    <header>
        <figure style="background-image: url({!!$r->usuario->imagem!!});" data-ajuda="{{$r->usuario->nome}}"></figure>
        <h1>{{$r->titulo}}</h1>
    </header>
    <a class="botao_link" href="{{LINK}}/app/visualizar/comercial-empresa/{{$r->id}}">ver empresa</a>
    <p class="data">{{$r->data_criacao}}</p>
    <div class="bloco">
        <i class="icone botao_item_atendimento">@iconeTelefone(19)</i>
        <i class="icone botao_item_historico">@iconeMensagem(18)</i>

        <div class="linha"></div>
        <i class="inativar botao_item_cancelar" data-ajuda="Finalizar contrato">@iconeFechar(10)</i>
        <i class="ativar botao_item_concluir" data-ajuda="Contrato fechado">@iconeCheck(12)</i>

        <div class="grow"></div>

        <i class="seta botao_item_anterior" data-ajuda="Voltar contrato">@iconeSetaEsquerda(18)</i>
        <i class="seta botao_item_proximo" data-ajuda="Avançar contrato">@iconeSetaDireita(18)</i>
    </div>
</article>
