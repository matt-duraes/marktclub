<article class="bloco_kambam_item" data-id="{!!$r->id!!}">
    <header>
        <h1>{{$r->titulo}}</h1>
    </header>
    <a class="botao_link" href="{{LINK}}/app/visualizar/comercial-prospeccao/{{$r->id}}">ver prospecção</a>
    <p class="data">{{$r->data_criacao}}</p>
    <div class="bloco">
        <i class="icone botao_item_atendimento" data-ajuda="Dados de contato">@iconeTelefone(19)</i>
        <i class="icone botao_item_historico" data-ajuda="Adicionar histórico">@iconeMensagem(18)</i>

        <div class="linha"></div>
        <i class="inativar botao_item_cancelar" data-ajuda="Cancelar contrato">@iconeFechar(10)</i>
        <i class="ativar botao_item_concluir" data-ajuda="Concluir contrato">@iconeCheck(12)</i>

        <div class="grow"></div>

        <i class="seta botao_item_anterior {!!$r->status == $primeiro_status ? 'display_none' : ''!!}" data-ajuda="Voltar contrato">@iconeSetaEsquerda(18)</i>
        <i class="seta botao_item_proximo {!!$r->status == $ultimo_status ? 'display_none' : ''!!}" data-ajuda="Avançar contrato">@iconeSetaDireita(18)</i>
    </div>
</article>
