@template "painel"
@system "Popup"
@painel "app_geral_visualizar"

#bloco_votacao
    align-items: flex-start
    .zero
        padding: 40px 0
        text-align: center
    .botao_pequeno
        font-size: 1.4rem
        background-color: $cor
        border-radius: 25px
        color: #FFF
        padding: 8px 30px
        margin: 5px 0 15px
        cursor: pointer
        &.loading
            background-color: #CCC
            cursor: no-drop
        &.vermelho
            background-color: $botaoDeletar
        &.azul
            background-color: $botaoEditar
    > .botao_pequeno
        margin-left: 20px
.bloco_pergunta
    width: 100%
    padding: 0 20px
    margin-top: 10px
.bloco_pergunta .linha
    width: 100%
    padding: 10px 20px 10px 55px
    flexRow()
    flex-wrap: wrap
    border: 1px solid #CCC
    border-bottom: none
    position: relative
    &:last-child
        border: 1px solid #CCC
    h1
        width: 100%
        texto()
        font-weight: bold
    .grow
        flexGrow()
    i.drag
        width: 30px
        height: 30px
        flexCenter()
        fill: #888
        position: absolute
        background-color: #f6f6f6
        border-radius: 4px
        top: 27px
        left: 10px
        cursor: pointer
        z-index: 2
    .botao
        font-size: 1.3rem
        margin: 10px 10px 0 0
        cursor: pointer
        color: #FFF
        padding: 3px 15px
        border-radius: 20px
        &.editar
            background-color: $corAzul
        &.resposta
            background-color: $corVerde
        &.deletar
            background-color: $corVermelho
        &:last-child
            margin-right: 0

#bloco_pergunta_add
    width: 100%
    max-width: 700px
    flexCol()
    form
        width: 100%
        flexCol()
        align-items: flex-start
    form h2
        subtitulo()
        margin-top: 30px
    .botao_pequeno
        font-size: 1.4rem
        background-color: $cor
        border-radius: 25px
        color: #FFF
        padding: 8px 30px
        margin: 5px 0 15px
        cursor: pointer
        &.loading
            background-color: #CCC
            cursor: no-drop
    form .zero
        width: 100%
        padding: 50px 20px
        text-align: center
        texto()
        color: #999
    form .botao
        width: 100px
        height: 45px
        line-height: 45px
        margin-top: 10px
        bgDegradeVerde()
        border-radius: 30px
        color: #fff
        font-size: $textoFontSize
        cursor: pointer
        text-align: center

#bloco_resposta_add
    width: 100%
    max-width: 700px
    flexCol()
    form
        width: 100%
        flexCol()
        align-items: flex-start
    form .bloco_metade
        width: 100%
        flexRow()
        justify-content: space-between
    form .bloco_switch
        width: calc(50% - 10px)
    form h2
        subtitulo()
        margin: 30px 0 5px
    form .zero
        width: 100%
        padding: 30px 0
        texto()
        color: #999
    form .bloco_botao
        width: 100%
        flexRow()
        justify-content: flex-end
        margin-top: 15px
    form .bloco_botao .botao
        bgDegradeVerde()
        height: 40px
        line-height: 40px
        border-radius: 20px
        color: #fff
        padding: 0 25px
        font-size: 1.2rem
        cursor: pointer

#bloco_resposta_add .lista_resposta
    width: 100%
    flexCol()
    .linha
        width: 100%
        flexCenter()
        border: 1px solid #CCC
        border-bottom: none
        position: relative
        padding: 10px
        &:last-child
            border: 1px solid #CCC
    .linha h1
        texto()
        flexGrow()
        padding-left: 10px
    .linha i.drag
        width: 30px
        height: 30px
        flexCenter()
        fill: #888
        background-color: #f6f6f6
        border-radius: 4px
        cursor: pointer
        z-index: 2
    .botao
        font-size: 1.3rem
        margin-left: 10px
        cursor: pointer
        color: #FFF
        padding: 5px 10px
        border-radius: 20px
        &.editar
            background-color: $corAzul
        &.deletar
            background-color: $corVermelho
