@template "painel"
@resource "painel/app_geral_visualizar"

#bloco_endereco_add
    width: 100VW
    height: 100vh
    position: fixed
    top: 0
    left: 0
    z-index: 100
    background: rgba(0,0,0,.7)
    flexRow()
    justify-content: center
    align-items: flex-start
    overflow-y: auto
    .conteudo
        max-width: 800px

#bloco_endereco_add .conteudo
    h2
        width: 100%
    .bloco
        width: 100%
        flexRow()
        flex-wrap: wrap
        padding: 0 20px
    .bloco_endereco_titulo
        flexGrow()
        margin-right: 20px
    .bloco_endereco_telefone
        max-width: 200px
    .bloco_endereco_pais
        max-width: 200px
        margin-right: 20px
    .bloco_endereco_cep
        max-width: 160px
    .bloco_endereco_logradouro
        max-width: 300px
        margin-right: 20px
    .bloco_endereco_numero
        max-width: 100px
        margin-right: 20px
    .bloco_endereco_referencia
        flexGrow()
    .bloco_endereco_bairro
        max-width: 200px
        margin-right: 20px
    .bloco_endereco_estado
        max-width: 180px
        margin-right: 20px
    .bloco_endereco_cidade_brasil
    .bloco_endereco_cidade_estrangeiro
        flexGrow()
    .bloco_mapa
        width: 100%
        max-height: calc(100vh - 100px)
        margin-top: 20px
        border-top: 2px solid $cor
    .bloco_mapa h2
        width: calc(100% - 40px)
        margin-left: 20px
    .bloco_mapa .geolocalizacao
        width: 100%
        flexRow()
        padding: 0 20px 10px
        justify-content: space-between
    .bloco_mapa .geolocalizacao .bloco_input
        flexGrow()
        margin-right: 20px
    .bloco_mapa .geolocalizacao .botao
        height: 45px
        line-height: 45px
        padding: 0 15px
        bgDegradeCinza()
        textoFontSize()
        border-radius: 4px
        margin-top: 20px
        cursor: no-drop
        color: #666
    .bloco_mapa .geolocalizacao .botao.ativo
        bgDegradeVerde()
        color: #FFF
        cursor: pointer
    .bloco_mapa .mapa
        width: 100%
        height: 400px
        background-color: #EEE
    .footer
        width: 100%
        flexRow()
        justify-content: flex-end
        padding: 10px 20px
