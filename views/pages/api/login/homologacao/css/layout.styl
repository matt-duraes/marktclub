@system "Resetar"

body
    background-color: #F6F6F6
    font-family: Arial, Helvetica, sans-serif

#site
    width: 100%
    display: flex
    flex-direction: column
    align-items: center
    padding: 40px 20px
    h1
        font-size: 3rem
        margin-bottom: 40px
    p
        margin-top: 10px
        font-size: 1.6rem
        line-height: 1.5em
        max-width: 400px
        text-align: center
        color: #666
    p strong
        font-size: 1.6rem
        font-weight: bold
