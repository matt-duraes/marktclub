@template "documentacao"

#site .bloco_fluxo
    width: 100%
    display: flex
    flex-direction: column
    h2
        font-size: 1.8rem
        font-weight: bold
        margin-top: 40px
    p
        width: 100%
        texto()
        color: #666
        margin: 10px 0
    .fluxo_grafico
        width: 100%
        display: flex
        flex-direction: column
        margin-top: 30px
    .linha
        width: 100%
        position: relative
        display: flex
        flex-direction: row
    .linha p
        text-align: center
        padding: 0 10px
    .linha .servidor
        width: 300px
        border: 1px solid #DDD
        border-radius: 5px
        padding: 10px
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
    .linha .servidor figure
        width: 100%
        height: 50px
        position: relative
        background: url(../images/api/servidor.svg) no-repeat center center
        background-size: auto 50px
        margin: 10px 0 15px
    .linha .servidor span
        height: 30px
        line-height: 30px
        background-color: $cor
        color: #FFF
        padding: 0 10px
        border-radius: 20px
        font-size: 1.4rem
        margin-bottom: 5px
    .linha .seta_direita
    .linha .seta_esquerda
        position: relative
        flex-grow: 1
        flex-basis: 0%
        display: flex
        padding: 0 40px
        align-items: center
        justify-content: center
    .linha .seta_direita::after
    .linha .seta_esquerda::after
        content: ""
        width: calc(100% - 90px)
        height: 3px
        background: #CCC
        position: absolute
    .linha .seta_direita::after
        left: 40px
    .linha .seta_esquerda::after
        left: 45px
    .linha .seta_direita span
    .linha .seta_esquerda span
        position: absolute
        width: 12.5px
        height: 25px
        overflow: hidden
    .linha .seta_direita span
        right: 40px
    .linha .seta_esquerda span
        left: 40px
    .linha .seta_direita span::before
    .linha .seta_esquerda span::before
        content: ""
        position: absolute
        width: 25px
        height: 25px
        top: 0px
        background: #CCC
        transform: rotate(45deg)
    .linha .seta_direita span::before
        left: -18px
    .linha .seta_esquerda span::before
        left: 5px
    .linha .grow
        flex-grow: 1
        flex-basis: 0%
    .linha .seta_baixo
        display: flex
        flex-direction: row
        align-items: center
        justify-content: center
        width: 300px
        height: 50px
        margin: 10px 0
        position: relative
    .linha .seta_baixo::after
        content: ""
        width: 3px
        height: 40px
        background: #CCC
        position: absolute
    .linha .seta_baixo span
        position: absolute
        width: 25px
        height: 25px
        overflow: hidden
        top: 35px
    .linha .seta_baixo span::before
        content: ""
        position: absolute
        width: 25px
        height: 25px
        background: #CCC
        transform: rotate(45deg)
        top: -18px
@media screen and (max-width: 800px)
    #site .bloco_fluxo
        .linha .servidor
            width: calc(50% - 20px)
        .linha .seta_direita::after
        .linha .seta_esquerda::after
            display: none
        .linha .seta_direita span
        .linha .seta_esquerda span
            left: 0
            right: 0
            margin: auto
        .linha .seta_baixo
            width: calc(50% - 40px)
@media screen and (max-width: 600px)
    #site .bloco_fluxo
        .linha
            width: calc(100% + 40px)
            margin-left: -20px
        .linha .servidor
            width: 50%
            border-radius: 0
            &:last-child
                border-left: none
        .linha .seta_direita
        .linha .seta_esquerda
            position: absolute
            width: 100%
            height: 100%
            z-index: 2
        .linha .seta_direita span
        .linha .seta_esquerda span
            background: #FFF
            outline: 10px solid #FFF
        .linha .seta_baixo
            width: 50%
