{
    "name": "andrerodrigue5/framework",
    "description": "Micro Framework",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "firebase/php-jwt": "^5.2",
        "intervention/image": "^2.5",
        "phpmailer/phpmailer": "^6.4",
        "symfony/http-client": "^5.3",
        "symfony/browser-kit": "^5.3",
        "symfony/css-selector": "^5.3",
        "symfony/http-foundation": "^5.3",
        "symfony/mime": "^5.3",
        "phpmussel/core": "^3.3.0",
        "ezyang/htmlpurifier": "^4.13",
        "php-webdriver/webdriver": "^1.11",
        "mpdf/mpdf": "^8.0",
        "google/apiclient": "^2.0",
        "box/spout": "^3.3",
        "phpseclib/phpseclib": "^3.0",
        "sendgrid/sendgrid": "^8.0"
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "System\\": "src/",
            "Status\\": "src/Status",
            "Random\\": "src/Random",
            "Order\\": "src/Order",
            "Tests\\": ["tests","src/Tests"],
            "App\\": "app/",
            "Controller\\": "src/Controller/",
            "ORM\\": "src/Orm/",
            "Helpers\\": "src/Helpers/",
            "Modules\\": "src/Modules/",
            "DataBase\\": "src/Database/",
            "Route\\": "src/Route/",
            "Api\\": "src/Http/",
            "Http\\": "src/Http/",
            "Erro\\": "src/Erro/",
            "ApiController\\": "src/Api/Controllers",
            "ApiModel\\": "src/Api/Models",
            "PainelConfig\\": "src/Painel/Config",
            "PainelApp\\": "src/Painel/App",
            "PainelController\\": "src/Painel/Controllers",
            "PainelModel\\": "src/Painel/Models",
            "DocumentacaoConfig\\": "src/Documentacao/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
