@template "painel"

<div id="bloco_assinatura">
    <form action="" method="post" class="bg form_geral">
        @? formInput(name:'assinatura_nome', label: 'Nome', placeholder: 'Digite seu nome', local: 'André Rodrigues')
        @? formInput(name:['assinatura_cargo_sigla', 'assinatura_cargo_nome'], label: 'Cargo', placeholder: ['Digite seu cargo', 'Descrição (opcional)'], separador: '|', local: ['CTO', 'Chief Technology Officer'])
        @? formInput(name:['assinatura_celular', 'assinatura_telefone'], label: 'Telefone', placeholder: ['Digite seu celular', 'Digite o telefone (opcional)'], separador: '|', mascara: ['00000-0000', '0000-0000'], local: ['98177-7773'])
        <div class="bloco_row">
            @? formInput(name:'assinatura_email', label: 'E-mail', placeholder: 'Digite seu e-mail', local: 'andre')
            <div class="dominio">@youhuul.com.br</div>
        </div>
    </form>

    <div class="assinatura bg">
        <figure><img src="https://youhuul.com.br/images/assinatura/youhuul.png" width="80" alt="You Huul"></figure>
        <div class="dado">
            <div class="nome texto"></div>
            <div class="separador texto display_none"> | </div>
            <div class="cargo texto"><strong></strong> <span></span></div>
            <div class="linha">
                <div class="texto"><span class="ddi display_none">+55 (61)</span> <strong class="celular"></strong> <span class="telefone"></span></div>
                <div class="email texto"></div>
                <div class="texto">youhuul.com.br</div>
            </div>
        </div>
    </div>
    <div class="bloco_botao">
        <div class="botao" id="botao_copiar_assinatura">Copiar</div>
        <a href="" class="botao destaque">Abrir assinatura</a>
    </div>
</div>
