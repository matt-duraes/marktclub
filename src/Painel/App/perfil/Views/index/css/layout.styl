@template "painel"

#bloco_perfil
    width: 100%
    display: flex
    flex-direction: column
    padding-top: 130px
    align-items: center
#bloco_perfil .conteudo
    width: calc(100% - 40px)
    max-width: 1000px
    background: #FFF
    border-radius: 4px
    display: flex
    flex-direction: row
    flex-wrap: wrap
    .imagem
        width: 100%
        display: flex
        justify-content: center
        margin-top: -100px
    .imagem figure
        width: 200px
        height: 200px
        position: relative
        border-radius: 50%
        background-position: center center
        background-size: cover
        background-color: #EEE
        overflow: hidden
        display: flex
        align-items: center
        justify-content: center
    .imagem figure button
        width: 100%
        height: 100%
        background-color: rgba(0,0,0,.7)
        position: absolute
        top: 0
        left: 0
        z-index: 2
        display: flex
        align-items: center
        justify-content: center
        cursor: pointer
        opacity: 0
        transition: opacity .3s ease-out
        border-radius: 50%
        &:hover
            opacity: 1
    .imagem figure button span
        color: #FFF
        border: 1px solid #FFF
        border-radius: 3px
        font-size: 1.4rem
        padding: 5px 10px
    .botao
        width: 100%
        display: flex
        justify-content: center
        margin: 20px 0
    .botao a
        border: 1px solid #DDD
        border-radius: 3px
        padding: 5px
        font-size: 1.2rem
    .bloco
        width: 50%
        text-align-last: right
        padding: 10px 10px 20px 20px
    .bloco.direito
        text-align-last: left
    .bloco h1
        font-size: $tituloFontSize
        color: #999
        margin-bottom: 8px
    .bloco p
        width: 100%
        position: relative
        font-size: $textoFontSize
        padding: 10px 0
        &::after
            content: " "
            position: absolute
            bottom: 0
            width: 100px
            height: 1px
            background-color: #EEE
    .bloco p span.zero
        font-size: $textoFontSize
        color: #AAA
    .bloco.esquerdo p::after
        right: 0
    .bloco.direito p::after
        left: 0
    .bloco p:last-child::after
        display: none
    .bloco p strong
        font-size: 1.4rem
        font-weight: normal
        color: #999

#bloco_perfil .conteudo .social
    width: 100%
    display: flex
    flex-direction: row
    flex-wrap: wrap
    margin-top: 30px
    padding: 50px 20px 80px 20px
    border-top: 1px solid #EEE
    justify-content: center
    h1
        width: 100%
        font-size: $tituloFontSize
        color: $cor
        text-align: center
    > p
        width: 100%
        max-width: 500px
        text-align: center
        line-height: 1.5em
        font-size: $textoFontSize
        color: #666
        margin: 10px 0 40px 0
    .linha
        width: 100%
    button
        height: 50px
        display: flex
        flex-direction: row
        align-items: center
        margin: 0 15px
        border-radius: 5px
        fill: #FFF
        overflow: hidden
        &.google
            background-color: $google
        &.facebook
            background-color: $facebook
    button i
        width: 50px
        height: 50px
        display: flex
        align-items: center
        justify-content: center
        background-color: rgba(0,0,0,.2)
    button figure
        width: 50px
        height: 50px
        background-size: cover
        background-position: center center
        display: none
    button p
        height: 50px
        line-height: 50px
        font-size: 1.4rem
        color: #FFF
        padding: 0 20px

@media screen and (max-width:700px)
    #bloco_perfil .conteudo
        width: calc(100% - 40px)
        .botao a
            padding: 10px 25px
            font-size: 1.4rem
        .bloco
            width: 100%
            text-align-last: left
            padding: 20px
        .bloco h1
            display: flex
            justify-content: center
        .bloco p
            display: flex
            justify-content: center
        .bloco p::after
            display: none
    #bloco_perfil .conteudo .social
        flex-direction: column
        justify-content: center
        align-items: center
        > p
            max-width: 350px
        button
            width: 200px
            margin-top: 20px
        button p
            flex-grow: 1
            flex-basis: 0%
            padding: 0

#bloco_perfil_imagem
    width: 100%
    height: 100%
    position: fixed
    top: 0
    left: 0
    z-index: 10000
    background: rgba(0,0,0,.7)
    display: none
    align-items: center
    justify-content: center
    opacity: 0
    transition: opacity .3s ease-out
    &.abrir
        opacity: 1
    .conteudo
        max-width: 500px
