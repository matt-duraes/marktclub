body
html
    background-color: #F6F6F6
    font-family: 'Roboto', sans-serif

input
p
div
h1
h2
h3
span
a
    font-weight: 300

.grecaptcha-badge
    display: none !important

// Firefox
*
    scrollbar-width: thin
    scrollbar-color: rgba(255,255,255, 0) rgba(255,255,255, 0)
    &:hover
        scrollbar-color: #c0c0c0 rgba(255,255,255, 0)
// Chrome
*::-webkit-scrollbar
    width: 10px
    height: 5px
*::-webkit-scrollbar-track
    background: rgba(255,255,255, 0)
*::-webkit-scrollbar-thumb
    background-color: rgba(255,255,255,0)
    border-radius: 20px
    transition: opacity .3s ease-out
*:hover::-webkit-scrollbar-thumb
    background-color: #c0c0c0


p
a
input
textarea
button
.fw_alerta_notificacao_p
#fw_ajuda
#bloco_fw_select .option li
.input_checkbox label
.fw_loading_bola_texto
    font-weight: 300

input.autocomplete
    width: 1
    height: 1
    position: absolute
    top: -9999px
    left: -999px
    opacity: 0

.mobile
    display: none !important

#site
    width: 100vw
    min-height: 100vh
    display: flex
    flex-direction: column
    position: relative

#painel_local_acesso
    font-weight: bold
    font-size: 2rem
    color: #169e90

#header_template
    width: 100%
    height: 60px
    position: fixed
    top: 0
    left: 0
    background: #FFF
    align-items: center
    display: flex
    flex-direction: row
    border-bottom: 1px solid #EEE
    z-index: 101
    &.z_index
        z-index: 111
    /* Logo */
    .bloco_logo
        width: 300px
        display: flex
        flex-direction: row
        align-items: center
    .bloco_logo .menu_mobile
        width: 40px
        height: 40px
        margin-left: 20px
        fill: #999
        flexCenter()
        display: none
    .bloco_logo .nome
        height: 1.5em
        line-height: 1.5em
        font-size: 2rem
        font-weight: bold
        padding: 0 20px
        overflow: hidden
        color: #999
    .bloco_logo .logo
        height: 20px
        margin-left: 20px
    .bloco_logo .logo img
        max-height: 100%
    /* App */
    .bloco_app
        height: 60px
        position: relative
        padding: 0 20px
        display: flex
        flex-direction: row
        align-items: center
        flex-grow: 1
        flex-basis: 0%
        z-index: 10
    .bloco_app h1
        font-weight: 300
        font-size: 1.6rem
        display: flex
        flex-direction: row
        align-items: center
        color: #888
        margin-right: 20px
        text-transform: uppercase
    .bloco_app h1 a
        font-size: 1.6rem
        color: #AAA
    .bloco_app h1 span
        margin: 0 5px
        color: #CCC
    .bloco_app form
        height: 40px
        margin-right: 20px
        position: relative
        flexGrow()
        justify-content: center
        z-index: 10
    .bloco_app form input
        width: 100%
        max-width: 250px
        height: 40px
        border-radius: 20px
        border: 1px solid #EEE
        padding: 0 40px 0 20px
        font-size: 1.3rem
        transition: max-width .3s ease-out, border-color .3s ease-out
        background: #FFF
        z-index: 2
        &::placeholder
            color: #999
        &:focus
        &:not(:placeholder-shown)
            max-width: 500px
            border-color: #DDD
    .bloco_app form button
        width: 40px
        height: 40px
        fill: #CCC
        margin-left: -45px
        transition: fill .3s ease-out
        border-radius: 50%
        z-index: 3
    .bloco_app form input:focus + button
    .bloco_app form input:not(:placeholder-shown) + button
        fill: #AAA
    .bloco_app form .bg
        width: 100vw
        height: 100vh
        position: fixed
        top: 0
        left: 0
        background-color: rgba(0,0,0,.7)
        z-index: 1
        display: none
        opacity: 0
        transition: opacity .3s ease-out
    .bloco_app form.animacao .bg
        opacity: 1
    .bloco_app .resto
        height: 60px
        flexGrow()
    .bloco_app .resto_mobile
        display: none
    .bloco_app > button
        width: 30px
        height: 30px
        flexCenter()
        border-radius: 50%
        fill: #999
        margin-right: 10px
        background-color: #FFF
        transition: background-color .3s ease-out, fill .3s ease-out
        &:hover
            background-color: #EEE
            fill: #666
    .bloco_app > button.animacao .bloco_animacao
        width: 0px
        height: 0px
        background-color: #EEE
        position: absolute
        border-radius: 50%
        z-index: 1
        animation: animacao_header_botao_abrir .5s linear
    .bloco_app > button svg
        position: relative
        z-index: 2
    .bloco_app .linha
        width: 1px
        height: 30px
        background-color: #EEE
        margin: 0 10px 0 20px
    /* Config */
    .bloco_config
        height: 60px
        position: relative
        display: flex
        padding-right: 10px
        flex-direction: row
        justify-content: flex-end
        align-items: center
        z-index: 1
    .bloco_config .bloco_trabalho
        width: 0
        height: 0
        margin-right: 0
        position: relative
        overflow: hidden
        &.ativo
            width: 40px
            height: 40px
            margin-right: 20px
        &.ativo .botao
            top: 0
            opacity: 1
    .bloco_config .bloco_trabalho .botao
        width: 40px
        height: 40px
        position: absolute
        flexCenter()
        background-color: $corVermelho
        border-radius: 50%
        cursor: pointer
        top: -40px
        opacity: 0
        transition: top .2s ease-out, opacity .2s ease-out
        &:after
        &:before
            width: 5px
            height: 16px
            position: absolute
            background-color: #FFF
            border-radius: 2px
            content: ""
        &:after
            left: 12px
        &:before
            right: 12px
    .bloco_config .bloco_notificacao
        width: 40px
        height: 40px
        position: relative
        margin-right: 20px
        flexRow()
        border-radius: 50%
        background-color: #DDD
        cursor: pointer
    .bloco_config .bloco_notificacao .notificacao
        width: 100%
        height: 100%
        flexCenter()
        fill: #666
    .bloco_config .bloco_notificacao .numero
        width: 25px
        height: 25px
        line-height: 25px
        text-align: center
        background-color: $corNotificacao
        color: #FFF
        border-radius: 50%
        position: absolute
        right: -7px
        top: -5px
        font-size: 1.4rem
        box-shadow: 2px 2px 5px rgba(0,0,0,.1)
    .bloco_config .menu_config
        width: 40px
        height: 40px
        margin-right: 20px
        background-size: cover
        background-position: center center
        border-radius: 50%
        background-color: #EEE
        cursor: pointer

#main_template
    width: calc(100% - 300px)
    height: calc(100vh - 60px)
    margin-top: 60px
    margin-left: 300px
    z-index: 110
    overflow-y: auto
    .centralizar_main_template
        width: 100%
        display: flex
        flex-direction: column
        align-items: center

#switch_menu_esquerdo
#switch_menu_direito
    width: 20px
    height: 100vh
    position: fixed
    top: 0
    z-index: 199
    display: none
#switch_menu_direito
    right: 0

@keyframes animacao_header_botao_abrir
    0%
        width: 30px
        height: 30px
        opacity: 1
    100%
        width: 80px
        height: 80px
        opacity: 0

@media screen and (max-width:1100px)
    #header_template
        .bloco_logo
            width: auto
        .bloco_logo .menu_mobile
            display: flex
        .bloco_logo .logo
            display: none
        .bloco_logo .logo img
            max-height: 100%
    #main_template
        width: 100%
        margin-left: 0

@media print
    .bloco_config
        display: none !important
    .bloco_app
        form
        button
            display: none !important
    #main_template
        width: 100%
        margin-left: 0
        height: initial
        margin-top: 0
    #header_template
        position: initial

@media screen and (max-width:1000px)
    .desktop
        display: none !important
    .mobile
        display: flex !important
    #switch_menu_esquerdo
    #switch_menu_direito
        display: flex

@media screen and (max-width:700px)
    #header_template .bloco_app
        h1
            display: none
        .linha
            margin: 0 0 0 5px
@media screen and (max-width:600px)
    #header_template .bloco_app
        form
            display: none
        .resto_mobile
            display: flex
