#nav_template
    width: 300px
    height: calc(100vh - 60px)
    position: fixed
    top: 60px
    left: 0
    display: flex
    z-index: 50
    .bg
        width: 100%
        height: 100%
        top: 0
        left: 0
        position: absolute
        background: #FFF
        opacity: 1
        transition: opacity .3s ease-out
        box-shadow: 2px 0 5px rgba(0,0,0,.05)
        z-index: 1
    .conteudo
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background: #FFF
        transition: left .3s ease-out
        overflow-y: auto
        display: flex
        z-index: 2
#nav_template.menu_aberto
    .bg
        opacity: 1
    .conteudo
        left: 0

#bloco_menu_principal
    width: 100%
    display: flex
    flex-direction: column
    h2
        font-size: 1.3rem
        color: #999
        font-weight: 500
        padding: 30px 20px 10px 20px
    .botao
        height: 45px
        padding-right: 20px
        position: relative
        display: flex
        align-items: center
        z-index: 2
        cursor: pointer
    .botao i
        margin: 0 5px 0 15px
        fill: #999
    .botao i svg
        width: 30px
        height: 30px
    .botao p
        font-weight: 300
        font-size: 1.5rem
        flex-grow: 1
        flex-basis: 0%
        color: #666
        padding-right: 10px
    .botao .mais
        width: 30px
        height: 30px
        display: flex
        align-items: center
        justify-content: center
    .botao .mais span
        width: 2px
        height: 12px
        position: absolute
        background-color: #CCC
        border-radius: 2px
        opacity: 1
        transition: transform .3s ease-out, opacity .3s ease-out
        &:nth-child(2)
            transform: rotate(90deg)
    .menu.aberto .botao .mais span
        &:nth-child(1)
            transform: rotate(-90deg)
        &:nth-child(2)
            transform: rotate(0deg)
            opacity: 0
    .menu
        width: 100%
        height: 45px
        margin: 2px 0
        display: inline-block
        overflow: hidden
        transition: height .3s ease-out
    .menu a
        width: 100%
        height: 45px
        line-height: 45px
        margin: 2px 0
        opacity: 0
        transition: opacity .3s ease-out
        display: flex
    .menu.aberto a
        opacity: 1
    .menu a p
        height: 45px
        line-height: 45px
        padding: 0 20px 0 50px
        color: #666
        font-weight: 300
        font-size: 1.5rem
        z-index: 2
    .pagina_atual .botao i
        fill: #FFF
    .pagina_atual .botao p
    a.pagina_atual p
        color: #FFF
    .menu_hover
        position: relative
        &::before
            content: ""
            position: absolute
            top: 0
            left: 0
            height: 45px
            width: calc(100% - 20px)
            border-radius: 0 25px 25px 0
            background-color: #EEE
            z-index: 1
            display: none
    .menu_hover:hover::before
        display: block
    .pagina_atual::before
        background-color: $cor
        display: block
    .footer
        width: 100%
        padding-top: 20px
        flexCol()

@media screen and (max-width:1100px)
    #nav_template
        width: 100vw
        height: 100vh
        top: 0
        z-index: 201
        display: none
        &.show
            display: flex
        .bg
            opacity: 0
            background-color: rgba(0,0,0,.7)
        .conteudo
            max-width: 300px
            left: -300px

@media print
    #nav_template
        display: none
        .conteudo
            left: -300px
