h3()
    width: 100%
    font-size: 1.4rem
    font-weight: 500
    color: #999
    margin: 7px 0 2px 0

.bloco_checkbox_interno
    width: 100%
    flexCol()
    h3
        h3()
        margin-bottom: 10px
    .input_checkbox
        margin: 5px 0
.form_geral .bloco_switch + .bloco_checkbox_interno
    margin-top: 20px

.bloco_checkbox_geral
    width: 100%
    position: relative
    display: flex
    flex-direction: row
    flex-wrap: wrap
    border-radius: 3px
    margin: 0 0 10px 0
    overflow: hidden
    &.bloco_fieldset_margin
        margin-top: 20px
        padding: 10px 10px 20px 20px
        border: 1px solid #DDD
    &.bloco_checkbox_mais
        max-height: 180px
    &.bloco_checkbox_aberto
        max-height: none
        padding-bottom: 40px
    h3
        h3()
    h4
        width: 100%
        font-weight: 500
        color: #999
        margin: 20px 0 -5px 0
        font-size: 1.4rem
    .marcar_todas
        width: 100%
        position: relative
        padding-bottom: 15px
        &::after
            width: 100%
            max-width: 70px
            height: 1px
            content: ""
            position: absolute
            bottom: 0
            left: 0
            background-color: #EEE
    .input_checkbox
        width: calc(50% - 10px)
        margin: 15px 10px 0 0
    .marcar_todas .input_checkbox
        width: 100%
    .botao_mais
        width: 100%
        height: 30px
        position: absolute
        left: 0
        bottom: 0
        background-image: linear-gradient(0deg, #FFFFFF, #FFFFFF50, #FFFFFF00)
        cursor: pointer
        z-index: 2
        display: flex
        justify-content: center
    .botao_mais span
        height: 30px
        line-height: 30px
        text-align: center
        background-color: $cor
        font-size: 1.2rem
        color: #FFF
        padding: 0 20px
        border-radius: 15px
.bloco_checkbox_geral.bloco_checkbox_aberto .botao_mais span
    background-color: #CCC
    color: #666
@media screen and (max-width:1000px)
    .bloco_checkbox_geral .input_checkbox
        width: 100%
