.bloco_app_relatorio
    width: 100%
    display: flex
    flex-direction: column
    header
        width: 100%
        display: flex
        flex-direction: row
        justify-content: flex-end
        padding: 20px 30px 0 0
    header form
        position: relative
        background: #FFF
        border-radius: 5px
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        display: flex
        padding: 10px
        flex-direction: row
    header form.form_geral .bloco_input
        width: auto
        margin-top: 0
        margin-bottom: 0
        margin-right: 10px
    header form.form_geral .bloco_input input
        margin-top: 3px
    header form .bloco_input_data
        max-width: 250px
    header form .bloco_linha
        flexRow()
    header form .bloco_linha .bloco_input
        margin-right: 0
        &:last-child
            margin-right: 10px
    header form i
        width: 50px
        height: 50px
        flexCenter()
        fill: #333
        background-color: #CCC
        border-radius: 5px
        z-index: 3
        cursor: pointer
        &.show
            display: flex
    header form i.botao
        background-color: $corAzul
        fill: #FFF
        z-index: 5
    .lista
        width: 100%
        display: flex
        flex-direction: row
        flex-wrap: wrap
        padding: 0 0 30px 30px
        align-items: flex-start
    .lista .linha
        width: 100%

.bloco_app_relatorio .lista .bloco_quadro_colorido
    width: 100%
    margin-top: 30px
    overflow: hidden
    .scroll
        width: 100%
        display: flex
        flex-direction: row
    .quadro
        width: calc(25% - 30px)
        margin-right: 30px
        border-radius: 5px
        box-shadow: 0 4px 5px rgba(0,0,0,.05)
        color: #FFF
        padding: 30px 20px
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
        &.verde
            background-color: #0bc78e
        &.azul
            background-color: #25b4fa
        &.vermelho
            background-color: #ff585e
        &.roxo
            background-color: #ae72e4
    .quadro .numero
        width: 100%
        text-align: center
        font-size: 3rem
        font-weight: bold
        margin-bottom: 5px
        display: flex
        justify-content: center
    .quadro .porcentagem
        width: 100%
        text-align: center
        margin-top: 20px
        font-size: 2rem
        display: flex
        justify-content: center
    .quadro p
        width: 100%
        text-align: center
        font-size: 1.7rem
        &.porcentagem_texto
            font-size: 1.5rem
    .quadro .numero .loading
    .quadro .porcentagem .loading
        width: 60px
        height: 100%
        background: #FFFFFF40
        position: relative
        overflow: hidden
        font-size: inherit
        text-indent: -999px
        &::after
            content: ""
            position: absolute
            top: 0
            left: 0
            width: 10px
            height: 100%
            background: #FFFFFF50
            background-image: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.05), rgba(255,255,255,0))
            animation: loading_esqueleto_grafico_colorido 1s linear infinite
    .quadro .porcentagem .loading
        width: 40px
    .quadro .barra
        width: 100%
        max-width: 140px
        height: 4px
        margin: 5px 0
        background-color: #00000020
        border-radius: 2px
        overflow: hidden
        display: flex
    .quadro .barra span
        width: 0
        height: 100%
        background-color: #FFF
@keyframes loading_esqueleto_grafico_colorido
    0%
        left: -30px
    100%
        left: calc(100% + 20px)

.bloco_app_relatorio .lista .fw_grafico
    background-color: #FFF
    position: relative
    box-shadow: 0 4px 5px rgba(0,0,0,.05)
    margin: 30px 30px 0 0
    padding-top: 50px
    border-radius: 5px
    display: flex
    flex-direction: row
    overflow: hidden
    &.loading::after
        content: ""
        width: 30%
        height: 1px
        background: $corAzul
        position: absolute
        top: 50px
        left: 0
        animation: loading_grafico_header 1.5s linear infinite
        z-index: 10
    &.fw_grafico_grande
        width: calc(100% - 30px)
    &.fw_grafico_medio
        width: calc(50% - 30px)
    &.fw_grafico_pequeno
        width: calc((100% / 3) - 30px)
    &.fw_grafico_2
        width: calc(((100% / 3) * 2) - 30px)
    .fw_grafico_bloco_grafico
        display: flex
        flex-direction: column
    .fw_grafico_titulo
        width: 100%
        font-size: $textoFontSize
        height: 50px
        line-height: 50px
        padding: 0 20px
        position: absolute
        top: 0
        left: 0
        color: #666
        border-bottom: 1px solid #EEE
        overflow: hidden
    .loading_geral
        width: 100%
        height: 300px
        display: flex
        align-items: center
    .loading_geral p
        width: 100%
        text-align: center
        font-size: 1.4rem
        color: #999
    .fw_grafico_bloco_lista
        width: 100%
        position: relative
        &::before
        &::after
            content: ""
            width: 100%
            height: 20px
            z-index: 2
            position: absolute
            left: 0
        &::before
            top: 0
            background-image: linear-gradient(to bottom, #FFF, #FFFFFF00)
        &::after
            bottom: 0
            background-image: linear-gradient(to top, #FFF, #FFFFFF00)
    .fw_grafico_bloco_lista .scroll
        width: 100%
        height: 300px
        overflow-y: auto
        padding: 10px 0
    .fw_grafico_bloco_lista .linha
        width: 100%
        position: relative
        display: flex
        flex-direction: row
        align-items: center
        padding: 10px 20px
        z-index: 1
        cursor: default
        &:hover
            background-color: #F6F6F6
    .fw_grafico_bloco_lista .linha .item
        flex-grow: 1
        flex-basis: 0%
        font-size: 1.4rem
        line-height: 1.5em
        padding-right: 20px
    .fw_grafico_bloco_lista .linha .porcentagem
        width: 50px
        height: 6px
        display: flex
        align-items: center
        border-radius: 5px
        background: #CCC
        overflow: hidden
    .fw_grafico_bloco_lista .linha .porcentagem span
        height: 6px
        background: $cor
    .fw_grafico_bloco_lista .linha .valor
        min-width: 100px
        font-size: 1.4rem
        display: flex
        margin-left: 20px
        align-items: center
        justify-content: space-between
    .fw_grafico_bloco_lista .linha .valor span
        color: #666
        font-size: 1.2rem
    .fw_grafico_grafico
        width: 100%
        display: flex
        flex-direction: column
    .fw_grafico_grafico .fw_grafico_header
        width: 100%
        display: flex
        flex-direction: row
        justify-content: center
        border-bottom: 1px dashed #DDD
        overflow-x: auto
        padding: 0 20px
    .fw_grafico_grafico .fw_grafico_header .fw_grafico_header_item
        padding: 20px 40px
        border-right: 1px dashed #DDD
        &:last-child
            border-right: none
    .fw_grafico_grafico .fw_grafico_header .fw_grafico_header_item .fw_grafico_header_item_valor
        width: 100%
        font-size: 2rem
        font-weight: bold
        text-align: center
        color: #666
    .fw_grafico_grafico .fw_grafico_header .fw_grafico_header_item .fw_grafico_header_item_texto
        width: 100%
        text-align: center
        font-size: $textoFontSize
        color: #999
        margin-top: 10px
    .fw_grafico_grafico .fw_grafico_canvas
        width: 100%
        padding: 40px
        position: relative
        display: flex
        justify-content: center
    .fw_grafico_grafico .fw_grafico_canvas .fw_grafico_linha_media
        width: calc(100% - 110px)
        height: 1px
        position: absolute
        top: 30%
        left: 70px
        border-bottom: 2px dashed #000
        // border-top: 2px dashed #FFF
        z-index: 10
    .fw_grafico_grafico .fw_grafico_canvas canvas
        position: relative
        z-index: 2
    .fw_grafico_grafico .fw_grafico_canvas .fw_grafico_porcentagem
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        display: flex
        align-items: center
        justify-content: center
        z-index: 1
        font-size: 2rem
        color: #CCC
    .fw_grafico_grafico .fw_grafico_label
        width: 100%
        display: flex
        flex-direction: row
        flex-wrap: wrap
        justify-content: center
        padding-bottom: 30px
    .fw_grafico_grafico .fw_grafico_label .fw_grafico_label_botao
        display: flex
        align-items: center
        justify-content: center
        cursor: default
        margin: 0 10px 10px 10px
    .fw_grafico_grafico .fw_grafico_label .fw_grafico_label_botao .fw_grafico_label_botao_bola
        width: 12px
        height: 12px
        border-radius: 50%
        margin-right: 5px
    .fw_grafico_grafico .fw_grafico_label .fw_grafico_label_botao .fw_grafico_label_botao_texto
        font-size: 1.4rem
    .fw_grafico_grafico .fw_grafico_footer
        width: 100%
        display: flex
        justify-content: center
        padding: 0 0 40px 0
    .fw_grafico_grafico .fw_grafico_footer_item
        margin: 0 15px
        display: flex
        flex-direction: column
        align-items: center
    .fw_grafico_grafico .fw_grafico_footer_item .fw_grafico_footer_item_texto
        color: #999
        font-size: 1.6rem
        text-align: center
        margin-bottom: 10px
    .fw_grafico_grafico .fw_grafico_footer_item .fw_grafico_footer_item_valor
        font-size: 2rem
        position: relative
        font-weight: bold
        display: flex
        flex-direction: row
        align-items: center
        color: #333
    .fw_grafico_grafico .fw_grafico_footer_item .fw_grafico_footer_item_valor .fw_grafico_footer_item_icone
        width: 20px
        height: 20px
        display: flex
        align-items: center
        justify-content: center
        margin-right: 5px
        position: absolute
        left: -20px
    .fw_grafico_tabela
        display: flex
        flex-direction: column
        flex-grow: 1
        flex-basis: 0%
        padding: 40px 40px 40px 0
    .fw_grafico_tabela .fw_grafico_tabela_lista
        width: 100%
        min-height: 40px
        position: relative
        display: flex
        flex-direction: row
        flex-wrap: wrap
        margin-bottom: 10px
        align-items: center
        &.fw_grafico_tabela_icone_imagem
            padding-left: 60px
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_icone
        width: 40px
        height: 40px
        background-color: #EEE
        border-radius: 50%
        position: absolute
        left: 0
        display: flex
        align-items: center
        justify-content: center
        fill: #666
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_imagem
        width: 40px
        height: 40px
        border-radius: 50%
        position: absolute
        left: 0
        background-position: center center
        background-size: contain
        background-color: #EEE
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_nome
        font-size: 1.4rem
        flex-grow: 1
        flex-basis: 0%
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_valor
        width: calc(25% - 30px)
        font-size: 1.4rem
        font-weight: bold
        color: #333
        display: flex
        justify-content: flex-end
        align-items: center
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_valor span
        height: 100%
        color: #666
        font-size: 1.2rem
        margin-right: 10px
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_porcentagem
        width: 100%
        height: 6px
        background: #DDD
        border-radius: 6px
        margin-top: -10px
        overflow: hidden
        display: flex
    .fw_grafico_tabela .fw_grafico_tabela_lista .fw_grafico_tabela_porcentagem span
        height: 6px
@keyframes loading_grafico_header
    0%
        left: 0
        width: 0
    50%
        width: 100%
        left: 0
    100%
        width: 0
        left: 100%

.bloco_app_relatorio .lista .fw_grafico.fw_grafico_pequeno
    flex-direction: column
    .fw_grafico_tabela
        padding: 20px

@media screen and (max-width:1000px)
    .bloco_app_relatorio .lista .bloco_quadro_colorido
        margin-top: 0
        .scroll
            flex-wrap: wrap
        .quadro
            width: calc(50% - 30px)
            margin-top: 30px

    .bloco_app_relatorio .lista
        padding-left: 20px
    .bloco_app_relatorio .lista .fw_grafico
        &.fw_grafico_grande
        &.fw_grafico_medio
        &.fw_grafico_pequeno
            width: calc(100% - 20px)
    .bloco_app_relatorio .lista .fw_grafico
        margin-right: 20px

@media screen and (max-width:600px)
    .bloco_app_relatorio
        header
            width: 100%
            padding-right: 20px
        header form
            width: 100%
        header form input
            width: 100%
        header form p
            width: 100%

    .bloco_app_relatorio .lista .bloco_quadro_colorido
        width: calc(100% + 20px)
        margin-left: -20px
        margin-top: 30px
        .scroll
            width: calc((100% - 60px) * 4)
            flex-wrap: nowrap
            margin-left: 20px
            transition: margin-left .3s ease-out
            &.bloco_2
                margin-left: calc(-100vw + 100px)
            &.bloco_3
                margin-left: calc(-200vw + 160px)
            &.bloco_4
                margin-left: calc(-300vw + 240px)
        .quadro
            width: calc(100% - 40px)
            margin: 0 20px 0 0

    .bloco_app_relatorio .lista .fw_grafico
        width: calc(100% - 30px)
        margin-left: 0
    .bloco_app_relatorio .lista .fw_grafico.fw_grafico_barra .fw_grafico_canvas
    .bloco_app_relatorio .lista .fw_grafico.fw_grafico_linha .fw_grafico_canvas
        overflow-x: auto
