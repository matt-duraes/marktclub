#bloco_historico_view
    width: calc(100% - 40px)
    max-width: 800px
    position: relative
    background-color: #FFF
    display: flex
    align-items: center
    flex-direction: column
    boxShadow()
    border-radius: 5px
    margin-bottom: 20px
    &.grande
        width: 100%
        max-width: 100%
    header
        width: 100%
        border-bottom: 1px solid #DDD
        display: flex
        flex-direction: row
        padding: 10px 20px
        z-index: 3
    header .fechar
        width: 30px
        height: 30px
        position: relative
        flexCenter()
        cursor: pointer
        &.desktop
            margin: 0 -5px 0 30px
        &.desktop::after
            content: ""
            position: absolute
            left: -10px
            width: 1px
            height: 100%
            background-color: #CCC
        &.mobile
            margin: 0 10px 0 -10px
    header h1
        height: 30px
        line-height: 30px
        font-size: $textoFontSize
        color: #666
        flexGrow()
    header form
        display: flex
        flex-direction: row
    header form input
        width: 180px
        height: 30px
        line-height: 30px
        padding: 0 10px
        border-radius: 20px
        border: 1px solid #DDD
        font-size: 1.2rem
        &.input_data
            width: 80px
        &.input_data_de
            border-right: none
            border-radius: 20px 0 0 20px
            padding-right: 0
            margin-left: 10px
        &.input_data_ate
            border-left: none
            border-radius: 0 20px 20px 0
            padding-left: 0
            margin-right: 10px
    header form p
        height: 30px
        line-height: 30px
        color: #999
        padding: 0 10px
        border-top: 1px solid #DDD
        border-bottom: 1px solid #DDD
    header form .botao
        bgDegradeVerde()
        color: #FFF
        height: 30px
        line-height: 30px
        padding: 0 20px
        border-radius: 20px
        font-size: 1.2rem
        cursor: pointer
    header form .botao_download
        bgDegradeCinza()
        height: 30px
        padding: 0 20px
        border-radius: 20px
        cursor: pointer
        margin-left: 10px
        display: flex
        align-items: center
        justify-content: center
    header form .botao_download svg
        fill: #FFF
    .add_fake
        width: 100%
        height: 110px
    .add
        width: 100%
        min-height: 110px
        position: absolute
        display: flex
        flex-direction: column
        padding: 20px 20px 20px 70px
        top: 60px
        justify-content: flex-start
        align-items: flex-start
        background: #FFF
        z-index: 4
        &.fixo
            position: fixed
            top: 60px
    .add figure
        width: 40px
        height: 40px
        border-radius: 50%
        position: absolute
        top: 20px
        left: 20px
        border: 1px solid #DDD
        background-position: center center
        background-size: cover
    .add .bloco_input
        margin-top: 0
        margin-bottom: 0
    .add .bloco_input.textarea_arquivo textarea
        padding-right: 45px
    .add .bloco_input textarea
        max-height: calc(50vh) !important
        overflow-y: auto
    .add .textarea .usuario_editando
        color: #999
    .add .textarea .usuario_marcado
        color: #00aced
        text-decoration: underline
    .add .arquivo_previa
        width: calc(100% - 6px)
        flexRow()
        flex-wrap: wrap
        display: none
        margin: 3px 0 0 3px
        position: relative
        background-color: #F0F0F0
        padding: 0 50px 10px 10px
        z-index: 6
    .add .arquivo_previa .arquivo_previa_item
        flexRow()
        padding: 5px 5px 5px 10px
        align-items: center
        border: 1px solid #CCC
        border-radius: 5px
        margin: 10px 10px 0 0
    .add .arquivo_previa .arquivo_previa_item .arquivo_previa_titulo
        line-height: 1.5em
        font-size: 1.2rem
        flexGrow()
        overflow: hidden
    .add .arquivo_previa .arquivo_previa_item i
        width: 20px
        height: 20px
        cursor: pointer
        flexCenter()
        margin-left: 5px
        fill: #999
    .add .botao_upload
        position: absolute
        width: 50px
        height: 50px
        flexCenter()
        top: 0
        right: 0
        z-index: 7
        overflow: hidden
    .add .botao_upload input
        width: 50px
        height: 50px
        position: absolute
        top: 0
        left: 0
        z-index: 2
        opacity: 0
    .add .botao_upload i
        width: 50px
        height: 50px
        flexCenter()
        position: absolute
        top: 0
        left: 0
        transition: left .3s ease-out
        cursor: pointer
        fill: #999
        z-index: 1
    .add p
        width: 100%
        text-align: right
        font-size: 1.2rem
        color: #666
        margin-top: 10px
    .add .bloco_app_extra
        width: 100%
        flexRow()
        flex-wrap: wrap
        position: relative
        padding: 10px 0 15px 0
        &::after
            width: calc(100% - 20px)
            height: 1px
            background-color: #DDD
            content: ""
            position: absolute
            top: 0
            left: 10px
    .add .bloco_app_extra h2
        width: 100%
        font-size: 1.2rem
        padding-left: 10px
    .add .bloco_app_extra .checkbox_interno
        flexRow()
        position: relative
        margin: 10px 10px 0 10px
    .add .bloco_app_extra .checkbox_interno input
        position: absolute
        top: 0
        left: 0
        width: 100%
        height: 100%
    .add .bloco_app_extra .checkbox_interno .checkbox_interno_titulo
        textoFontSize()
        position: relative
        flexRow()
        align-items: center
        padding-left: 25px
        min-height: 18px
        &::after
            width: 18px
            height: 18px
            position: absolute
            left: 0
            background-image: linear-gradient(to bottom, #ccc, #ddd)
            border-radius: 3px
            content: " "
    .add .bloco_app_extra .checkbox_interno input:checked ~ .checkbox_interno_titulo::after
        background: #169e91 url(/images/plugins/form/check.svg) no-repeat center center
        background-size: 10px auto
    .lista
        width: 100%
        margin-top: 20px
        display: flex
        flex-direction: column
    .lista .zero
        width: 100%
        text-align: center
        color: #999
        font-size: $textoFontSize
        padding: 30px 0 60px 0
    .lista .bloco_historico_data
        width: 100%
        text-align: center
        font-size: 1.8rem
        color: #999
        margin: 20px 0
        cursor: default
    .mais
        height: 40px
        line-height: 40px
        border: 1px solid #CCC
        border-radius: 20px
        margin-bottom: 20px
        padding: 0 20px
        cursor: pointer
        font-size: 1.2rem
        display: none

@media screen and (max-width:800px)
    #bloco_historico_view
        header form
            display: none
        .add
            padding-left: 20px
        .add figure
            display: none
        .add p
            display: none
#bloco_historico_view .lista .item
    width: 100%
    position: relative
    display: flex
    flex-direction: row
    padding: 20px
    &.minha_mensagem
        flex-direction: row-reverse
    figure
        width: 30px
        height: 30px
        border-radius: 50%
        border: 1px solid #DDD
        background-position: center center
        background-size: cover
    .fixar
        width: 25px
        height: 25px
        flexCenter()
        position: absolute
        top: 55px
        border-radius: 20px
        fill: #999
        opacity: 0
        cursor: pointer
    .fixar.ativo
    &:hover .fixar
        opacity: 0
    &.minha_mensagem .fixar
        right: 25px
    &.outra_mensagem .fixar
        left: 20px
    figure ~ .dado
        min-width: 150px
        display: flex
        flex-direction: column
        position: absolute
        background: #FFF
        top: 15px
        border-radius: 40px
        padding: 10px 20px
        box-shadow: 0 4px 5px rgba(0,0,0,.2)
        opacity: 0
        transition: opacity .3s ease-out, left .3s ease-out, right .3s ease-out
        z-index: 3
    figure:hover ~ .dado
        opacity: 1
    &.outra_mensagem figure ~ .dado
        left: 80px
    &.outra_mensagem figure:hover ~ .dado
        left: 60px
    &.minha_mensagem figure ~ .dado
        right: 80px
    &.minha_mensagem figure:hover ~ .dado
        right: 60px
    .deletar
        width: 30px
        height: 30px
        position: relative
        position: absolute
        top: 60px
        display: flex
        align-items: center
        justify-content: center
        fill: $corDeletar
        cursor: pointer
    .deletar .loading
        width: 30px
        height: 30px
        border-top: 1px solid $corLoading
        animation: botao_deletar_loading 2s linear 0s infinite
        position: absolute
        top: 0
        left: 0
        border-radius: 50%
    .dado h2
        font-size: $textoFontSize
        color: #666
    .dado .data
        font-size: 1.2rem
        color: #999
        margin-top: 5px
        text-align: right
    &.outra_mensagem .dado .data
        text-align: left
    p.mensagem
        max-width: 500px
        margin-left: 20px
        line-height: 1.5em
        position: relative
        font-size: $textoFontSize
        border: 1px solid #DDD
        padding: 20px 30px
        z-index: 2
        &:hover
            z-index: 4
    &.outra_mensagem p.mensagem
        margin-left: 10px
        border-radius: 0 40px 40px 40px
        background-color: #DDD
    &.minha_mensagem p.mensagem
        margin-right: 10px
        border-radius: 40px 0 40px 40px
        background-color: $cor
        color: #FFF
    p.mensagem a
        font-size: $textoFontSize
        font-weight: bold
@keyframes botao_deletar_loading
    0%
        transform: rotate(0deg)
    50%
        transform: rotate(180deg)
    75%
        transform: rotate(270deg)
    100%
        transform: rotate(360deg)

#bloco_historico_view.sem_box_shadow
    box-shadow: none !important
    header
        padding: 10px 0
    .lista .item
        padding: 20px 0
    .add
        padding: 20px 0 20px 50px
    .add figure
        left: 0

#bloco_historico_view .bloco_marcar_equipe
    width: 100%
    max-width: 400px
    max-height: 180px
    position: absolute
    boxShadow()
    background: #FFF
    padding: 5px 0
    border-radius: 5px
    border: 1px solid #CCC
    overflow-y: auto
    display: none
    &.ativo
        display: block
    &.top
        top: calc(100% - 45px)
    &.bottom
        bottom: calc(100% - 20px)
    li
        width: 100%
        min-height: 54px
        padding: 5px 20px 5px 64px
        position: relative
        justify-content: center
        cursor: pointer
        display: none
        &:hover
        &.hover
            background-color: #EEE
        &.ativo
            flexCol()
    li .imagem
        width: 34px
        height: 34px
        imagemRedonda()
        background-color: #EEE
        position: absolute
        left: 20px
    li .usuario
        width: 100%
        font-size: 1.7rem
        font-weight: bold
        color: #666
    li .nome
        width: 100%
        font-size: 1.3rem
        color: #666

.bloco_historico_popup
    width: 100%
    max-height: 100vh
    overflow-y: auto
    #bloco_historico_view
        max-width: 800px
        margin: 20px auto

#bloco_download
    max-width: 800px
