.fw_documento
    i
        font-style: italic
        font-size: inherit
        font-weight: inherit
    u
        font-size: inherit
        text-decoration: underline
        font-weight: inherit
    s
        font-size: inherit
        font-weight: inherit
    strong
        font-size: inherit
        font-weight: bold
    span,
    a
        font-size: inherit
    h1
        line-height: 1.4em
        font-size: 3.4rem
        font-weight: bold
        margin-bottom: 10px
    h2
        line-height: 1.4em
        font-size: 2.2rem
        margin: 10px 0
        color: #1f2123
    p
        line-height: 1.5em
        font-size: 1.8rem
        margin: 25px 0
        color: #1f2123
    figure.image
        width: 100%
        text-align: center
    figure.image.bloco_imagem_destaque
        width: 1000px
        position: relative
        padding-bottom: 30px
        overflow: hidden
        margin-left: calc(((1000px - 100%) / 2) * -1)
        display: flex
        align-item: center
        justify-content: center
    figure.image.bloco_imagem_esquerda
        max-width: 300px !important
        float: left
        margin: 10px 30px 10px 0
    figure.image.bloco_imagem_direita
        max-width: 300px !important
        float: right
        margin: 10px 0 10px 30px
    figure.image img
        max-width: 100%
        max-height: 100%
    figure.image figcaption
        width: 100%
        line-height: 1.5em
        font-size: 1.3rem
        color: #1f2123
        font-weight: inherit
        text-align: center
        background: #EEE
        padding: 10px 20px
    ol
        list-style: decimal
        padding-left: 20px
        margin: 10px 0
        display: flex
        flex-direction: column
    ul
        list-style: disc
        padding-left: 20px
        margin: 10px 0
        display: flex
        flex-direction: column
    ul li,
    ol li
        line-height: 1.5em
        font-size: 1.8rem
        margin: 3px 0
        color: #1f2123
        font-weight: 300
    a
        font-weight: bold
        color: #00aced
    .fw_botao_download
        background-color: $cor
        color: #FFF
        margin-right: 20px
        padding: 12px 20px
        font-size: 1.4rem
        border-radius: 3px
        font-weight: 300
    blockquote
        width: 100%
        line-height: 1.5em
        font-size: 1.8rem
        font-style: italic
        display: flex
        padding: 0 !important
        margin: 0 !important
        flex-direction: column
        align-items: flex-end
        border-left: none !important
    blockquote *
        font-size: 1.8rem
        font-style: italic
    blockquote p
        max-width: 470px
        position: relative
        padding-left: 60px
        color: #1f2123
        margin: 15px 0
    blockquote p:first-child
        margin-top: 10px
    blockquote p:first-child::before
        content: '"'
        position: absolute
        top: 36px
        left: 0
        font-size: 10rem
        color: #999
    figure.table
        display: block !important
        color: #1f2123
    table
        width: 100%
        border: 1px double #b3b3b3
    table td
        font-size: 1.8rem
        border: 1px solid #bfbfbf
        padding: 8px 10px
    table td *
        font-size: inherit
        color: inherit
    .bloco_destaque
        background-image: linear-gradient(90deg,rgba(0,0,0,0) 50%,#F3D1CE 0)
        background-size: 200%
        background-position: 0
        transition: background-position .8s
        &.ativar
            background-position: -100%
    .bloco_observacao
        border-left: 4px solid #e2d44c
        background-color: #EEE
        padding: 10px 20px
        font-size: 1.8rem
        color: #333
        margin-top: 20px
    .bloco_observacao .bloco_observacao_mensagem > *
        margin: 10px 0
    .bloco_observacao .bloco_observacao_mensagem > *:first-child
        margin-top: 0
    .bloco_observacao .bloco_observacao_mensagem > *:last-child
        margin-bottom: 0
    hr
        height: 1px !important
        background: #CCC !important
    pre
        width: 100%
        position: relative
        display: flex
        flex-direction: row
        background-color: #282a36
        border-radius: 5px
        overflow-x: auto
        overflow-y: hidden
    pre .bloco_copiar
        width: 25px
        height: 25px
        top: 5px
        right: 10px
        display: flex
        align-items: center
        justify-content: center
        position: absolute
        fill: #FFF
        z-index: 3
        cursor: pointer
        transition: opacity .3s ease-out
        opacity: 0
    pre:hover .bloco_copiar
        opacity: 1
    pre .bloco_linha
        color: #FFF
        background: #000
        font-size: 1.8rem
        line-height: 1.5em
        text-align: right
        padding: 15px
        user-select: none
    pre code
        width: 100%
        color: #FFF
        font-size: 1.8rem
        line-height: 1.5em
        tab-size: 4
        padding: 15px 20px
        z-index: 1
@media screen and (max-width:1000px)
    .fw_documento figure.image.bloco_imagem_esquerda
    .fw_documento figure.image.bloco_imagem_direita
        width: 100% !important
        margin: 10px 0 30px 0
    .fw_documento figure.image.bloco_imagem_destaque
        width: 100%
        margin-left: 0
