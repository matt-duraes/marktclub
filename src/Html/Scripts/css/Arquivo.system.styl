// OPTION
#fw_upload .fw_upload_option
    width: 300px
    max-width: 100%
    height: calc(100vh - 40px)
    top: 0
    right: 0
    position: absolute
    z-index: 4
    background-color: #FFF
    border-left: 1px solid #EEE
    overflow-x: hidden
    overflow-y: auto
    transition: right .3s ease-out
    display: none
    &.fw_upload_option_abrir
        right: 0
    .fw_upload_titulo
        width: 100%
        height: 50px
        display: flex
        flex-direction: row
        align-items: center
        color: #666
        border-bottom: 1px solid #eee
        padding: 0 10px 0 20px
    .fw_upload_titulo span
        flex-grow: 1
        flex-basis: 0%
        padding-right: 20px
        font-size: 1.8em
    .fw_upload_titulo button
        width: 30px
        height: 30px
        border-radius: 50%
        display: flex
        align-items: center
        justify-content: center
    .fw_upload_titulo button:hover
        background-color: #EEE
    .fw_upload_titulo button svg
        width: 10px
        height: 10px
        fill: #666
    .fw_upload_preview
        width: 100%
        max-height: 200px
        overflow: hidden
    .fw_upload_preview img
        width: 100%
        max-width: 100%
    .fw_upload_dado
        width: 100%
        padding: 20px
    .fw_upload_acao_botao
        width: 100%
        height: 30px
        margin-top: 10px
        display: flex
        flex-direction: row
        align-items: center
        justify-content: center
        border-radius: 3px
        border: 1px solid #EEE
    .fw_upload_acao_botao span
        height: 20px
        line-height: 22px
        font-size: 1.2em
        text-align: center
    .fw_upload_acao_botao svg
        width: 13px
        height: 13px
        margin-right: 10px
        fill: #666
    .fw_upload_acao_botao.fw_upload_acao_botao_deletar
        background-color: #FF6C60
        border-color: #FF6C60
        color: #FFF
    .fw_upload_acao_botao.fw_upload_acao_botao_deletar svg
        fill: #FFF
    .fw_upload_linha
        width: 100%
        height: 1px
        background-color: #EEE
        margin: 20px 0 20px 0
    .margin_propriedade
        width: 100%
        margin-top: 30px
    h2
        font-weight: bold
        font-size: 1.4em
        margin: 0 0 20px 0
    ul
        width: 100%
        margin-top: 20px
    ul li
        width: 100%
        margin-top: 10px
        display: flex
        flex-direction: row
    ul li span
        font-size: 1.2em
        color: #666
    ul li span:nth-child(1)
        width: 90px
    ul li span:nth-child(2)
        flex-grow: 1
        flex-basis: 0%
    .fw_upload_usar
        width: 100%
        height: 50px
        line-height: 50px
        color: #FFF
        margin: 40px 0 20px 0
        background-color: #23B9A9
        border-radius: 3px
        font-size: 1.4em


