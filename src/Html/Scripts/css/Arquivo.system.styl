.fw_upload_body
    overflow-y: hidden

#fw_upload
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    background-color: rgba(0, 0, 0, .2)
    display: flex
    flex-direction: column
    align-items: center
    justify-content: flex-start
    z-index: 1
    .fw_upload_conteudo
        width: calc(100% - 40px)
        max-height: calc(100vh - 40px)
        position: relative
        background-color: #FFF
        overflow: hidden
        margin: 20px
        box-shadow: 0 5px 5px rgba(0, 0, 0, .3)
    .fw_upload_grow
        flex-grow: 1
        flex-basis: 0%
@media screen and (max-width:700px)
    #fw_upload
        background-color: #FFF
    #fw_upload .fw_upload_conteudo
        width: 100vw
        height: 100vh
        box-shadow: none
        margin: 0
// HEADER
#fw_upload .fw_upload_header
    width: 100%
    height: 70px
    position: relative
    display: flex
    flex-direction: row
    align-items: center
    padding: 0 20px
    border-bottom: 1px solid #EEE
    z-index: 3
// HEADER > BOTAO
#fw_upload .fw_upload_header .fw_upload_botao_upload
    width: 160px
    height: 40px
    line-height: 40px
    position: relative
    border: 1px solid #23B9A9
    border-radius: 3px
    font-size: 1.2em
    margin-right: 30px
    display: flex
    align-items: center
    flex-direction: row
    background-color: #23B9A9
    color: #FFF
    cursor: default
    i
        width: 40px
        height: 40px
        background-color: rgba(0,0,0,.1)
        display: flex
        align-items: center
        justify-content: center
        margin-right: 15px
    svg
        width: 19px
        height: 19px
        position: relative
        fill: #FFF
        z-index: 1
        cursor: default
    input
        width: 100%
        height: 40px
        z-index: 2
        position: absolute
        top: 0
        left: 0
        opacity: 0
        cursor: default
@media screen and (max-width:700px)
    #fw_upload .fw_upload_header .fw_upload_botao_upload
        width: 50px
        height: 50px
        line-height: 50px
        span
            display: none
        i
            width: 50px
            height: 50px
            margin: 0
            background: rgba(255,255,255,0)
        i svg
            width: 25px
            height: 25px
        input
            height: 50px


// HEADER > BUSCAR
#fw_upload .fw_upload_header .fw_upload_buscar
    height: 40px
    position: relative
    .fw_upload_buscar_input
        width: 350px
        max-width: 100%
        height: 40px
        border: 1px solid #DDD
        border-radius: 20px
        padding: 0 45px 0 15px
        font-size: 1.4em
    .fw_upload_buscar_botao
        width: 30px
        height: 30px
        position: absolute
        top: 5px
        right: 7px
        fill: #999
    .fw_upload_buscar_botao svg
        width: 15px
        height: 15px
        fill: #666
        margin: 7.5px 0 0 7.5px
@media screen and (max-width:900px)
    #fw_upload .fw_upload_header .fw_upload_buscar
        display: none

// HEADER > CONFIG
#fw_upload .fw_upload_config
    display: flex
    flex-direction: row
    margin-right: 10px
    .fw_upload_linha
        width: 1px
        height: 30px
        background-color: #EEE
        margin-right: 10px
    .fw_upload_botao
        width: 35px
        height: 35px
        display: flex
        position: relative
        flex-direction: column
        align-items: center
        justify-content: center
        border-radius: 50%
        margin-right: 10px
    .fw_upload_botao_hover
        width: 35px
        height: 35px
        cursor: pointer
        display: flex
        align-items: center
        justify-content: center
        border-radius: 50%
    .fw_upload_botao_hover:hover
        background-color: #EEE
    .fw_upload_botao>svg
        fill: #999
    .fw_upload_botao .fw_upload_botao_dropdown svg
        fill: #999
    .fw_upload_botao .conteudo
        width: 200px
        position: relative
        padding-bottom: 10px
        background-color: #FFF
        border-radius: 3px
        box-shadow: 0 2px 5px rgba(0, 0, 0, .1)
        position: absolute
        top: 42px
        left: calc((150 - 35px) / 2)
        border: 1px solid #DDD
        display: none
    .fw_upload_botao .conteudo>span
        width: 12px
        height: 12px
        position: absolute
        top: -6px
        border: 1px solid #DDD
        border-right: none
        border-bottom: none
        margin: auto
        left: 0
        right: 0
        background-color: #FFF
        transform: rotate(45deg)
    .fw_upload_botao .conteudo>p
        width: 100%
        font-size: 1.4em
        color: #999
        padding: 10px
        margin-bottom: 10px
        border-bottom: 1px solid #EEE
        cursor: default
    .fw_upload_botao .conteudo button
        width: 100%
        display: flex
        align-items: center
        padding: 8px 20px
    .fw_upload_botao .conteudo button:hover
        background-color: #EEE
    .fw_upload_botao .conteudo button svg
        fill: #666
        margin-right: 10px
    .fw_upload_botao .conteudo button span
        font-size: 1.3em
        color: #666
    .fw_upload_option_show
        display: none

// HEADER > FECHAR
#fw_upload .fw_upload_fechar
    width: 25px
    height: 25px
    display: flex
    margin-right: 10px
    align-items: center
    justify-content: center
    cursor: pointer
    svg
        width: 12px
        height: 12px
        fill: #666

// LOADING
#fw_upload .fw_upload_loading_bloco
    width: 100%
    height: 100%
    position: fixed
    top: 0
    left: 0
    z-index: 20
    cursor: progress

#fw_upload .fw_upload_loading
    width: 100%
    height: 1px
    position: absolute
    top: 69px
    left: 0
    display: none
    z-index: 4
    span
        width: 0%
        height: 1px
        position: absolute
        top: 0
        left: 0
        background-color: #4AA9E9
        animation: fw_upload_loading 2s linear 0s infinite

#fw_upload .fw_upload_loading_geral
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    z-index: 20
    display: none
    align-items: center
    justify-content: center
    cursor: progress

// LISTA DE IMAGEM
#fw_upload .fw_upload_lista_dado
    width: 100%
    height: calc(100vh - 130px)
    position: relative
    overflow-x: hidden
    overflow-y: auto
    display: block
    z-index: 1
    .fw_upload_lista_dado_conteudo
        width: 100%
        display: flex
        flex-direction: column
    .fw_upload_lista_arquivo
        width: 100%
        padding: 0 0 20px 20px
        display: flex
        flex-direction: row
        flex-wrap: wrap

// LISTA DE ICONES
#fw_upload .fw_upload_lista_dado_conteudo .fw_upload_lista_icone
    width: 100%
    align-items: center
    flex-direction: column
    text-align: center
    margin: 80px 0 40px 0
    svg
        width: 80px
        height: 80px
        fill: #CCC
        margin-bottom: 10px
    p
        font-size: 1.8em
        color: #CCC

#fw_upload .fw_upload_lista_dado_conteudo .fw_upload_carregar_mais
    width: 100%
    display: none
    justify-content: center
    margin: 20px 0 40px 0
    button
        height: 50px
        line-height: 50px
        border: 1px solid #DDD
        border-radius: 3px
        color: #AAA
        font-size: 1.4em
        padding: 0 20px

