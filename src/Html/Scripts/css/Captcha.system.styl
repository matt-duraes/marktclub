.fw_captcha
    width: 100%
    height: 56px
    border: 1px solid #DDD
    border-radius: 28px
    background-color: #FFF
    margin: 15px auto 0 auto
    background-color: #FFF
    display: flex
    flex-direction: row
    align-items: center
    padding: 10px 20px
    cursor: pointer
.fw_captcha.fw_captcha_checked
    border-color: #23B9A9
.fw_captcha .fw_captcha_box_loading
    width: 25px
    height: 25px
    position: absolute
    border: 3px solid #DDD
    border-top: 3px solid #23B9A9
    border-radius: 50%
    opacity: 0
    animation: fw_captcha_loading 1.1s linear .3s infinite
    z-index: 2
    display: none
.fw_captcha.fw_captcha_loading .fw_captcha_box_loading
    display: block
.fw_captcha .fw_captcha_box
    width: 20px
    height: 20px
    line-height: 20px
    text-align: center
    position: absolute
    color: #FFF
    font-size: 0
    font-family: painel
    border: 1px solid #DDD
    transform: rotate(270deg)
    z-index: 1
.fw_captcha.fw_captcha_clique .fw_captcha_box
    border-radius: 50%
.fw_captcha.fw_captcha_loading .fw_captcha_box
    width: 25px
    height: 25px
    border-width: 3px
.fw_captcha.fw_captcha_checked .fw_captcha_box
    width: 25px
    height: 25px
    border: 3px solid #23B9A9
    font-size: 1.3em
    transform: rotate(360deg)
    transition: all .2s ease-out
    color: #23B9A9
.fw_captcha .fw_captcha_texto
    position: relative
    font-size: 1.2em
    display: flex
    flex-grow: 1
    flex-basis: 0%
    padding-left: 35px
.fw_captcha .fw_captcha_icone
    width: 30px
    height: 30px
    background: url(../images/fwcaptcha/captcha.png) no-repeat
    background-size: 30px auto

@keyframes fw_captcha_loading {
    0% {
        opacity: 1;
        transform: rotate(1deg);
    }
    50% {
        opacity: 1;
        transform: rotate(180deg);
    }
    100% {
        opacity: 1;
        transform: rotate(360deg);
    }
}