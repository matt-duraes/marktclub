.fw_popup_body
    overflow: hidden !important
    padding-right: 10px
.fw_popup_display_none
    display: none !important
.fw_popup_conteudo
    opacity: 1
    transition: margin-top .3s ease-out, opacity .3s ease-out
.fw_popup_conteudo_animacao
    margin-top: -100px !important
    opacity: 0
#bloco_fw_popup
    width: 100%
    height: 100%
    position: fixed
    top: 0
    left: 0
    overflow: hidden
    background-color: rgba(0,0,0,.7)
    opacity: 0
    z-index: 10001
    display: flex
    justify-content: center
    align-items: flex-start
    transition: opacity .3s ease-out
    &.fw_popup_animacao
        opacity: 1
