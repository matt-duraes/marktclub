body.fw_body_hidden
    overflow: hidden !important
.form_geral .hide
    display: none !important
.form_geral .bloco_input_footer
    width: 100%
    height: 15px
    position: absolute
    bottom: -7px
    display: flex
    flex-direction: row
    justify-content: space-between
    overflow: hidden
    .input_mensagem
        height: 15px
        line-height: 15px
        flex-grow: 1
        position: absolute
        display: flex
        left: 10px
        bottom: 0
        font-size: 1.1rem
        color: #FF6C60
        padding: 0 5px
        opacity: 0
        background: #FFF
        transition: top .3s ease-out, opacity .3s ease-out
        overflow: hidden
        &.ativo
