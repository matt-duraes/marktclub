.form_geral .form_bloco .bloco_input_select
    width: 100%
    position: relative
    display: flex
    flex-direction: column
    .input_conteudo
        width: 100%
        position: relative
        display: flex
        flex-direction: row
        &::after
            content: ""
            width: calc(100% - 2px)
            height: 43px
            position: absolute
            top: 20px
            left: 0
