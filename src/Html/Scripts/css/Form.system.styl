        &.ativo
            opacity: 1
        .bloco_input_contador_numero
        .bloco_input_contador_barra
            font-size: 1.1rem



/* INPUT, SELECT TEXTAREA */
.form_geral
    .bloco_input
        width: 100%
        position: relative
        margin: 20px 0 10px 0
    .bloco_input .input_bloqueado
        width: 100%
        height: 45px
        position: absolute
        top: 10px
        left: 0
        z-index: 10
        border-radius: 3px
        background-color: #FFFFFF50
        cursor: no-drop
    .bloco_input .input_icone
        width: 45px
        height: 45px
        line-height: 45px
        position: absolute
        top: 0
        left: 0
        display: none
        align-items: center
        justify-content: center
        border-radius: 3px 0 0 3px
        z-index: 2
    .bloco_input .input_http
        height: 45px
        line-height: 46px
        position: absolute
        top: 0
        left: 15px
        font-size: 1.4rem
        color: #999
        display: none
    .bloco_input input
    .bloco_input textarea
        width: 100%
        height: 45px
        position: relative
        padding: 0 15px
        font-size: 1.4rem
        overflow: hidden
        z-index: 2
    .input_select input
        padding-right: 35px
    .input_textarea textarea
        line-height: 1.5em
        padding: 12px
    .bloco_input input::placeholder
        color: #999
    .bloco_input .borda
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        border: 1px solid #DDD
        z-index: 0
        border-radius: 3px
    .input_textarea .borda
        height: calc(100% - 2px)
    .bloco_input input:focus ~ .borda
    .bloco_input textarea:focus ~ .borda
        border-color: #169e91
        border-width: 2px
    .input_select
        background: url(/images/plugins/form/select.svg) no-repeat
        background-position: calc(100% - 15px) center
        background-size: 10px auto
    .bloco_input label
        height: 20px
        line-height: 21px
        padding: 0 5px
        position: absolute
        left: 10px
        top: 2px
        background-color: #FFF
        color: #169e91
        font-size: 1.2rem
        transition: top .2s ease-out, opacity .2s ease-out
        opacity: 0
        z-index: 2
    .bloco_input .input_geral.input_obrigatorio ~ label:after
        position: absolute
        top: 0
        content: "*"
        padding: 0 5px 0 3px
        background: #FFF
    .bloco_input .input_geral:not(:placeholder-shown) ~ label
        top: -10px
        opacity: 1
    .bloco_input .input_geral:not(:placeholder-shown) ~ .input_http
        display: flex
    .bloco_input .input_geral.input_url:not(:placeholder-shown)
        padding-left: 65px
        &:focus
            padding-left: 64px
    .bloco_input .input_icone_erro
        display: none
    .bloco_input .input_geral.input_obrigatorio ~ .input_icone_erro
        width: 25px
        height: 25px
        line-height: 30px
        position: absolute
        top: 10px
        display: block
        text-align: center
        z-index: 9
        &:after
            font-size: 1.4rem
            color: #FF6C60
            content: "*"
            opacity: 0
            transition: opacity .3s ease-out
    .bloco_input .input_geral.input_obrigatorio:placeholder-shown ~ .input_icone_erro
        right: 7px
        &:after
            opacity: 1
    .bloco_input .input_geral.input_obrigatorio:not(:placeholder-shown) ~ .input_icone_erro
        display: none
    .input_select .input_geral.input_obrigatorio:placeholder-shown ~ .input_icone_erro
        right: 35px
    .bloco_input.input_quantidade_erro .input_geral
    .bloco_input .input_geral.input_erro
    .bloco_input .input_geral.input_obrigatorio.input_obrigatorio_ativo:placeholder-shown
        border-color: #FF6C60
    .bloco_input .input_ajuda
        width: 25px
        height: 25px
        line-height: 25px
        position: absolute
        top: 20px
        right: 10px
        font-size: 1.4rem
        text-align: center
        background-color: #169e91
        color: #FFF
        border-radius: 50%
        cursor: default
    .bloco_input.bloco_ajuda .input_icone_erro
        right: 38px !important
    .input_input.bloco_senha input
    .input_input.bloco_ajuda input
        padding-right: 40px
    .bloco_input.bloco_senha .botao_olho
        width: 30px
        height: 100%
        position: absolute
        right: 5px
        top: 0
        z-index: 10
        display: flex
        align-items: center
        justify-content: center
    .bloco_input.bloco_senha .botao_olho .icone_olho
        width: 25px
        height: 25px
        display: none
        align-items: center
        justify-content: center
        cursor: pointer
    .bloco_input.bloco_senha .botao_olho .icone_olho svg
        width: 25px
        height: 25px
        margin: 3px 0 0 4px
        fill: #666
    .bloco_input.bloco_senha .botao_olho .icone_olho.olho_aberto
        display: flex
    .bloco_input.bloco_senha.mostrar_senha .botao_olho .icone_olho.olho_fechado
        display: flex
    .bloco_input.bloco_senha.mostrar_senha .botao_olho .icone_olho.olho_aberto
        display: none
    .bloco_input.bloco_senha .input_icone_erro
        padding-right: 38px !important
    .input_select ul
        display: none

.form_geral .bloco_input.bloco_input_icone
