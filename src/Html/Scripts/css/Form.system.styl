        overflow-y: hidden !important
        &.ck-focused
            overflow-y: auto !important
.bloco_editor > textarea
    display: none

.form_geral .bloco_ckeditor
    display: flex
    justify-content: center

// IMAGEM
.form_geral .fw_form_imagem
    width: 100%
    margin-top: 10px
    position: relative
    display: flex
    flex-direction: column
    align-items: center
    .fw_imagem_conteudo
        position: relative
        background: #EEE
        border: 10px solid #EEE
        overflow: hidden
    .fw_imagem_conteudo .fw_imagem_figure
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        z-index: 2
        background-size: contain
        background-position: center center
        background-repeat: no-repeat
    .fw_imagem_conteudo .fw_imagem_icone
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        display: flex
        align-items: center
        justify-content: center
        fill: #CCC
        z-index: 1
    .fw_imagem_conteudo .fw_imagem_icone svg
        max-width: calc(100% - 40px)
        max-height: calc(100% - 40px)
    .fw_imagem_controle
        width: calc(100% - 20px)
        position: absolute
        left: 10px
        bottom: 10px
        display: flex
        flex-direction: row
        z-index: 2
    .fw_imagem_controle .fw_imagem_linha
        flex-grow: 1
        flex-basis: 0%
    .fw_imagem_controle .fw_imagem_icone
        width: 35px
        height: 35px
        overflow: hidden
        position: relative
        fill: #FFF
        background-color: #fff
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        border-radius: 3px
        margin: 0 5px
        display: flex
        justify-content: center
        align-items: center
        cursor: pointer
        &.fw_imagem_upload
            background-color: #169e91
        &.fw_imagem_visualizar
            background-color: #00bcf2
        &.fw_imagem_remover
            background-color: #FF6C60
    .fw_imagem_controle .fw_imagem_icone input
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        opacity: 0
        z-index: 10
    .fw_imagem_hide
        display: none !important

.form_geral .fw_form_imagem.fw_form_tipo_redondo
    .fw_imagem_conteudo
        border-radius: 50%
        border: none
        box-shadow: 0 4px 5px rgba(0,0,0,.05)
    .fw_imagem_conteudo .fw_imagem_figure
        background-size: cover
    .fw_imagem_controle
        width: 100%
        position: relative
        left: 0
        bottom: 0
        margin-top: 20px
        justify-content: center
    .fw_imagem_controle .fw_imagem_linha
        display: none

#fw_imagem_bloco_visualizar
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    z-index: 9999
    background-color: rgba(0,0,0,.7)
    overflow-y: auto
    display: none
    justify-content: center
    align-items: flex-start
    opacity: 0
    transition: opacity .3s ease-out
    user-select: none
    &.fw_imagem_bloco_abrir
        opacity: 1
    .fw_imagem_icone
        width: 30px
        height: 30px
        position: fixed
        top: 20px
        fill: #FFF
        background-color: rgba(0,0,0,.7)
        border: 1px solid #FFF
        border-radius: 4px
        z-index: 2
        display: flex
        align-items: center
        justify-content: center
        cursor: pointer
        &.fw_imagem_fechar
            right: 20px
        &.fw_imagem_tamanho_real
        &.fw_imagem_tamanho_reduzido
            right: 65px
        &.fw_imagem_tamanho_reduzido
            display: none
    .fw_imagem_figure
        z-index: 1
        margin: 20px 0
        background-image: url("data:image/svg+xml;base64,")
        background-repeat: repeat
    .fw_imagem_figure img
        max-width: calc(100vw - 80px)
        max-height: calc(100vh - 42px)
        float: left
        &.fw_imagem_img_tamanho_real
            max-width: calc(100vw - 40px)
            max-height: 1000000px

.fw_form_tag
    width: 100%
    display: flex
    flex-direction: column
    .fw_form_tag_hide
        display: none
    .fw_form_tag_remover_todos
        width: 120px
        position: relative
        margin-top: 10px
        padding: 5px 0
        font-size: 1.2rem
        border-radius: 20px
        color: #FFF
        background-color: #FF6C60
        text-align: center
        cursor: pointer
        margin-bottom: 10px

.fw_form_tag .fw_form_tag_lista
    width: 100%
    display: flex
    flex-direction: row
    flex-wrap: wrap
    .fw_form_tag_item
        padding: 2px 0 2px 10px
        border-radius: 30px
        background-color: #DDD
        margin: 0 7px 10px 0
        display: flex
        align-items: center
        justify-content: center
        overflow: hidden
        cursor: default
    .fw_form_tag_item span
        font-size: 1.2rem
    .fw_form_tag_item .fw_form_tag_remover
        width: 15px
        height: 15px
        margin: 0 5px
        display: flex
        align-items: center
        justify-content: center
        cursor: pointer
.fw_form_tag.fw_form_tag_url .fw_form_tag_lista
    flex-direction: column
    .fw_form_tag_item span
        font-size: 1.2rem
        flex-grow: 1
        flex-basis: 0%
