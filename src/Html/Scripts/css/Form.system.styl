    .input_conteudo .input_select .input_select_texto
        border: none
        border-radius: 0
        padding-left: 15px
.form_geral .form_bloco .bloco_input_select.input_focus
    .input_conteudo::after
        width: calc(100% - 4px)
        height: 41px
        border: 2px solid #169e91
    .input_conteudo .input_select_linha
        width: 2px
        background-color: #169e91
    .input_conteudo .input_select
        margin-left: -1px
.form_geral .form_bloco .bloco_input_select.input_quantidade_erro
    .input_conteudo::after
        border-color: #FF6C60
    .input_conteudo .input_select_linha
        background-color: #FF6C60

#fw_form_select
#bloco_geral_autocomplete
    position: absolute
    display: none
    z-index: 10001
    .option
        width: 100%
        max-height: calc(38px * 5)
        position: absolute
        background-color: #333
        box-shadow: 0 3px 5px #FFF
        border-radius: 3px
        z-index: 10
        overflow-x: hidden
        overflow-y: auto
        &.loading_geral::after
            width: 100%
            height: 2px
            content: " "
            background-color: #FFF
            position: absolute
            top: 0
            left: 0
            z-index: 10
            animation: form_animacao_barra 2s ease-in-out 0s infinite
    .option li
        width: 100%
        height: 38px
        line-height: 38px
        padding: 0 10px 0 30px
        border: none
        font-size: 1.2rem
        color: #FFF
        display: flex
        flex-direction: row
        align-items: center
        cursor: pointer
        overflow: hidden
        align-items: flex-start
        &.hover
            background-color: #169e91
        &.selected
            background: url(/images/plugins/form/check.svg) no-repeat 9px center
            background-size: 10px auto
        &.selected.hover
            background-color: #169e91
        &.disabled
            cursor: no-drop
        &.loading
            height: 80px
            line-height: 80px
            cursor: progress
            text-align: center
#bloco_geral_autocomplete
    .option li
        color: #CCC
    .option li strong
        font-weight: bold
        font-size: 1.2rem
        color: #FFF
    .option li .flex_grow
        flex-grow: 1
        flex-basis: 0%
    .option li p
        font-size: 1.2rem
    .option li i.novo
        width: 20px
        height: 20px
        background-color: #FFFFFF50
        color: #000000
        margin-top: 8px
        font-size: 1.6rem
        border-radius: 50%
        display: flex
        align-items: center
        justify-content: center

/* CHECKBOX */
.form_geral .input_checkbox
    position: relative
    display: flex
    flex-direction: row
    overflow: hidden
    label
        min-height: 18px
        font-size: 1.4rem
        line-height: 1.5em
        color: #666
        position: relative
        padding-left: 25px
        display: flex
        align-items: center
        cursor: pointer
        word-break: break-word
    label *
        font-size: inherit
    label strong
        margin: 0 5px
    label::after
        width: 18px
        height: 18px
        position: absolute
        left: 0
        background-image: linear-gradient(to bottom, #CCC, #DDD)
        border-radius: 3px
        content: " "
    label .input_ajuda
        width: 25px
        height: 25px
        line-height: 25px
        font-size: 1.6rem
        font-weight: bold
        text-align: center
        background-color: #169e91
        color: #FFF
        margin-left: 10px
        border-radius: 50%
        cursor: default
    input
        width: 0
        height: 0
        opacity: 0
    input:checked ~ label::after
        background: #169e91 url(/images/plugins/form/check.svg) no-repeat center center
        background-size: 10px auto

/* RADIO */
.form_geral .input_radio
    position: relative
    display: flex
    flex-direction: row
    overflow: hidden
    label
        min-height: 18px
        font-size: 1.3rem
        color: #666
        position: relative
        padding-left: 25px
        display: flex
        align-items: center
        cursor: pointer
    label::after
        width: 18px
        height: 18px
        position: absolute
        left: 0
        background-image: linear-gradient(to bottom, #CCC, #DDD)
        border-radius: 50%
        content: " "
        z-index: 1
    label::before
        width: 6px
        height: 6px
        position: absolute
        left: 6px
        background: #FFF
        border-radius: 50%
        content: " "
        z-index: 2
        display: none
    input
        display: none
    input:checked ~ label::after
        background: #169e91
    input:checked ~ label::before
        display: block

/* BOTÃO SWTICH */
.form_geral .bloco_switch
    margin-top: 20px
    position: relative
    display: flex
    user-select: none
    input
        width: 1px
        height: 1px
        position: absolute
        left: 0
        top: 10px
        opacity: 0
        z-index: 1
    label
        display: flex
        color: #666
        flex-direction: row
        align-items: center
        cursor: pointer
        z-index: 2
    label p
        font-size: 1.4rem
    label .input_ajuda
        width: 25px
        height: 25px
        line-height: 25px
        font-size: 1.6rem
        font-weight: bold
        text-align: center
        background-color: #169e91
        color: #FFF
        margin-left: 10px
        border-radius: 50%
        cursor: default
    label span
        width: 40px
        height: 24px
        position: relative
        margin-left: 10px
        background: #CCC
        border-radius: 12px
        display: flex
        transition: background-color .3s ease-out
    label span::after
        width: 20px
        height: 20px
        content: ""
        position: absolute
        background: #FFF
        box-shadow: 0 0 5px #00000020
        border-radius: 50%
        top: 2px
        left: 2px
        transition: left .3s ease-out
    input:focus ~ label span
        background-color: #BBB
    input:checked ~ label span
        background-color: #169e91
    input:checked ~ label span::after
        left: 18px

.form_geral .input_cor
    height: 65px
    position: relative
    margin-top: 10px
    display: flex
    align-items: center
    .input_cor_conteudo
        height: 45px
        position: relative
        display: flex
        flex-direction: row
        border-radius: 3px
        border: 1px solid #DDD
        cursor: pointer
        overflow: hidden
    .input_cor_conteudo *
        cursor: pointer
    .input_cor_conteudo label
        height: 45px
        line-height: 44px
        font-size: 1.4rem
        font-weight: 300
        color: #999
        margin: 0 15px
    .input_cor_conteudo .input_cor_bg
        width: 50px
        height: 45px
        border-left: 1px solid #DDD
        z-index: 2
    .input_cor_conteudo .input_cor_icone
        position: absolute
        width: 50px
        height: 45px
        right: 0
        display: flex
        align-items: center
        justify-content: center
        fill: #CCC
        z-index: 1

.form_geral.form_esqueleto
    .bloco_input
        overflow: hidden
    .bloco_input::after
        width: 100%
        height: 45px
        position: absolute
        top: 10px
        left: 0
        z-index: 10
        content: " "
        background-color: #EEE
        border-radius: 3px
    .bloco_input::before
        width: 40px
        height: 45px
        content: " "
        position: absolute
        top: 10px
        left: -20px
        z-index: 11
        animation: form_esqueleto_loading 2s ease-in-out 0s infinite
        background-image: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,.6), rgba(255,255,255,0))
    .bloco_input label
        display: none

/* ANIMAÇÃO */
@keyframes form_esqueleto_loading
    0%
        left: -40px
    100%
        left: 100%
@keyframes loading_form
    0%
        left: -100%
    100%
        left: 100%
@keyframes form_animacao_barra
    0%
        left: -100%
    100%
        left: 100%

