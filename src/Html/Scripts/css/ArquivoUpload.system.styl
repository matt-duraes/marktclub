.fw_upload_body
    overflow: hidden
.fw_upload_hide
    display: none !important

.fw_upload
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    background-color: rgba(0,0,0,.7)
    z-index: 10000
    opacity: 0
    transition: opacity .3s ease-out
    &.fw_upload_abrir
        opacity: 1
.fw_upload_loading_geral
    width: 100vw
    height: 100vh
    z-index: 10
    position: fixed
    top: 0
    left: 0
    cursor: progress

.fw_upload .fw_upload_visualizar_imagem
    width: 100vw
    height: 100vh
    position: fixed
    top: 0
    left: 0
    background-color: rgba(0,0,0,.7)
    z-index: 20
    display: flex
    align-items: center
    justify-content: center
    opacity: 0
    transition: opacity .3s ease-out
    &.fw_upload_visualizar_imagem_abrir
        opacity: 1
    .fw_upload_visualizar_fechar
        width: 30px
        height: 30px
        position: absolute
        top: 20px
        right: 20px
        fill: #999
        background-color: #FFF
        border-radius: 50%
        display: flex
        align-items: center
        justify-content: center
        z-index: 2
        cursor: pointer
    .fw_upload_visualizar_img
        max-width: calc(100vw - 40px)
        max-height: calc(100vh - 40px)
        position: relative
        z-index: 1
        background-image: url("../images/plugins/arquivo/grade_photoshop.svg")

.fw_upload .fw_upload_form_editar
    width: 100vw
    height: 100vh
    position: fixed
    z-index: 20
    display: flex
    justify-content: center
    align-items: flex-start
    background-color: rgba(0,0,0,.7)
    opacity: 0
    z-index: 10
    transition: opacity .3s ease-out
    &.fw_upload_form_editar_abrir
        opacity: 1
.fw_upload .fw_upload_form_editar.fw_upload_form_editar_abrir .fw_upload_form_editar_conteudo
    top: 20px
.fw_upload .fw_upload_form_editar .fw_upload_form_editar_conteudo
    max-width: calc(100% - 40px)
    min-width: 400px
    position: absolute
    background-color: #FFF
    top: -100px
    display: flex
    flex-direction: column
    align-items: flex-end
    transition: top .3s ease-out
    border-radius: 5px
    overflow: hidden
    .fw_upload_form_editar_h1
        width: 100%
        height: 50px
        line-height: 50px
        position: relative
        padding: 0 20px
        font-size: 1.6rem
        border-bottom: 1px solid #CCC
        z-index: 1
    .fw_upload_form_editar_fechar
        width: 40px
        height: 40px
        fill: #999
        position: absolute
        top: 5px
        right: 10px
        display: flex
        align-items: center
        justify-content: center
        z-index: 2
        cursor: pointer
    .fw_upload_form_editar_p
        width: 100%
        font-size: 1.6rem
        line-height: 1.5em
        color: #666
        padding: 20px
    .fw_upload_form_editar_input
        width: calc(100% - 44px)
        height: 50px
        padding: 0 10px
        margin-right: 20px
        border-radius: 3px
        font-size: 1.4rem
        border: 1px solid #DDD
    .fw_upload_form_editar_input:focus
    .fw_upload_form_editar_input:not(:placeholder-shown)
        border: 2px solid $corVerde
        padding: 0 9px
    .fw_upload_form_editar_botao
        height: 40px
        line-height: 40px
        padding: 0 20px
        border-radius: 25px
        background-color: $corVerde
        color: #FFF
        margin: 20px
        font-size: 1.6rem
        cursor: pointer

.fw_upload .fw_upload_diretorio_mover
    width: 100vw
    height: 100vh
    position: fixed
    display: flex
    justify-content: center
    align-items: flex-start
    background-color: rgba(0,0,0,.7)
    opacity: 0
    z-index: 10
    transition: opacity .3s ease-out
    &.fw_upload_diretorio_mover_abrir
        opacity: 1
.fw_upload .fw_upload_diretorio_mover.fw_upload_diretorio_mover_abrir .fw_upload_diretorio_mover_conteudo
    top: 20px
.fw_upload .fw_upload_diretorio_mover .fw_upload_diretorio_mover_conteudo
    max-width: calc(100% - 40px)
    min-width: 400px
    position: absolute
    background-color: #FFF
    top: -100px
    transition: top .3s ease-out
    border-radius: 5px
    overflow: hidden
    .fw_upload_diretorio_mover_h1
        width: 100%
        height: 50px
        line-height: 50px
        position: relative
        padding: 0 20px
        font-size: 1.6rem
        border-bottom: 1px solid #CCC
        z-index: 1
    .fw_upload_diretorio_mover_fechar
        width: 40px
        height: 40px
        fill: #999
        position: absolute
        top: 5px
        right: 10px
        display: flex
        align-items: center
        justify-content: center
        z-index: 2
        cursor: pointer
    .fw_upload_diretorio_mover_lista
        width: 100%
        padding: 40px 50px
        position: relative
        margin-bottom: 20px
        border-bottom: 1px solid #DDD
        display: flex
        flex-direction: column
        justify-content: center
        align-item: center
        overflow: auto
    .fw_upload_diretorio_mover_lista ul
        width: 100%
        position: relative
        display: flex
        flex-direction: column
        justify-content: flex-start
        align-items: flex-start
        overflow: hidden
    .fw_upload_diretorio_mover_lista > ul
        align-items: center
    .fw_upload_diretorio_mover_lista ul li
        position: relative
        display: flex
        flex-direction: row
        justify-content: flex-start
        align-items: flex-start
        padding-bottom: 20px
        &:last-child
            padding-bottom: 0
    .fw_upload_diretorio_mover_lista ul li .botao
        height: 30px
        line-height: 30px
        font-size: 1.4rem
        padding: 0 20px
        background-color: #DDD
        border-radius: 50px
        cursor: pointer
        white-space: nowrap
        user-select: none
        &.fw_upload_diretorio_mover_selecionado
            background-color: $corVerde
            color: #FFF
        &.fw_upload_diretorio_mover_atual
            background-color: $corAzul
            cursor: default
            color: #FFF
        &.atual:hover
            background-color: $corAzul
    .fw_upload_diretorio_mover_lista ul li ul
        padding-left: 40px
    .fw_upload_diretorio_mover_lista ul li ul li::after
        content: ""
        position: absolute
        top: 15px
        left: -21px
        width: 2px
        height: 100%
        background-color: $corAzul
    .fw_upload_diretorio_mover_lista ul li ul li:last-child::after
        display: none
    .fw_upload_diretorio_mover_lista ul li ul li::before
        content: ""
        position: absolute
        top: 15px
        left: -21px
        width: 21px
        height: 2px
        background-color: $corAzul
    .fw_upload_diretorio_mover_lista ul li ul li:first-child::before
        left: -40px
        width: 40px
    .fw_upload_diretorio_mover_p
        width: 100%
        max-width: 400px
        padding: 0 20px
        font-size: 1.5rem
        line-height: 1.5em
        color: #666

    .fw_upload_diretorio_mover_aceitar
        width: 100%
        display: flex
        flex-direction: row
        padding: 20px
        justify-content: space-between
    .fw_upload_diretorio_mover_aceitar .fw_upload_diretorio_mover_aceitar_input
        width: calc(100% - 120px)
        height: 40px
        padding: 0 10px
        border-radius: 3px
        font-size: 1.4rem
        border: 1px solid #DDD
    .fw_upload_diretorio_mover_aceitar .fw_upload_diretorio_mover_aceitar_input:focus
    .fw_upload_diretorio_mover_aceitar .fw_upload_diretorio_mover_aceitar_input:not(:placeholder-shown)
        border: 2px solid $corVerde
        padding: 0 9px
    .fw_upload_diretorio_mover_aceitar .fw_upload_diretorio_mover_aceitar_botao
        width: 100px
        height: 40px
        line-height: 40px
        text-align: center
        color: #FFF
        background-color: $corVerde
        font-size: 1.5rem
        border-radius: 20px
        cursor: pointer

.fw_upload .fw_upload_usar_arquivo
    height: 60px
    line-height: 60px
    padding: 0 30px
    position: fixed
    right: 40px
    bottom: 40px
    z-index: 10
    background-color: $corVerde
    color: #FFF
    border-radius: 30px
    font-size: 1.6rem
    cursor: pointer
    z-index: 40

.fw_upload .fw_upload_conteudo
    width: calc(100vw - 40px)
    height: calc(100vh - 40px)
    position: absolute
    top: -100px
    left: 20px
    background-color: #FFF
    border-radius: 10px
    overflow: hidden
    z-index: 1
    transition: top .3s ease-out
.fw_upload.fw_upload_abrir .fw_upload_conteudo
    top: 20px

.fw_upload_grow
    flex-grow: 1
    flex-basis: 0%

.fw_upload_conteudo .fw_upload_header
    width: 100%
    height: 60px
    position: relative
    box-shadow: 0 4px 5px rgba(0,0,0,.05)
    background: #FFF
    padding: 0 20px
    display: flex
    flex-direction: row
    flex-wrap: wrap
    align-items: center
    z-index: 4
    .fw_upload_header_upload
        width: 180px
        height: 40px
        position: relative
        border-radius: 20px
        background-color: $corVerde
        overflow: hidden
        display: flex
        flex-direction: row
        align-items: center
        justify-content: center
        fill: #FFF
        cursor: pointer
    .fw_upload_header_upload svg
        margin-right: 10px
    .fw_upload_header_upload p
        color: #FFF
        font-size: 1.4rem
    .fw_upload_header_upload input
        width: 100%
        height: 100%
        position: absolute
        z-index: 2
        top: 0
        left: 0
        opacity: 0
    .fw_upload_header_form
        width: calc(100vw - 500px)
        margin: 0 20px
        position: relative
        display: flex
        flex-direction: row
        align-items: center
        justify-content: center
    .fw_upload_header_form input
        width: 250px
        max-width: 100%
        height: 40px
        line-height: 40px
        border-radius: 20px
        border: 1px solid #EEE
        font-size: 1.4rem
        padding: 0 40px 0 20px
        z-index: 1
        color: #999
        transition: width .3s ease-out, border-color .3s ease-out
        &::placeholder
            color: #CCC
        &:focus
        &:not(:placeholder-shown)
            width: 600px
            border-color: #DDD
    .fw_upload_header_form .fw_upload_header_form_botao
        width: 40px
        height: 40px
        display: flex
        margin-left: -40px
        z-index: 2
        align-items: center
        justify-content: center
        fill: #CCC
    .fw_upload_header_config
        width: 160px
        height: 40px
        position: relative
        display: flex
        padding-right: 10px
        flex-direction: row
        justify-content: flex-end
    .fw_upload_header_config .fw_upload_header_botao
        margin-right: 10px
    .fw_upload_header_config .fw_upload_header_config_ul
        width: 240px
        position: absolute
        top: 50px
        right: -20px
        background: #fff
        box-shadow: 0 4px 5px rgba(0,0,0,.05)
        border: 1px solid #EEE
        padding: 10px 0
    .fw_upload_header_config .fw_upload_header_config_ul .fw_upload_header_config_li
        width: 100%
        line-height: 1.5em
        padding: 7px 20px
        font-size: 1.4rem
        cursor: pointer
        &:hover
            background-color: #EEE
    .fw_upload_header_config .fw_upload_header_config_ul .fw_upload_header_config_linha
        width: 100%
        height: 1px
        background-color: #DDD
        margin: 10px 0
    .fw_upload_header_botao
        width: 40px
        height: 40px
        display: flex
        align-items: center
        justify-content: center
        fill: #999
        cursor: pointer

.fw_upload_conteudo .fw_upload_config
    width: 100%
    height: 50px
    position: relative
    display: flex
    flex-direction: row
    align-items: center
    padding: 0 20px
    background: #FFF
    z-index: 2
    .fw_upload_loading_linha
        width: 0%
        height: 1px
        position: absolute
        top: 0
        left: 0
        background-color: $corAzul
        animation: loading_barra 2s ease-out infinite
        z-index: 10
    .fw_upload_config_voltar
        width: 30px
        height: 30px
        margin-right: 20px
        display: flex
        align-items: center
        justify-content: center
        cursor: pointer
    .fw_upload_config_diretorio
        display: flex
        flex-direction: row
        align-items: center
    .fw_upload_config_diretorio_nome
    .fw_upload_config_diretorio_botao
        font-size: 1.6rem
        color: #666
        cursor: default
    .fw_upload_config_diretorio_botao
        cursor: pointer
    .fw_upload_config_diretorio_seta
        padding: 0 10px
        color: #666
        cursor: default

.fw_upload_conteudo .fw_upload_dado
    width: 100%
    max-width: 400px
    height: calc(100vh - 40px)
    position: absolute
    right: -400px
    top: 0
    opacity: 0
    padding-bottom: 130px
    background-color: #FFF
    z-index: 4
    box-shadow: -4px 0 5px rgba(0,0,0,.1)
    overflow-y: auto
    display: flex
    flex-direction: column
    align-items: center
    transition: opacity .3s ease-out, right .3s ease-out
    &.fw_upload_dado_abrir
        opacity: 1
        right: 0
    .fw_upload_dado_nome
        width: 100%
        height: 50px
        line-height: 50px
        overflow: hidden
        padding: 0 50px 0 20px
        font-size: 1.4rem
    .fw_upload_dado_fechar
        width: 30px
        height: 30px
        display: flex
        align-items: center
        justify-content: center
        position: absolute
        top: 10px
        right: 10px
        fill: #666
        cursor: pointer
    .fw_upload_dado_preview
        width: 100%
        height: 300px
        position: relative
        margin-bottom: 50px
        overflow: hidden
        cursor: pointer
    .fw_upload_dado_preview .fw_upload_dado_preview_grade
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background-image: url("../images/plugins/arquivo/grade_photoshop.svg")
        z-index: 1
    .fw_upload_dado_preview .fw_upload_dado_preview_bg
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background-size: cover
        background-position: center center
        z-index: 2
    .fw_upload_dado_preview_arquivo
        width: 100%
        height: 200px
        position: relative
        margin-bottom: 50px
        background-color: #DDD
        display: flex
        align-items: center
        justify-content: center
        font-size: 4rem
        color: #999
        text-transform: uppercase
    .fw_upload_botao_deletar
        width: calc(100% - 40px)
        max-width: 200px
        height: 40px
        line-height: 40px
        padding: 0 30px
        margin-bottom: 50px
        border-radius: 30px
        font-size: 1.6rem
        color: #FFF
        text-align: center
        background-color: $corVermelho
        cursor: pointer
    .fw_upload_dado_detalhe
        width: 100%
        padding: 10px 20px
        display: flex
        flex-direction: row
        border-top: 1px dashed #DDD
        &.fw_upload_dado_detalhe_dono
            border-top: none
    .fw_upload_dado_detalhe strong
    .fw_upload_dado_detalhe p
        font-size: 1.4rem
        line-height: 1.5em
    .fw_upload_dado_detalhe strong
        width: 100px
        text-align: right
        margin-right: 5px
    .fw_upload_dado_usar
        height: 50px
        line-height: 50px
        font-size: 1.6rem
        padding: 0 30px
        border-radius: 30px
        background-color: $corVerde
        position: fixed
        color: #FFF
        bottom: 40px
        cursor: pointer

.fw_upload_conteudo .fw_upload_arquivo
    width: 100%
    height: calc(100vh - 150px)
    position: relative
    overflow-y: auto
    padding-bottom: 20px
    z-index: 1
    .fw_upload_arquivo_lista
        width: 100%
        display: flex
        flex-direction: row
        flex-wrap: wrap
        padding: 10px 10px 60px 10px
    .fw_upload_zero
        width: 100%
        height: calc(100vh - 180px)
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
    .fw_upload_zero .fw_upload_zero_i
        width: 100px
        height: 100px
        border: 1px solid #CCC
        fill: #CCC
        border-radius: 50%
        display: flex
        align-items: center
        justify-content: center
    .fw_upload_zero .fw_upload_zero_p
        line-height: 1.5em
        font-size: 1.6rem
        color: #999
        margin-top: 20px
        text-align: center
    .fw_upload_mais
        max-width: 200px
        text-align: center
        font-size: 1.4rem
        height: 40px
        line-height: 40px
        border: 1px solid #CCC
        border-radius: 25px
        text-align: center
        overflow: hidden
        padding: 0 20px
        color: #999
        margin: 0 auto
        cursor: pointer
@keyframes loading_barra
    0%
        width: 0
        left: 0
    50%
        width: 100%
        left: 0
    100%
        left: 100%

.fw_upload_conteudo .fw_upload_arquivo .fw_upload_arquivo_diretorio
    width: 100%
    display: flex
    flex-direction: row
    padding: 20px 20px 0 20px
    .fw_upload_arquivo_diretorio_pasta
        padding: 40px
        display: flex
        flex-direction: column
        fill: #666
        cursor: pointer
        &:hover
            background-color: #F6F6F6
    .fw_upload_arquivo_diretorio_p
        font-size: 1.6rem
        color: #666
        margin-top: 20px
        text-align: center

.fw_upload_conteudo .fw_upload_arquivo .fw_upload_arquivo_lista .fw_upload_arquivo_imagem
    width: 150px
    margin: 10px
    display: flex
    flex-direction: column
    align-items: center
    .fw_upload_figure
        width: 100%
        height: 150px
        position: relative
        overflow: hidden
        background-color: #CCC
        box-shadow: 0 4px 5px rgba(0,0,0,.1)
        cursor: pointer
    .fw_upload_figure .fw_upload_bg
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background: #169e91
    .fw_upload_figure .fw_upload_grade
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background-image: url("../images/plugins/arquivo/grade_photoshop.svg")
        z-index: 2
    .fw_upload_figure .fw_upload_imagem
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background-size: cover
        background-position: center center
        z-index: 3
    .fw_upload_figure .fw_upload_extensao
        width: 100%
        height: 100%
        position: absolute
        top: 0
        left: 0
        background: #DDD
        color: #999
        font-size: 3rem
        display: flex
        align-items: center
        justify-content: center
        z-index: 3
    .fw_upload_figure .fw_upload_grade
    .fw_upload_figure .fw_upload_imagem
    .fw_upload_figure .fw_upload_extensao
        transition: width .3s ease-out, height .3s ease-out, top .3s ease-out, left .3s ease-out
    .fw_upload_figure .fw_upload_check
        width: 45px
        height: 45px
        display: flex
        align-items: center
        justify-content: center
        position: absolute
        top: 0
        left: 0
        z-index: 4
    .fw_upload_figure .fw_upload_check .fw_upload_check_icone
        width: 25px
        height: 25px
        display: flex
        align-items: center
        justify-content: center
        border-radius: 50%
        background-color: #FFF
        fill: #CCC
        opacity: 0
        transition: opacity .3s ease-out
        box-shadow: 0 2px 2px rgba(0,0,0,.3)
    .fw_upload_figure:hover .fw_upload_check .fw_upload_check_icone
        opacity: 1
    .fw_upload_nome
        width: 100%
        line-height: 1.5em
        text-align: center
        margin-top: 8px
        font-size: 1.6rem
        color: #666

.fw_upload_conteudo .fw_upload_arquivo .fw_upload_arquivo_lista .fw_upload_arquivo_imagem.fw_upload_arquivo_loading
    .fw_upload_figure::after
        content: ""
        position: absolute
        top: 0
        left: 0
        width: 40px
        height: 1000px
        opacity: .7
        background-image: linear-gradient(to right, rgba(255,255,255,0), #FFF, rgba(255,255,255,0))
        animation: fw_upload_esqueleto 1.3s ease-out infinite
    .fw_upload_figure .fw_upload_visualizar
    .fw_upload_figure .fw_upload_grade
        display: none
    .fw_upload_figure .fw_upload_check
        display: none
    .fw_upload_figure .fw_upload_bg
        background-color: #DDD
    .fw_upload_nome
        width: 80px
        height: 26px
        background-color: #DDD
        position: relative
        overflow: hidden
    .fw_upload_nome::after
        content: ""
        position: absolute
        top: 0
        left: 0
        width: 40px
        height: 1000px
        opacity: .7
        background-image: linear-gradient(to right, rgba(255,255,255,0), #FFF, rgba(255,255,255,0))
        animation: fw_upload_esqueleto 1.3s ease-out infinite
@keyframes fw_upload_esqueleto
    0%
        left: -60px
    100%
        left: 100%
.fw_upload_conteudo .fw_upload_arquivo .fw_upload_arquivo_lista .fw_upload_arquivo_imagem.fw_upload_arquivo_checked
    .fw_upload_figure .fw_upload_grade
    .fw_upload_figure .fw_upload_imagem
    .fw_upload_figure .fw_upload_extensao
        width: 130px
        height: 130px
        top: 10px
        left: 10px
    .fw_upload_figure .fw_upload_check .fw_upload_check_icone
        opacity: 1
        fill: #169e91
