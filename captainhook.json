{
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\Ramsey\\CaptainHook\\ValidateConventionalCommit",
                "config": {
                    "typeCase": "kebab",
                    "types": [
                        "build",
                        "ci",
                        "docs",
                        "feat",
                        "fix",
                        "perf",
                        "refactor",
                        "style",
                        "test",
                        "chore",
                        "env",
                        "improvement",
                        "revert"
                    ],
                    "scopeCase": "kebab",
                    "scopeRequired": false,
                    "scopes": [
                        "deps",
                        "composer",
                        "gulp",
                        "captainhook",
                        "api",
                        "site"
                    ],
                    "descriptionCase": "lower",
                    "descriptionEndMark": "",
                    "bodyRequired": false,
                    "bodyWrapWidth": 72,
                    "requiredFooters": []
                }
            }
        ]
    },
    "pre-push": {
        "enabled": false,
        "actions": []
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "php src/Files/stop-burrice.php"
            },
            {
                "action": "composer normalize"
            },
            {
                "action": "./vendor/bin/php-cs-fixer fix"
            },
            {
                "action": "gulp commit"
            },
            {
                "action": "git add ."
            }
        ]
    },
    "prepare-commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\Ramsey\\CaptainHook\\PrepareConventionalCommit"
            }
        ]
    },
    "post-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "git fetch --all --progress"
            }
        ]
    },
    "post-merge": {
        "enabled": false,
        "actions": []
    },
    "post-checkout": {
        "enabled": false,
        "actions": []
    },
    "post-rewrite": {
        "enabled": false,
        "actions": []
    },
    "post-change": {
        "enabled": false,
        "actions": []
    }
}
